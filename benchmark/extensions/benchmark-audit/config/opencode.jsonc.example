{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "benchmark-audit": {
      "type": "local",
      "command": [
        "node",
        "<repo-root>/benchmark/extensions/benchmark-audit/server.mjs",
        "--root",
        "<repo-root>"
      ],
      "enabled": true,
      "timeout": 5000
    }
  }
}
