+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { filterRuns, sortRuns, summarizeRuns } from "./run-explorer.mjs";
+
+test("empty inputs return zeroed summaries", () => {
+  assert.deepEqual(summarizeRuns([]), {
+    visibleCount: 0,
+    passRatePct: 0,
+    medianElapsedSeconds: 0,
+    totalCostUsd: 0,
+    costedRunCount: 0,
+  });
+});
+
+test("sort cost-asc puts known costs before null and breaks ties by score and id", () => {
+  const runs = Object.freeze([
+    Object.freeze({
+      id: "z-null-99",
+      assistant: "OpenCode",
+      model: "Z",
+      outcome: "pass",
+      score: 99,
+      elapsedSeconds: 10,
+      costUsd: null,
+    }),
+    Object.freeze({
+      id: "a-null-50",
+      assistant: "OpenCode",
+      model: "A",
+      outcome: "pass",
+      score: 50,
+      elapsedSeconds: 10,
+      costUsd: null,
+    }),
+    Object.freeze({
+      id: "b-cost-02",
+      assistant: "Codex",
+      model: "B",
+      outcome: "pass",
+      score: 80,
+      elapsedSeconds: 20,
+      costUsd: 0.02,
+    }),
+    Object.freeze({
+      id: "c-cost-01",
+      assistant: "Codex",
+      model: "C",
+      outcome: "fail",
+      score: 90,
+      elapsedSeconds: 15,
+      costUsd: 0.01,
+    }),
+  ]);
+
+  const result = sortRuns(runs, "cost-asc");
+  assert.deepEqual(result.map((run) => run.id), [
+    "c-cost-01",
+    "b-cost-02",
+    "z-null-99",
+    "a-null-50",
+  ]);
+});
