{"type":"tool_use","timestamp":1787495584430,"sessionID":"ses_fd0f6a6f6ffeuCbicMa0SsYkFB","part":{"type":"tool","tool":"write","callID":"functions.write:11","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-09KaDP/checkout/benchmark/fixtures/T4-run-explorer/student-tests.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { filterRuns, sortRuns, summarizeRuns } from \"./run-explorer.mjs\";\n\ntest(\"empty inputs return zeroed summaries\", () => {\n  assert.deepEqual(summarizeRuns([]), {\n    visibleCount: 0,\n    passRatePct: 0,\n    medianElapsedSeconds: 0,\n    totalCostUsd: 0,\n    costedRunCount: 0,\n  });\n});\n\ntest(\"sort cost-asc puts known costs before null and breaks ties by score and id\", () => {\n  const runs = Object.freeze([\n    Object.freeze({\n      id: \"z-null-99\",\n      assistant: \"OpenCode\",\n      model: \"Z\",\n      outcome: \"pass\",\n      score: 99,\n      elapsedSeconds: 10,\n      costUsd: null,\n    }),\n    Object.freeze({\n      id: \"a-null-50\",\n      assistant: \"OpenCode\",\n      model: \"A\",\n      outcome: \"pass\",\n      score: 50,\n      elapsedSeconds: 10,\n      costUsd: null,\n    }),\n    Object.freeze({\n      id: \"b-cost-02\",\n      assistant: \"Codex\",\n      model: \"B\",\n      outcome: \"pass\",\n      score: 80,\n      elapsedSeconds: 20,\n      costUsd: 0.02,\n    }),\n    Object.freeze({\n      id: \"c-cost-01\",\n      assistant: \"Codex\",\n      model: \"C\",\n      outcome: \"fail\",\n      score: 90,\n      elapsedSeconds: 15,\n      costUsd: 0.01,\n    }),\n  ]);\n\n  const result = sortRuns(runs, \"cost-asc\");\n  assert.deepEqual(result.map((run) => run.id), [\n    \"c-cost-01\",\n    \"b-cost-02\",\n    \"z-null-99\",\n    \"a-null-50\",\n  ]);\n});\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-09KaDP/checkout/benchmark/fixtures/T4-run-explorer/student-tests.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T4-run-explorer/student-tests.mjs","time":{"start":1787495584424,"end":1787495584428}},"id":"prt_02f0a12a4001NPWoLfElcVGm2L","sessionID":"ses_fd0f6a6f6ffeuCbicMa0SsYkFB","messageID":"msg_02f0a030f0012mBYqr73zw9do4"}}
