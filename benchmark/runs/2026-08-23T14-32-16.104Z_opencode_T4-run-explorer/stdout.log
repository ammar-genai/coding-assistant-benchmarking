{"type":"tool_use","timestamp":1787495560336,"sessionID":"ses_fd0f6a6f6ffeuCbicMa0SsYkFB","part":{"type":"tool","tool":"write","callID":"functions.write:8","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-09KaDP/checkout/benchmark/fixtures/T4-run-explorer/run-explorer.mjs","content":"export const sampleRuns = Object.freeze([\n  Object.freeze({\n    id: \"cx-sol-01\",\n    assistant: \"Codex\",\n    model: \"GPT-5.6 Sol\",\n    outcome: \"pass\",\n    score: 96,\n    elapsedSeconds: 72.4,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"cc-fable-01\",\n    assistant: \"Claude Code\",\n    model: \"Claude Fable 5\",\n    outcome: \"pass\",\n    score: 97,\n    elapsedSeconds: 88.1,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"oc-kimi-01\",\n    assistant: \"OpenCode\",\n    model: \"Kimi K3\",\n    outcome: \"pass\",\n    score: 93,\n    elapsedSeconds: 45.2,\n    costUsd: 0.14,\n  }),\n  Object.freeze({\n    id: \"oc-qwen-01\",\n    assistant: \"OpenCode\",\n    model: \"Qwen3.8-27B\",\n    outcome: \"fail\",\n    score: 78,\n    elapsedSeconds: 41.8,\n    costUsd: 0.05,\n  }),\n  Object.freeze({\n    id: \"cc-fable-02\",\n    assistant: \"Claude Code\",\n    model: \"Claude Fable 5\",\n    outcome: \"fail\",\n    score: 84,\n    elapsedSeconds: 101.6,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"cx-sol-02\",\n    assistant: \"Codex\",\n    model: \"GPT-5.6 Sol\",\n    outcome: \"pass\",\n    score: 91,\n    elapsedSeconds: 64.9,\n    costUsd: null,\n  }),\n]);\n\n/**\n * @param {unknown} value\n * @returns {value is Array<unknown>}\n */\nfunction isArray(value) {\n  return Array.isArray(value);\n}\n\n/**\n * @param {number} value\n * @returns {boolean}\n */\nfunction isFiniteNumber(value) {\n  return typeof value === \"number\" && Number.isFinite(value);\n}\n\n/**\n * Filter benchmark runs by assistant and/or outcome.\n * @param {readonly object[]} runs\n * @param {{ assistant?: string, outcome?: string }} filters\n * @returns {object[]}\n */\nexport function filterRuns(runs, filters = {}) {\n  if (!isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const assistantFilter = filters?.assistant;\n  const outcomeFilter = filters?.outcome;\n\n  return runs.filter((run) => {\n    if (assistantFilter && assistantFilter !== \"all\" && run.assistant !== assistantFilter) {\n      return false;\n    }\n    if (outcomeFilter && outcomeFilter !== \"all\" && run.outcome !== outcomeFilter) {\n      return false;\n    }\n    return true;\n  });\n}\n\n/**\n * Sort benchmark runs by the requested order.\n * @param {readonly object[]} runs\n * @param {string} order\n * @returns {object[]}\n */\nexport function sortRuns(runs, order) {\n  if (!isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const copy = runs.slice();\n\n  switch (order) {\n    case \"score-desc\":\n      return copy.sort((a, b) => {\n        if (b.score !== a.score) return b.score - a.score;\n        if (a.elapsedSeconds !== b.elapsedSeconds) return a.elapsedSeconds - b.elapsedSeconds;\n        return a.id.localeCompare(b.id);\n      });\n\n    case \"time-asc\":\n      return copy.sort((a, b) => {\n        if (a.elapsedSeconds !== b.elapsedSeconds) return a.elapsedSeconds - b.elapsedSeconds;\n        if (b.score !== a.score) return b.score - a.score;\n        return a.id.localeCompare(b.id);\n      });\n\n    case \"cost-asc\": {\n      return copy.sort((a, b) => {\n        const aCost = isFiniteNumber(a.costUsd) ? a.costUsd : null;\n        const bCost = isFiniteNumber(b.costUsd) ? b.costUsd : null;\n\n        if (aCost === null && bCost === null) {\n          // both unknown: fall back to score-desc then id\n          if (b.score !== a.score) return b.score - a.score;\n          return a.id.localeCompare(b.id);\n        }\n        if (aCost === null) return 1; // unknown after known\n        if (bCost === null) return -1; // known before unknown\n        if (aCost !== bCost) return aCost - bCost;\n        if (b.score !== a.score) return b.score - a.score;\n        return a.id.localeCompare(b.id);\n      });\n    }\n\n    default:\n      throw new TypeError(`Unsupported sort order: ${order}`);\n  }\n}\n\n/**\n * Summarize a subset of benchmark runs.\n * @param {readonly object[]} runs\n * @returns {{ visibleCount: number, passRatePct: number, medianElapsedSeconds: number, totalCostUsd: number, costedRunCount: number }}\n */\nexport function summarizeRuns(runs) {\n  if (!isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const count = runs.length;\n  if (count === 0) {\n    return {\n      visibleCount: 0,\n      passRatePct: 0,\n      medianElapsedSeconds: 0,\n      totalCostUsd: 0,\n      costedRunCount: 0,\n    };\n  }\n\n  const passCount = runs.filter((run) => run.outcome === \"pass\").length;\n  const passRatePct = Math.round((passCount / count) * 1000) / 10;\n\n  const sortedElapsed = runs\n    .map((run) => run.elapsedSeconds)\n    .slice()\n    .sort((a, b) => a - b);\n  const mid = Math.floor(sortedElapsed.length / 2);\n  const medianElapsedSeconds =\n    sortedElapsed.length % 2 === 1\n      ? sortedElapsed[mid]\n      : (sortedElapsed[mid - 1] + sortedElapsed[mid]) / 2;\n\n  let costedRunCount = 0;\n  // Sum costs in cents to avoid floating-point residue.\n  let totalCents = 0;\n  for (const run of runs) {\n    if (isFiniteNumber(run.costUsd)) {\n      costedRunCount += 1;\n      totalCents += Math.round(run.costUsd * 100);\n    }\n  }\n  const totalCostUsd = totalCents / 100;\n\n  return {\n    visibleCount: count,\n    passRatePct,\n    medianElapsedSeconds,\n    totalCostUsd,\n    costedRunCount,\n  };\n}\n\n// Browser-only rendering and interactions.\nif (typeof document !== \"undefined\") {\n  const assistantFilterEl = document.getElementById(\"assistant-filter\");\n  const outcomeFilterEl = document.getElementById(\"outcome-filter\");\n  const sortOrderEl = document.getElementById(\"sort-order\");\n  const resetButtonEl = document.getElementById(\"reset-filters\");\n  const resultsListEl = document.getElementById(\"results-list\");\n  const emptyStateEl = document.getElementById(\"empty-state\");\n  const statusEl = document.getElementById(\"status-message\");\n\n  const visibleCountEl = document.getElementById(\"visible-count\");\n  const passRateEl = document.getElementById(\"pass-rate\");\n  const medianTimeEl = document.getElementById(\"median-time\");\n  const knownCostEl = document.getElementById(\"known-cost\");\n\n  function formatCost(costUsd) {\n    if (isFiniteNumber(costUsd)) {\n      return `$${costUsd.toFixed(2)}`;\n    }\n    return \"Subscription\";\n  }\n\n  function formatElapsed(seconds) {\n    return `${seconds}s`;\n  }\n\n  function getFilters() {\n    return {\n      assistant: assistantFilterEl?.value ?? \"all\",\n      outcome: outcomeFilterEl?.value ?? \"all\",\n    };\n  }\n\n  function updateUI() {\n    if (!resultsListEl || !statusEl) return;\n\n    const filters = getFilters();\n    const order = sortOrderEl?.value ?? \"score-desc\";\n\n    const filtered = filterRuns(sampleRuns, filters);\n    const sorted = sortRuns(filtered, order);\n    const summary = summarizeRuns(sorted);\n\n    // Update summary values.\n    if (visibleCountEl) visibleCountEl.textContent = String(summary.visibleCount);\n    if (passRateEl) passRateEl.textContent = `${summary.passRatePct.toFixed(1)}%`;\n    if (medianTimeEl) medianTimeEl.textContent = formatElapsed(summary.medianElapsedSeconds);\n    if (knownCostEl) {\n      knownCostEl.textContent =\n        summary.costedRunCount === 0\n          ? \"$0.00\"\n          : `$${summary.totalCostUsd.toFixed(2)} (${summary.costedRunCount} known)`;\n    }\n\n    // Render results list.\n    resultsListEl.replaceChildren();\n\n    if (sorted.length === 0) {\n      emptyStateEl?.removeAttribute(\"hidden\");\n    } else {\n      emptyStateEl?.setAttribute(\"hidden\", \"\");\n      for (const run of sorted) {\n        const article = document.createElement(\"article\");\n        article.className = \"run-card\";\n\n        const header = document.createElement(\"header\");\n        const heading = document.createElement(\"h3\");\n        heading.textContent = `${run.assistant} — ${run.model}`;\n        header.appendChild(heading);\n\n        const outcomeBadge = document.createElement(\"span\");\n        outcomeBadge.className = `outcome outcome-${run.outcome}`;\n        outcomeBadge.textContent = run.outcome === \"pass\" ? \"Pass\" : \"Fail\";\n        header.appendChild(outcomeBadge);\n        article.appendChild(header);\n\n        const metrics = document.createElement(\"dl\");\n        metrics.className = \"run-metrics\";\n\n        const scoreTerm = document.createElement(\"dt\");\n        scoreTerm.textContent = \"Score\";\n        const scoreDef = document.createElement(\"dd\");\n        scoreDef.textContent = String(run.score);\n        metrics.appendChild(scoreTerm);\n        metrics.appendChild(scoreDef);\n\n        const timeTerm = document.createElement(\"dt\");\n        timeTerm.textContent = \"Time\";\n        const timeDef = document.createElement(\"dd\");\n        timeDef.textContent = formatElapsed(run.elapsedSeconds);\n        metrics.appendChild(timeTerm);\n        metrics.appendChild(timeDef);\n\n        const costTerm = document.createElement(\"dt\");\n        costTerm.textContent = \"Cost\";\n        const costDef = document.createElement(\"dd\");\n        costDef.textContent = formatCost(run.costUsd);\n        metrics.appendChild(costTerm);\n        metrics.appendChild(costDef);\n\n        article.appendChild(metrics);\n        resultsListEl.appendChild(article);\n      }\n    }\n\n    // Update live status region.\n    statusEl.textContent =\n      sorted.length === 0\n        ? \"No benchmark runs match the current filters.\"\n        : `Showing ${sorted.length} benchmark run${sorted.length === 1 ? \"\" : \"s\"}.`;\n  }\n\n  function resetFilters() {\n    if (assistantFilterEl) assistantFilterEl.value = \"all\";\n    if (outcomeFilterEl) outcomeFilterEl.value = \"all\";\n    if (sortOrderEl) sortOrderEl.value = \"score-desc\";\n    updateUI();\n  }\n\n  assistantFilterEl?.addEventListener(\"change\", updateUI);\n  outcomeFilterEl?.addEventListener(\"change\", updateUI);\n  sortOrderEl?.addEventListener(\"change\", updateUI);\n  resetButtonEl?.addEventListener(\"click\", resetFilters);\n\n  updateUI();\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-09KaDP/checkout/benchmark/fixtures/T4-run-explorer/run-explorer.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T4-run-explorer/run-explorer.mjs","time":{"start":1787495560320,"end":1787495560333}},"id":"prt_02f09b479001mytzj0QJRkh0vJ","sessionID":"ses_fd0f6a6f6ffeuCbicMa0SsYkFB","messageID":"msg_02f097170001BBD3r7WMsot85a"}}
