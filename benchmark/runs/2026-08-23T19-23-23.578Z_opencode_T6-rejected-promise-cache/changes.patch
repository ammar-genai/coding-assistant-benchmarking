+import { createConfigApi } from "./config-api.mjs";
+import { ConfigOriginError, createConfigCache } from "./config-cache.mjs";
+
+const CONFIG = Object.freeze({ version: "v1", features: Object.freeze(["search"]) });
+
+test("a rejected load is removed so the next read retries the origin", async () => {
+  let calls = 0;
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    if (calls === 1) {
+      throw new ConfigOriginError("transient");
+    }
+    return CONFIG;
+  });
+
+  await assert.rejects(cache.getConfig("acme"), ConfigOriginError);
+  assert.equal(cache.size(), 0, "failed entry should be evicted");
+
+  assert.deepEqual(await cache.getConfig("acme"), CONFIG);
+  assert.equal(calls, 2);
+});
+
+test("a late failure for a replaced entry must not evict the replacement", async () => {
+  let resolveFirst;
+  let rejectFirst;
+  let resolveSecond;
+  let calls = 0;
+  const firstOrigin = new Promise((resolve, reject) => {
+    resolveFirst = resolve;
+    rejectFirst = reject;
+  });
+  const secondOrigin = new Promise((resolve) => {
+    resolveSecond = resolve;
+  });
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    return calls === 1 ? firstOrigin : secondOrigin;
+  });
+
+  const first = cache.getConfig("acme");
+  cache.clear("acme");
+  const second = cache.getConfig("acme");
+
+  resolveSecond(CONFIG);
+  await second;
+
+  // The first load now fails after it was replaced by a successful one.
+  rejectFirst(new ConfigOriginError("first load"));
+  await assert.rejects(first, ConfigOriginError);
+
+  // The first load's catch must not have deleted the replacement.
+  assert.equal(cache.size(), 1);
+  assert.deepEqual(await cache.getConfig("acme"), CONFIG);
+  assert.equal(calls, 2, "no extra origin call after a successful replacement");
+});
+
+test("callers waiting on a failed load all observe the same failure", async () => {
+  let rejectLoad;
+  let calls = 0;
+  const origin = new Promise((_, reject) => {
+    rejectLoad = reject;
+  });
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    return origin;
+  });
+
+  const first = cache.getConfig("acme");
+  const second = cache.getConfig("acme");
+
+  rejectLoad(new ConfigOriginError("shared failure"));
+  await assert.rejects(Promise.all([first, second]), ConfigOriginError);
+  assert.equal(calls, 1, "concurrent callers share one in-flight load");
+});
+
+test("an invalid origin result must not poison future reads", async () => {
+  let calls = 0;
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    if (calls === 1) {
+      return { version: "", features: ["search"] };
+    }
+    return CONFIG;
+  });
+
+  await assert.rejects(cache.getConfig("acme"), /version must be a non-empty string/);
+  assert.equal(cache.size(), 0, "invalid entry should be evicted");
+
+  assert.deepEqual(await cache.getConfig("acme"), CONFIG);
+  assert.equal(calls, 2);
+});
+
+test("successful entries are not evicted by unrelated failures", async () => {
+  let acmeCalls = 0;
+  let betaCalls = 0;
+  const cache = createConfigCache(async (tenantId) => {
+    if (tenantId === "acme") {
+      acmeCalls += 1;
+      return CONFIG;
+    }
+    betaCalls += 1;
+    throw new ConfigOriginError("beta is down");
+  });
+
+  await cache.getConfig("acme");
+  await assert.rejects(cache.getConfig("beta"), ConfigOriginError);
+  await cache.getConfig("acme");
+
+  assert.equal(acmeCalls, 1, "acme should still be cached");
+  assert.equal(betaCalls, 1);
+});
+
+test("the API contract is preserved after an origin recovery", async () => {
+  let calls = 0;
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    if (calls === 1) {
+      throw new ConfigOriginError("temporary");
+    }
+    return CONFIG;
+  });
+  const handle = createConfigApi(cache);
+
+  const failed = await handle({ method: "GET", url: "/api/config/acme" });
+  assert.equal(failed.status, 503);
+  assert.equal(failed.headers["retry-after"], "1");
+  assert.equal(failed.headers["cache-control"], "no-store");
+
+  const recovered = await handle({ method: "GET", url: "/api/config/acme" });
+  assert.equal(recovered.status, 200);
+  assert.deepEqual(recovered.body, { config: CONFIG });
+  assert.equal(recovered.headers["cache-control"], "no-store");
 });
