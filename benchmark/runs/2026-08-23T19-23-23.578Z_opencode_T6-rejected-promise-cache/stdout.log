ait pending);\n","filediff":{"file":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-nnFPSx/checkout/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs","patch":"Index: /private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-nnFPSx/checkout/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\n===================================================================\n--- /private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-nnFPSx/checkout/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\n+++ /private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-nnFPSx/checkout/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\n@@ -50,9 +50,15 @@\n \n if (!pending) {\n   pending = Promise.resolve()\n     .then(() => loadFromOrigin(key))\n-    .then(normalizeConfig);\n+    .then(normalizeConfig)\n+    .catch((error) => {\n+      if (entries.get(key) === pending) {\n+        entries.delete(key);\n+      }\n+      throw error;\n+    });\n   entries.set(key, pending);\n }\n \n return copyConfig(await pending);\n","additions":7,"deletions":1},"truncated":false},"title":"benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs","time":{"start":1787513015311,"end":1787513015314}},"id":"prt_030140bfc001P88pE91sVtLcVF","sessionID":"ses_fcfec1ec3ffeTM9XJmOkxV2mTm","messageID":"msg_03013fad7001epM40D7LjA74nj"}}
