ssert.equal(calls, 1);\n42: });\n43: \n44: test(\"retries the origin after a transient load failure\", async () => {\n45:   let calls = 0;\n46:   const cache = createConfigCache(async () => {\n47:     calls += 1;\n48:     if (calls === 1) {\n49:       throw new ConfigOriginError(\"temporary timeout\");\n50:     }\n51:     return CONFIG;\n52:   });\n53: \n54:   await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n55:   assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n56:   assert.equal(calls, 2);\n57: });\n58: \n59: test(\"the API recovers on the request after a transient origin failure\", async () => {\n60:   let calls = 0;\n61:   const cache = createConfigCache(async () => {\n62:     calls += 1;\n63:     if (calls === 1) {\n64:       throw new ConfigOriginError(\"temporary timeout\");\n65:     }\n66:     return CONFIG;\n67:   });\n68:   const handle = createConfigApi(cache);\n69: \n70:   const failed = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n71:   const recovered = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n72: \n73:   assert.equal(failed.status, 503);\n74:   assert.equal(failed.headers[\"retry-after\"], \"1\");\n75:   assert.equal(recovered.status, 200);\n76:   assert.deepEqual(recovered.body, { config: CONFIG });\n77: });\n78: \n79: test(\"keeps tenants separate and supports targeted invalidation\", async () => {\n80:   const calls = [];\n81:   const cache = createConfigCache(async (tenantId) => {\n82:     calls.push(tenantId);\n83:     return { version: `${tenantId}-${calls.length}`, features: [] };\n84:   });\n85: \n86:   await cache.getConfig(\"acme\");\n87:   await cache.getConfig(\"beta\");\n88:   cache.clear(\"acme\");\n89:   await cache.getConfig(\"acme\");\n90: \n91:   assert.deepEqual(calls, [\"acme\", \"beta\", \"acme\"]);\n92:   assert.equal(cache.size(), 2);\n93: });\n\n(End of file - total 93 lines)\n</content>","metadata":{"preview":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createConfigApi } from \"./config-api.mjs\";\nimport { ConfigOriginError, createConfigCache } from \"./config-cache.mjs\";\n\nconst CONFIG = Object.freeze({ version: \"v1\", features: Object.freeze([\"search\"]) });\n\ntest(\"caches successful loads and returns isolated copies\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return CONFIG;\n  });\n\n  const first = await cache.getConfig(\"acme\");\n  first.features.push(\"mutated\");\n  const second = await cache.getConfig(\" acme \");\n\n  assert.equal(calls, 1);","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-nnFPSx/checkout/benchmark/fixtures/T6-rejected-promise-cache/config-cache.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createConfigApi } from \"./config-api.mjs\";\nimport { ConfigOriginError, createConfigCache } from \"./config-cache.mjs\";\n\nconst CONFIG = Object.freeze({ version: \"v1\", features: Object.freeze([\"search\"]) });\n\ntest(\"caches successful loads and returns isolated copies\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return CONFIG;\n  });\n\n  const first = await cache.getConfig(\"acme\");\n  first.features.push(\"mutated\");\n  const second = await cache.getConfig(\" acme \");\n\n  assert.equal(calls, 1);\n  assert.deepEqual(second, { version: \"v1\", features: [\"search\"] });\n  assert.notEqual(first, second);\n});\n\ntest(\"coalesces concurrent cache misses for one tenant\", async () => {\n  let release;\n  let calls = 0;\n  const origin = new Promise((resolve) => {\n    release = resolve;\n  });\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return origin;\n  });\n\n  const first = cache.getConfig(\"acme\");\n  const second = cache.getConfig(\"acme\");\n  release(CONFIG);\n\n  assert.deepEqual(await Promise.all([first, second]), [CONFIG, CONFIG]);\n  assert.equal(calls, 1);\n});\n\ntest(\"retries the origin after a transient load failure\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      throw new ConfigOriginError(\"temporary timeout\");\n    }\n    return CONFIG;\n  });\n\n  await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n  assert.equal(calls, 2);\n});\n\ntest(\"the API recovers on the request after a transient origin failure\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      throw new ConfigOriginError(\"temporary timeout\");\n    }\n    return CONFIG;\n  });\n  const handle = createConfigApi(cache);\n\n  const failed = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n  const recovered = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n\n  assert.equal(failed.status, 503);\n  assert.equal(failed.headers[\"retry-after\"], \"1\");\n  assert.equal(recovered.status, 200);\n  assert.deepEqual(recovered.body, { config: CONFIG });\n});\n\ntest(\"keeps tenants separate and supports targeted invalidation\", async () => {\n  const calls = [];\n  const cache = createConfigCache(async (tenantId) => {\n    calls.push(tenantId);\n    return { version: `${tenantId}-${calls.length}`, features: [] };\n  });\n\n  await cache.getConfig(\"acme\");\n  await cache.getConfig(\"beta\");\n  cache.clear(\"acme\");\n  await cache.getConfig(\"acme\");\n\n  assert.deepEqual(calls, [\"acme\", \"beta\", \"acme\"]);\n  assert.equal(cache.size(), 2);\n});","lineStart":1,"lineEnd":93,"totalLines":93,"truncated":false}},"title":"benchmark/fixtures/T6-rejected-promise-cache/config-cache.test.mjs","time":{"start":1787513008515,"end":1787513008531}},"id":"prt_03013f181001hb