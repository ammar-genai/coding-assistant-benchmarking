{"type":"tool_use","timestamp":1787513022867,"sessionID":"ses_fcfec1ec3ffeTM9XJmOkxV2mTm","part":{"type":"tool","tool":"write","callID":"functions.write:10","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-nnFPSx/checkout/benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createConfigApi } from \"./config-api.mjs\";\nimport { ConfigOriginError, createConfigCache } from \"./config-cache.mjs\";\n\nconst CONFIG = Object.freeze({ version: \"v1\", features: Object.freeze([\"search\"]) });\n\ntest(\"a rejected load is removed so the next read retries the origin\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      throw new ConfigOriginError(\"transient\");\n    }\n    return CONFIG;\n  });\n\n  await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n  assert.equal(cache.size(), 0, \"failed entry should be evicted\");\n\n  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n  assert.equal(calls, 2);\n});\n\ntest(\"a late failure for a replaced entry must not evict the replacement\", async () => {\n  let releaseFirst;\n  let releaseSecond;\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      return new Promise((_, reject) => {\n        releaseFirst = () => reject(new ConfigOriginError(\"first load\"));\n      });\n    }\n    return new Promise((resolve) => {\n      releaseSecond = () => resolve(CONFIG);\n    });\n  });\n\n  const first = cache.getConfig(\"acme\");\n  cache.clear(\"acme\");\n  const second = cache.getConfig(\"acme\");\n\n  releaseFirst();\n  await assert.rejects(first, ConfigOriginError);\n\n  releaseSecond();\n  assert.deepEqual(await second, CONFIG);\n\n  // The first load's catch must not have deleted the replacement.\n  assert.equal(cache.size(), 1);\n  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n  assert.equal(calls, 2, \"no extra origin call after a successful replacement\");\n});\n\ntest(\"callers waiting on a failed load all observe the same failure\", async () => {\n  let release;\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return new Promise((_, reject) => {\n      release = () => reject(new ConfigOriginError(\"shared failure\"));\n    });\n  });\n\n  const first = cache.getConfig(\"acme\");\n  const second = cache.getConfig(\"acme\");\n\n  release();\n  await assert.rejects(Promise.all([first, second]), ConfigOriginError);\n  assert.equal(calls, 1, \"concurrent callers share one in-flight load\");\n});\n\ntest(\"an invalid origin result must not poison future reads\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      return { version: \"\", features: [\"search\"] };\n    }\n    return CONFIG;\n  });\n\n  await assert.rejects(cache.getConfig(\"acme\"), /version must be a non-empty string/);\n  assert.equal(cache.size(), 0, \"invalid entry should be evicted\");\n\n  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n  assert.equal(calls, 2);\n});\n\ntest(\"successful entries are not evicted by unrelated failures\", async () => {\n  let acmeCalls = 0;\n  let betaCalls = 0;\n  const cache = createConfigCache(async (tenantId) => {\n    if (tenantId === \"acme\") {\n      acmeCalls += 1;\n      return CONFIG;\n    }\n    betaCalls += 1;\n    throw new ConfigOriginError(\"beta is down\");\n  });\n\n  await cache.getConfig(\"acme\");\n  await assert.rejects(cache.getConfig(\"beta\"), ConfigOriginError);\n  await cache.getConfig(\"acme\");\n\n  assert.equal(acmeCalls, 1, \"acme should still be cached\");\n  assert.equal(betaCalls, 1);\n});\n\ntest(\"the API contract is preserved after an origin recovery\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      throw new ConfigOriginError(\"temporary\");\n    }\n    return CONFIG;\n  });\n  const handle = createConfigApi(cache);\n\n  const failed = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n  assert.equal(failed.status, 503);\n  assert.equal(failed.headers[\"retry-after\"], \"1\");\n  assert.equal(failed.headers[\"cache-control\"], \"no-store\");\n\n  const recovered = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n  assert.equal(recovered.status, 200);\n  assert.deepEqual(recovered.body, { config: CONFIG });\n  assert.equal(recovered.headers[\"cache-control\"], \"no-store\");\n});\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-nnFPSx/checkout/benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs","time":{"start":1787513022856,"end":1787513022865}},"id":"prt_030142983001mwWIo3GD7mZpjz","sessionID":"ses_fcfec1ec3ffeTM9XJmOkxV2mTm","messageID":"msg_030140c94001y7Cn34YlpSJlSh"}}
