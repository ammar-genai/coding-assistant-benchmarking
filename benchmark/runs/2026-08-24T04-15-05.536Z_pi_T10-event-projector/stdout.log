er)) {\n      throw new TypeError(\"CREATED requires a positive finite notional and non-empty owner\");\n    }\n    return;\n  }\n\n  if (event.type === \"AMENDED\") {\n    if (!isRecord(event.payload)) {\n      throw new TypeError(\"AMENDED requires a payload\");\n    }\n    const keys = Object.keys(event.payload);\n    if (keys.length === 0 || keys.some((key) => key !== \"notional\" && key !== \"owner\")) {\n      throw new TypeError(\"AMENDED may contain only notional and owner\");\n    }\n    if ((own(event.payload, \"notional\") && !validNotional(event.payload.notional)) ||\n        (own(event.payload, \"owner\") && !validOwner(event.payload.owner))) {\n      throw new TypeError(\"AMENDED fields must remain valid\");\n    }\n    return;\n  }\n\n  if (event.payload !== undefined && (!isRecord(event.payload) || Object.keys(event.payload).length !== 0)) {\n    throw new TypeError(\"CANCELLED does not accept payload fields\");\n  }\n}\n\nfunction reduceEvent(previous, event) {\n  if (event.type === \"CREATED\") {\n    return {\n      tradeId: event.tradeId,\n      version: event.version,\n      status: \"active\",\n      notional: event.payload.notional,\n      owner: event.payload.owner,\n    };\n  }\n  if (event.type === \"AMENDED\") {\n    return {\n      ...previous,\n      version: event.version,\n      ...(own(event.payload, \"notional\") ? { notional: event.payload.notional } : {}),\n      ...(own(event.payload, \"owner\") ? { owner: event.payload.owner } : {}),\n    };\n  }\n  return { ...previous, version: event.version, status: \"cancelled\" };\n}\n\nexport function createEventProjector(applyToStore) {\n  if (typeof applyToStore !== \"function\") {\n    throw new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map();\n  const tails = new Map();\n\n  async function project(event) {\n    let acceptedEvent;\n    try {\n      acceptedEvent = copy(event);\n      validateEvent(acceptedEvent);\n    } catch (error) {\n      if (error instanceof TypeError) throw error;\n      throw new TypeError(\"event must be cloneable\", { cause: error });\n    }\n\n    const tradeId = acceptedEvent.tradeId;\n    const previousTail = tails.get(tradeId) ?? Promise.resolve();\n    const operation = previousTail.then(async () => {\n      const previous = states.get(tradeId);\n\n      if (previous && acceptedEvent.version <= previous.version) {\n        return copy(previous);\n      }\n      if (!previous) {\n        if (acceptedEvent.type !== \"CREATED\" || acceptedEvent.version !== 1) {\n          throw new Error(\"the first event must be CREATED at version 1\");\n        }\n      } else {\n        if (acceptedEvent.version !== previous.version + 1) {\n          throw new Error(\"event version must be exactly the current version plus one\");\n        }\n        if (previous.status === \"cancelled\") {\n          throw new Error(\"a cancelled trade is terminal\");\n        }\n        if (acceptedEvent.type === \"CREATED\") {\n          throw new Error(\"CREATED is only valid as the first event\");\n        }\n      }\n\n      const next = reduceEvent(previous, acceptedEvent);\n      await applyToStore(tradeId, copy(next), copy(acceptedEvent));\n      states.set(tradeId, next);\n      return copy(next);\n    });\n\n    const tail = operation.then(() => undefined, () => undefined);\n    tails.set(tradeId, tail);\n    tail.then(() => {\n      if (tails.get(tradeId) === tail) tails.delete(tradeId);\n    });\n    return operation;\n  }\n\n  function getSnapshot(tradeId) {\n    return copy(states.get(tradeId)) ?? null;\n  }\n\n  return { project, getSnapshot };\n}\n"}],"isError":false,"timestamp":1787544981865},{"role":"assistant","content":[{"type":"text","text":"Implemented the event projector repair in:\n\n- `benchmark/fixtures/T10-event-projector/event-projector.mjs`\n- `benchmark/fixtures/T10-event-projector/student-tests.mjs`\n- `benchmark/fixtures/T10-event-projector/INCIDENT.md`\n\n**Root cause:** A single global promise chain serialized every trade and remained rejected after a persistence failure. State was also committed before persistence succeeded.\n\n**Repair:** Added recoverable per-trade queues, post-persistence state commits, lifecycle/version validation, terminal cancellation handling, payload validation, and defensive cloning across all boundaries.\n\n**Tests added:** Five regression tests covering:\n\n- Per-trade concurrency and same-trade ordering\n- Persistence failure rollback and recovery\n- Duplicate/stale events, version gaps, and cancellation\n- Event and payload validation\n- Mutation isolation for inputs, callback arguments, results, and snapshots\n\n**Visible test result:**\n\n```text\ntests 7\npass 7\nfail 0\n```\n\n**Remaining risk:** Tests use deterministic in-memory persistence; real-store crash windows and ambiguous external failures still require persistence-layer idempotency."}],"api":"openai-completions","provider":"openrouter","model":"openai/gpt-5.6-sol","usage":{"input":3,"output":568,"cacheRead":6787,"cacheWrite":1328,"reasoning":337,"totalTokens":8686,"cost":{"input":0.000007500000000000001,"output":0.00852,"cacheRead":0.00169675,"cacheWrite":0.00415,"total":0.014374250000000002}},"stopReason":"stop","timestamp":1787544981865,"responseId":"gen-1787544981-dr5QoFMaGuih1TBLfSxe","rawStopReason":"stop"}],"willRetry":false}
