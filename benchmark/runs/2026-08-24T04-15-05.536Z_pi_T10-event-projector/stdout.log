sisted, [\"free:1\", \"blocked:1\", \"blocked:2\"]);\n});\n\ntest(\"failed persistence neither commits nor poisons that trade\", async () => {\n  let attempts = 0;\n  const projector = createEventProjector(async () => {\n    attempts += 1;\n    if (attempts === 1) throw new Error(\"temporary failure\");\n  });\n\n  await assert.rejects(projector.project(created()), /temporary failure/);\n  assert.equal(projector.getSnapshot(\"trade-1\"), null);\n  assert.equal((await projector.project(created())).version, 1);\n  assert.equal(attempts, 2);\n});\n\ntest(\"stale events are idempotent and gaps and post-cancellation events reject\", async () => {\n  let writes = 0;\n  const projector = createEventProjector(async () => { writes += 1; });\n  await projector.project(created());\n\n  const stale = await projector.project(created(\"trade-1\", {\n    payload: { notional: 999, owner: \"other\" },\n  }));\n  assert.equal(stale.notional, 100);\n  assert.equal(writes, 1);\n  await assert.rejects(projector.project({\n    tradeId: \"trade-1\", version: 3, type: \"AMENDED\", payload: { owner: \"desk-b\" },\n  }), /version/);\n  await projector.project({ tradeId: \"trade-1\", version: 2, type: \"CANCELLED\" });\n  await assert.rejects(projector.project({\n    tradeId: \"trade-1\", version: 3, type: \"AMENDED\", payload: { owner: \"desk-b\" },\n  }), /terminal/);\n  assert.equal(projector.getSnapshot(\"trade-1\").status, \"cancelled\");\n});\n\ntest(\"validates lifecycle events and amendment fields\", async () => {\n  const projector = createEventProjector(async () => {});\n  await assert.rejects(projector.project({\n    tradeId: \"new\", version: 1, type: \"AMENDED\", payload: { owner: \"desk-b\" },\n  }), /first event/);\n  await assert.rejects(projector.project(created(\"bad\", {\n    payload: { notional: Infinity, owner: \"\" },\n  })), TypeError);\n\n  await projector.project(created());\n  const amended = await projector.project({\n    tradeId: \"trade-1\", version: 2, type: \"AM