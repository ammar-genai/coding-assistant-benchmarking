+import { createEventProjector } from "./event-projector.mjs";
+
+const created = (tradeId = "trade-1", overrides = {}) => ({
+  tradeId,
+  version: 1,
+  type: "CREATED",
+  payload: { notional: 100, owner: "desk-a" },
+  ...overrides,
+});
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((done) => { resolve = done; });
+  return { promise, resolve };
+}
+
+test("queues each trade independently while preserving same-trade order", async () => {
+  const releaseFirst = deferred();
+  const persisted = [];
+  const projector = createEventProjector(async (tradeId, state) => {
+    if (tradeId === "blocked") await releaseFirst.promise;
+    persisted.push(`${tradeId}:${state.version}`);
+  });
+
+  const blocked = projector.project(created("blocked"));
+  const blockedAmendment = projector.project({
+    tradeId: "blocked", version: 2, type: "AMENDED", payload: { notional: 125 },
+  });
+  const unrelated = projector.project(created("free"));
+
+  assert.equal((await unrelated).tradeId, "free");
+  assert.deepEqual(persisted, ["free:1"]);
+  releaseFirst.resolve();
+  await Promise.all([blocked, blockedAmendment]);
+  assert.deepEqual(persisted, ["free:1", "blocked:1", "blocked:2"]);
+});
+
+test("failed persistence neither commits nor poisons that trade", async () => {
+  let attempts = 0;
+  const projector = createEventProjector(async () => {
+    attempts += 1;
+    if (attempts === 1) throw new Error("temporary failure");
+  });
+
+  await assert.rejects(projector.project(created()), /temporary failure/);
+  assert.equal(projector.getSnapshot("trade-1"), null);
+  assert.equal((await projector.project(created())).version, 1);
+  assert.equal(attempts, 2);
+});
+
