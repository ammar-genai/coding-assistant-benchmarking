+  let writes = 0;
+  const projector = createEventProjector(async () => { writes += 1; });
+  await projector.project(created());
+
+  const stale = await projector.project(created("trade-1", {
+    payload: { notional: 999, owner: "other" },
+  }));
+  assert.equal(stale.notional, 100);
+  assert.equal(writes, 1);
+  await assert.rejects(projector.project({
+    tradeId: "trade-1", version: 3, type: "AMENDED", payload: { owner: "desk-b" },
+  }), /version/);
+  await projector.project({ tradeId: "trade-1", version: 2, type: "CANCELLED" });
+  await assert.rejects(projector.project({
+    tradeId: "trade-1", version: 3, type: "AMENDED", payload: { owner: "desk-b" },
+  }), /terminal/);
+  assert.equal(projector.getSnapshot("trade-1").status, "cancelled");
