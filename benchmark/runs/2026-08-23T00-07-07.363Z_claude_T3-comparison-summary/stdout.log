{"type":"assistant","message":{"id":"msg_b298fa5be53f17505205cb9b","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_6d9jwntn","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-KFa75N/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs","content":"// Student-authored tests for the T3 comparison-summary contract.\n// These cover edge cases not exercised by the committed comparison-summary.test.mjs suite.\nimport assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"summarizeAssistants: case-sensitive grouping, run_id tie-break, and even median\", () => {\n  const runs = [\n    {\n      run_id: \"run-b\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \"run-a\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \"run-c\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 60,\n      elapsed_ms: 200,\n    },\n    {\n      run_id: \"run-d\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 60,\n      elapsed_ms: 300,\n    },\n    {\n      run_id: \"lower-1\",\n      assistant: \"opencode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 50,\n      elapsed_ms: 10,\n    },\n  ];\n\n  const result = summarizeAssistants(runs);\n\n  assert.deepEqual(result, [\n    {\n      assistant: \"OpenCode\",\n      run_count: 4,\n      best_score: 80,\n      best_run_id: \"run-a\", // same score and elapsed as run-b; smaller run_id wins\n      median_elapsed_ms: 150, // even count: (100 + 200) / 2\n    },\n    {\n      assistant: \"opencode\",\n      run_count: 1,\n      best_score: 50,\n      best_run_id: \"lower-1\",\n      median_elapsed_ms: 10,\n    },\n  ]);\n\n  // The input array and its records must not be mutated.\n  assert.deepEqual(\n    runs.map((run) => run.run_id),\n    [\"run-b\", \"run-a\", \"run-c\", \"run-d\", \"lower-1\"],\n  );\n});\n\ntest(\"summarizeAssistants: invalid eligible data throws, ineligible data is ignored\", () => {\n  assert.throws(() => summarizeAssistants(\"not-an-array\"), TypeError);\n\n  const runs = [\n    {\n      run_id: \"bad-score\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 150, // out of range for an eligible run\n      elapsed_ms: 10,\n    },\n    {\n      run_id: \"failed-invalid\",\n      assistant: \"Codex\",\n      status: \"failed\", // ineligible, so its invalid fields must not matter\n      acceptance_status: \"pass\",\n      score: -5,\n      elapsed_ms: -100,\n      comparison_eligible: true,\n    },\n    {\n      run_id: \"good\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 75,\n      elapsed_ms: 25,\n    },\n  ];\n\n  assert.throws(() => summarizeAssistants(runs), TypeError);\n  assert.deepEqual(summarizeAssistants(runs.slice(1)), [\n    {\n      assistant: \"Codex\",\n      run_count: 1,\n      best_score: 75,\n      best_run_id: \"good\",\n      median_elapsed_ms: 25,\n    },\n  ]);\n});\n\ntest(\"renderComparisonTable: preserves order, escapes pipes, formats seconds\", () => {\n  const summaries = [\n    {\n      assistant: \"Beta|One\",\n      run_count: 3,\n      best_score: 90,\n      best_run_id: \"id|b\",\n      median_elapsed_ms: 1250,\n    },\n    {\n      assistant: \"Alpha\",\n      run_count: 1,\n      best_score: 100,\n      best_run_id: \"id-a\",\n      median_elapsed_ms: 500,\n    },\n  ];\n\n  // Supplied order is preserved even though \"Alpha\" sorts before \"Beta\".\n  assert.equal(\n    renderComparisonTable(summaries),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"| Beta\\\\|One | 3 | 90 | id\\\\|b | 1.250 s |\",\n      \"| Alpha | 1 | 100 | id-a | 0.500 s |\",\n    ].join(\"\\n\"),\n  );\n});\n\ntest(\"renderComparisonTable: rejects invalid summary fields\", () => {\n  assert.throws(() => renderComparisonTable(\"nope\"), TypeError);\n\n  const base = {\n    assistant: \"Pi\",\n    run_count: 2,\n    best_score: 90,\n    best_run_id: \"pi-run\",\n    median_elapsed_ms: 100,\n  };\n\n  assert.throws(\n    () => renderComparisonTable([{ ...base, run_count: 0 }]),\n    TypeError,\n  );\n  assert.throws(\n    () => renderComparisonTable([{ ...base, best_score: 101 }]),\n    TypeError,\n  );\n  assert.throws(\n    () => renderComparisonTable([{ ...base, median_elapsed_ms: -1 }]),\n    TypeError,\n  );\n  assert.throws(\n    () => renderComparisonTable([{ ...base, assistant: \"\" }]),\n    TypeError,\n  );\n});\n"}}],"usage":{"input_tokens":21896,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1da5eca0-d58c-4774-8d48-41166d9f2452","uuid":"f5492fe7-a560-44b3-bec2-84a74d1fd169","timestamp":"2026-08-23T00:07:52.506Z"}
