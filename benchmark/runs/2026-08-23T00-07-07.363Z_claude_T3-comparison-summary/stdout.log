"breaks a best-score tie with elapsed time\", () => {\n  const runs = [\n    {\n      run_id: \"slower\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 94,\n      elapsed_ms: 1_100,\n    },\n    {\n      run_id: \"faster\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 94,\n      elapsed_ms: 900,\n    },\n  ];\n\n  assert.equal(summarizeAssistants(runs)[0].best_run_id, \"faster\");\n});\n\ntest(\"renders the exact Markdown table format\", () => {\n  const summaries = [\n    {\n      assistant: \"Open|Code\",\n      run_count: 2,\n      best_score: 95.5,\n      best_run_id: \"run|2\",\n      median_elapsed_ms: 1_250,\n    },\n  ];\n\n  assert.equal(\n    renderComparisonTable(summaries),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"| Open\\\\|Code | 2 | 95.5 | run\\\\|2 | 1.250 s |\",\n    ].join(\"\\n\"),\n  );\n});\n\ntest(\"renders an explicit empty state below the table header\", () => {\n  assert.equal(\n    renderComparisonTable([]),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"\",\n      \"_No eligible runs._\",\n    ].join(\"\\n\"),\n  );\n});\n","numLines":126,"startLine":1,"totalLines":126}}}
