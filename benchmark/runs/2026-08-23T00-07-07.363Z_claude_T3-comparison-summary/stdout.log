eric values after a numeric sort. For an even count, average the\n * two middle values. The input array is not mutated.\n */\nfunction median(times) {\n  const sorted = [...times].sort((x, y) => x - y);\n  const middle = sorted.length >> 1;\n  if (sorted.length % 2 === 1) return sorted[middle];\n  return (sorted[middle - 1] + sorted[middle]) / 2;\n}\n\nexport function summarizeAssistants(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const groups = new Map();\n\n  for (const run of runs) {\n    if (!isEligible(run)) continue;\n    validateEligibleRun(run);\n\n    let group = groups.get(run.assistant);\n    if (group === undefined) {\n      group = { runs: [] };\n      groups.set(run.assistant, group);\n    }\n    group.runs.push(run);\n  }\n\n  const summaries = [];\n  for (const [assistant, group] of groups) {\n    let best = group.runs[0];\n    for (const run of group.runs) {\n      if (isBetter(run, best)) best = run;\n    }\n    summaries.push({\n      assistant,\n      run_count: group.runs.length,\n      best_score: best.score,\n      best_run_id: best.run_id,\n      median_elapsed_ms: median(group.runs.map((run) => run.elapsed_ms)),\n    });\n  }\n\n  summaries.sort((a, b) => {\n    if (a.assistant < b.assistant) return -1;\n    if (a.assistant > b.assistant) return 1;\n    return 0;\n  });\n\n  return summaries;\n}\n"}}],"usage":{"input_tokens":13853,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1da5eca0-d58c-4774-8d48-41166d9f2452","uuid":"ed3d6abf-3907-4a70-8a39-d5294f0a2afd","timestamp":"2026-08-23T00:07:47.236Z"}
