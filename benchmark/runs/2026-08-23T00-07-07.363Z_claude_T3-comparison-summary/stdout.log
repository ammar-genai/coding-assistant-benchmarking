e an array\");\n  }\n\n  if (summaries.length === 0) {\n    return [HEADER, DIVIDER, \"\", \"_No eligible runs._\"].join(\"\\n\");\n  }\n\n  const rows = [HEADER, DIVIDER];\n  for (const summary of summaries) {\n    if (!isValidSummary(summary)) {\n      throw new TypeError(\"summary has invalid fields\");\n    }\n    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);\n    rows.push(\n      `| ${escapeCell(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapeCell(summary.best_run_id)} | ${seconds} s |`,\n    );\n  }\n\n  return rows.join(\"\\n\");\n}\n","structuredPatch":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":58,"lines":[" /**","  * Render assistant summaries as a stable Markdown table.","  */","+","+const HEADER = \"| Assistant | Runs | Best score | Best run | Median time |\";","+const DIVIDER = \"|---|---:|---:|---|---:|\";","+","+/**","+ * A summary must satisfy the render contract before it can be displayed.","+ */","+function isValidSummary(summary) {","+  if (summary === null || typeof summary !== \"object\" || Array.isArray(summary)) {","+    return false;","+  }","+  if (typeof summary.assistant !== \"string\" || summary.assistant.length === 0) {","+    return false;","+  }","+  if (typeof summary.best_run_id !== \"string\" || summary.best_run_id.length === 0) {","+    return false;","+  }","+  if (!Number.isInteger(summary.run_count) || summary.run_count <= 0) {","+    return false;","+  }","+  if (!Number.isFinite(summary.best_score) || summary.best_score < 0 || summary.best_score > 100) {","+    return false;","+  }","+  if (!Number.isFinite(summary.median_elapsed_ms) || summary.median_elapsed_ms < 0) {","+    return false;","+  }","+  return true;","+}","+","+function escapeCell(value) {","+  return value.replaceAll(\"|\", \"\\\\|\");","+}","+"," export function renderComparisonTable(summaries) {","   if (!Array.isArray(summaries)) {","     throw new TypeError(\"summaries must be an array\");","   }"," ","-  return \"\";","+  if (summaries.length === 0) {","+    return [HEADER, DIVIDER, \"\", \"_No eligible runs._\"].join(\"\\n\");","+  }","+","+  const rows = [HEADER, DIVIDER];","+  for (const summary of summaries) {","+    if (!isValidSummary(summary)) {","+      throw new TypeError(\"summary has invalid fields\");","+    }","+    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);","+    rows.push(","+      `| ${escapeCell(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapeCell(summary.best_run_id)} | ${seconds} s |`,","+    );","+  }","+","+  return rows.join(\"\\n\");"," }"]}],"originalFile":"/**\n * Render assistant summaries as a stable Markdown table.\n */\nexport function renderComparisonTable(summaries) {\n  if (!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n\n  return \"\";\n}\n","userModified":false}}
