+test("renderComparisonTable: preserves order, escapes pipes, formats seconds", () => {
+  const summaries = [
+    {
+      assistant: "Beta|One",
+      run_count: 3,
+      best_score: 90,
+      best_run_id: "id|b",
+      median_elapsed_ms: 1250,
