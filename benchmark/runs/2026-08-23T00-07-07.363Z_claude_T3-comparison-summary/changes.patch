+
+test("renderComparisonTable: rejects invalid summary fields", () => {
+  assert.throws(() => renderComparisonTable("nope"), TypeError);
+
+  const base = {
+    assistant: "Pi",
+    run_count: 2,
+    best_score: 90,
+    best_run_id: "pi-run",
+    median_elapsed_ms: 100,
+  };
+
+  assert.throws(
+    () => renderComparisonTable([{ ...base, run_count: 0 }]),
+    TypeError,
