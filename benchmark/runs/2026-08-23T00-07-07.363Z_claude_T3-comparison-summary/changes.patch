+      status: "complete",
+      acceptance_status: "pass",
+      score: 80,
+      elapsed_ms: 100,
+    },
+    {
+      run_id: "run-a",
+      assistant: "OpenCode",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 80,
+      elapsed_ms: 100,
+    },
+    {
+      run_id: "run-c",
+      assistant: "OpenCode",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 60,
+      elapsed_ms: 200,
+    },
+    {
+      run_id: "run-d",
+      assistant: "OpenCode",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 60,
+      elapsed_ms: 300,
+    },
+    {
+      run_id: "lower-1",
+      assistant: "opencode",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 50,
+      elapsed_ms: 10,
+    },
+  ];
+
+  const result = summarizeAssistants(runs);
+
+  assert.deepEqual(result, [
+    {
+      assistant: "OpenCode",
+      run_count: 4,
+      best_score: 80,
+      best_run_id: "run-a", // same score and elapsed as run-b; smaller run_id wins
+      median_elapsed_ms: 150, // even count: (100 + 200) / 2
+    },
+    {
+      assistant: "opencode",
+      run_count: 1,
+      best_score: 50,
+      best_run_id: "lower-1",
+      median_elapsed_ms: 10,
+    },
+  ]);
+
+  // The input array and its records must not be mutated.
+  assert.deepEqual(
+    runs.map((run) => run.run_id),
+    ["run-b", "run-a", "run-c", "run-d", "lower-1"],
+  );
+});
+
+test("summarizeAssistants: invalid eligible data throws, ineligible data is ignored", () => {
+  assert.throws(() => summarizeAssistants("not-an-array"), TypeError);
+
+  const runs = [
+    {
+      run_id: "bad-score",
+      assistant: "Codex",
