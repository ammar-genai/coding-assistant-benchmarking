diff --git a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
index 3fe2216..91810ae 100644
--- a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
+++ b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
@@ -1,10 +1,100 @@
 /**
  * Build one comparison summary per assistant from raw benchmark run records.
  */
+
+/**
+ * A run is eligible for comparison only when it completed, its answer passed,
+ * and it was not explicitly excluded.
+ */
+function isEligible(run) {
+  return (
+    run !== null &&
+    typeof run === "object" &&
+    run.status === "complete" &&
+    run.acceptance_status === "pass" &&
+    run.comparison_eligible !== false
+  );
+}
+
+/**
+ * Enforce the data contract on an eligible run. Invalid fields on an
+ * ineligible run are irrelevant and never reach this check.
+ */
+function validateEligibleRun(run) {
+  if (typeof run.run_id !== "string" || run.run_id.length === 0) {
+    throw new TypeError("run_id must be a non-empty string");
+  }
+  if (typeof run.assistant !== "string" || run.assistant.length === 0) {
+    throw new TypeError("assistant must be a non-empty string");
+  }
+  if (!Number.isFinite(run.score) || run.score < 0 || run.score > 100) {
+    throw new TypeError("score must be a finite number from 0 through 100");
+  }
+  if (!Number.isFinite(run.elapsed_ms) || run.elapsed_ms < 0) {
+    throw new TypeError("elapsed_ms must be a finite number greater than or equal to zero");
+  }
+}
+
+/**
+ * Returns true when `a` is a better result than `b`: higher score, then lower
+ * elapsed time, then lexicographically smaller run_id.
+ */
+function isBetter(a, b) {
+  if (a.score !== b.score) return a.score > b.score;
+  if (a.elapsed_ms !== b.elapsed_ms) return a.elapsed_ms < b.elapsed_ms;
+  return a.run_id < b.run_id;
+}
+
+/**
+ * Median of numeric values after a numeric sort. For an even count, average the
+ * two middle values. The input array is not mutated.
+ */
+function median(times) {
+  const sorted = [...times].sort((x, y) => x - y);
+  const middle = sorted.length >> 1;
+  if (sorted.length % 2 === 1) return sorted[middle];
+  return (sorted[middle - 1] + sorted[middle]) / 2;
+}
+
 export function summarizeAssistants(runs) {
   if (!Array.isArray(runs)) {
     throw new TypeError("runs must be an array");
   }
 
-  return [];
+  const groups = new Map();
+
+  for (const run of runs) {
+    if (!isEligible(run)) continue;
+    validateEligibleRun(run);
+
+    let group = groups.get(run.assistant);
+    if (group === undefined) {
+      group = { runs: [] };
+      groups.set(run.assistant, group);
+    }
+    group.runs.push(run);
+  }
+
+  const summaries = [];
+  for (const [assistant, group] of groups) {
+    let best = group.runs[0];
+    for (const run of group.runs) {
+      if (isBetter(run, best)) best = run;
+    }
+    summaries.push({
+      assistant,
+      run_count: group.runs.length,
+      best_score: best.score,
+      best_run_id: best.run_id,
+      median_elapsed_ms: median(group.runs.map((run) => run.elapsed_ms)),
+    });
+  }
+
+  summaries.sort((a, b) => {
+    if (a.assistant < b.assistant) return -1;
+    if (a.assistant > b.assistant) return 1;
+    return 0;
+  });
+
+  return summaries;
 }
