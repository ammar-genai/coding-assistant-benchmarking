@@ -1,10 +1,58 @@
 /**
  * Render assistant summaries as a stable Markdown table.
  */
+
+const HEADER = "| Assistant | Runs | Best score | Best run | Median time |";
+const DIVIDER = "|---|---:|---:|---|---:|";
+
+/**
+ * A summary must satisfy the render contract before it can be displayed.
+ */
+function isValidSummary(summary) {
+  if (summary === null || typeof summary !== "object" || Array.isArray(summary)) {
+    return false;
+  }
+  if (typeof summary.assistant !== "string" || summary.assistant.length === 0) {
+    return false;
+  }
+  if (typeof summary.best_run_id !== "string" || summary.best_run_id.length === 0) {
+    return false;
+  }
+  if (!Number.isInteger(summary.run_count) || summary.run_count <= 0) {
+    return false;
+  }
+  if (!Number.isFinite(summary.best_score) || summary.best_score < 0 || summary.best_score > 100) {
+    return false;
+  }
+  if (!Number.isFinite(summary.median_elapsed_ms) || summary.median_elapsed_ms < 0) {
+    return false;
+  }
+  return true;
+}
+
+function escapeCell(value) {
+  return value.replaceAll("|", "\\|");
+}
+
 export function renderComparisonTable(summaries) {
   if (!Array.isArray(summaries)) {
     throw new TypeError("summaries must be an array");
   }
 
-  return "";
+  if (summaries.length === 0) {
+    return [HEADER, DIVIDER, "", "_No eligible runs._"].join("\n");
+  }
+
+  const rows = [HEADER, DIVIDER];
+  for (const summary of summaries) {
+    if (!isValidSummary(summary)) {
+      throw new TypeError("summary has invalid fields");
+    }
+    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);
+    rows.push(
+      `| ${escapeCell(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapeCell(summary.best_run_id)} | ${seconds} s |`,
+    );
+  }
+
+  return rows.join("\n");
 }
