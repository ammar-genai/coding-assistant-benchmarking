+      event = structuredClone(input);
+      validateEvent(event);
+    } catch (error) {
+      return Promise.reject(error);
+    }
+
+    const tail = tails.get(event.tradeId) ?? Promise.resolve();
+
+    const result = tail.then(async () => {
+      const previous = states.get(event.tradeId) ?? null;
+
+      if (previous === null) {
+        if (event.type !== "CREATED" || event.version !== 1) {
+          throw new Error(
+            "first accepted event must be CREATED at version 1",
