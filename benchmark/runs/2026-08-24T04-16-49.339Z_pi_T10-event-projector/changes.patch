+import { createEventProjector } from "./event-projector.mjs";
+
+const created = (tradeId = "trade-1") => ({
+  tradeId,
+  version: 1,
+  type: "CREATED",
+  payload: { notional: 100, owner: "desk-a" },
+});
+
+test("different trades progress concurrently while one trade is blocked", async () => {
+  const order = [];
+  let release;
+  const projector = createEventProjector(async (tradeId, state) => {
+    if (tradeId === "blocked" && state.version === 1) {
+      await new Promise((resolve) => {
+        release = resolve;
+      });
+    }
+    order.push(`${tradeId}@${state.version}`);
+  });
+
+  const blockedFirst = projector.project(created("blocked"));
+  const blockedSecond = projector.project({
+    tradeId: "blocked",
+    version: 2,
+    type: "AMENDED",
+    payload: { owner: "desk-b" },
+  });
+
+  // A different trade must not wait behind the blocked trade's queue.
+  await projector.project(created("free"));
+  assert.deepEqual(order, ["free@1"]);
+
+  release();
+  await Promise.all([blockedFirst, blockedSecond]);
+  assert.deepEqual(order, ["free@1", "blocked@1", "blocked@2"]);
+  assert.equal(projector.getSnapshot("blocked").version, 2);
+  assert.equal(projector.getSnapshot("free").version, 1);
+});
+
+test("duplicate or stale versions return the snapshot without persisting", async () => {
+  const persisted = [];
+  const projector = createEventProjector(async (_tradeId, state) => {
+    persisted.push(state.version);
+  });
+
+  await projector.project(created());
+  await projector.project({
+    tradeId: "trade-1",
+    version: 2,
+    type: "AMENDED",
+    payload: { notional: 150 },
+  });
+
+  const duplicate = await projector.project(created()); // version 1 again
+  const stale = await projector.project({
+    tradeId: "trade-1",
+    version: 2,
+    type: "AMENDED",
+    payload: { notional: 999 },
+  });
+
+  assert.equal(duplicate.version, 2); // returns current snapshot
+  assert.equal(stale.version, 2);
+  assert.equal(stale.notional, 150); // stale payload ignored
+  assert.deepEqual(persisted, [1, 2]); // nothing extra persisted
+});
+
+test("version gaps and invalid first events reject without changing state", async () => {
+  const projector = createEventProjector(async () => {});
+
+  await assert.rejects(
+    projector.project({
+      tradeId: "trade-1",
+      version: 2,
+      type: "CREATED",
+      payload: { notional: 100, owner: "desk-a" },
+    }),
+    /first accepted event/,
