+    version: 2,
+    type: "AMENDED",
+    payload: { owner: "desk-c" },
+  });
+  assert.equal(ok.version, 2);
+  assert.equal(ok.owner, "desk-c");
+});
+
+test("a cancelled trade is terminal and rejects a later new version", async () => {
+  const projector = createEventProjector(async () => {});
+
+  await projector.project(created());
