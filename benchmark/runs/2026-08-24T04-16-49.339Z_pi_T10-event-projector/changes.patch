+  const input = created();
+  await projector.project(input);
+  input.payload.notional = 1; // mutating the caller's event must not matter
+  seen[0].state.notional = 1; // mutating the store callback's value must not
+  seen[0].event.payload.owner = "hacker";
+
+  const snapshot = projector.getSnapshot("trade-1");
+  assert.equal(snapshot.notional, 100);
