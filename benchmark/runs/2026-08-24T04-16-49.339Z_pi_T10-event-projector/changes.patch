+        }
+      } else {
+        if (event.version <= previous.version) {
+          // Duplicate or stale version: return current state, do not persist.
+          return copyState(previous);
+        }
+        if (event.version !== previous.version + 1) {
+          throw new Error(
+            `version gap: expected ${previous.version + 1}, got ${event.version}`,
+          );
+        }
