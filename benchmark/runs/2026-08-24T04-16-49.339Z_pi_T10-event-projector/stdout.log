{"type":"tool_execution_start","toolCallId":"write:5","toolName":"write","args":{"path":"benchmark/fixtures/T10-event-projector/event-projector.mjs","content":"const SUPPORTED_TYPES = new Set([\"CREATED\", \"AMENDED\", \"CANCELLED\"]);\n\nfunction copyState(state) {\n  return state ? structuredClone(state) : null;\n}\n\nfunction validateEvent(event) {\n  if (event === null || typeof event !== \"object\" || Array.isArray(event)) {\n    throw new TypeError(\"event must be an object\");\n  }\n  if (typeof event.tradeId !== \"string\" || event.tradeId.length === 0) {\n    throw new TypeError(\"event.tradeId must be a non-empty string\");\n  }\n  if (!Number.isInteger(event.version) || event.version < 1) {\n    throw new TypeError(\"event.version must be a positive integer\");\n  }\n  if (!SUPPORTED_TYPES.has(event.type)) {\n    throw new TypeError(`unsupported event type: ${event.type}`);\n  }\n  if (event.type !== \"CANCELLED\") {\n    if (\n      event.payload === null ||\n      typeof event.payload !== \"object\" ||\n      Array.isArray(event.payload)\n    ) {\n      throw new TypeError(\"event.payload must be an object\");\n    }\n  }\n}\n\nfunction validateCompleteState(state) {\n  if (\n    typeof state.notional !== \"number\" ||\n    !Number.isFinite(state.notional) ||\n    state.notional <= 0\n  ) {\n    throw new TypeError(\"state.notional must be a positive finite number\");\n  }\n  if (typeof state.owner !== \"string\" || state.owner.length === 0) {\n    throw new TypeError(\"state.owner must be a non-empty string\");\n  }\n}\n\nfunction reduceEvent(previous, event) {\n  if (event.type === \"CREATED\") {\n    const next = {\n      tradeId: event.tradeId,\n      version: event.version,\n      status: \"active\",\n      notional: event.payload.notional,\n      owner: event.payload.owner,\n    };\n    validateCompleteState(next);\n    return next;\n  }\n  if (event.type === \"AMENDED\") {\n    const next = { ...previous, ...event.payload, version: event.version };\n    validateCompleteState(next);\n    return next;\n  }\n  // CANCELLED\n  return { ...previous, version: event.version, status: \"cancelled\" };\n}\n\nexport function createEventProjector(applyToStore) {\n  if (typeof applyToStore !== \"function\") {\n    throw new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map();\n  const tails = new Map();\n\n  function project(input) {\n    // Snapshot the caller's event so later mutation cannot affect processing.\n    let event;\n    try {\n      event = structuredClone(input);\n      validateEvent(event);\n    } catch (error) {\n      return Promise.reject(error);\n    }\n\n    const tail = tails.get(event.tradeId) ?? Promise.resolve();\n\n    const result = tail.then(async () => {\n      const previous = states.get(event.tradeId) ?? null;\n\n      if (previous === null) {\n        if (event.type !== \"CREATED\" || event.version !== 1) {\n          throw new Error(\n            \"first accepted event must be CREATED at version 1\",\n          );\n        }\n      } else {\n        if (event.version <= previous.version) {\n          // Duplicate or stale version: return current state, do not persist.\n          return copyState(previous);\n        }\n        if (event.version !== previous.version + 1) {\n          throw new Error(\n            `version gap: expected ${previous.version + 1}, got ${event.version}`,\n          );\n        }\n        if (previous.status === \"cancelled\") {\n          throw new Error(`trade ${event.tradeId} is cancelled and terminal`);\n        }\n      }\n\n      const next = reduceEvent(previous, event);\n      // Commit state only after persistence succeeds.\n      await applyToStore(event.tradeId, copyState(next), structuredClone(event));\n      states.set(event.tradeId, next);\n      return copyState(next);\n    });\n\n    // Keep the per-trade chain alive even when this event rejects, and keep\n    // each trade's queue independent so trades proceed concurrently.\n    tails.set(\n      event.tradeId,\n      result.then(\n        () => undefined,\n        () => undefined,\n      ),\n    );\n    return result;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n"}}
{"type":"tool_execution_start","toolCallId":"write:6","toolName":"write","args":{"path":"benchmark/fixtures/T10-event-projector/student-tests.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createEventProjector } from \"./event-projector.mjs\";\n\nconst created = (tradeId = \"trade-1\") => ({\n  tradeId,\n  version: 1,\n  type: \"CREATED\",\n  payload: { notional: 100, owner: \"desk-a\" },\n});\n\ntest(\"different trades progress concurrently while one trade is blocked\", async () => {\n  const order = [];\n  let release;\n  const projector = createEventProjector(async (tradeId, state) => {\n    if (tradeId === \"blocked\" && state.version === 1) {\n      await new Promise((resolve) => {\n        release = resolve;\n      });\n    }\n    order.push(`${tradeId}@${state.version}`);\n  });\n\n  const blockedFirst = projector.project(created(\"blocked\"));\n  const blockedSecond = projector.project({\n    tradeId: \"blocked\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { owner: \"desk-b\" },\n  });\n\n  // A different trade must not wait behind the blocked trade's queue.\n  await projector.project(created(\"free\"));\n  assert.deepEqual(order, [\"free@1\"]);\n\n  release();\n  await Promise.all([blockedFirst, blockedSecond]);\n  assert.deepEqual(order, [\"free@1\", \"blocked@1\", \"blocked@2\"]);\n  assert.equal(projector.getSnapshot(\"blocked\").version, 2);\n  assert.equal(projector.getSnapshot(\"free\").version, 1);\n});\n\ntest(\"duplicate or stale versions return the snapshot without persisting\", async () => {\n  const persisted = [];\n  const projector = createEventProjector(async (_tradeId, state) => {\n    persisted.push(state.version);\n  });\n\n  await projector.project(created());\n  await projector.project({\n    tradeId: \"trade-1\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { notional: 150 },\n  });\n\n  const duplicate = await projector.project(created()); // version 1 again\n  const stale = await projector.project({\n    tradeId: \"trade-1\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { notional: 999 },\n  });\n\n  assert.equal(duplicate.version, 1);\n  assert.equal(stale.version, 2);\n  assert.equal(stale.notional, 150); // stale payload ignored\n  assert.deepEqual(persisted, [1, 2]); // nothing extra persisted\n});\n\ntest(\"version gaps and invalid first events reject without changing state\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 2,\n      type: \"CREATED\",\n      payload: { notional: 100, owner: \"desk-a\" },\n    }),\n    /first accepted event/,\n  );\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 1,\n      type: \"AMENDED\",\n      payload: { notional: 100 },\n    }),\n    /first accepted event/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\"), null);\n\n  await projector.project(created());\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 4,\n      type: \"AMENDED\",\n      payload: { notional: 200 },\n    }),\n    /version gap/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 1);\n\n  // A later valid event still succeeds after the gap rejection.\n  const ok = await projector.project({\n    tradeId: \"trade-1\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { owner: \"desk-c\" },\n  });\n  assert.equal(ok.version, 2);\n  assert.equal(ok.owner, \"desk-c\");\n});\n\ntest(\"a cancelled trade is terminal and rejects a later new version\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await projector.project(created());\n  const cancelled = await projector.project({\n    tradeId: \"trade-1\",\n    version: 2,\n    type: \"CANCELLED\",\n  });\n  assert.equal(cancelled.status, \"cancelled\");\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 3,\n      type: \"AMENDED\",\n      payload: { notional: 200 },\n    }),\n    /terminal/,\n  );\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 3,\n      type: \"CREATED\",\n      payload: { notional: 200, owner: \"desk-b\" },\n    }),\n    /terminal/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\").status, \"cancelled\");\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 2);\n});\n\ntest(\"malformed events reject with TypeError\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(projector.project(null), TypeError);\n  await assert.rejects(\n    projector.project({ version: 1, type: \"CREATED\", payload: {} }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project({ tradeId: \"t\", version: 1, type: \"SHREDDED\", payload: {} }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t\",\n      version: 1,\n      type: \"CREATED\",\n      payload: { notional: -5, owner: \"desk-a\" },\n    }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t\",\n      version: 1,\n      type: \"CREATED\",\n      payload: { notional: 100, owner: \"\" },\n    }),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"t\"), null);\n});\n\ntest(\"inputs, returned states, and snapshots do not expose mutable internals\", async () => {\n  const seen = [];\n  const projector = createEventProjector(async (_tradeId, state, event) => {\n    seen.push({ state, event });\n  });\n\n  const input = created();\n  await projector.project(input);\n  input.payload.notional = 1; // mutating the caller's event must not matter\n  seen[0].state.notional = 1; // mutating the store callback's value must not\n  seen[0].event.payload.owner = \"hacker\";\n\n  const snapshot = projector.getSnapshot(\"trade-1\");\n  assert.equal(snapshot.notional, 100);\n  assert.equal(snapshot.owner, \"desk-a\");\n\n  snapshot.notional = 2; // mutating a snapshot must not change internals\n  assert.equal(projector.getSnapshot(\"trade-1\").notional, 100);\n});\n"}}
{"type":"tool_execution_start","toolCallId":"write:7","toolName":"write","args":{"path":"benchmark/fixtures/T10-event-projector/INCIDENT.md","content":"# Event projector incident\n\nStatus: resolved\n\n## Impact\n\nAfter a temporary persistence rejection, the projector failed every\nsubsequent `project()` call for any trade (the shared promise chain stayed\nrejected forever). Additionally, all trades were serialized behind a single\nglobal queue, so one slow persistence blocked unrelated trades. State was\nalso committed to the in-memory map before `applyToStore` succeeded, so a\nfailed write left the snapshot ahead of the store. No versioning, duplicate,\ngap, terminal-state, or payload validation existed.\n\n## Root cause\n\n`createEventProjector` chained every event onto one module-scope `pending`\npromise (`pending = pending.then(...)`). Once `applyToStore` rejected, the\nrejection propagated into `pending`, so all later events — for that trade or\nany other — rejected immediately. The same global chain also prevented\nconcurrent progress across trades. The reducer result was written to\n`states` before awaiting persistence, committing uncommitted data on\nfailure, and `reduceEvent` performed no version, lifecycle, or payload\nchecks.\n\n## Fix\n\n- Replaced the single global queue with a per-trade promise tail, so events\n  for one trade apply serially in call order while different trades proceed\n  concurrently.\n- Each tail is continued with a swallowing handler (`result.then(noop,\n  noop)`), so a rejection of one event never poisons later work for that\n  trade.\n- `applyToStore` is awaited before `states.set`, so state commits only after\n  persistence succeeds.\n- Added validation: malformed events (bad shape, unknown type, bad payload)\n  reject with `TypeError`; the first accepted event must be `CREATED` at\n  version 1; later events must be exactly `version + 1`; duplicate/stale\n  versions return the current snapshot without persisting; a `CANCELLED`\n  trade is terminal and rejects any later new version; `CREATED` requires a\n  positive finite `notional` and non-empty `owner`, and `AMENDED` must leave\n  a valid complete state.\n- All inputs, callback arguments, returned states, and snapshots are\n  deep-cloned (`structuredClone`) so no mutable internal state escapes.\n\n## Regression coverage\n\n`student-tests.mjs` contains six tests:\n\n1. Different trades progress concurrently while one trade is blocked behind\n   a held persistence promise.\n2. Duplicate/stale versions return the current snapshot without persisting.\n3. Version gaps and invalid first events reject without changing state, and\n   the trade still accepts a valid follow-up.\n4. A cancelled trade is terminal and rejects later new versions.\n5. Malformed events reject with `TypeError`.\n6. Inputs, store-callback values, returned states, and snapshots do not\n   expose mutable internal state.\n\n## Remaining risk\n\nPer-trade tails are retained in a `Map` for the lifetime of the projector;\na very large number of distinct trade IDs would grow that map (entries are\nonly settled promises, so impact is small). Persistence failures surface to\nthe caller but are not retried, by design — callers must resubmit the event.\n"}}
