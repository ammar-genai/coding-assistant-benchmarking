on,\n      status: \"active\",\n      notional: event.payload.notional,\n      owner: event.payload.owner,\n    };\n    validateCompleteState(next);\n    return next;\n  }\n  if (event.type === \"AMENDED\") {\n    const next = { ...previous, ...event.payload, version: event.version };\n    validateCompleteState(next);\n    return next;\n  }\n  // CANCELLED\n  return { ...previous, version: event.version, status: \"cancelled\" };\n}\n\nexport function createEventProjector(applyToStore) {\n  if (typeof applyToStore !== \"function\") {\n    throw new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map();\n  const tails = new Map();\n\n  function project(input) {\n    // Snapshot the caller's event so later mutation cannot affect processing.\n    let event;\n    try {\n      event = structuredClone(input);\n      validateEvent(event);\n    } catch (error) {\n      return Promise.reject(error);\n    }\n\n    const tail = tails.get(event.tradeId) ?? Promise.resolve();\n\n    const result = tail.then(async () => {\n      const previous = states.get(event.tradeId) ?? null;\n\n      if (previous === null) {\n        if (event.type !== \"CREATED\" || event.version !== 1) {\n          throw new Error(\n            \"first accepted event must be CREATED at version 1\",\n          );\n        }\n      } else {\n        if (event.version <= previous.version) {\n          // Duplicate or stale version: return current state, do not persist.\n          return copyState(previous);\n        }\n        if (event.version !== previous.version + 1) {\n          throw new Error(\n            `version gap: expected ${previous.version + 1}, got ${event.version}`,\n          );\n        }\n        if (previous.status === \"cancelled\") {\n          throw new Error(`trade ${event.tradeId} is cancelled and terminal`);\n        }\n      }\n\n      const next = reduceEvent(previous, event);\n      // Commit state only after persistence succeeds.\n      await applyToStore(event.tradeId, copyState(next), structuredClone(event));\n      states.set(event.tradeId, next);\n      return copyState(next);\n    });\n\n    // Keep the per-trade chain alive even when this event rejects, and keep\n    // each trade's queue independent so trades proceed concurrently.\n    tails.set(\n      event.tradeId,\n      result.then(\n        () => undefined,\n        () => undefined,\n      ),\n    );\n    return result;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n"}}}}
