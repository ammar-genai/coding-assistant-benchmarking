+const HTML_ESCAPES = {
+  "&": "&amp;",
+  "<": "&lt;",
+  ">": "&gt;",
+  '"': "&quot;",
+  "'": "&#39;",
+};
+
+function escapeHtml(value) {
+  return String(value).replace(/[&<>"']/g, (character) => HTML_ESCAPES[character]);
+}
+
+function summaryValue(summary, key) {
+  const value = summary[key];
+  return value === undefined || value === null ? 0 : value;
+}
+
+function renderSummaryItems(summary) {
+  const entries = [
+    ["Total", summaryValue(summary, "total")],
+    ["Approve", summaryValue(summary, "approve")],
+    ["Reject", summaryValue(summary, "reject")],
+    ["Needs work", summaryValue(summary, "needs-work")],
+  ];
+  return entries
+    .map(
+      ([label, value]) =>
+        `          <li><strong>${escapeHtml(label)}:</strong> ${escapeHtml(value)}</li>`,
+    )
+    .join("\n");
+}
+
+function renderRows(reviews) {
+  if (reviews.length === 0) {
+    return '          <tr><td colspan="5">No reviews yet.</td></tr>';
+  }
+  return reviews
+    .map((review) => {
+      const safe = isRecord(review) ? review : {};
+      return [
+        "          <tr>",
+        `            <td>${escapeHtml(safe.runId ?? "")}</td>`,
+        `            <td>${escapeHtml(safe.decision ?? "")}</td>`,
+        `            <td>${escapeHtml(safe.reviewer ?? "")}</td>`,
+        `            <td>${escapeHtml(safe.note ?? "")}</td>`,
+        `            <td>${escapeHtml(safe.updatedAt ?? "")}</td>`,
+        "          </tr>",
+      ].join("\n");
+    })
+    .join("\n");
+}
+
+function isRecord(value) {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+export function renderReviewPage({ reviews = [], summary = {}, message = "" } = {}) {
+  const safeReviews = Array.isArray(reviews) ? reviews : [];
+  const safeSummary = isRecord(summary) ? summary : {};
+
+  return `<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <title>Run review queue</title>
+  </head>
+  <body>
+    <main>
+      <h1>Run review queue</h1>
+      <p>Record one current review decision per benchmark run. Posting again for the same run replaces the previous decision.</p>
+      <section aria-labelledby="summary-heading">
+        <h2 id="summary-heading">Queue summary</h2>
+        <ul>
+${renderSummaryItems(safeSummary)}
+        </ul>
+      </section>
+      <p class="status" role="status" aria-live="polite">${escapeHtml(message)}</p>
+      <section aria-labelledby="form-heading">
+        <h2 id="form-heading">Save a review</h2>
+        <form method="post" action="/api/reviews">
+          <p>
+            <label for="run-id">Run ID</label>
+            <input id="run-id" name="runId" type="text" required>
+          </p>
+          <p>
+            <label for="decision">Decision</label>
+            <select id="decision" name="decision">
+              <option value="approve">approve</option>
+              <option value="reject">reject</option>
+              <option value="needs-work">needs-work</option>
+            </select>
+          </p>
+          <p>
+            <label for="reviewer">Reviewer</label>
+            <input id="reviewer" name="reviewer" type="text" required>
+          </p>
+          <p>
+            <label for="note">Note</label>
+            <textarea id="note" name="note" rows="3" aria-describedby="note-help"></textarea>
+          </p>
+          <p id="note-help">A note is required when the decision is reject or needs-work; it is optional for approve. Notes are limited to 240 characters.</p>
+          <p>
+            <button type="submit">Save review</button>
+          </p>
+        </form>
+      </section>
+      <table>
+        <caption>Saved run reviews</caption>
+        <thead>
+          <tr>
+            <th scope="col">Run ID</th>
+            <th scope="col">Decision</th>
+            <th scope="col">Reviewer</th>
+            <th scope="col">Note</th>
+            <th scope="col">Updated</th>
+          </tr>
+        </thead>
+        <tbody>
+${renderRows(safeReviews)}
+        </tbody>
+      </table>
+    </main>
+  </body>
+</html>`;
 }
diff --git a/benchmark/fixtures/T5-review-queue/review-store.mjs b/benchmark/fixtures/T5-review-queue/review-store.mjs
index 1138160..e726724 100644
--- a/benchmark/fixtures/T5-review-queue/review-store.mjs
+++ b/benchmark/fixtures/T5-review-queue/review-store.mjs
@@ -1,3 +1,93 @@
-export function createReviewStore() {
-  throw new Error("TODO: implement the review store");
+const REVIEW_FIELDS = ["runId", "decision", "reviewer", "note"];
+
+function defaultNow() {
+  return new Date().toISOString();
+}
+
+function isRecord(value) {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function copyReview(review) {
+  return {
+    runId: review.runId,
+    decision: review.decision,
+    reviewer: review.reviewer,
+    note: review.note,
+    createdAt: review.createdAt,
+    updatedAt: review.updatedAt,
+  };
+}
+
+function compareReviews(a, b) {
+  if (a.updatedAt > b.updatedAt) {
+    return -1;
+  }
+  if (a.updatedAt < b.updatedAt) {
+    return 1;
+  }
+  if (a.runId < b.runId) {
+    return -1;
+  }
+  if (a.runId > b.runId) {
+    return 1;
+  }
+  return 0;
+}
+
+export function createReviewStore({ now } = {}) {
+  const clock = now === undefined ? defaultNow : now;
+  if (typeof clock !== "function") {
+    throw new TypeError("createReviewStore: now must be a function");
+  }
+
+  const reviews = new Map();
+
+  function save(input) {
+    if (!isRecord(input)) {
+      throw new TypeError("save: review must be an object");
+    }
+    for (const field of REVIEW_FIELDS) {
+      if (typeof input[field] !== "string") {
+        throw new TypeError(`save: review.${field} must be a string`);
+      }
+    }
+
+    const timestamp = clock();
+    if (typeof timestamp !== "string" || timestamp.length === 0) {
+      throw new TypeError("save: now must return a non-empty string");
+    }
+
+    const existing = reviews.get(input.runId);
+    const created = existing === undefined;
+    const stored = {
+      runId: input.runId,
+      decision: input.decision,
+      reviewer: input.reviewer,
+      note: input.note,
+      createdAt: created ? timestamp : existing.createdAt,
+      updatedAt: timestamp,
+    };
+    reviews.set(input.runId, stored);
+
+    return { created, review: copyReview(stored) };
+  }
+
+  function get(runId) {
+    const stored = reviews.get(runId);
+    return stored === undefined ? null : copyReview(stored);
+  }
+
+  function list({ decision } = {}) {
+    const selected = [];
+    for (const review of reviews.values()) {
+      if (decision === undefined || review.decision === decision) {
+        selected.push(copyReview(review));
+      }
+    }
+    selected.sort(compareReviews);
+    return selected;
+  }
+
+  return { save, get, list };
 }
