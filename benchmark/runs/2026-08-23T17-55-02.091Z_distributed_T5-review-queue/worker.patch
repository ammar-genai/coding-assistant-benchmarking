-// Add at least three meaningful node:test cases for the feature contract.
-// Do not copy or modify the committed review-queue.test.mjs suite.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { createReviewApi } from "./review-api.mjs";
+import { renderReviewPage } from "./review-page.mjs";
+import { createReviewStore } from "./review-store.mjs";
+
+test("store orders by newest update with runId tie-breaks, filters, and isolates state", () => {
+  let current = "2026-08-23T10:00:00.000Z";
+  const store = createReviewStore({ now: () => current });
+
+  const draft = { runId: "run-bravo", decision: "approve", reviewer: "Ada", note: "initial" };
+  store.save(draft);
+  draft.note = "mutated after save";
+  store.save({ runId: "run-alpha", decision: "reject", reviewer: "Ada", note: "Missing tests" });
+  store.save({ runId: "run-charlie", decision: "approve", reviewer: "Ada", note: "" });
+
+  // Mutating the caller's input must not leak into stored state.
+  assert.equal(store.get("run-bravo").note, "initial");
+
+  // Equal timestamps fall back to ascending runId order.
+  assert.deepEqual(
+    store.list().map((review) => review.runId),
+    ["run-alpha", "run-bravo", "run-charlie"],
+  );
+
+  current = "2026-08-23T11:00:00.000Z";
+  store.save({ runId: "run-bravo", decision: "needs-work", reviewer: "Ada", note: "Add coverage" });
+  assert.deepEqual(
+    store.list().map((review) => review.runId),
+    ["run-bravo", "run-alpha", "run-charlie"],
+  );
+
+  assert.deepEqual(
+    store.list({ decision: "approve" }).map((review) => review.runId),
+    ["run-charlie"],
+  );
+
+  // Returned arrays and reviews are copies, not live references.
+  const listed = store.list();
+  listed[0].note = "mutated copy";
+  listed.pop();
+  assert.equal(store.get("run-bravo").note, "Add coverage");
+  assert.equal(store.list().length, 3);
+  assert.equal(store.get("run-missing"), null);
+});
+
+test("store rejects invalid input and unusable clocks with TypeError", () => {
+  assert.throws(() => createReviewStore({ now: "not a function" }), TypeError);
+
+  const store = createReviewStore({ now: () => "2026-08-23T10:00:00.000Z" });
+  assert.throws(() => store.save(null), TypeError);
+  assert.throws(() => store.save(["run-alpha"]), TypeError);
+  assert.throws(
+    () => store.save({ runId: "run-alpha", decision: "approve", reviewer: "Ada", note: 42 }),
+    TypeError,
+  );
+  assert.deepEqual(store.list(), []);
+
+  let ticks = 0;
+  const flaky = createReviewStore({
+    now: () => {
+      ticks += 1;
+      return ticks === 1 ? "2026-08-23T10:00:00.000Z" : "";
+    },
+  });
+  flaky.save({ runId: "run-alpha", decision: "approve", reviewer: "Ada", note: "" });
+  assert.throws(
+    () => flaky.save({ runId: "run-alpha", decision: "reject", reviewer: "Ada", note: "x" }),
+    TypeError,
+  );
+
+  // The failed update must not mutate the stored review.
+  assert.equal(flaky.get("run-alpha").decision, "approve");
+  assert.equal(flaky.get("run-alpha").updatedAt, "2026-08-23T10:00:00.000Z");
+});
+
+test("api validates posts, reports sorted unknown fields, and never stores invalid data", () => {
+  let current = "2026-08-23T10:00:00.000Z";
+  const store = createReviewStore({ now: () => current });
+  const handle = createReviewApi(store);
+
+  assert.throws(() => createReviewApi({ save() {} }), TypeError);
+
+  const created = handle({
+    method: "POST",
+    url: "/api/reviews",
+    body: { runId: "run-alpha", decision: "approve", reviewer: "Ada", note: "" },
+  });
+  assert.equal(created.status, 201);
+
+  current = "2026-08-23T11:00:00.000Z";
+  const updated = handle({
+    method: "POST",
+    url: "/api/reviews",
+    body: { runId: "run-alpha", decision: "reject", reviewer: "Ada", note: "Missing tests" },
+  });
+  assert.equal(updated.status, 200);
+  assert.equal(updated.body.review.createdAt, "2026-08-23T10:00:00.000Z");
+  assert.equal(updated.body.review.updatedAt, "2026-08-23T11:00:00.000Z");
+  assert.equal(updated.body.review.decision, "reject");
+
+  const unknown = handle({
+    method: "POST",
+    url: "/api/reviews",
+    body: { runId: "run-beta", decision: "approve", reviewer: "Ada", note: "", zeta: 1, alpha: 2 },
+  });
+  assert.equal(unknown.status, 400);
+  assert.equal(unknown.body.fields.body, "Unknown fields: alpha, zeta");
+  assert.equal(store.get("run-beta"), null);
+
+  const missingBody = handle({ method: "POST", url: "/api/reviews" });
+  assert.equal(missingBody.status, 400);
+  assert.equal(missingBody.body.error, "validation_failed");
+  assert.equal(typeof missingBody.body.fields.body, "string");
