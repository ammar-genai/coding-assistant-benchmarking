+  });
+  assert.equal(invalid.status, 400);
+  assert.deepEqual(Object.keys(invalid.body.fields).sort(), ["note", "reviewer"]);
+  assert.deepEqual(
+    store.list().map((review) => review.runId),
+    ["run-alpha"],
+  );
+});
+
+test("api routes reads and errors, keeps summaries global, and never leaks headers", () => {
+  const store = createReviewStore({ now: () => "2026-08-23T12:00:00.000Z" });
+  const handle = createReviewApi(store);
+  handle({
+    method: "POST",
+    url: "/api/reviews",
+    body: { runId: "run-alpha", decision: "approve", reviewer: "Ada", note: "" },
+  });
+  handle({
+    method: "POST",
+    url: "/api/reviews",
+    body: { runId: "run-beta", decision: "reject", reviewer: "Bob", note: "Flaky" },
+  });
+
+  const filtered = handle({ method: "GET", url: "/api/reviews?decision=reject" });
+  assert.equal(filtered.status, 200);
+  assert.deepEqual(
+    filtered.body.reviews.map((review) => review.runId),
+    ["run-beta"],
+  );
+  assert.deepEqual(filtered.body.summary, { total: 2, approve: 1, reject: 1, "needs-work": 0 });
+
+  const badFilter = handle({ method: "GET", url: "/api/reviews?decision=mixed" });
+  assert.equal(badFilter.status, 400);
+  assert.equal(badFilter.body.error, "validation_failed");
+
+  const detail = handle({ method: "GET", url: "/api/reviews/run-alpha" });
+  assert.equal(detail.status, 200);
+  assert.equal(detail.body.review.runId, "run-alpha");
+
+  const missing = handle({ method: "GET", url: "/api/reviews/run-missing" });
+  assert.equal(missing.status, 404);
+  assert.deepEqual(missing.body, { error: "review_not_found" });
+
+  const collectionMethod = handle({ method: "DELETE", url: "/api/reviews" });
+  assert.equal(collectionMethod.status, 405);
+  assert.equal(collectionMethod.headers.allow, "GET, POST");
+
+  const detailMethod = handle({ method: "POST", url: "/api/reviews/run-alpha" });
+  assert.equal(detailMethod.status, 405);
+  assert.deepEqual(detailMethod.body, { error: "method_not_allowed" });
+  assert.equal(detailMethod.headers.allow, "GET");
+
+  // The 405 allow header must not leak into later responses.
+  const after = handle({ method: "GET", url: "/api/reviews/run-alpha" });
+  assert.equal("allow" in after.headers, false);
+  assert.deepEqual(Object.keys(after), ["status", "headers", "body"]);
+
+  const unknown = handle({ method: "GET", url: "/somewhere/else" });
+  assert.equal(unknown.status, 404);
+  assert.deepEqual(unknown.body, { error: "not_found" });
+
+  assert.equal(handle(null).status, 400);
+  assert.deepEqual(handle(null).body, { error: "invalid_request" });
+  assert.deepEqual(handle({ method: "GET", url: 42 }).body, { error: "invalid_request" });
+});
+
+test("page escapes injected markup in the message, summary, and review fields", () => {
+  const html = renderReviewPage({
+    reviews: [
+      {
+        runId: 'run-x"><script>alert(1)</script>',
+        decision: "reject",
+        reviewer: '<img src=x onerror="alert(1)">',
+        note: '" onload="alert(1)',
+        createdAt: "2026-08-23T10:00:00.000Z",
+        updatedAt: "2026-08-23T11:00:00.000Z",
+      },
+    ],
+    summary: { total: "<i>s1</i>", approve: "<i>s2</i>", reject: "<i>s3</i>", "needs-work": "<i>s4</i>" },
+    message: '<script>alert("msg")</script>',
+  });
+
+  assert.equal(html.includes("<script>"), false);
+  assert.equal(html.includes("<img"), false);
+  assert.equal(html.includes("<i>"), false);
+  assert.equal(html.includes('onload="alert'), false);
+  assert.equal(html.includes('onerror="alert'), false);
+
+  assert.ok(html.includes("&lt;script&gt;alert(&quot;msg&quot;)&lt;/script&gt;"));
+  assert.ok(html.includes("run-x&quot;&gt;&lt;script&gt;alert(1)&lt;/script&gt;"));
+  assert.ok(html.includes("&lt;img src=x onerror=&quot;alert(1)&quot;&gt;"));
+  assert.ok(html.includes("&quot; onload=&quot;alert(1)"));
+  for (const marker of ["s1", "s2", "s3", "s4"]) {
+    assert.ok(html.includes(`&lt;i&gt;${marker}&lt;/i&gt;`));
+  }
+
+  // The document structure stays intact despite hostile caller data.
+  assert.ok(html.startsWith("<!DOCTYPE html>"));
+  assert.ok(html.includes("<caption>Saved run reviews</caption>"));
+  assert.ok(html.includes('aria-live="polite"'));
+  assert.ok(html.includes('<label for="note">Note</label>'));
+});
