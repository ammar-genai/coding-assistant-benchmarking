index bb59cf2..3596b6d 100644
--- a/benchmark/fixtures/T5-review-queue/README.md
+++ b/benchmark/fixtures/T5-review-queue/README.md
@@ -1,3 +1,68 @@
 # Run review queue fixture
 
-TODO: document the completed feature, API behavior, and operating limits.
+A dependency-free, in-memory review queue for benchmark runs. The fixture has
+three layers:
+
+- `review-store.mjs` — in-memory store (`createReviewStore`) keeping at most
+  one current review per `runId`.
+- `review-api.mjs` — synchronous JSON-style API boundary (`createReviewApi`)
+  returning `{ status, headers, body }` responses.
+- `review-page.mjs` — server-rendered HTML page (`renderReviewPage`) with a
+  summary, a review form, and a table of saved reviews.
+
+## Routes
+
+### `POST /api/reviews`
+
+Saves the current review for a run. Posting again for the same `runId`
+replaces the stored review while preserving its `createdAt` timestamp.
+
+- The body must be an object with exactly the string fields `runId`,
+  `decision`, `reviewer`, and `note`. Any other field is reported as a sorted
+  `body` field error (for example `Unknown fields: alpha, zeta`).
+- All four values are trimmed before validation and storage.
+- `runId` must match `^run-[a-z0-9][a-z0-9-]{2,63}$`.
+- `decision` must be `approve`, `reject`, or `needs-work`.
+- `reviewer` must contain 2 through 40 characters after trimming.
+- `note` may be at most 240 characters and is required for `reject` and
+  `needs-work`; it may be empty for `approve`.
+- Returns `201` with `{ review }` for a new run and `200` with `{ review }`
+  for an update. Reviews carry `runId`, `decision`, `reviewer`, `note`,
+  `createdAt`, and `updatedAt`.
+- Invalid input returns `400` with
+  `{ "error": "validation_failed", "fields": { ... } }` listing every detected
+  problem; nothing is saved.
+
+### `GET /api/reviews`
+
+Returns `{ reviews, summary }`. Reviews are sorted by newest `updatedAt`
+first, breaking timestamp ties by lexicographically smaller `runId`. The
+`summary` always counts all stored reviews and has exactly `total`,
+`approve`, `reject`, and `needs-work`. An optional `?decision=` query filters
+only the `reviews` array; an invalid decision value returns the standard
+`validation_failed` error.
+
+### `GET /api/reviews/:runId`
+
+Returns `200` with `{ review }`, or `404` with
+`{ "error": "review_not_found" }` when the run has no review.
+
+## Errors and headers
+
+Every response has exactly the shape `{ status, headers, body }` and includes
+the header `content-type: application/json; charset=utf-8`.
+
+- `400 { "error": "validation_failed", "fields": { ... } }` — invalid input;
+  nothing is saved.
+- `400 { "error": "invalid_request" }` — unusable request object or URL.
+- `404 { "error": "not_found" }` — unknown route.
+- `404 { "error": "review_not_found" }` — unknown run id on a detail route.
+- `405 { "error": "method_not_allowed" }` — unsupported method on a recognized
+  route. Includes an `allow` header: `GET, POST` on the collection and `GET`
+  on a detail route.
+
+## Storage limits
+
+The store is process-local and not durable: reviews live only in memory, so
+the store resets on every process restart. It has no external dependencies
+and no persistence layer.
diff --git a/benchmark/fixtures/T5-review-queue/review-api.mjs b/benchmark/fixtures/T5-review-queue/review-api.mjs
index 9c13861..4220e4f 100644
--- a/benchmark/fixtures/T5-review-queue/review-api.mjs
+++ b/benchmark/fixtures/T5-review-queue/review-api.mjs
@@ -1,3 +1,199 @@
-export function createReviewApi() {
-  throw new Error("TODO: implement the review API");
+const CONTENT_TYPE = "application/json; charset=utf-8";
+const DECISIONS = ["approve", "reject", "needs-work"];
+const BODY_FIELDS = ["runId", "decision", "reviewer", "note"];
+const RUN_ID_PATTERN = /^run-[a-z0-9][a-z0-9-]{2,63}$/;
+const COLLECTION_PATH = "/api/reviews";
+const DETAIL_PREFIX = "/api/reviews/";
+const REVIEWER_MIN_LENGTH = 2;
+const REVIEWER_MAX_LENGTH = 40;
+const NOTE_MAX_LENGTH = 240;
+const DECISION_RULE = "decision must be approve, reject, or needs-work";
+
+function respond(status, body, extraHeaders = {}) {
+  return {
+    status,
+    headers: { "content-type": CONTENT_TYPE, ...extraHeaders },
+    body,
+  };
+}
+
+function validationFailed(fields) {
+  return respond(400, { error: "validation_failed", fields });
+}
+
+function invalidRequest() {
+  return respond(400, { error: "invalid_request" });
+}
+
+function methodNotAllowed(allow) {
+  return respond(405, { error: "method_not_allowed" }, { allow });
+}
+
+function isRecord(value) {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isValidDecision(value) {
+  return DECISIONS.includes(value);
+}
+
+export function createReviewApi(store) {
+  if (
+    store === null ||
+    store === undefined ||
+    typeof store.save !== "function" ||
+    typeof store.get !== "function" ||
+    typeof store.list !== "function"
+  ) {
+    throw new TypeError("createReviewApi: store must provide save, get, and list functions");
+  }
+
+  function handlePost(body) {
+    if (!isRecord(body)) {
+      return validationFailed({
+        body: "body must be an object with runId, decision, reviewer, and note",
+      });
+    }
+
+    const fields = {};
+    const unknown = Object.keys(body)
+      .filter((key) => !BODY_FIELDS.includes(key))
+      .sort();
+    if (unknown.length > 0) {
+      fields.body = `Unknown fields: ${unknown.join(", ")}`;
+    }
+
+    const trimmed = {};
+    for (const field of BODY_FIELDS) {
+      const value = body[field];
+      if (typeof value !== "string") {
+        fields[field] = `${field} must be a string`;
+      } else {
+        trimmed[field] = value.trim();
+      }
+    }
+
+    if (trimmed.runId !== undefined && !RUN_ID_PATTERN.test(trimmed.runId)) {
+      fields.runId = "runId must match ^run-[a-z0-9][a-z0-9-]{2,63}$";
+    }
+    if (trimmed.decision !== undefined && !isValidDecision(trimmed.decision)) {
+      fields.decision = DECISION_RULE;
+    }
+    if (
+      trimmed.reviewer !== undefined &&
+      (trimmed.reviewer.length < REVIEWER_MIN_LENGTH ||
+        trimmed.reviewer.length > REVIEWER_MAX_LENGTH)
+    ) {
+      fields.reviewer = "reviewer must contain 2 through 40 characters";
+    }
+    if (trimmed.note !== undefined) {
+      if (trimmed.note.length > NOTE_MAX_LENGTH) {
+        fields.note = "note must be at most 240 characters";
+      } else if (
+        trimmed.note.length === 0 &&
+        (trimmed.decision === "reject" || trimmed.decision === "needs-work")
+      ) {
+        fields.note = "note is required for reject and needs-work";
+      }
+    }
+
+    if (Object.keys(fields).length > 0) {
+      return validationFailed(fields);
+    }
+
+    const { created, review } = store.save(trimmed);
+    return respond(created ? 201 : 200, { review });
+  }
+
+  function handleCollection(searchParams) {
+    const all = store.list();
+    const summary = { total: all.length, approve: 0, reject: 0, "needs-work": 0 };
+    for (const review of all) {
+      if (review.decision === "approve") {
+        summary.approve += 1;
+      } else if (review.decision === "reject") {
+        summary.reject += 1;
+      } else if (review.decision === "needs-work") {
+        summary["needs-work"] += 1;
+      }
+    }
+
+    let reviews = all;
+    if (searchParams.has("decision")) {
+      const decision = searchParams.get("decision");
+      if (!isValidDecision(decision)) {
+        return validationFailed({ decision: DECISION_RULE });
+      }
+      reviews = all.filter((review) => review.decision === decision);
+    }
+
+    return respond(200, { reviews, summary });
+  }
+
+  function handleDetail(runId) {
+    const review = store.get(runId);
+    if (review === null) {
+      return respond(404, { error: "review_not_found" });
+    }
+    return respond(200, { review });
+  }
+
+  function handleReviewRequest(request) {
+    if (!isRecord(request)) {
+      return invalidRequest();
+    }
+    const { method, url } = request;
+    if (
+      typeof method !== "string" ||
+      method.length === 0 ||
+      typeof url !== "string" ||
+      url.length === 0
+    ) {
+      return invalidRequest();
+    }
+
+    let parsed;
+    try {
+      parsed = new URL(url, "http://localhost");
+    } catch {
+      return invalidRequest();
+    }
+
+    let pathname = parsed.pathname;
+    if (pathname.length > 1 && pathname.endsWith("/")) {
+      pathname = pathname.slice(0, -1);
+    }
+    const upperMethod = method.toUpperCase();
+
+    if (pathname === COLLECTION_PATH) {
+      if (upperMethod === "POST") {
+        return handlePost(request.body);
+      }
+      if (upperMethod === "GET") {
+        return handleCollection(parsed.searchParams);
+      }
+      return methodNotAllowed("GET, POST");
+    }
+
+    if (pathname.startsWith(DETAIL_PREFIX)) {
+      const rawId = pathname.slice(DETAIL_PREFIX.length);
+      if (rawId.length === 0 || rawId.includes("/")) {
+        return respond(404, { error: "not_found" });
+      }
+      let runId;
+      try {
+        runId = decodeURIComponent(rawId);
+      } catch {
+        return invalidRequest();
+      }
+      if (upperMethod !== "GET") {
+        return methodNotAllowed("GET");
+      }
+      return handleDetail(runId);
+    }
+
+    return respond(404, { error: "not_found" });
+  }
+
+  return handleReviewRequest;
 }
