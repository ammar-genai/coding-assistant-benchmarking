{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ltt4r2x3srTqhbgySTGv4y","type":"tool_result","content":"1\tconst CONTENT_TYPE = \"application/json; charset=utf-8\";\n2\tconst DECISIONS = [\"approve\", \"reject\", \"needs-work\"];\n3\tconst BODY_FIELDS = [\"runId\", \"decision\", \"reviewer\", \"note\"];\n4\tconst RUN_ID_PATTERN = /^run-[a-z0-9][a-z0-9-]{2,63}$/;\n5\tconst COLLECTION_PATH = \"/api/reviews\";\n6\tconst DETAIL_PREFIX = \"/api/reviews/\";\n7\tconst REVIEWER_MIN_LENGTH = 2;\n8\tconst REVIEWER_MAX_LENGTH = 40;\n9\tconst NOTE_MAX_LENGTH = 240;\n10\tconst DECISION_RULE = \"decision must be approve, reject, or needs-work\";\n11\t\n12\tfunction respond(status, body, extraHeaders = {}) {\n13\t  return {\n14\t    status,\n15\t    headers: { \"content-type\": CONTENT_TYPE, ...extraHeaders },\n16\t    body,\n17\t  };\n18\t}\n19\t\n20\tfunction validationFailed(fields) {\n21\t  return respond(400, { error: \"validation_failed\", fields });\n22\t}\n23\t\n24\tfunction invalidRequest() {\n25\t  return respond(400, { error: \"invalid_request\" });\n26\t}\n27\t\n28\tfunction methodNotAllowed(allow) {\n29\t  return respond(405, { error: \"method_not_allowed\" }, { allow });\n30\t}\n31\t\n32\tfunction isRecord(value) {\n33\t  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n34\t}\n35\t\n36\tfunction isValidDecision(value) {\n37\t  return DECISIONS.includes(value);\n38\t}\n39\t\n40\texport function createReviewApi(store) {\n41\t  if (\n42\t    store === null ||\n43\t    store === undefined ||\n44\t    typeof store.save !== \"function\" ||\n45\t    typeof store.get !== \"function\" ||\n46\t    typeof store.list !== \"function\"\n47\t  ) {\n48\t    throw new TypeError(\"createReviewApi: store must provide save, get, and list functions\");\n49\t  }\n50\t\n51\t  function handlePost(body) {\n52\t    if (!isRecord(body)) {\n53\t      return validationFailed({\n54\t        body: \"body must be an object with runId, decision, reviewer, and note\",\n55\t      });\n56\t    }\n57\t\n58\t    const fields = {};\n59\t    const unknown = Object.keys(body)\n60\t      .filter((key) => !BODY_FIELDS.includes(key))\n61\t      .sort();\n62\t    if (unknown.length > 0) {\n63\t      fields.body = `Unknown fields: ${unknown.join(\", \")}`;\n64\t    }\n65\t\n66\t    const trimmed = {};\n67\t    for (const field of BODY_FIELDS) {\n68\t      const value = body[field];\n69\t      if (typeof value !== \"string\") {\n70\t        fields[field] = `${field} must be a string`;\n71\t      } else {\n72\t        trimmed[field] = value.trim();\n73\t      }\n74\t    }\n75\t\n76\t    if (trimmed.runId !== undefined && !RUN_ID_PATTERN.test(trimmed.runId)) {\n77\t      fields.runId = \"runId must match ^run-[a-z0-9][a-z0-9-]{2,63}$\";\n78\t    }\n79\t    if (trimmed.decision !== undefined && !isValidDecision(trimmed.decision)) {\n80\t      fields.decision = DECISION_RULE;\n81\t    }\n82\t    if (\n83\t      trimmed.reviewer !== undefined &&\n84\t      (trimmed.reviewer.length < REVIEWER_MIN_LENGTH ||\n85\t        trimmed.reviewer.length > REVIEWER_MAX_LENGTH)\n86\t    ) {\n87\t      fields.reviewer = \"reviewer must contain 2 through 40 characters\";\n88\t    }\n89\t    if (trimmed.note !== undefined) {\n90\t      if (trimmed.note.length > NOTE_MAX_LENGTH) {\n91\t        fields.note = \"note must be at most 240 characters\";\n92\t      } else if (\n93\t        trimmed.note.length === 0 &&\n94\t        (trimmed.decision === \"reject\" || trimmed.decision === \"needs-work\")\n95\t      ) {\n96\t        fields.note = \"note is required for reject and needs-work\";\n97\t      }\n98\t    }\n99\t\n100\t    if (Object.keys(fields).length > 0) {\n101\t      return validationFailed(fields);\n102\t    }\n103\t\n104\t    const { created, review } = store.save(trimmed);\n105\t    return respond(created ? 201 : 200, { review });\n106\t  }\n107\t\n108\t  function handleCollection(searchParams) {\n109\t    const all = store.list();\n110\t    const summary = { total: all.length, approve: 0, reject: 0, \"needs-work\": 0 };\n111\t    for (const review of all) {\n112\t      if (review.decision === \"approve\") {\n113\t        summary.approve += 1;\n114\t      } else if (review.decision === \"reject\") {\n115\t        summary.reject += 1;\n116\t      } else if (review.decision === \"needs-work\") {\n117\t        summary[\"needs-work\"] += 1;\n118\t      }\n119\t    }\n120\t\n121\t    let reviews = all;\n122\t    if (searchParams.has(\"decision\")) {\n123\t      const decision = searchParams.get(\"decision\");\n124\t      if (!isValidDecision(decision)) {\n125\t        return validationFailed({ decision: DECISION_RULE });\n126\t      }\n127\t      reviews = all.filter((review) => review.decision === decision);\n128\t    }\n129\t\n130\t    return respond(200, { reviews, summary });\n131\t  }\n132\t\n133\t  function handleDetail(runId) {\n134\t    const review = store.get(runId);\n135\t    if (review === null) {\n136\t      return respond(404, { error: \"review_not_found\" });\n137\t    }\n138\t    return respond(200, { review });\n139\t  }\n140\t\n141\t  function handleReviewRequest(request) {\n142\t    if (!isRecord(request)) {\n143\t      return invalidRequest();\n144\t    }\n145\t    const { method, url } = request;\n146\t    if (\n147\t      typeof method !== \"string\" ||\n148\t      method.length === 0 ||\n149\t      typeof url !== \"string\" ||\n150\t      url.length === 0\n151\t    ) {\n152\t      return invalidRequest();\n153\t    }\n154\t\n155\t    let parsed;\n156\t    try {\n157\t      parsed = new URL(url, \"http://localhost\");\n158\t    } catch {\n159\t      return invalidRequest();\n160\t    }\n161\t\n162\t    let pathname = parsed.pathname;\n163\t    if (pathname.length > 1 && pathname.endsWith(\"/\")) {\n164\t      pathname = pathname.slice(0, -1);\n165\t    }\n166\t    const upperMethod = method.toUpperCase();\n167\t\n168\t    if (pathname === COLLECTION_PATH) {\n169\t      if (upperMethod === \"POST\") {\n170\t        return handlePost(request.body);\n171\t      }\n172\t      if (upperMethod === \"GET\") {\n173\t        return handleCollection(parsed.searchParams);\n174\t      }\n175\t      return methodNotAllowed(\"GET, POST\");\n176\t    }\n177\t\n178\t    if (pathname.startsWith(DETAIL_PREFIX)) {\n179\t      const rawId = pathname.slice(DETAIL_PREFIX.length);\n180\t      if (rawId.length === 0 || rawId.includes(\"/\")) {\n181\t        return respond(404, { error: \"not_found\" });\n182\t      }\n183\t      let runId;\n184\t      try {\n185\t        runId = decodeURIComponent(rawId);\n186\t      } catch {\n187\t        return invalidRequest();\n188\t      }\n189\t      if (upperMethod !== \"GET\") {\n190\t        return methodNotAllowed(\"GET\");\n191\t      }\n192\t      return handleDetail(runId);\n193\t    }\n194\t\n195\t    return respond(404, { error: \"not_found\" });\n196\t  }\n197\t\n198\t  return handleReviewRequest;\n199\t}\n200\t"}]},"parent_tool_use_id":null,"session_id":"c56c70be-17cd-4219-9f0a-e7eecfb0e52e","uuid":"4e2f334d-f82d-4177-b3fd-b15abbc253b0","timestamp":"2026-08-23T18:01:29.132Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-workflow-o0L2GK/checkout/benchmark/fixtures/T5-review-queue/review-api.mjs","content":"const CONTENT_TYPE = \"application/json; charset=utf-8\";\nconst DECISIONS = [\"approve\", \"reject\", \"needs-work\"];\nconst BODY_FIELDS = [\"runId\", \"decision\", \"reviewer\", \"note\"];\nconst RUN_ID_PATTERN = /^run-[a-z0-9][a-z0-9-]{2,63}$/;\nconst COLLECTION_PATH = \"/api/reviews\";\nconst DETAIL_PREFIX = \"/api/reviews/\";\nconst REVIEWER_MIN_LENGTH = 2;\nconst REVIEWER_MAX_LENGTH = 40;\nconst NOTE_MAX_LENGTH = 240;\nconst DECISION_RULE = \"decision must be approve, reject, or needs-work\";\n\nfunction respond(status, body, extraHeaders = {}) {\n  return {\n    status,\n    headers: { \"content-type\": CONTENT_TYPE, ...extraHeaders },\n    body,\n  };\n}\n\nfunction validationFailed(fields) {\n  return respond(400, { error: \"validation_failed\", fields });\n}\n\nfunction invalidRequest() {\n  return respond(400, { error: \"invalid_request\" });\n}\n\nfunction methodNotAllowed(allow) {\n  return respond(405, { error: \"method_not_allowed\" }, { allow });\n}\n\nfunction isRecord(value) {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n}\n\nfunction isValidDecision(value) {\n  return DECISIONS.includes(value);\n}\n\nexport function createReviewApi(store) {\n  if (\n    store === null ||\n    store === undefined ||\n    typeof store.save !== \"function\" ||\n    typeof store.get !== \"function\" ||\n    typeof store.list !== \"function\"\n  ) {\n    throw new TypeError(\"createReviewApi: store must provide save, get, and list functions\");\n  }\n\n  function handlePost(body) {\n    if (!isRecord(body)) {\n      return validationFailed({\n        body: \"body must be an object with runId, decision, reviewer, and note\",\n      });\n    }\n\n    const fields = {};\n    const unknown = Object.keys(body)\n      .filter((key) => !BODY_FIELDS.includes(key))\n      .sort();\n    if (unknown.length > 0) {\n      fields.body = `Unknown fields: ${unknown.join(\", \")}`;\n    }\n\n    const trimmed = {};\n    for (const field of BODY_FIELDS) {\n      const value = body[field];\n      if (typeof value !== \"string\") {\n        fields[field] = `${field} must be a string`;\n      } else {\n        trimmed[field] = value.trim();\n      }\n    }\n\n    if (trimmed.runId !== undefined && !RUN_ID_PATTERN.test(trimmed.runId)) {\n      fields.runId = \"runId must match ^run-[a-z0-9][a-z0-9-]{2,63}$\";\n    }\n    if (trimmed.decision !== undefined && !isValidDecision(trimmed.decision)) {\n      fields.decision = DECISION_RULE;\n    }\n    if (\n      trimmed.reviewer !== undefined &&\n      (trimmed.reviewer.length < REVIEWER_MIN_LENGTH ||\n        trimmed.reviewer.length > REVIEWER_MAX_LENGTH)\n    ) {\n      fields.reviewer = \"reviewer must contain 2 through 40 characters\";\n    }\n    if (trimmed.note !== undefined) {\n      if (trimmed.note.length > NOTE_MAX_LENGTH) {\n        fields.note = \"note must be at most 240 characters\";\n      } else if (\n        trimmed.note.length === 0 &&\n        (trimmed.decision === \"reject\" || trimmed.decision === \"needs-work\")\n      ) {\n        fields.note = \"note is required for reject and needs-work\";\n      }\n    }\n\n    if (Object.keys(fields).length > 0) {\n      return validationFailed(fields);\n    }\n\n    const { created, review } = store.save(trimmed);\n    return respond(created ? 201 : 200, { review });\n  }\n\n  function handleCollection(searchParams) {\n    const all = store.list();\n    const summary = { total: all.length, approve: 0, reject: 0, \"needs-work\": 0 };\n    for (const review of all) {\n      if (review.decision === \"approve\") {\n        summary.approve += 1;\n      } else if (review.decision === \"reject\") {\n        summary.reject += 1;\n      } else if (review.decision === \"needs-work\") {\n        summary[\"needs-work\"] += 1;\n      }\n    }\n\n    let reviews = all;\n    if (searchParams.has(\"decision\")) {\n      const decision = searchParams.get(\"decision\");\n      if (!isValidDecision(decision)) {\n        return validationFailed({ decision: DECISION_RULE });\n      }\n      reviews = all.filter((review) => review.decision === decision);\n    }\n\n    return respond(200, { reviews, summary });\n  }\n\n  function handleDetail(runId) {\n    const review = store.get(runId);\n    if (review === null) {\n      return respond(404, { error: \"review_not_found\" });\n    }\n    return respond(200, { review });\n  }\n\n  function handleReviewRequest(request) {\n    if (!isRecord(request)) {\n      return invalidRequest();\n    }\n    const { method, url } = request;\n    if (\n      typeof method !== \"string\" ||\n      method.length === 0 ||\n      typeof url !== \"string\" ||\n      url.length === 0\n    ) {\n      return invalidRequest();\n    }\n\n    let parsed;\n    try {\n      parsed = new URL(url, \"http://localhost\");\n    } catch {\n      return invalidRequest();\n    }\n\n    let pathname = parsed.pathname;\n    if (pathname.length > 1 && pathname.endsWith(\"/\")) {\n      pathname = pathname.slice(0, -1);\n    }\n    const upperMethod = method.toUpperCase();\n\n    if (pathname === COLLECTION_PATH) {\n      if (upperMethod === \"POST\") {\n        return handlePost(request.body);\n      }\n      if (upperMethod === \"GET\") {\n        return handleCollection(parsed.searchParams);\n      }\n      return methodNotAllowed(\"GET, POST\");\n    }\n\n    if (pathname.startsWith(DETAIL_PREFIX)) {\n      const rawId = pathname.slice(DETAIL_PREFIX.length);\n      if (rawId.length === 0 || rawId.includes(\"/\")) {\n        return respond(404, { error: \"not_found\" });\n      }\n      let runId;\n      try {\n        runId = decodeURIComponent(rawId);\n      } catch {\n        return invalidRequest();\n      }\n      if (upperMethod !== \"GET\") {\n        return methodNotAllowed(\"GET\");\n      }\n      return handleDetail(runId);\n    }\n\n    return respond(404, { error: \"not_found\" });\n  }\n\n  return handleReviewRequest;\n}\n","numLines":200,"startLine":1,"totalLines":200}}}
