{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0186BdpJXbQXEYo1T3b213tz","type":"tool_result","content":"1\tconst REVIEW_FIELDS = [\"runId\", \"decision\", \"reviewer\", \"note\"];\n2\t\n3\tfunction defaultNow() {\n4\t  return new Date().toISOString();\n5\t}\n6\t\n7\tfunction isRecord(value) {\n8\t  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n9\t}\n10\t\n11\tfunction copyReview(review) {\n12\t  return {\n13\t    runId: review.runId,\n14\t    decision: review.decision,\n15\t    reviewer: review.reviewer,\n16\t    note: review.note,\n17\t    createdAt: review.createdAt,\n18\t    updatedAt: review.updatedAt,\n19\t  };\n20\t}\n21\t\n22\tfunction compareReviews(a, b) {\n23\t  if (a.updatedAt > b.updatedAt) {\n24\t    return -1;\n25\t  }\n26\t  if (a.updatedAt < b.updatedAt) {\n27\t    return 1;\n28\t  }\n29\t  if (a.runId < b.runId) {\n30\t    return -1;\n31\t  }\n32\t  if (a.runId > b.runId) {\n33\t    return 1;\n34\t  }\n35\t  return 0;\n36\t}\n37\t\n38\texport function createReviewStore({ now } = {}) {\n39\t  const clock = now === undefined ? defaultNow : now;\n40\t  if (typeof clock !== \"function\") {\n41\t    throw new TypeError(\"createReviewStore: now must be a function\");\n42\t  }\n43\t\n44\t  const reviews = new Map();\n45\t\n46\t  function save(input) {\n47\t    if (!isRecord(input)) {\n48\t      throw new TypeError(\"save: review must be an object\");\n49\t    }\n50\t    for (const field of REVIEW_FIELDS) {\n51\t      if (typeof input[field] !== \"string\") {\n52\t        throw new TypeError(`save: review.${field} must be a string`);\n53\t      }\n54\t    }\n55\t\n56\t    const timestamp = clock();\n57\t    if (typeof timestamp !== \"string\" || timestamp.length === 0) {\n58\t      throw new TypeError(\"save: now must return a non-empty string\");\n59\t    }\n60\t\n61\t    const existing = reviews.get(input.runId);\n62\t    const created = existing === undefined;\n63\t    const stored = {\n64\t      runId: input.runId,\n65\t      decision: input.decision,\n66\t      reviewer: input.reviewer,\n67\t      note: input.note,\n68\t      createdAt: created ? timestamp : existing.createdAt,\n69\t      updatedAt: timestamp,\n70\t    };\n71\t    reviews.set(input.runId, stored);\n72\t\n73\t    return { created, review: copyReview(stored) };\n74\t  }\n75\t\n76\t  function get(runId) {\n77\t    const stored = reviews.get(runId);\n78\t    return stored === undefined ? null : copyReview(stored);\n79\t  }\n80\t\n81\t  function list({ decision } = {}) {\n82\t    const selected = [];\n83\t    for (const review of reviews.values()) {\n84\t      if (decision === undefined || review.decision === decision) {\n85\t        selected.push(copyReview(review));\n86\t      }\n87\t    }\n88\t    selected.sort(compareReviews);\n89\t    return selected;\n90\t  }\n91\t\n92\t  return { save, get, list };\n93\t}\n94\t"}]},"parent_tool_use_id":null,"session_id":"c56c70be-17cd-4219-9f0a-e7eecfb0e52e","uuid":"8579378f-97d4-4816-9513-237eacd79381","timestamp":"2026-08-23T18:01:28.323Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-workflow-o0L2GK/checkout/benchmark/fixtures/T5-review-queue/review-store.mjs","content":"const REVIEW_FIELDS = [\"runId\", \"decision\", \"reviewer\", \"note\"];\n\nfunction defaultNow() {\n  return new Date().toISOString();\n}\n\nfunction isRecord(value) {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n}\n\nfunction copyReview(review) {\n  return {\n    runId: review.runId,\n    decision: review.decision,\n    reviewer: review.reviewer,\n    note: review.note,\n    createdAt: review.createdAt,\n    updatedAt: review.updatedAt,\n  };\n}\n\nfunction compareReviews(a, b) {\n  if (a.updatedAt > b.updatedAt) {\n    return -1;\n  }\n  if (a.updatedAt < b.updatedAt) {\n    return 1;\n  }\n  if (a.runId < b.runId) {\n    return -1;\n  }\n  if (a.runId > b.runId) {\n    return 1;\n  }\n  return 0;\n}\n\nexport function createReviewStore({ now } = {}) {\n  const clock = now === undefined ? defaultNow : now;\n  if (typeof clock !== \"function\") {\n    throw new TypeError(\"createReviewStore: now must be a function\");\n  }\n\n  const reviews = new Map();\n\n  function save(input) {\n    if (!isRecord(input)) {\n      throw new TypeError(\"save: review must be an object\");\n    }\n    for (const field of REVIEW_FIELDS) {\n      if (typeof input[field] !== \"string\") {\n        throw new TypeError(`save: review.${field} must be a string`);\n      }\n    }\n\n    const timestamp = clock();\n    if (typeof timestamp !== \"string\" || timestamp.length === 0) {\n      throw new TypeError(\"save: now must return a non-empty string\");\n    }\n\n    const existing = reviews.get(input.runId);\n    const created = existing === undefined;\n    const stored = {\n      runId: input.runId,\n      decision: input.decision,\n      reviewer: input.reviewer,\n      note: input.note,\n      createdAt: created ? timestamp : existing.createdAt,\n      updatedAt: timestamp,\n    };\n    reviews.set(input.runId, stored);\n\n    return { created, review: copyReview(stored) };\n  }\n\n  function get(runId) {\n    const stored = reviews.get(runId);\n    return stored === undefined ? null : copyReview(stored);\n  }\n\n  function list({ decision } = {}) {\n    const selected = [];\n    for (const review of reviews.values()) {\n      if (decision === undefined || review.decision === decision) {\n        selected.push(copyReview(review));\n      }\n    }\n    selected.sort(compareReviews);\n    return selected;\n  }\n\n  return { save, get, list };\n}\n","numLines":94,"startLine":1,"totalLines":94}}}
