{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"git status --short && git diff -- benchmark/fixtures/T5-review-queue/review-store.mjs benchmark/fixtures/T5-review-queue/review-api.mjs benchmark/fixtures/T5-review-queue/review-page.mjs benchmark/fixtures/T5-review-queue/student-tests.mjs benchmark/fixtures/T5-review-queue/README.md && sed -n '1,260p' benchmark/fixtures/T5-review-queue/review-queue.test.mjs\"","aggregated_output":" M benchmark/fixtures/T5-review-queue/README.md\n M benchmark/fixtures/T5-review-queue/review-api.mjs\n M benchmark/fixtures/T5-review-queue/review-page.mjs\n M benchmark/fixtures/T5-review-queue/review-store.mjs\n M benchmark/fixtures/T5-review-queue/student-tests.mjs\ndiff --git a/benchmark/fixtures/T5-review-queue/README.md b/benchmark/fixtures/T5-review-queue/README.md\nindex bb59cf2..3596b6d 100644\n--- a/benchmark/fixtures/T5-review-queue/README.md\n+++ b/benchmark/fixtures/T5-review-queue/README.md\n@@ -1,3 +1,68 @@\n # Run review queue fixture\n \n-TODO: document the completed feature, API behavior, and operating limits.\n+A dependency-free, in-memory review queue for benchmark runs. The fixture has\n+three layers:\n+\n+- `review-store.mjs` — in-memory store (`createReviewStore`) keeping at most\n+  one current review per `runId`.\n+- `review-api.mjs` — synchronous JSON-style API boundary (`createReviewApi`)\n+  returning `{ status, headers, body }` responses.\n+- `review-page.mjs` — server-rendered HTML page (`renderReviewPage`) with a\n+  summary, a review form, and a table of saved reviews.\n+\n+## Routes\n+\n+### `POST /api/reviews`\n+\n+Saves the current review for a run. Posting again for the same `runId`\n+replaces the stored review while preserving its `createdAt` timestamp.\n+\n+- The body must be an object with exactly the string fields `runId`,\n+  `decision`, `reviewer`, and `note`. Any other field is reported as a sorted\n+  `body` field error (for example `Unknown fields: alpha, zeta`).\n+- All four values are trimmed before validation and storage.\n+- `runId` must match `^run-[a-z0-9][a-z0-9-]{2,63}$`.\n+- `decision` must be `approve`, `reject`, or `needs-work`.\n+- `reviewer` must contain 2 through 40 characters after trimming.\n+- `note` may be at most 240 characters and is required for `reject` and\n+  `needs-work`; it may be empty for `approve`.\n+- Returns `201` with `{ review }` for a new run and `200` with `{ review }`\n+  for an update. Reviews carry `runId`, `decision`, `reviewer`, `note`,\n+  `createdAt`, and `updatedAt`.\n+- Invalid input returns `400` with\n+  `{ \"error\": \"validation_failed\", \"fields\": { ... } }` listing every detected\n+  problem; nothing is saved.\n+\n+### `GET /api/reviews`\n+\n+Returns `{ reviews, summary }`. Reviews are sorted by newest `updatedAt`\n+first, breaking timestamp ties by lexicographically smaller `runId`. The\n+`summary` always counts all stored reviews and has exactly `total`,\n+`approve`, `reject`, and `needs-work`. An optional `?decision=` query filters\n+only the `reviews` array; an invalid decision value returns the standard\n+`validation_failed` error.\n+\n+### `GET /api/reviews/:runId`\n+\n+Returns `200` with `{ review }`, or `404` with\n+`{ \"error\": \"review_not_found\" }` when the run has no review.\n+\n+## Errors and headers\n+\n+Every response has exactly the shape `{ status, headers, body }` and includes\n+the header `content-type: application/json; charset=utf-8`.\n+\n+- `400 { \"error\": \"validation_failed\", \"fields\": { ... } }` — invalid input;\n+  nothing is saved.\n+- `400 { \"error\": \"invalid_request\" }` — unusable request object or URL.\n+- `404 { \"error\": \"not_found\" }` — unknown route.\n+- `404 { \"error\": \"review_not_found\" }` — unknown run id on a detail route.\n+- `405 { \"error\": \"method_not_allowed\" }` — unsupported method on a recognized\n+  route. Includes an `allow` header: `GET, POST` on the collection and `GET`\n+  on a detail route.\n+\n+## Storage limits\n+\n+The store is process-local and not durable: reviews live only in memory, so\n+the store resets on every process restart. It has no external dependencies\n+and no persistence layer.\ndiff --git a/benchmark/fixtures/T5-review-queue/review-api.mjs b/benchmark/fixtures/T5-review-queue/review-api.mjs\nindex 9c13861..4220e4f 100644\n--- a/benchmark/fixtures/T5-review-queue/review-api.mjs\n+++ b/benchmark/fixtures/T5-review-queue/review-api.mjs\n@@ -1,3 +1,199 @@\n-export function createReviewApi() {\n-  throw new Error(\"TODO: implement the review API\");\n+const CONTENT_TYPE = \"application/json; charset=utf-8\";\n+const DECISIONS = [\"approve\", \"reject\", \"needs-work\"];\n+const BODY_FIELDS = [\"runId\", \"decision\", \"reviewer\", \"note\"];\n+const RUN_ID_PATTERN = /^run-[a-z0-9][a-z0-9-]{2,63}$/;\n+const COLLECTION_PATH = \"/api/reviews\";\n+const DETAIL_PREFIX = \"/api/reviews/\";\n+const REVIEWER_MIN_LENGTH = 2;\n+const REVIEWER_MAX_LENGTH = 40;\n+const NOTE_MAX_LENGTH = 240;\n+const DECISION_RULE = \"decision must be approve, reject, or needs-work\";\n+\n+function respond(status, body, extraHeaders = {}) {\n+  return {\n+    status,\n+    headers: { \"content-type\": CONTENT_TYPE, ...extraHeaders },\n+    body,\n+  };\n+}\n+\n+function validationFailed(fields) {\n+  return respond(400, { error: \"validation_failed\", fields });\n+}\n+\n+function invalidRequest() {\n+  return respond(400, { error: \"invalid_request\" });\n+}\n+\n+function methodNotAllowed(allow) {\n+  return respond(405, { error: \"method_not_allowed\" }, { allow });\n+}\n+\n+function isRecord(value) {\n+  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n+}\n+\n+function isValidDecision(value) {\n+  return DECISIONS.includes(value);\n+}\n+\n+export function createReviewApi(store) {\n+  if (\n+    store === null ||\n+    store === undefined ||\n+    typeof store.save !== \"function\" ||\n+    typeof store.get !== \"function\" ||\n+    typeof store.list !== \"function\"\n+  ) {\n+    throw new TypeError(\"createReviewApi: store must provide save, get, and list functions\");\n+  }\n+\n+  function handlePost(body) {\n+    if (!isRecord(body)) {\n+      return validationFailed({\n+        body: \"body must be an object with runId, decision, reviewer, and note\",\n+      });\n+    }\n+\n+    const fields = {};\n+    const unknown = Object.keys(body)\n+      .filter((key) => !BODY_FIELDS.includes(key))\n+      .sort();\n+    if (unknown.length > 0) {\n+      fields.body = `Unknown fields: ${unknown.join(\", \")}`;\n+    }\n+\n+    const trimmed = {};\n+    for (const field of BODY_FIELDS) {\n+      const value = body[field];\n+      if (typeof value !== \"string\") {\n+        fields[field] = `${field} must be a string`;\n+      } else {\n+        trimmed[field] = value.trim();\n+      }\n+    }\n+\n+    if (trimmed.runId !== undefined && !RUN_ID_PATTERN.test(trimmed.runId)) {\n+      fields.runId = \"runId must match ^run-[a-z0-9][a-z0-9-]{2,63}$\";\n+    }\n+    if (trimmed.decision !== undefined && !isValidDecision(trimmed.decision)) {\n+      fields.decision = DECISION_RULE;\n+    }\n+    if (\n+      trimmed.reviewer !== undefined &&\n+      (trimmed.reviewer.length < REVIEWER_MIN_LENGTH ||\n+        trimmed.reviewer.length > REVIEWER_MAX_LENGTH)\n+    ) {\n+      fields.reviewer = \"reviewer must contain 2 through 40 characters\";\n+    }\n+    if (trimmed.note !== undefined) {\n+      if (trimmed.note.length > NOTE_MAX_LENGTH) {\n+        fields.note = \"note must be at most 240 characters\";\n+      } else if (\n+        trimmed.note.length === 0 &&\n+        (trimmed.decision === \"reject\" || trimmed.decision === \"needs-work\")\n+      ) {\n+        fields.note = \"note is required for reject and needs-work\";\n+      }\n+    }\n+\n+    if (Object.keys(fields).length > 0) {\n+      return validationFailed(fields);\n+    }\n+\n+    const { created, review } = store.save(trimmed);\n+    return respond(created ? 201 : 200, { review });\n+  }\n+\n+  function handleCollection(searchParams) {\n+    const all = store.list();\n+    const summary = { total: all.length, approve: 0, reject: 0, \"needs-work\": 0 };\n+    for (const review of all) {\n+      if (review.decision === \"approve\") {\n+        summary.approve += 1;\n+      } else if (review.decision === \"reject\") {\n+        summary.reject += 1;\n+      } else if (review.decision === \"needs-work\") {\n+        summary[\"needs-work\"] += 1;\n+      }\n+    }\n+\n+    let reviews = all;\n+    if (searchParams.has(\"decision\")) {\n+      const decision = searchParams.get(\"decision\");\n+      if (!isValidDecision(decision)) {\n+        return validationFailed({ decision: DECISION_RULE });\n+      }\n+      reviews = all.filter((review) => review.decision === decision);\n+    }\n+\n+    return respond(200, { reviews, summary });\n+  }\n+\n+  function handleDetail(runId) {\n+    const review = store.get(runId);\n+    if (review === null) {\n+      return respond(404, { error: \"review_not_found\" });\n+    }\n+    return respond(200, { review });\n+  }\n+\n+  function handleReviewRequest(request) {\n+    if (!isRecord(request)) {\n+      return invalidRequest();\n+    }\n+    const { method, url } = request;\n+    if (\n+      typeof method !== \"string\" ||\n+      method.length === 0 ||\n+      typeof url !== \"string\" ||\n+      url.length === 0\n+    ) {\n+      return invalidRequest();\n+    }\n+\n+    let parsed;\n+    try {\n+      parsed = new URL(url, \"http://localhost\");\n+    } catch {\n+      return invalidRequest();\n+    }\n+\n+    let pathname = parsed.pathname;\n+    if (pathname.length > 1 && pathname.endsWith(\"/\")) {\n+      pathname = pathname.slice(0, -1);\n+    }\n+    const upperMethod = method.toUpperCase();\n+\n+    if (pathname === COLLECTION_PATH) {\n+      if (upperMethod === \"POST\") {\n+        return handlePost(request.body);\n+      }\n+      if (upperMethod === \"GET\") {\n+        return handleCollection(parsed.searchParams);\n+      }\n+      return methodNotAllowed(\"GET, POST\");\n+    }\n+\n+    if (pathname.startsWith(DETAIL_PREFIX)) {\n+      const rawId = pathname.slice(DETAIL_PREFIX.length);\n+      if (rawId.length === 0 || rawId.includes(\"/\")) {\n+        return respond(404, { error: \"not_found\" });\n+      }\n+      let runId;\n+      try {\n+        runId = decodeURIComponent(rawId);\n+      } catch {\n+        return invalidRequest();\n+      }\n+      if (upperMethod !== \"GET\") {\n+        return methodNotAllowed(\"GET\");\n+      }\n+      return handleDetail(runId);\n+    }\n+\n+    return respond(404, { error: \"not_found\" });\n+  }\n+\n+  return handleReviewRequest;\n }\ndiff --git a/benchmark/fixtures/T5-review-queue/review-page.mjs b/benchmark/fixtures/T5-review-queue/review-page.mjs\nindex 558c95a..055c98b 100644\n--- a/benchmark/fixtures/T5-review-queue/review-page.mjs\n+++ b/benchmark/fixtures/T5-review-queue/review-page.mjs\n@@ -1,3 +1,125 @@\n-export function renderReviewPage() {\n-  return \"<h1>TODO: build the run review queue</h1>\";\n+const HTML_ESCAPES = {\n+  \"&\": \"&amp;\",\n+  \"<\": \"&lt;\",\n+  \">\": \"&gt;\",\n+  '\"': \"&quot;\",\n+  \"'\": \"&#39;\",\n+};\n+\n+function escapeHtml(value) {\n+  return String(value).replace(/[&<>\"']/g, (character) => HTML_ESCAPES[character]);\n+}\n+\n+function summaryValue(summary, key) {\n+  const value = summary[key];\n+  return value === undefined || value === null ? 0 : value;\n+}\n+\n+function renderSummaryItems(summary) {\n+  const entries = [\n+    [\"Total\", summaryValue(summary, \"total\")],\n+    [\"Approve\", summaryValue(summary, \"approve\")],\n+    [\"Reject\", summaryValue(summary, \"reject\")],\n+    [\"Needs work\", summaryValue(summary, \"needs-work\")],\n+  ];\n+  return entries\n+    .map(\n+      ([label, value]) =>\n+        `          <li><strong>${escapeHtml(label)}:</strong> ${escapeHtml(value)}</li>`,\n+    )\n+    .join(\"\\n\");\n+}\n+\n+function renderRows(reviews) {\n+  if (reviews.length === 0) {\n+    return '          <tr><td colspan=\"5\">No reviews yet.</td></tr>';\n+  }\n+  return reviews\n+    .map((review) => {\n+      const safe = isRecord(review) ? review : {};\n+      return [\n+        \"          <tr>\",\n+        `            <td>${escapeHtml(safe.runId ?? \"\")}</td>`,\n+        `            <td>${escapeHtml(safe.decision ?? \"\")}</td>`,\n+        `            <td>${escapeHtml(safe.reviewer ?? \"\")}</td>`,\n+        `            <td>${escapeHtml(safe.note ?? \"\")}</td>`,\n+        `            <td>${escapeHtml(safe.updatedAt ?? \"\")}</td>`,\n+        \"          </tr>\",\n+      ].join(\"\\n\");\n+    })\n+    .join(\"\\n\");\n+}\n+\n+function isRecord(value) {\n+  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n+}\n+\n+export function renderReviewPage({ reviews = [], summary = {}, message = \"\" } = {}) {\n+  const safeReviews = Array.isArray(reviews) ? reviews : [];\n+  const safeSummary = isRecord(summary) ? summary : {};\n+\n+  return `<!DOCTYPE html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"utf-8\">\n+    <title>Run review queue</title>\n+  </head>\n+  <body>\n+    <main>\n+      <h1>Run review queue</h1>\n+      <p>Record one current review decision per benchmark run. Posting again for the same run replaces the previous decision.</p>\n+      <section aria-labelledby=\"summary-heading\">\n+        <h2 id=\"summary-heading\">Queue summary</h2>\n+        <ul>\n+${renderSummaryItems(safeSummary)}\n+        </ul>\n+      </section>\n+      <p class=\"status\" role=\"status\" aria-live=\"polite\">${escapeHtml(message)}</p>\n+      <section aria-labelledby=\"form-heading\">\n+        <h2 id=\"form-heading\">Save a review</h2>\n+        <form method=\"post\" action=\"/api/reviews\">\n+          <p>\n+            <label for=\"run-id\">Run ID</label>\n+            <input id=\"run-id\" name=\"runId\" type=\"text\" required>\n+          </p>\n+          <p>\n+            <label for=\"decision\">Decision</label>\n+            <select id=\"decision\" name=\"decision\">\n+              <option value=\"approve\">approve</option>\n+              <option value=\"reject\">reject</option>\n+              <option value=\"needs-work\">needs-work</option>\n+            </select>\n+          </p>\n+          <p>\n+            <label for=\"reviewer\">Reviewer</label>\n+            <input id=\"reviewer\" name=\"reviewer\" type=\"text\" required>\n+          </p>\n+          <p>\n+            <label for=\"note\">Note</label>\n+            <textarea id=\"note\" name=\"note\" rows=\"3\" aria-describedby=\"note-help\"></textarea>\n+          </p>\n+          <p id=\"note-help\">A note is required when the decision is reject or needs-work; it is optional for approve. Notes are limited to 240 characters.</p>\n+          <p>\n+            <button type=\"submit\">Save review</button>\n+          </p>\n+        </form>\n+      </section>\n+      <table>\n+        <caption>Saved run reviews</caption>\n+        <thead>\n+          <tr>\n+            <th scope=\"col\">Run ID</th>\n+            <th scope=\"col\">Decision</th>\n+            <th scope=\"col\">Reviewer</th>\n+            <th scope=\"col\">Note</th>\n+            <th scope=\"col\">Updated</th>\n+          </tr>\n+        </thead>\n+        <tbody>\n+${renderRows(safeReviews)}\n+        </tbody>\n+      </table>\n+    </main>\n+  </body>\n+</html>`;\n }\ndiff --git a/benchmark/fixtures/T5-review-queue/review-store.mjs b/benchmark/fixtures/T5-review-queue/review-store.mjs\nindex 1138160..e726724 100644\n--- a/benchmark/fixtures/T5-review-queue/review-store.mjs\n+++ b/benchmark/fixtures/T5-review-queue/review-store.mjs\n@@ -1,3 +1,93 @@\n-export function createReviewStore() {\n-  throw new Error(\"TODO: implement the review store\");\n+const REVIEW_FIELDS = [\"runId\", \"decision\", \"reviewer\", \"note\"];\n+\n+function defaultNow() {\n+  return new Date().toISOString();\n+}\n+\n+function isRecord(value) {\n+  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n+}\n+\n+function copyReview(review) {\n+  return {\n+    runId: review.runId,\n+    decision: review.decision,\n+    reviewer: review.reviewer,\n+    note: review.note,\n+    createdAt: review.createdAt,\n+    updatedAt: review.updatedAt,\n+  };\n+}\n+\n+function compareReviews(a, b) {\n+  if (a.updatedAt > b.updatedAt) {\n+    return -1;\n+  }\n+  if (a.updatedAt < b.updatedAt) {\n+    return 1;\n+  }\n+  if (a.runId < b.runId) {\n+    return -1;\n+  }\n+  if (a.runId > b.runId) {\n+    return 1;\n+  }\n+  return 0;\n+}\n+\n+export function createReviewStore({ now } = {}) {\n+  const clock = now === undefined ? defaultNow : now;\n+  if (typeof clock !== \"function\") {\n+    throw new TypeError(\"createReviewStore: now must be a function\");\n+  }\n+\n+  const reviews = new Map();\n+\n+  function save(input) {\n+    if (!isRecord(input)) {\n+      throw new TypeError(\"save: review must be an object\");\n+    }\n+    for (const field of REVIEW_FIELDS) {\n+      if (typeof input[field] !== \"string\") {\n+        throw new TypeError(`save: review.${field} must be a string`);\n+      }\n+    }\n+\n+    const timestamp = clock();\n+    if (typeof timestamp !== \"string\" || timestamp.length === 0) {\n+      throw new TypeError(\"save: now must return a non-empty string\");\n+    }\n+\n+    const existing = reviews.get(input.runId);\n+    const created = existing === undefined;\n+    const stored = {\n+      runId: input.runId,\n+      decision: input.decision,\n+      reviewer: input.reviewer,\n+      note: input.note,\n+      createdAt: created ? timestamp : existing.createdAt,\n+      updatedAt: timestamp,\n+    };\n+    reviews.set(input.runId, stored);\n+\n+    return { created, review: copyReview(stored) };\n+  }\n+\n+  function get(runId) {\n+    const stored = reviews.get(runId);\n+    return stored === undefined ? null : copyReview(stored);\n+  }\n+\n+  function list({ decision } = {}) {\n+    const selected = [];\n+    for (const review of reviews.values()) {\n+      if (decision === undefined || review.decision === decision) {\n+        selected.push(copyReview(review));\n+      }\n+    }\n+    selected.sort(compareReviews);\n+    return selected;\n+  }\n+\n+  return { save, get, list };\n }\ndiff --git a/benchmark/fixtures/T5-review-queue/student-tests.mjs b/benchmark/fixtures/T5-review-queue/student-tests.mjs\nindex 6330f62..7f06636 100644\n--- a/benchmark/fixtures/T5-review-queue/student-tests.mjs\n+++ b/benchmark/fixtures/T5-review-queue/student-tests.mjs\n@@ -1,2 +1,222 @@\n-// Add at least three meaningful node:test cases for the feature contract.\n-// Do not copy or modify the committed review-queue.test.mjs suite.\n+import assert from \"node:assert/strict\";\n+import test from \"node:test\";\n+\n+import { createReviewApi } from \"./review-api.mjs\";\n+import { renderReviewPage } from \"./review-page.mjs\";\n+import { createReviewStore } from \"./review-store.mjs\";\n+\n+test(\"store orders by newest update with runId tie-breaks, filters, and isolates state\", () => {\n+  let current = \"2026-08-23T10:00:00.000Z\";\n+  const store = createReviewStore({ now: () => current });\n+\n+  const draft = { runId: \"run-bravo\", decision: \"approve\", reviewer: \"Ada\", note: \"initial\" };\n+  store.save(draft);\n+  draft.note = \"mutated after save\";\n+  store.save({ runId: \"run-alpha\", decision: \"reject\", reviewer: \"Ada\", note: \"Missing tests\" });\n+  store.save({ runId: \"run-charlie\", decision: \"approve\", reviewer: \"Ada\", note: \"\" });\n+\n+  // Mutating the caller's input must not leak into stored state.\n+  assert.equal(store.get(\"run-bravo\").note, \"initial\");\n+\n+  // Equal timestamps fall back to ascending runId order.\n+  assert.deepEqual(\n+    store.list().map((review) => review.runId),\n+    [\"run-alpha\", \"run-bravo\", \"run-charlie\"],\n+  );\n+\n+  current = \"2026-08-23T11:00:00.000Z\";\n+  store.save({ runId: \"run-bravo\", decision: \"needs-work\", reviewer: \"Ada\", note: \"Add coverage\" });\n+  assert.deepEqual(\n+    store.list().map((review) => review.runId),\n+    [\"run-bravo\", \"run-alpha\", \"run-charlie\"],\n+  );\n+\n+  assert.deepEqual(\n+    store.list({ decision: \"approve\" }).map((review) => review.runId),\n+    [\"run-charlie\"],\n+  );\n+\n+  // Returned arrays and reviews are copies, not live references.\n+  const listed = store.list();\n+  listed[0].note = \"mutated copy\";\n+  listed.pop();\n+  assert.equal(store.get(\"run-bravo\").note, \"Add coverage\");\n+  assert.equal(store.list().length, 3);\n+  assert.equal(store.get(\"run-missing\"), null);\n+});\n+\n+test(\"store rejects invalid input and unusable clocks with TypeError\", () => {\n+  assert.throws(() => createReviewStore({ now: \"not a function\" }), TypeError);\n+\n+  const store = createReviewStore({ now: () => \"2026-08-23T10:00:00.000Z\" });\n+  assert.throws(() => store.save(null), TypeError);\n+  assert.throws(() => store.save([\"run-alpha\"]), TypeError);\n+  assert.throws(\n+    () => store.save({ runId: \"run-alpha\", decision: \"approve\", reviewer: \"Ada\", note: 42 }),\n+    TypeError,\n+  );\n+  assert.deepEqual(store.list(), []);\n+\n+  let ticks = 0;\n+  const flaky = createReviewStore({\n+    now: () => {\n+      ticks += 1;\n+      return ticks === 1 ? \"2026-08-23T10:00:00.000Z\" : \"\";\n+    },\n+  });\n+  flaky.save({ runId: \"run-alpha\", decision: \"approve\", reviewer: \"Ada\", note: \"\" });\n+  assert.throws(\n+    () => flaky.save({ runId: \"run-alpha\", decision: \"reject\", reviewer: \"Ada\", note: \"x\" }),\n+    TypeError,\n+  );\n+\n+  // The failed update must not mutate the stored review.\n+  assert.equal(flaky.get(\"run-alpha\").decision, \"approve\");\n+  assert.equal(flaky.get(\"run-alpha\").updatedAt, \"2026-08-23T10:00:00.000Z\");\n+});\n+\n+test(\"api validates posts, reports sorted unknown fields, and never stores invalid data\", () => {\n+  let current = \"2026-08-23T10:00:00.000Z\";\n+  const store = createReviewStore({ now: () => current });\n+  const handle = createReviewApi(store);\n+\n+  assert.throws(() => createReviewApi({ save() {} }), TypeError);\n+\n+  const created = handle({\n+    method: \"POST\",\n+    url: \"/api/reviews\",\n+    body: { runId: \"run-alpha\", decision: \"approve\", reviewer: \"Ada\", note: \"\" },\n+  });\n+  assert.equal(created.status, 201);\n+\n+  current = \"2026-08-23T11:00:00.000Z\";\n+  const updated = handle({\n+    method: \"POST\",\n+    url: \"/api/reviews\",\n+    body: { runId: \"run-alpha\", decision: \"reject\", reviewer: \"Ada\", note: \"Missing tests\" },\n+  });\n+  assert.equal(updated.status, 200);\n+  assert.equal(updated.body.review.createdAt, \"2026-08-23T10:00:00.000Z\");\n+  assert.equal(updated.body.review.updatedAt, \"2026-08-23T11:00:00.000Z\");\n+  assert.equal(updated.body.review.decision, \"reject\");\n+\n+  const unknown = handle({\n+    method: \"POST\",\n+    url: \"/api/reviews\",\n+    body: { runId: \"run-beta\", decision: \"approve\", reviewer: \"Ada\", note: \"\", zeta: 1, alpha: 2 },\n+  });\n+  assert.equal(unknown.status, 400);\n+  assert.equal(unknown.body.fields.body, \"Unknown fields: alpha, zeta\");\n+  assert.equal(store.get(\"run-beta\"), null);\n+\n+  const missingBody = handle({ method: \"POST\", url: \"/api/reviews\" });\n+  assert.equal(missingBody.status, 400);\n+  assert.equal(missingBody.body.error, \"validation_failed\");\n+  assert.equal(typeof missingBody.body.fields.body, \"string\");\n+\n+  const invalid = handle({\n+    method: \"POST\",\n+    url: \"/api/reviews\",\n+    body: { runId: \"run-gamma\", decision: \"needs-work\", reviewer: \"A\", note: \"\" },\n+  });\n+  assert.equal(invalid.status, 400);\n+  assert.deepEqual(Object.keys(invalid.body.fields).sort(), [\"note\", \"reviewer\"]);\n+  assert.deepEqual(\n+    store.list().map((review) => review.runId),\n+    [\"run-alpha\"],\n+  );\n+});\n+\n+test(\"api routes reads and errors, keeps summaries global, and never leaks headers\", () => {\n+  const store = createReviewStore({ now: () => \"2026-08-23T12:00:00.000Z\" });\n+  const handle = createReviewApi(store);\n+  handle({\n+    method: \"POST\",\n+    url: \"/api/reviews\",\n+    body: { runId: \"run-alpha\", decision: \"approve\", reviewer: \"Ada\", note: \"\" },\n+  });\n+  handle({\n+    method: \"POST\",\n+    url: \"/api/reviews\",\n+    body: { runId: \"run-beta\", decision: \"reject\", reviewer: \"Bob\", note: \"Flaky\" },\n+  });\n+\n+  const filtered = handle({ method: \"GET\", url: \"/api/reviews?decision=reject\" });\n+  assert.equal(filtered.status, 200);\n+  assert.deepEqual(\n+    filtered.body.reviews.map((review) => review.runId),\n+    [\"run-beta\"],\n+  );\n+  assert.deepEqual(filtered.body.summary, { total: 2, approve: 1, reject: 1, \"needs-work\": 0 });\n+\n+  const badFilter = handle({ method: \"GET\", url: \"/api/reviews?decision=mixed\" });\n+  assert.equal(badFilter.status, 400);\n+  assert.equal(badFilter.body.error, \"validation_failed\");\n+\n+  const detail = handle({ method: \"GET\", url: \"/api/reviews/run-alpha\" });\n+  assert.equal(detail.status, 200);\n+  assert.equal(detail.body.review.runId, \"run-alpha\");\n+\n+  const missing = handle({ method: \"GET\", url: \"/api/reviews/run-missing\" });\n+  assert.equal(missing.status, 404);\n+  assert.deepEqual(missing.body, { error: \"review_not_found\" });\n+\n+  const collectionMethod = handle({ method: \"DELETE\", url: \"/api/reviews\" });\n+  assert.equal(collectionMethod.status, 405);\n+  assert.equal(collectionMethod.headers.allow, \"GET, POST\");\n+\n+  const detailMethod = handle({ method: \"POST\", url: \"/api/reviews/run-alpha\" });\n+  assert.equal(detailMethod.status, 405);\n+  assert.deepEqual(detailMethod.body, { error: \"method_not_allowed\" });\n+  assert.equal(detailMethod.headers.allow, \"GET\");\n+\n+  // The 405 allow header must not leak into later responses.\n+  const after = handle({ method: \"GET\", url: \"/api/reviews/run-alpha\" });\n+  assert.equal(\"allow\" in after.headers, false);\n+  assert.deepEqual(Object.keys(after), [\"status\", \"headers\", \"body\"]);\n+\n+  const unknown = handle({ method: \"GET\", url: \"/somewhere/else\" });\n+  assert.equal(unknown.status, 404);\n+  assert.deepEqual(unknown.body, { error: \"not_found\" });\n+\n+  assert.equal(handle(null).status, 400);\n+  assert.deepEqual(handle(null).body, { error: \"invalid_request\" });\n+  assert.deepEqual(handle({ method: \"GET\", url: 42 }).body, { error: \"invalid_request\" });\n+});\n+\n+test(\"page escapes injected markup in the message, summary, and review fields\", () => {\n+  const html = renderReviewPage({\n+    reviews: [\n+      {\n+        runId: 'run-x\"><script>alert(1)</script>',\n+        decision: \"reject\",\n+        reviewer: '<img src=x onerror=\"alert(1)\">',\n+        note: '\" onload=\"alert(1)',\n+        createdAt: \"2026-08-23T10:00:00.000Z\",\n+        updatedAt: \"2026-08-23T11:00:00.000Z\",\n+      },\n+    ],\n+    summary: { total: \"<i>s1</i>\", approve: \"<i>s2</i>\", reject: \"<i>s3</i>\", \"needs-work\": \"<i>s4</i>\" },\n+    message: '<script>alert(\"msg\")</script>',\n+  });\n+\n+  assert.equal(html.includes(\"<script>\"), false);\n+  assert.equal(html.includes(\"<img\"), false);\n+  assert.equal(html.includes(\"<i>\"), false);\n+  assert.equal(html.includes('onload=\"alert'), false);\n+  assert.equal(html.includes('onerror=\"alert'), false);\n+\n+  assert.ok(html.includes(\"&lt;script&gt;alert(&quot;msg&quot;)&lt;/script&gt;\"));\n+  assert.ok(html.includes(\"run-x&quot;&gt;&lt;script&gt;alert(1)&lt;/script&gt;\"));\n+  assert.ok(html.includes(\"&lt;img src=x onerror=&quot;alert(1)&quot;&gt;\"));\n+  assert.ok(html.includes(\"&quot; onload=&quot;alert(1)\"));\n+  for (const marker of [\"s1\", \"s2\", \"s3\", \"s4\"]) {\n+    assert.ok(html.includes(`&lt;i&gt;${marker}&lt;/i&gt;`));\n+  }\n+\n+  // The document structure stays intact despite hostile caller data.\n+  assert.ok(html.startsWith(\"<!DOCTYPE html>\"));\n+  assert.ok(html.includes(\"<caption>Saved run reviews</caption>\"));\n+  assert.ok(html.includes('aria-live=\"polite\"'));\n+  assert.ok(html.includes('<label for=\"note\">Note</label>'));\n+});\nimport assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createReviewApi } from \"./review-api.mjs\";\nimport { renderReviewPage } from \"./review-page.mjs\";\nimport { createReviewStore } from \"./review-store.mjs\";\n\nfunction clock(...timestamps) {\n  let index = 0;\n  return () => timestamps[index++];\n}\n\ntest(\"stores one current review per run and preserves creation time\", () => {\n  const store = createReviewStore({\n    now: clock(\"2026-08-23T10:00:00.000Z\", \"2026-08-23T11:00:00.000Z\"),\n  });\n  const first = store.save({ runId: \"run-alpha\", decision: \"approve\", reviewer: \"Ada\", note: \"\" });\n  const updated = store.save({ runId: \"run-alpha\", decision: \"needs-work\", reviewer: \"Ada\", note: \"Add tests\" });\n\n  assert.equal(first.created, true);\n  assert.equal(updated.created, false);\n  assert.equal(store.list().length, 1);\n  assert.equal(updated.review.createdAt, \"2026-08-23T10:00:00.000Z\");\n  assert.equal(updated.review.updatedAt, \"2026-08-23T11:00:00.000Z\");\n});\n\ntest(\"creates, normalizes, lists, and filters reviews through the API\", () => {\n  const store = createReviewStore({ now: () => \"2026-08-23T12:00:00.000Z\" });\n  const handle = createReviewApi(store);\n  const created = handle({\n    method: \"POST\",\n    url: \"/api/reviews\",\n    body: { runId: \" run-alpha \", decision: \" approve \", reviewer: \" Ada \", note: \" looks good \" },\n  });\n\n  assert.equal(created.status, 201);\n  assert.equal(created.headers[\"content-type\"], \"application/json; charset=utf-8\");\n  assert.deepEqual(created.body.review, {\n    runId: \"run-alpha\",\n    decision: \"approve\",\n    reviewer: \"Ada\",\n    note: \"looks good\",\n    createdAt: \"2026-08-23T12:00:00.000Z\",\n    updatedAt: \"2026-08-23T12:00:00.000Z\",\n  });\n\n  const listed = handle({ method: \"GET\", url: \"/api/reviews?decision=approve\" });\n  assert.equal(listed.status, 200);\n  assert.equal(listed.body.reviews.length, 1);\n  assert.deepEqual(listed.body.summary, { total: 1, approve: 1, reject: 0, \"needs-work\": 0 });\n});\n\ntest(\"returns field errors instead of saving an invalid decision\", () => {\n  const store = createReviewStore();\n  const handle = createReviewApi(store);\n  const result = handle({\n    method: \"POST\",\n    url: \"/api/reviews\",\n    body: { runId: \"bad\", decision: \"reject\", reviewer: \"A\", note: \"\" },\n  });\n\n  assert.equal(result.status, 400);\n  assert.equal(result.body.error, \"validation_failed\");\n  assert.deepEqual(Object.keys(result.body.fields).sort(), [\"note\", \"reviewer\", \"runId\"]);\n  assert.deepEqual(store.list(), []);\n});\n\ntest(\"renders a labeled form, summary, table, and empty state\", () => {\n  const html = renderReviewPage({\n    reviews: [],\n    summary: { total: 0, approve: 0, reject: 0, \"needs-work\": 0 },\n    message: \"\",\n  });\n\n  assert.match(html, /<main>/);\n  assert.match(html, /<label for=\"run-id\">Run ID<\\/label>/);\n  assert.match(html, /aria-live=\"polite\"/);\n  assert.match(html, /<caption>Saved run reviews<\\/caption>/);\n  assert.match(html, /No reviews yet\\./);\n});\n","exit_code":0,"status":"completed"}}
