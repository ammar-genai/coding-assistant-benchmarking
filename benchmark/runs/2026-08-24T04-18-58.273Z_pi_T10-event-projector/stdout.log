serialization, full validation, and commit-after-persist:\n\n"},{"type":"toolCall","id":"chatcmpl-tool-b0e26d29e42ea5d0","name":"write","arguments":{"path":"benchmark/fixtures/T10-event-projector/event-projector.mjs","content":"const SUPPORTED_TYPES = new Set([\"CREATED\", \"AMENDED\", \"CANCELLED\"]);\n\nfunction copyState(state) {\n  return state ? structuredClone(state) : null;\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.length > 0;\n}\n\nfunction isPositiveFinite(value) {\n  return typeof value === \"number\" && Number.isFinite(value) && value > 0;\n}\n\nfunction isValidNotional(value) {\n  return isPositiveFinite(value);\n}\n\nfunction isValidOwner(value) {\n  return isNonEmptyString(value);\n}\n\nfunction validateEvent(event) {\n  if (typeof event !== \"object\" || event === null || Array.isArray(event)) {\n    throw new TypeError(\"event must be an object\");\n  }\n  if (!isNonEmptyString(event.tradeId)) {\n    throw new TypeError(\"event.tradeId must be a non-empty string\");\n  }\n  if (\n    !Number.isInteger(event.version) ||\n    !Number.isSafeInteger(event.version) ||\n    event.version < 1\n  ) {\n    throw new TypeError(\"event.version must be a positive safe integer\");\n  }\n  if (!SUPPORTED_TYPES.has(event.type)) {\n    throw new TypeError(`unsupported event type: ${event.type}`);\n  }\n  if (event.payload !== null && typeof event.payload !== \"object\") {\n    throw new TypeError(\"event.payload must be an object or null\");\n  }\n  const payload = event.payload ?? {};\n\n  if (event.type === \"CREATED\") {\n    if (!isValidNotional(payload.notional)) {\n      throw new TypeError(\"CREATED.payload.notional must be a positive finite number\");\n    }\n    if (!isValidOwner(payload.owner)) {\n      throw new TypeError(\"CREATED.payload.owner must be a non-empty string\");\n    }\n  }\n\n  if (event.type === \"AMENDED\") {\n    const { notional, owner, ...unknown } = payload;\n    if (Object.keys(unknown).length > 0) {\n      throw new TypeError(\"AMENDED.payload may only contain notional and owner\");\n    }\n    if (notional === undefined && owner === undefined) {\n      throw new TypeError(\"AMENDED.payload must replace notional and/or owner\");\n    }\n    if (notional !== undefined && !isValidNotional(notional)) {\n      throw new TypeError(\"AMENDED.payload.notional must be a positive finite number\");\n    }\n    if (owner !== undefined && !isValidOwner(owner)) {\n      throw new TypeError(\"AMENDED.payload.owner must be a non-empty string\");\n    }\n  }\n}\n\nfunction reduceEvent(previous, event) {\n  if (event.type === \"CREATED\") {\n    return {\n      tradeId: event.tradeId,\n      version: event.version,\n      status: \"active\",\n      notional: event.payload.notional,\n      owner: event.payload.owner,\n    };\n  }\n  if (event.type === \"AMENDED\") {\n    const next = { ...previous, version: event.version };\n    if (event.payload.notional !== undefined) {\n      next.notional = event.payload.notional;\n    }\n    if (event.payload.owner !== undefined) {\n      next.owner = event.payload.owner;\n    }\n    return next;\n  }\n  return { ...previous, version: event.version, status: \"cancelled\" };\n}\n\nclass EventSequenceError extends Error {}\n\nexport function createEventProjector(applyToStore) {\n  if (typeof applyToStore !== \"function\") {\n    throw new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map();\n  const tradeChains = new Map();\n\n  async function applyEvent(event) {\n    const { tradeId } = event;\n    const current = states.get(tradeId);\n\n    if (event.type === \"CREATED\") {\n      if (current !== undefined) {\n        if (event.version <= current.version) {\n          return copyState(current);\n        }\n        throw new EventSequenceError(\n          `trade ${tradeId} already exists at version ${current.version}; CREATED is only valid as the first event`,\n        );\n      }\n      if (event.version !== 1) {\n        throw new EventSequenceError(\n          `trade ${tradeId} has no state; CREATED must be version 1, got ${event.version}`,\n        );\n      }\n    } else {\n      if (current === undefined) {\n        throw new EventSequenceError(\n          `trade ${tradeId} has no state; ${event.type} requires an existing CREATED trade`,\n        );\n      }\n      if (event.version <= current.version) {\n        return copyState(current);\n      }\n      if (event.version !== current.version + 1) {\n        throw new EventSequenceError(\n          `trade ${tradeId} is at version ${current.version}; expected ${current.version + 1}, got ${event.version}`,\n        );\n      }\n      if (current.status === \"cancelled\") {\n        throw new EventSequenceError(\n          `trade ${tradeId} is terminal (cancelled); no further events are accepted`,\n        );\n      }\n    }\n\n    const next = reduceEvent(current, event);\n    try {\n      await applyToStore(tradeId, copyState(next), structuredClone(event));\n    } catch (error) {\n      // Persistence failed: leave the store view untouched and let later\n      // events for this trade (and other trades) proceed from the old state.\n      throw error;\n    }\n    states.set(tradeId, next);\n    return copyState(next);\n  }\n\n  function project(event) {\n    const chain = tradeChains.get(event?.tradeId) ?? Promise.resolve();\n    const result = chain.then(() => {\n      validateEvent(event);\n      return applyEvent(event);\n    });\n    tradeChains.set(event?.tradeId, result.catch(() => {}));\n    return result;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n"}}],"api":"openai-completions","provider":"openrouter","model":"qwen/qwen3.8-27b","usage":{"input":5418,"output":1458,"cacheRead":0,"cacheWrite":0,"reasoning":13,"totalTokens":6876,"cost":{"input":0.0024381000000000003,"output":0.004665600000000001,"cacheRead":0,"c