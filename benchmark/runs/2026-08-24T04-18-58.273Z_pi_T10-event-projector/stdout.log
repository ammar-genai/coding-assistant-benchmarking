ector.project(created());\n  const stale = await projector.project(\n    amended(\"trade-1\", 1, { owner: \"desk-b\" }),\n  );\n\n  assert.equal(persistCalls, 1);\n  assert.deepEqual(duplicate, first);\n  assert.deepEqual(stale, first);\n  assert.deepEqual(projector.getSnapshot(\"trade-1\"), first);\n});\n\ntest(\"version gaps and non-sequential first events reject without changing state\", async () => {\n  let persistCalls = 0;\n  const projector = createEventProjector(async () => {\n    persistCalls += 1;\n  });\n\n  await projector.project(created());\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 4)),\n    /expected 3, got 4/,\n  );\n  assert.equal(persistCalls, 1);\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 1);\n\n  await assert.rejects(\n    projector.project({ ...created(\"trade-2\"), version: 7 }),\n    /CREATED must be version 1/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-2\"), null);\n  assert.equal(persistCalls, 1);\n});\n\ntest(\"a cancelled trade is terminal\", async () => {\n  const projector = createEventProjector(async () => {});\n  await projector.project(created());\n  const cancelled = await projector.project({\n    tradeId: \"trade-1\",\n    version: 2,\n    type: \"CANCELLED\",\n    payload: {},\n  });\n  assert.equal(cancelled.status, \"cancelled\");\n\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 3, { owner: \"desk-b\" })),\n    /terminal/,\n  );\n  assert.deepEqual(projector.getSnapshot(\"trade-1\"), cancelled);\n});\n\ntest(\"amended may replace either field but must keep a valid complete state\", async () => {\n  const projector = createEventProjector(async () => {});\n  await projector.project(created());\n\n  const amendedOwner = await projector.project(\n    amended(\"trade-1\", 2, { owner: \"desk-b\" }),\n  );\n  assert.equal(amendedOwner.notional, 100);\n  assert.equal(amendedOwner.owner, \"desk-b\");\n\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 3, { notional: -5 })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 3, { owner: \"\" })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 3, { notional: 100 })),\n    /expected 3/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 2);\n});\n\ntest(\"malformed events reject with TypeError\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({ tradeId: \"t\", version: 1, type: \"FILLED\", payload: {} }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project({ tradeId: \"t\", version: 1, type: \"CREATED\", payload: {} }),\n    /notional/,\n  );\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t\",\n      version: 1,\n      type: \"CREATED\",\n      payload: { notional: Number.NaN, owner: \"desk\" },\n    }),\n    TypeError,\n  );\n  await assert.rejects(projector.project(null), TypeError);\n  await assert.rejects(projector.project(\"nope\"), TypeError);\n  assert.equal(projector.getSnapshot(\"t\"), null);\n});\n\ntest(\"snapshots and callback values do not expose mutable internal state\", async () => {\n  const received = [];\n  const projector = createEventProjector(async (_tradeId, state, event) => {\n    state.notional = 999999;\n    event.payload.owner = \"tampered\";\n    received.push({ state, event });\n  });\n\n  const first = await projector.project(created());\n  first.notional = 1;\n  first.owner = \"mutated\";\n\n  const second = await projector.project(amended(\"trade-1\", 2, { owner: \"x\" }));\n  second.status = \"mutated\";\n\n  const snapshot = projector.getSnapshot(\"trade-1\");\n  assert.equal(snapshot.version, 2);\n  assert.equal(snapshot.notional, 125);\n  assert.equal(snapshot.owner, \"x\");\n  assert.equal(snapshot.status, \"active\");\n  assert.equal(received[0].state.notional, 999999); // mutation was on a clone\n  assert.equal(