         b.score === a.score &&\n          b.elapsed_ms === a.elapsed_ms &&\n          b.run_id < a.run_id\n        ) {\n          return b;\n        }\n        return a;\n      });\n\n      const median = medianElapsedMs(\n        runsForAssistant.map((run) => run.elapsed_ms),\n      );\n\n      return {\n        assistant,\n        run_count: runsForAssistant.length,\n        best_score: best.score,\n        best_run_id: best.run_id,\n        median_elapsed_ms: median,\n      };\n    })\n    .sort((a, b) => (a.assistant < b.assistant ? -1 : a.assistant > b.assistant ? 1 : 0));\n\n  return summaries;\n}\n\nfunction medianElapsedMs(elapsedTimes) {\n  const sorted = [...elapsedTimes].sort((a, b) => a - b);\n  const mid = Math.floor(sorted.length / 2);\n  if (sorted.length % 2 === 1) {\n    return sorted[mid];\n  }\n  return (sorted[mid - 1] + sorted[mid]) / 2;\n}\nEOF\necho done'","aggregated_output":"done\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cd /var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-k9OLNw/checkout && cat > benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs <<'EOF'\n/**\n * Render assistant summaries as a stable Markdown table.\n */\nexport function renderComparisonTable(summaries) {\n  if (\"'!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n\n  const header = [\n    \"| Assistant | Runs | Best score | Best run | Median time |\",\n    \"|---|---:|---:|---|---:|\",\n  ];\n\n  if (summaries.length === 0) {\n    return [...header, \"\", \"_No eligible runs._\"].join(\"'\"\\\\n\\\");\n  }\n\n  const rows = summaries.map((summary) => {\n    validateSummary(summary);\n    const assistant = escapePipe(summary.assistant);\n    const bestRunId = escapePipe(summary.best_run_id);\n    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);\n    return \"'`| ${assistant} | ${summary.run_count} | ${summary.best_score} | ${bestRunId} | ${seconds} s |`;\n  });\n\n  return [...header, ...rows].join(\"'\"\\\\n\\\");\n}\n\nfunction validateSummary(summary) {\n  if (\n    typeof summary?.assistant \"'!== \"string\" ||\n    summary.assistant === \"\"\n  ) {\n    throw new TypeError(\"assistant must be a non-empty string\");\n  }\n  if (\n    typeof summary?.best_run_id !== \"string\" ||\n    summary.best_run_id === \"\"\n  ) {\n    throw new TypeError(\"best_run_id must be a non-empty string\");\n  }\n  if (\n    !Number.isInteger(summary?.run_count) ||\n    summary.run_count < 1\n  ) {\n    throw new TypeError(\"run_count must be a positive integer\");\n  }\n  if (\n    typeof summary?.best_score !== \"number\" ||\n    !Number.isFinite(summary.best_score) ||\n    summary.best_score < 0 ||\n    summary.best_score > 100\n  ) {\n    throw new TypeError(\"best_score must be a finite number from 0 through 100\");\n  }\n  if (\n    typeof summary?.median_elapsed_ms !== \"number\" ||\n    !Number.isFinite(summary.median_elapsed_ms) ||\n    summary.median_elapsed_ms < 0\n  ) {\n    throw new TypeError(\n      \"median_elapsed_ms must be a finite number greater than or equal to zero\",\n    );\n  }\n}\n\nfunction escapePipe(value) {\n  return value.replace(/'\"\\\\|/g, \\\"\\\\\\\\|\\\");\n}\nEOF\necho done\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
