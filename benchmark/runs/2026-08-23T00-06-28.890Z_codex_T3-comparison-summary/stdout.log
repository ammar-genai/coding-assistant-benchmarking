{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cd /var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-k9OLNw/checkout && cat > benchmark/fixtures/T3-comparison-summary/student-tests.mjs <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\n\nimport { renderComparisonTable } from \\\"./render-comparison-table.mjs\\\";\nimport { summarizeAssistants } from \\\"./summarize-assistants.mjs\\\";\n\ntest(\\\"throws TypeError for non-array runs and invalid eligible data\\\", () => {\n  assert.throws(() => summarizeAssistants(\\\"not-an-array\\\"), TypeError);\n  assert.throws(\n    () =>\n      summarizeAssistants([\n        {\n          run_id: \\\"bad\\\",\n          assistant: \\\"Codex\\\",\n          status: \\\"complete\\\",\n          acceptance_status: \\\"pass\\\",\n          score: 101,\n          elapsed_ms: 100,\n        },\n      ]),\n    TypeError,\n  );\n  assert.throws(\n    () =>\n      summarizeAssistants([\n        {\n          run_id: \\\"\\\",\n          assistant: \\\"Codex\\\",\n          status: \\\"complete\\\",\n          acceptance_status: \\\"pass\\\",\n          score: 50,\n          elapsed_ms: 100,\n        },\n      ]),\n    TypeError,\n  );\n});\n\ntest(\\\"does not throw for invalid data on an ineligible run\\\", () => {\n  const result = summarizeAssistants([\n    {\n      run_id: 123,\n      assistant: \\\"\\\",\n      status: \\\"pending\\\",\n      acceptance_status: \\\"pass\\\",\n      score: \\\"nope\\\",\n      elapsed_ms: -5,\n    },\n  ]);\n  assert.deepEqual(result, []);\n});\n\ntest(\\\"groups by case-sensitive assistant and breaks score tie by run id\\\", () => {\n  const runs = [\n    {\n      run_id: \\\"codex-b\\\",\n      assistant: \\\"Codex\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 88,\n      elapsed_ms: 500,\n    },\n    {\n      run_id: \\\"codex-a\\\",\n      assistant: \\\"Codex\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 88,\n      elapsed_ms: 500,\n    },\n    {\n      run_id: \\\"other\\\",\n      assistant: \\\"codex\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 80,\n      elapsed_ms: 100,\n    },\n  ];\n\n  const summaries = summarizeAssistants(runs);\n  assert.equal(summaries.length, 2);\n  assert.deepEqual(summaries[0], {\n    assistant: \\\"Codex\\\",\n    run_count: 2,\n    best_score: 88,\n    best_run_id: \\\"codex-a\\\",\n    median_elapsed_ms: 500,\n  });\n  assert.deepEqual(summaries[1], {\n    assistant: \\\"codex\\\",\n    run_count: 1,\n    best_score: 80,\n    best_run_id: \\\"other\\\",\n    median_elapsed_ms: 100,\n  });\n});\n\ntest(\\\"computes median for an even run count and preserves input\\\", () => {\n  const runs = Object.freeze([\n    Object.freeze({\n      run_id: \\\"a\\\",\n      assistant: \\\"Codex\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 90,\n      elapsed_ms: 100,\n    }),\n    Object.freeze({\n      run_id: \\\"b\\\",\n      assistant: \\\"Codex\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 80,\n      elapsed_ms: 300,\n    }),\n    Object.freeze({\n      run_id: \\\"c\\\",\n      assistant: \\\"Codex\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 70,\n      elapsed_ms: 500,\n    }),\n    Object.freeze({\n      run_id: \\\"d\\\",\n      assistant: \\\"Codex\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 60,\n      elapsed_ms: 700,\n    }),\n  ]);\n\n  const summaries = summarizeAssistants(runs);\n  assert.equal(summaries[0].run_count, 4);\n  assert.equal(summaries[0].median_elapsed_ms, 400);\n  assert.equal(summaries[0].best_run_id, \\\"a\\\");\n});\n\ntest(\\\"throws TypeError for invalid summary fields in the renderer\\\", () => {\n  assert.throws(() => renderComparisonTable(\\\"nope\\\"), TypeError);\n  assert.throws(\n    () =>\n      renderComparisonTable([\n        {\n          assistant: \\\"Codex\\\",\n          run_count: 0,\n          best_score: 90,\n          best_run_id: \\\"a\\\",\n          median_elapsed_ms: 100,\n        },\n      ]),\n    TypeError,\n  );\n});\n\ntest(\\\"preserves summary order and formats median as three decimals\\\", () => {\n  const summaries = [\n    {\n      assistant: \\\"Zed\\\",\n      run_count: 1,\n      best_score: 50.5,\n      best_run_id: \\\"z\\\",\n      median_elapsed_ms: 1_250,\n    },\n    {\n      assistant: \\\"Alpha\\\",\n      run_count: 2,\n      best_score: 77,\n      best_run_id: \\\"a\\\",\n      median_elapsed_ms: 500,\n    },\n  ];\n\n  const table = renderComparisonTable(summaries);\n  const lines = table.split(\\\"\\\\n\\\");\n  assert.match(lines[2], /\"'^'\"\\\\| Zed \\\\| 1 \\\\| 50\\\\.5 \\\\| z \\\\| 1\\\\.250 s \\\\|\"'$/);\n  assert.match(lines[3], /''^'\"\\\\| Alpha \\\\| 2 \\\\| 77 \\\\| a \\\\| 0\\\\.500 s \\\\|\"'$/);\n});\nEOF\necho done && node --test benchmark/fixtures/T3-comparison-summary/comparison-summary.test.mjs benchmark/fixtures/T3-comparison-summary/student-tests.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
