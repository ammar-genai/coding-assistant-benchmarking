-// Add at least two meaningful node:test cases for the run explorer.
-// Do not copy or modify the committed run-explorer.test.mjs suite.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { filterRuns, sortRuns, summarizeRuns } from "./run-explorer.mjs";
+
+const mixedRuns = Object.freeze([
+  Object.freeze({
+    id: "z-fast-null",
+    assistant: "Codex",
+    model: "Sol",
+    outcome: "pass",
+    score: 50,
+    elapsedSeconds: 10,
+    costUsd: null,
+  }),
+  Object.freeze({
+    id: "a-slow-null",
+    assistant: "Claude Code",
+    model: "Fable",
+    outcome: "fail",
+    score: 50,
+    elapsedSeconds: 10,
+    costUsd: null,
+  }),
+  Object.freeze({
+    id: "m-known-005",
+    assistant: "OpenCode",
+    model: "Kimi",
+    outcome: "pass",
+    score: 99,
+    elapsedSeconds: 30,
+    costUsd: 0.05,
+  }),
+  Object.freeze({
+    id: "m-known-015",
+    assistant: "OpenCode",
+    model: "Qwen",
+    outcome: "fail",
+    score: 99,
+    elapsedSeconds: 20,
+    costUsd: 0.15,
+  }),
+]);
+
+test("sortRuns cost-asc places known costs first, ties on score and id", () => {
+  const result = sortRuns(mixedRuns, "cost-asc");
+  assert.deepEqual(result.map((run) => run.id), [
+    "m-known-005",
+    "m-known-015",
+    "a-slow-null",
+    "z-fast-null",
+  ]);
+  // Inputs must stay unchanged.
+  assert.deepEqual(mixedRuns.map((run) => run.id), [
+    "z-fast-null",
+    "a-slow-null",
+    "m-known-005",
+    "m-known-015",
+  ]);
+});
+
+test("summarizeRuns handles empty arrays and even-length medians without mutation", () => {
+  assert.deepEqual(summarizeRuns([]), {
+    visibleCount: 0,
+    passRatePct: 0,
+    medianElapsedSeconds: 0,
+    totalCostUsd: 0,
+    costedRunCount: 0,
+  });
+
+  const evenRuns = Object.freeze([
+    Object.freeze({
+      id: "a",
+      assistant: "Codex",
+      model: "Sol",
+      outcome: "pass",
+      score: 80,
+      elapsedSeconds: 10,
+      costUsd: 0.1,
+    }),
+    Object.freeze({
+      id: "b",
+      assistant: "OpenCode",
+      model: "Kimi",
+      outcome: "fail",
+      score: 70,
+      elapsedSeconds: 20,
+      costUsd: 0.2,
+    }),
+    Object.freeze({
+      id: "c",
+      assistant: "Claude Code",
+      model: "Fable",
+      outcome: "pass",
+      score: 90,
+      elapsedSeconds: 30,
+      costUsd: 0.3,
+    }),
+    Object.freeze({
+      id: "d",
+      assistant: "Codex",
+      model: "Sol",
+      outcome: "fail",
+      score: 60,
+      elapsedSeconds: 40,
+      costUsd: null,
+    }),
+  ]);
+
+  const summary = summarizeRuns(evenRuns);
+  assert.deepEqual(summary, {
+    visibleCount: 4,
+    passRatePct: 50.0,
+    medianElapsedSeconds: 25,
+    totalCostUsd: 0.6,
+    costedRunCount: 3,
+  });
+
+  // Verify the original array was not mutated.
+  assert.deepEqual(
+    evenRuns.map((run) => run.id),
+    ["a", "b", "c", "d"]
+  );
+});
+
+test("filterRuns and sortRuns reject non-array inputs", () => {
+  assert.throws(() => filterRuns(null, {}), TypeError);
+  assert.throws(() => filterRuns(undefined, {}), TypeError);
+  assert.throws(() => sortRuns("not-an-array", "score-desc"), TypeError);
+  assert.throws(() => sortRuns([], "unsupported-order"), TypeError);
+});
