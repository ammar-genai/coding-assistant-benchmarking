trol\">\n          <label for=\"outcome-filter\">Outcome</label>\n          <select id=\"outcome-filter\">\n            <option value=\"all\">All outcomes</option>\n            <option value=\"pass\">Pass</option>\n            <option value=\"fail\">Fail</option>\n          </select>\n        </div>\n\n        <div class=\"control\">\n          <label for=\"sort-order\">Sort by</label>\n          <select id=\"sort-order\">\n            <option value=\"score-desc\">Score (high to low)</option>\n            <option value=\"time-asc\">Time (fastest)</option>\n            <option value=\"cost-asc\">Cost (known first)</option>\n          </select>\n        </div>\n\n        <button type=\"button\" id=\"reset-filters\">Reset filters</button>\n      </section>\n\n      <section class=\"summary\" aria-labelledby=\"summary-heading\">\n        <h2 id=\"summary-heading\" class=\"visually-hidden\">Summary</h2>\n        <div class=\"summary-grid\">\n          <div class=\"summary-item\">\n            <span id=\"visible-count\">0</span>\n            <span class=\"summary-label\">Visible runs</span>\n          </div>\n          <div class=\"summary-item\">\n            <span id=\"pass-rate\">0%</span>\n            <span class=\"summary-label\">Pass rate</span>\n          </div>\n          <div class=\"summary-item\">\n            <span id=\"median-time\">0.0 s</span>\n            <span class=\"summary-label\">Median time</span>\n          </div>\n          <div class=\"summary-item\">\n            <span id=\"known-cost\">$0.00 (0)</span>\n            <span class=\"summary-label\">\n              Known cost\n              <small>(subscription costs excluded)</small>\n            </span>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"results\" aria-labelledby=\"results-heading\">\n        <h2 id=\"results-heading\" class=\"visually-hidden\">Run records</h2>\n\n        <p id=\"status-region\" class=\"status\" aria-live=\"polite\"></p>\n\n        <div id=\"empty-state\" class=\"empty-state\" hidden>\n          <p>No runs match the current filters.</p>\n        </div>\n\n        <div id=\"results-list\" class=\"results-list\"></div>\n      </section>\n    </main>\n  </body>\n</html>\n","structuredPatch":[{"oldStart":9,"oldLines":9,"newStart":9,"newLines":85,"lines":["   </head>","   <body>","     <main>","-      <p>Benchmark evidence</p>","-      <h1>Run explorer</h1>","-      <p>Build the interactive comparison interface described in the task.</p>","+      <header class=\"intro\">","+        <p class=\"eyebrow\">Benchmark evidence</p>","+        <h1>Run explorer</h1>","+        <p>","+          The records below are sample benchmark runs used to preview the","+          comparison interface. They are not final study results.","+        </p>","+      </header>","+","+      <section class=\"controls\" aria-labelledby=\"controls-heading\">","+        <h2 id=\"controls-heading\" class=\"visually-hidden\">Filter and sort runs</h2>","+","+        <div class=\"control\">","+          <label for=\"assistant-filter\">Assistant</label>","+          <select id=\"assistant-filter\">","+            <option value=\"all\">All assistants</option>","+            <option value=\"Codex\">Codex</option>","+            <option value=\"Claude Code\">Claude Code</option>","+            <option value=\"OpenCode\">OpenCode</option>","+          </select>","+        </div>","+","+        <div class=\"control\">","+          <label for=\"outcome-filter\">Outcome</label>","+          <select id=\"outcome-filter\">","+            <option value=\"all\">All outcomes</option>","+            <option value=\"pass\">Pass</option>","+            <option value=\"fail\">Fail</option>","+          </select>","+        </div>","+","+        <div class=\"control\">","+          <label for=\"sort-order\">Sort by</label>","+          <select id=\"sort-order\">","+            <option value=\"score-desc\">Score (high to low)</option>","+            <option va