{"type":"user","message":{"role":"user","content":[{"tool_use_id":"functions.Read:1","type":"tool_result","content":"1\timport assert from \"node:assert/strict\";\n2\timport { readFile } from \"node:fs/promises\";\n3\timport test from \"node:test\";\n4\t\n5\timport { filterRuns, sortRuns, summarizeRuns } from \"./run-explorer.mjs\";\n6\t\n7\tconst runs = Object.freeze([\n8\t  Object.freeze({\n9\t    id: \"codex-a\",\n10\t    assistant: \"Codex\",\n11\t    model: \"Sol\",\n12\t    outcome: \"pass\",\n13\t    score: 94,\n14\t    elapsedSeconds: 24,\n15\t    costUsd: null,\n16\t  }),\n17\t  Object.freeze({\n18\t    id: \"opencode-b\",\n19\t    assistant: \"OpenCode\",\n20\t    model: \"Kimi\",\n21\t    outcome: \"fail\",\n22\t    score: 81,\n23\t    elapsedSeconds: 18,\n24\t    costUsd: 0.04,\n25\t  }),\n26\t  Object.freeze({\n27\t    id: \"opencode-a\",\n28\t    assistant: \"OpenCode\",\n29\t    model: \"Qwen\",\n30\t    outcome: \"pass\",\n31\t    score: 94,\n32\t    elapsedSeconds: 20,\n33\t    costUsd: 0.02,\n34\t  }),\n35\t]);\n36\t\n37\ttest(\"filters by assistant and outcome without mutating the input\", () => {\n38\t  const result = filterRuns(runs, { assistant: \"OpenCode\", outcome: \"pass\" });\n39\t\n40\t  assert.deepEqual(result.map((run) => run.id), [\"opencode-a\"]);\n41\t  assert.notEqual(result, runs);\n42\t  assert.deepEqual(runs.map((run) => run.id), [\"codex-a\", \"opencode-b\", \"opencode-a\"]);\n43\t});\n44\t\n45\ttest(\"sorts score ties by faster elapsed time and then run ID\", () => {\n46\t  const result = sortRuns(runs, \"score-desc\");\n47\t\n48\t  assert.deepEqual(result.map((run) => run.id), [\"opencode-a\", \"codex-a\", \"opencode-b\"]);\n49\t  assert.deepEqual(runs.map((run) => run.id), [\"codex-a\", \"opencode-b\", \"opencode-a\"]);\n50\t});\n51\t\n52\ttest(\"summarizes the visible runs\", () => {\n53\t  assert.deepEqual(summarizeRuns(runs), {\n54\t    visibleCount: 3,\n55\t    passRatePct: 66.7,\n56\t    medianElapsedSeconds: 20,\n57\t    totalCostUsd: 0.06,\n58\t    costedRunCount: 2,\n59\t  });\n60\t});\n61\t\n62\ttest(\"ships the required accessible, responsive interface hooks\", async () => {\n63\t  const [html, css] = await Promise.all([\n64\t    readFile(new URL(\"./index.html\", import.meta.url), \"utf8\"),\n65\t    readFile(new URL(\"./styles.css\", import.meta.url), \"utf8\"),\n66\t  ]);\n67\t\n68\t  for (const id of [\"assistant-filter\", \"outcome-filter\", \"sort-order\"]) {\n69\t    assert.match(html, new RegExp(`<label[^>]+for=[\"']${id}[\"']`, \"i\"));\n70\t    assert.match(html, new RegExp(`<select[^>]+id=[\"']${id}[\"']`, \"i\"));\n71\t  }\n72\t  assert.match(html, /<main\\b/i);\n73\t  assert.match(html, /aria-live=[\"']polite[\"']/i);\n74\t  assert.match(html, /id=[\"']reset-filters[\"']/i);\n75\t  assert.match(html, /id=[\"']results-list[\"']/i);\n76\t  assert.match(html, /id=[\"']empty-state[\"'][^>]+hidden/i);\n77\t  assert.match(css, /@media\\s*\\([^)]*max-width\\s*:/i);\n78\t  assert.match(css, /:focus-visible/i);\n79\t  assert.doesNotMatch(html, /style\\s*=/i);\n80\t});\n81\t"}]},"parent_tool_use_id":null,"session_id":"1020fe11-6e6c-4920-9e00-77795660475d","uuid":"a2ffb6e9-b912-4e4d-b2c6-c83550e4bfe2","timestamp":"2026-08-23T14:31:12.430Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-VewvEL/checkout/benchmark/fixtures/T4-run-explorer/run-explorer.test.mjs","content":"import assert from \"node:assert/strict\";\nimport { readFile } from \"node:fs/promises\";\nimport test from \"node:test\";\n\nimport { filterRuns, sortRuns, summarizeRuns } from \"./run-explorer.mjs\";\n\nconst runs = Object.freeze([\n  Object.freeze({\n    id: \"codex-a\",\n    assistant: \"Codex\",\n    model: \"Sol\",\n    outcome: \"pass\",\n    score: 94,\n    elapsedSeconds: 24,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"opencode-b\",\n    assistant: \"OpenCode\",\n    model: \"Kimi\",\n    outcome: \"fail\",\n    score: 81,\n    elapsedSeconds: 18,\n    costUsd: 0.04,\n  }),\n  Object.freeze({\n    id: \"opencode-a\",\n    assistant: \"OpenCode\",\n    model: \"Qwen\",\n    outcome: \"pass\",\n    score: 94,\n    elapsedSeconds: 20,\n    costUsd: 0.02,\n  }),\n]);\n\ntest(\"filters by assistant and outcome without mutating the input\", () => {\n  const result = filterRuns(runs, { assistant: \"OpenCode\", outcome: \"pass\" });\n\n  assert.deepEqual(result.map((run) => run.id), [\"opencode-a\"]);\n  assert.notEqual(result, runs);\n  assert.deepEqual(runs.map((run) => run.id), [\"codex-a\", \"opencode-b\", \"opencode-a\"]);\n});\n\ntest(\"sorts score ties by faster elapsed time and then run ID\", () => {\n  const result = sortRuns(runs, \"score-desc\");\n\n  assert.deepEqual(result.map((run) => run.id), [\"opencode-a\", \"codex-a\", \"opencode-b\"]);\n  assert.deepEqual(runs.map((run) => run.id), [\"codex-a\", \"opencode-b\", \"opencode-a\"]);\n});\n\ntest(\"summarizes the visible runs\", () => {\n  assert.deepEqual(summarizeRuns(runs), {\n    visibleCount: 3,\n    passRatePct: 66.7,\n    medianElapsedSeconds: 20,\n    totalCostUsd: 0.06,\n    costedRunCount: 2,\n  });\n});\n\ntest(\"ships the required accessible, responsive interface hooks\", async () => {\n  const [html, css] = await Promise.all([\n    readFile(new URL(\"./index.html\", import.meta.url), \"utf8\"),\n    readFile(new URL(\"./styles.css\", import.meta.url), \"utf8\"),\n  ]);\n\n  for (const id of [\"assistant-filter\", \"outcome-filter\", \"sort-order\"]) {\n    assert.match(html, new RegExp(`<label[^>]+for=[\"']${id}[\"']`, \"i\"));\n    assert.match(html, new RegExp(`<select[^>]+id=[\"']${id}[\"']`, \"i\"));\n  }\n  assert.match(html, /<main\\b/i);\n  assert.match(html, /aria-live=[\"']polite[\"']/i);\n  assert.match(html, /id=[\"']reset-filters[\"']/i);\n  assert.match(html, /id=[\"']results-list[\"']/i);\n  assert.match(html, /id=[\"']empty-state[\"'][^>]+hidden/i);\n  assert.match(css, /@media\\s*\\([^)]*max-width\\s*:/i);\n  assert.match(css, /:focus-visible/i);\n  assert.doesNotMatch(html, /style\\s*=/i);\n});\n","numLines":81,"startLine":1,"totalLines":81}}}
