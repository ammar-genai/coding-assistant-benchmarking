{"type":"user","message":{"role":"user","content":[{"tool_use_id":"functions.Write:9","type":"tool_result","content":"The file /private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-VewvEL/checkout/benchmark/fixtures/T4-run-explorer/student-tests.mjs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1020fe11-6e6c-4920-9e00-77795660475d","uuid":"19b936f3-063d-40f9-a6ab-db1205c5b23e","timestamp":"2026-08-23T14:31:50.449Z","tool_use_result":{"type":"update","filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-VewvEL/checkout/benchmark/fixtures/T4-run-explorer/student-tests.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { filterRuns, sortRuns, summarizeRuns } from \"./run-explorer.mjs\";\n\nconst mixedRuns = Object.freeze([\n  Object.freeze({\n    id: \"z-fast-null\",\n    assistant: \"Codex\",\n    model: \"Sol\",\n    outcome: \"pass\",\n    score: 50,\n    elapsedSeconds: 10,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"a-slow-null\",\n    assistant: \"Claude Code\",\n    model: \"Fable\",\n    outcome: \"fail\",\n    score: 50,\n    elapsedSeconds: 10,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"m-known-005\",\n    assistant: \"OpenCode\",\n    model: \"Kimi\",\n    outcome: \"pass\",\n    score: 99,\n    elapsedSeconds: 30,\n    costUsd: 0.05,\n  }),\n  Object.freeze({\n    id: \"m-known-015\",\n    assistant: \"OpenCode\",\n    model: \"Qwen\",\n    outcome: \"fail\",\n    score: 99,\n    elapsedSeconds: 20,\n    costUsd: 0.15,\n  }),\n]);\n\ntest(\"sortRuns cost-asc places known costs first, ties on score and id\", () => {\n  const result = sortRuns(mixedRuns, \"cost-asc\");\n  assert.deepEqual(result.map((run) => run.id), [\n    \"m-known-005\",\n    \"m-known-015\",\n    \"a-slow-null\",\n    \"z-fast-null\",\n  ]);\n  // Inputs must stay unchanged.\n  assert.deepEqual(mixedRuns.map((run) => run.id), [\n    \"z-fast-null\",\n    \"a-slow-null\",\n    \"m-known-005\",\n    \"m-known-015\",\n  ]);\n});\n\ntest(\"summarizeRuns handles empty arrays and even-length medians without mutation\", () => {\n  assert.deepEqual(summarizeRuns([]), {\n    visibleCount: 0,\n    passRatePct: 0,\n    medianElapsedSeconds: 0,\n    totalCostUsd: 0,\n    costedRunCount: 0,\n  });\n\n  const evenRuns = Object.freeze([\n    Object.freeze({\n      id: \"a\",\n      assistant: \"Codex\",\n      model: \"Sol\",\n      outcome: \"pass\",\n      score: 80,\n      elapsedSeconds: 10,\n      costUsd: 0.1,\n    }),\n    Object.freeze({\n      id: \"b\",\n      assistant: \"OpenCode\",\n      model: \"Kimi\",\n      outcome: \"fail\",\n      score: 70,\n      elapsedSeconds: 20,\n      costUsd: 0.2,\n    }),\n    Object.freeze({\n      id: \"c\",\n      assistant: \"Claude Code\",\n      model: \"Fable\",\n      outcome: \"pass\",\n      score: 90,\n      elapsedSeconds: 30,\n      costUsd: 0.3,\n    }),\n    Object.freeze({\n      id: \"d\",\n      assistant: \"Codex\",\n      model: \"Sol\",\n      outcome: \"fail\",\n      score: 60,\n      elapsedSeconds: 40,\n      costUsd: null,\n    }),\n  ]);\n\n  const summary = summarizeRuns(evenRuns);\n  assert.deepEqual(summary, {\n    visibleCount: 4,\n    passRatePct: 50.0,\n    medianElapsedSeconds: 25,\n    totalCostUsd: 0.6,\n    costedRunCount: 3,\n  });\n\n  // Verify the original array was not mutated.\n  assert.deepEqual(\n    evenRuns.map((run) => run.id),\n    [\"a\", \"b\", \"c\", \"d\"]\n  );\n});\n\ntest(\"filterRuns and sortRuns reject non-array inputs\", () => {\n  assert.throws(() => filterRuns(null, {}), TypeError);\n  assert.throws(() => filterRuns(undefined, {}), TypeError);\n  assert.throws(() => sortRuns(\"not-an-array\", \"score-desc\"), TypeError);\n  assert.throws(() => sortRuns([], \"unsupported-order\"), TypeError);\n});\n","structuredPatch":[