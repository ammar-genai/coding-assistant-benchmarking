filterRuns(runs, filters = {}) {\n  if (!isNonNullArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const { assistant = \"all\", outcome = \"all\" } = filters;\n\n  return runs.filter((run) => {\n    if (assistant !== \"all\" && run.assistant !== assistant) return false;\n    if (outcome !== \"all\" && run.outcome !== outcome) return false;\n    return true;\n  });\n}\n\n/**\n * Sort benchmark runs by the requested order.\n * @param {readonly Record<string, unknown>[]} runs\n * @param {string} order\n * @returns {Record<string, unknown>[]}\n */\nexport function sortRuns(runs, order) {\n  if (!isNonNullArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const sorted = [...runs];\n\n  switch (order) {\n    case \"score-desc\": {\n      sorted.sort((a, b) => {\n        if (b.score !== a.score) return b.score - a.score;\n        if (a.elapsedSeconds !== b.elapsedSeconds) {\n          return a.elapsedSeconds - b.elapsedSeconds;\n        }\n        return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;\n      });\n      break;\n    }\n    case \"time-asc\": {\n      sorted.sort((a, b) => {\n        if (a.elapsedSeconds !== b.elapsedSeconds) {\n          return a.elapsedSeconds - b.elapsedSeconds;\n        }\n        if (b.score !== a.score) return b.score - a.score;\n        return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;\n      });\n      break;\n    }\n    case \"cost-asc\": {\n      sorted.sort((a, b) => {\n        const aKnown = a.costUsd !== null && typeof a.costUsd === \"number\";\n        const bKnown = b.costUsd !== null && typeof b.costUsd === \"number\";\n        if (aKnown && !bKnown) return -1;\n        if (!aKnown && bKnown) return 1;\n        if (aKnown && bKnown && a.costUsd !== b.costUsd) {\n          return a.costUsd - b.costUsd;\n        }\n        if (b.score !== a.score) return b.score - a.score;\n        return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;\n      });\n      break;\n    }\n    default:\n      throw new TypeError(`Unsupported sort order: ${order}`);\n  }\n\n  return sorted;\n}\n\n/**\n * Summarize a subset of benchmark runs.\n * @param {readonly Record<string, unknown>[]} runs\n * @returns {{\n *   visibleCount: number,\n *   passRatePct: number,\n *   medianElapsedSeconds: number,\n *   totalCostUsd: number,\n *   costedRunCount: number,\n * }}\n */\nexport function summarizeRuns(runs) {\n  if (!isNonNullArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const visibleCount = runs.length;\n  if (visibleCount === 0) {\n    return {\n      visibleCount: 0,\n      passRatePct: 0,\n      medianElapsedSeconds: 0,\n      totalCostUsd: 0,\n      costedRunCount: 0,\n    };\n  }\n\n  const passCount = runs.filter((run) => run.outcome === \"pass\").length;\n  const passRatePct = Math.round((passCount / visibleCount) * 1000) / 10;\n\n  const sortedElapsed = runs\n    .map((run) => Number(run.elapsedSeconds))\n    .sort((a, b) => a - b);\n  const mid = Math.floor(sortedElapsed.length / 2);\n  const medianElapsedSeconds =\n    sortedElapsed.length % 2 === 1\n      ? sortedElapsed[mid]\n      : (sortedElapsed[mid - 1] + sortedElapsed[mid]) / 2;\n\n  let totalCents = 0;\n  let costedRunCount = 0;\n  for (const run of runs) {\n    if (run.costUsd !== null && typeof run.costUsd === \"number\") {\n      totalCents += Math.round(run.costUsd * 100);\n      costedRunCount += 1;\n    }\n  }\n  const totalCostUsd = totalCents / 100;\n\n  return {\n    visibleCount,\n    passRatePct,\n    medianElapsedSeconds,\n    totalCostUsd,\n    costedRunCount,\n  };\n}\n\n// Browser-only rendering and interaction code.\nif (typeof document !== \"undefined\") {\n  const assistantFilter = document.getElementById(\"assistant-filter\");\n  const outcomeFilter = document.getElementById(\"outcome-filter\");\n  const sortOrder = document.getElementById(\"sort-order\");\n  const resetButton = document.getElementById(\"reset-filters\");\n  const resultsList = document.getElementById(\"results-list\");\n  const emptyState = document.getElementById(\"empty-state\");\n  const statusRegion = document.getElementById(\"status-region\");\n\n  const visibleCountEl = document.getElementById(\"visible-count\");\n  const passRateEl = document.getElementById(\"pass-rate\");\n  const medianTimeEl = document.getElementById(\"median-time\");\n  const knownCostEl = document.getElementById(\"known-cost\");\n\n  function render() {\n    const filters = {\n      assistant: assistantFilter.value,\n      outcome: outcomeFilter.value,\n    };\n    const order = sortOrder.value;\n\n    const filtered = filterRuns(sampleRuns, filters);\n    const sorted = sortRuns(filtered, order);\n    const summary = summarizeRuns(sorted);\n\n    visibleCountEl.textContent = String(summary.visibleCount);\n    passRateEl.textContent = `${summary.passRatePct.toFixed(1)}%`;\n    medianTimeEl.textContent = `${summary.medianElapsedSeconds.toFixed(1)} s`;\n    knownCostEl.textContent = `$${summary.totalCostUsd.toFixed(2)} (${summary.costedRunCount})`;\n\n    resultsList.replaceChildren();\n    if (sorted.length === 0) {\n      emptyState.hidden = false;\n    } else {\n      emptyState.hidden = true;\n      const fragment = document.createDocumentFragment();\n      for (const run of sorted) {\n        fragment.appendChild(createRunCard(run));\n      }\n      resultsList.appendChild(fragment);\n    }\n\n    statusRegion.textContent = `Showing ${summary.visibleCount} run${summary.visibleCount === 1 ? \"\" : \"s\"}`;\n  }\n\n  /**\n   * @param {Record<string, unknown>} run\n   * @returns {HTMLElement}\n   */\n  function createRunCard(run) {\n    const article = document.createElement(\"article\");\n    article.className = \"run-card\";\n    if (run.outcome === \"pass\") {\n      article.classList.add(\"run-pass\");\n    } else if (run.outcome === \"fail\") {\n      article.classList.add(\"run-fail\");\n    }\n\n    const header = document.createElement(\"div\");\n    header.className = \"run-header\";\n\n    const identity = document.createElement(\"div\");\n    identity.className = \"run-identity\";\n\n    const assistant = document.createElement(\"strong\");\n    assistant.className = \"run-assistant\";\n    assistant.textContent = String(run.assistant);\n\n    const model = document.createElement(\"span\");\n    model.className = \"run-model\";\n    model.textContent = String(run.model);\n\n    identity.appendChild(assistant);\n    identity.appendChild(model);\n\n    const outcome = document.createElement(\"span\");\n    outcome.className = \"run-outcome\";\n    outcome.textContent = String(run.outcome);\n    outcome.setAttribute(\"aria-label\", `Outcome: ${run.outcome}`);\n\n    header.appendChild(identity);\n    header.appendChild(outcome);\n\n    const metrics = document.createElement(\"dl\");\n    metrics.className = \"run-metrics\";\n\n    const scoreTerm = document.createElement(\"dt\");\n    scoreTerm.textContent = \"Score\";\n    const scoreDef = document.createElement(\"dd\");\n    scoreDef.textContent = String(run.score);\n\n    const timeTerm = document.createElement(\"dt\");\n    timeTerm.textContent = \"Time\";\n    const timeDef = document.createElement(\"dd\");\n    timeDef.textContent = `${Number(run.elapsedSeconds).toFixed(1)} s`;\n\n    const costTerm = document.createElement(\"dt\");\n    costTerm.textContent = \"Cost\";\n    const costDef = document.createElement(\"dd\");\n    costDef.textContent =\n      run.costUsd !== null && typeof run.costUsd === \"number\"\n        ? `$${Number(run.costUsd).toFixed(2)}`\n        : \"Subscription\";\n\n    metrics.appendChild(scoreTerm);\n    metrics.appendChild(scoreDef);\n    metrics.appendChild(timeTerm);\n    metrics.appendChild(timeDef);\n    metrics.appendChild(costTerm);\n    metrics.appendChild(costDef);\n\n    article.appendChild(header);\n    article.appendChild(metrics);\n    return article;\n  }\n\n  function reset() {\n    assistantFilter.value = \"all\";\n    outcomeFilter.value = \"all\";\n    sortOrder.value = \"score-desc\";\n    render();\n  }\n\n  assistantFilter.addEventListener(\"change\", render);\n  outcomeFilter.addEventListener(\"change\", render);\n  sortOrder.addEventListener(\"change\", render);\n  resetButton.addEventListener(\"click\", reset);\n\n  render();\n}\n"}}],"usage":{"input_tokens":8085,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1020fe11-6e6c-4920-9e00-77795660475d","uuid":"c1b31125-4c0f-4655-b4b4-9bddd08bafec","timestamp":"2026-08-23T14:31:50.420Z"}
{"type":"assistant","message":{"id":"msg_de83003a989aea233d999be0","type":"message","role":"assistant","model":"kimi-k2.7-code","content":[{"type":"tool_use","id":"functions.Write:7","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-VewvEL/checkout/benchmark/fixtures/T4-run-explorer/index.html","content":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Benchmark run explorer</title>\n    <link rel=\"stylesheet\" href=\"./styles.css\" />\n    <script type=\"module\" src=\"./run-explorer.mjs\"></script>\n  </head>\n  <body>\n    <main>\n      <header class=\"intro\">\n        <p class=\"eyebrow\">Benchmark evidence</p>\n        <h1>Run explorer</h1>\n        <p>\n          The records below are sample benchmark runs used to preview the\n          comparison interface. They are not final study results.\n        </p>\n      </header>\n\n      <section class=\"controls\" aria-labelledby=\"controls-heading\">\n        <h2 id=\"controls-heading\" class=\"visually-hidden\">Filter and sort runs</h2>\n\n        <div class=\"control\">\n          <label for=\"assistant-filter\">Assistant</label>\n          <select id=\"assistant-filter\">\n            <option value=\"all\">All assistants</option>\n            <option value=\"Codex\">Codex</option>\n            <option value=\"Claude Code\">Claude Code</option>\n            <option value=\"OpenCode\">OpenCode</option>\n          </select>\n        </div>\n\n        <div class=\"control\">\n          <label for=\"outcome-filter\">Outcome</label>\n          <select id=\"outcome-filter\">\n            <option value=\"all\">All outcomes</option>\n            <option value=\"pass\">Pass</option>\n            <option value=\"fail\">Fail</option>\n          </select>\n        </div>\n\n        <div class=\"control\">\n          <label for=\"sort-order\">Sort by</label>\n          <select id=\"sort-order\">\n            <option value=\"score-desc\">Score (high to low)</option>\n            <option value=\"time-asc\">Time (fastest)</option>\n            <option value=\"cost-asc\">Cost (known first)</option>\n          </select>\n        </div>\n\n        <button type=\"button\" id=\"reset-filters\">Reset filters</button>\n      </section>\n\n      <section class=\"summary\" aria-labelledby=\"summary-heading\">\n        <h2 id=\"summary-heading\" class=\"visually-hidden\">Summary</h2>\n        <div class=\"summary-grid\">\n          <div class=\"summary-item\">\n            <span id=\"visible-count\">0</span>\n            <span class=\"summary-label\">Visible runs</span>\n          </div>\n          <div class=\"summary-item\">\n            <span id=\"pass-rate\">0%</span>\n            <span class=\"summary-label\">Pass rate</span>\n          </div>\n          <div class=\"summary-item\">\n            <span id=\"median-time\">0.0 s</span>\n            <span class=\"summary-label\">Median time</span>\n          </div>\n          <div class=\"summary-item\">\n            <span id=\"known-cost\">$0.00 (0)</span>\n            <span class=\"summary-label\">\n              Known cost\n              <small>(subscription costs excluded)</small>\n            </span>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"results\" aria-labelledby=\"results-heading\">\n        <h2 id=\"results-heading\" class=\"visually-hidden\">Run records</h2>\n\n        <p id=\"status-region\" class=\"status\" aria-live=\"polite\"></p>\n\n        <div id=\"empty-state\" class=\"empty-state\" hidden>\n          <p>No runs match the current filters.</p>\n        </div>\n\n        <div id=\"results-list\" class=\"results-list\"></div>\n      </section>\n    </main>\n  </body>\n</html>\n"}}],"usage":{"input_tokens":8085,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1020fe11-6