[\n    { id: \"x\", desk: \"ABS\", requested: 5, priority: 1, submittedAt: \"2026-08-23T10:00:00Z\" },\n    { id: \"x\", desk: \"ABS\", requested: 5, priority: 2, submittedAt: \"2026-08-23T10:01:00Z\" },\n  ];\n  const capacity = { ABS: 10 };\n  const snapshot = structuredClone(duplicate);\n\n  assert.throws(() => allocateCapacity(duplicate, capacity), TypeError);\n  assert.throws(\n    () =>\n      allocateCapacity(\n        [{ id: \"\", desk: \"ABS\", requested: 5, priority: 1, submittedAt: \"2026-08-23T10:00:00Z\" }],\n        capacity,\n      ),\n    TypeError,\n  );\n  assert.deepEqual(duplicate, snapshot);\n  assert.deepEqual(capacity, { ABS: 10 });\n});\n\ntest(\"rejects invalid requested amounts, priorities, and missing desk capacity\", () => {\n  const base = { id: \"a\", desk: \"ABS\", priority: 1, submittedAt: \"2026-08-23T10:00:00Z\" };\n\n  assert.throws(() => allocateCapacity([{ ...base, requested: 0 }], { ABS: 10 }), TypeError);\n  assert.throws(() => allocateCapacity([{ ...base, requested: Infinity }], { ABS: 10 }), TypeError);\n  assert.throws(\n    () => allocateCapacity([{ ...base, requested: 5, priority: 1.5 }], { ABS: 10 }),\n    TypeError,\n  );\n  assert.throws(() => allocateCapacity([{ ...base, requested: 5 }], {}), TypeError);\n  assert.throws(() => allocateCapacity([{ ...base, requested: 5 }], { ABS: -1 }), TypeError);\n});\n"}}}}
