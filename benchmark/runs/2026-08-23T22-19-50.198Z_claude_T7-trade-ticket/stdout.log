{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M3EgXo7srCtGY2zPGFvyiA","type":"tool_result","content":"1\texport type ProductType =\n2\t  | \"agency-rmbs\"\n3\t  | \"non-agency-rmbs\"\n4\t  | \"cmbs\"\n5\t  | \"abs\"\n6\t  | \"clo\"\n7\t  | \"tba-mbs\";\n8\t\n9\texport type TradeStatus = \"draft\" | \"validated\" | \"booked\" | \"cancelled\";\n10\texport type Side = \"buy\" | \"sell\";\n11\texport type TradeModifier =\n12\t  | \"regular\"\n13\t  | \"specified-pool\"\n14\t  | \"stipulation\"\n15\t  | \"dollar-roll\"\n16\t  | \"weighted-average-price\";\n17\texport type ExceptionSeverity = \"error\" | \"warning\";\n18\texport type AuditAction =\n19\t  | \"created\"\n20\t  | \"updated\"\n21\t  | \"draft-saved\"\n22\t  | \"validated\"\n23\t  | \"booked\"\n24\t  | \"cancelled\";\n25\t\n26\texport const EXCEPTION_CODES = [\n27\t  \"required-security-id\",\n28\t  \"required-counterparty\",\n29\t  \"required-book\",\n30\t  \"required-trader\",\n31\t  \"required-agency\",\n32\t  \"required-pool\",\n33\t  \"invalid-original-face\",\n34\t  \"invalid-factor\",\n35\t  \"invalid-price\",\n36\t  \"settlement-before-trade\",\n37\t  \"invalid-security-id\",\n38\t  \"invalid-modifier-for-product\",\n39\t  \"allocation-mismatch\",\n40\t  \"missing-client-trade-id\",\n41\t] as const;\n42\t\n43\texport type ExceptionCode = (typeof EXCEPTION_CODES)[number];\n44\t\n45\texport interface AllocationInput {\n46\t  id: string;\n47\t  label: string;\n48\t  currentFace: number | null;\n49\t}\n50\t\n51\texport interface Allocation {\n52\t  id: string;\n53\t  label: string;\n54\t  currentFace: number;\n55\t}\n56\t\n57\texport interface AuditEvent {\n58\t  id: string;\n59\t  at: string;\n60\t  action: AuditAction;\n61\t  detail: string;\n62\t}\n63\t\n64\texport interface TradeEconomics {\n65\t  currentFace: number;\n66\t  grossPrincipal: number;\n67\t  signedExposure: number;\n68\t}\n69\t\n70\texport interface TradeDraft {\n71\t  internalTradeId: string | null;\n72\t  cl