    \"app/trade-capture/components/trade-review.tsx\",\n\n  Line 13:     \"app/trade-capture/state/reducer.ts\",\n\n  Line 14:     \"app/trade-capture/state/selectors.ts\",\n\n  Line 15:     \"app/trade-capture/trade-capture.css\"\n","metadata":{"matches":75,"truncated":false},"title":"trade-capture","time":{"start":1787530990164,"end":1787530990201}},"id":"prt_03126524e001TdRLzMTFqZEnpm","sessionID":"ses_fceda74b8ffec0f01p0fDyvTkH","messageID":"msg_03126339c0010dQ86V1jYnEvJL"}}
