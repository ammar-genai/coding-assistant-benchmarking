diff --git a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
index 3fe2216..227b5b0 100644
--- a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
+++ b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
@@ -1,10 +1,87 @@
 /**
  * Build one comparison summary per assistant from raw benchmark run records.
  */
+function isEligible(run) {
+  return (
+    run.status === "complete" &&
+    run.acceptance_status === "pass" &&
+    run.comparison_eligible !== false
+  );
+}
+
+function validate(run) {
+  if (
+    typeof run.run_id !== "string" ||
+    run.run_id.length === 0 ||
+    typeof run.assistant !== "string" ||
+    run.assistant.length === 0
+  ) {
+    throw new TypeError("run_id and assistant must be non-empty strings");
+  }
+  if (
+    typeof run.score !== "number" ||
+    !Number.isFinite(run.score) ||
+    run.score < 0 ||
+    run.score > 100
+  ) {
+    throw new TypeError("score must be a finite number from 0 through 100");
+  }
+  if (
+    typeof run.elapsed_ms !== "number" ||
+    !Number.isFinite(run.elapsed_ms) ||
+    run.elapsed_ms < 0
+  ) {
+    throw new TypeError("elapsed_ms must be a finite number >= 0");
+  }
+}
+
+function median(sorted) {
+  const n = sorted.length;
+  if (n % 2 === 1) {
+    return sorted[(n - 1) / 2];
+  }
+  return (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
+}
+
 export function summarizeAssistants(runs) {
   if (!Array.isArray(runs)) {
     throw new TypeError("runs must be an array");
   }
 
-  return [];
+  const eligible = runs.filter(isEligible);
+  eligible.forEach(validate);
+
+  const byAssistant = new Map();
+  for (const run of eligible) {
+    const group = byAssistant.get(run.assistant) ?? [];
+    group.push(run);
+    byAssistant.set(run.assistant, group);
+  }
+
+  const summaries = [];
+  for (const [assistant, group] of byAssistant) {
+    const best = group.reduce((a, b) => {
+      if (b.score !== a.score) {
+        return b.score > a.score ? b : a;
+      }
+      if (b.elapsed_ms !== a.elapsed_ms) {
+        return b.elapsed_ms < a.elapsed_ms ? b : a;
+      }
+      return b.run_id < a.run_id ? b : a;
+    });
+
+    const times = group.map((run) => run.elapsed_ms).sort((a, b) => a - b);
+
+    summaries.push({
+      assistant,
+      run_count: group.length,
+      best_score: best.score,
+      best_run_id: best.run_id,
+      median_elapsed_ms: median(times),
+    });
+  }
+
+  summaries.sort((a, b) => (a.assistant < b.assistant ? -1 : a.assistant > b.assistant ? 1 : 0));
+
+  return summaries;
 }
