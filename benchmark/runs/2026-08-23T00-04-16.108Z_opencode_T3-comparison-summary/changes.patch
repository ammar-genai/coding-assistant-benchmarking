+
+test("renders median in seconds with exactly three decimal places", () => {
+  const summaries = [
+    {
+      assistant: "Alpha",
+      run_count: 2,
+      best_score: 95,
+      best_run_id: "run-1",
+      median_elapsed_ms: 1_250,
+    },
+    {
+      assistant: "Beta",
+      run_count: 1,
+      best_score: 88.25,
+      best_run_id: "run|2",
+      median_elapsed_ms: 1_000,
