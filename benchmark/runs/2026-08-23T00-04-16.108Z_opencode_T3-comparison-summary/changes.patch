+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { renderComparisonTable } from "./render-comparison-table.mjs";
+import { summarizeAssistants } from "./summarize-assistants.mjs";
+
+test("throws TypeError when runs is not an array", () => {
+  assert.throws(() => summarizeAssistants(null), TypeError);
+  assert.throws(() => summarizeAssistants({}), TypeError);
+  assert.throws(() => summarizeAssistants("runs"), TypeError);
+});
+
+test("throws TypeError for invalid eligible run fields", () => {
+  const missingRunId = {
+    assistant: "A",
+    status: "complete",
+    acceptance_status: "pass",
+    score: 50,
+    elapsed_ms: 100,
+  };
+  assert.throws(() => summarizeAssistants([missingRunId]), TypeError);
+
+  const badScore = {
+    run_id: "r1",
+    assistant: "A",
+    status: "complete",
+    acceptance_status: "pass",
+    score: 150,
+    elapsed_ms: 100,
+  };
+  assert.throws(() => summarizeAssistants([badScore]), TypeError);
+
+  const negativeElapsed = {
+    run_id: "r1",
+    assistant: "A",
+    status: "complete",
+    acceptance_status: "pass",
+    score: 50,
+    elapsed_ms: -1,
+  };
+  assert.throws(() => summarizeAssistants([negativeElapsed]), TypeError);
+
+  const nanScore = {
+    run_id: "r1",
+    assistant: "A",
+    status: "complete",
+    acceptance_status: "pass",
+    score: Number.NaN,
+    elapsed_ms: 100,
+  };
+  assert.throws(() => summarizeAssistants([nanScore]), TypeError);
+});
+
+test("does not validate fields on ineligible runs", () => {
+  const ineligible = {
+    status: "failed",
+    acceptance_status: "fail",
+    run_id: "",
+    assistant: "",
+    score: 999,
+    elapsed_ms: -5,
+  };
+  assert.deepEqual(summarizeAssistants([ineligible]), []);
+});
+
+test("computes median across all eligible runs and does not mutate input", () => {
+  const runs = Object.freeze([
+    Object.freeze({
+      run_id: "c",
+      assistant: "Gamma",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 70,
+      elapsed_ms: 3_000,
+    }),
+    Object.freeze({
+      run_id: "a",
+      assistant: "Alpha",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 80,
+      elapsed_ms: 1_000,
+    }),
+    Object.freeze({
+      run_id: "b",
+      assistant: "Alpha",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 80,
+      elapsed_ms: 1_200,
+    }),
+    Object.freeze({
+      run_id: "d",
+      assistant: "Alpha",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 60,
+      elapsed_ms: 2_000,
+    }),
+  ]);
+
+  const result = summarizeAssistants(runs);
+
+  assert.deepEqual(
+    result.map((s) => s.assistant),
+    ["Alpha", "Gamma"],
+  );
+
+  const alpha = result[0];
+  assert.equal(alpha.run_count, 3);
+  assert.equal(alpha.best_score, 80);
+  assert.equal(alpha.best_run_id, "a");
+  assert.equal(alpha.median_elapsed_ms, 1_200);
+
+  assert.equal(runs.length, 4);
+});
+
+test("throws TypeError when a summary lacks required output fields", () => {
+  assert.throws(() => renderComparisonTable(null), TypeError);
+  assert.throws(() => renderComparisonTable([{ assistant: "A" }]), TypeError);
+  assert.throws(
+    () =>
+      renderComparisonTable([
+        {
+          assistant: "A",
+          run_count: 1,
+          best_score: 50,
+          best_run_id: "r",
+          median_elapsed_ms: Number.NaN,
