diff --git a/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs b/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
index 40fbc04..5702687 100644
--- a/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
+++ b/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
@@ -1,10 +1,46 @@
 /**
  * Render assistant summaries as a stable Markdown table.
  */
+function isSummary(summary) {
+  return (
+    summary !== null &&
+    typeof summary === "object" &&
+    typeof summary.assistant === "string" &&
+    typeof summary.run_count === "number" &&
+    Number.isFinite(summary.run_count) &&
+    typeof summary.best_score === "number" &&
+    Number.isFinite(summary.best_score) &&
+    typeof summary.best_run_id === "string" &&
+    typeof summary.median_elapsed_ms === "number" &&
+    Number.isFinite(summary.median_elapsed_ms)
+  );
+}
+
+function escape(value) {
+  return String(value).replaceAll("|", "\\|");
+}
+
 export function renderComparisonTable(summaries) {
   if (!Array.isArray(summaries)) {
     throw new TypeError("summaries must be an array");
   }
+  if (!summaries.every(isSummary)) {
+    throw new TypeError("each summary must have the required output fields and value types");
+  }
+
+  const header = [
+    "| Assistant | Runs | Best score | Best run | Median time |",
+    "|---|---:|---:|---|---:|",
+  ];
+
+  if (summaries.length === 0) {
+    return [...header, "", "_No eligible runs._"].join("\n");
+  }
+
+  const rows = summaries.map(
+    (s) =>
+      `| ${escape(s.assistant)} | ${s.run_count} | ${s.best_score} | ${escape(s.best_run_id)} | ${(s.median_elapsed_ms / 1000).toFixed(3)} s |`,
+  );
 
-  return "";
+  return [...header, ...rows].join("\n");
 }
