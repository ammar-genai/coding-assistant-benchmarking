{"type":"tool_use","timestamp":1787443470544,"sessionID":"ses_fd41153a5ffelEronWM5wISfOh","part":{"type":"tool","tool":"write","callID":"call_9526kotj","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-ZVdwCT/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","content":"/**\n * Build one comparison summary per assistant from raw benchmark run records.\n */\nfunction isEligible(run) {\n  return (\n    run.status === \"complete\" &&\n    run.acceptance_status === \"pass\" &&\n    run.comparison_eligible !== false\n  );\n}\n\nfunction validate(run) {\n  if (\n    typeof run.run_id !== \"string\" ||\n    run.run_id.length === 0 ||\n    typeof run.assistant !== \"string\" ||\n    run.assistant.length === 0\n  ) {\n    throw new TypeError(\"run_id and assistant must be non-empty strings\");\n  }\n  if (\n    typeof run.score !== \"number\" ||\n    !Number.isFinite(run.score) ||\n    run.score < 0 ||\n    run.score > 100\n  ) {\n    throw new TypeError(\"score must be a finite number from 0 through 100\");\n  }\n  if (\n    typeof run.elapsed_ms !== \"number\" ||\n    !Number.isFinite(run.elapsed_ms) ||\n    run.elapsed_ms < 0\n  ) {\n    throw new TypeError(\"elapsed_ms must be a finite number >= 0\");\n  }\n}\n\nfunction median(sorted) {\n  const n = sorted.length;\n  if (n % 2 === 1) {\n    return sorted[(n - 1) / 2];\n  }\n  return (sorted[n / 2 - 1] + sorted[n / 2]) / 2;\n}\n\nexport function summarizeAssistants(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const eligible = runs.filter(isEligible);\n  eligible.forEach(validate);\n\n  const byAssistant = new Map();\n  for (const run of eligible) {\n    const group = byAssistant.get(run.assistant) ?? [];\n    group.push(run);\n    byAssistant.set(run.assistant, group);\n  }\n\n  const summaries = [];\n  for (const [assistant, group] of byAssistant) {\n    const best = group.reduce((a, b) => {\n      if (b.score !== a.score) {\n        return b.score > a.score ? b : a;\n      }\n      if (b.elapsed_ms !== a.elapsed_ms) {\n        return b.elapsed_ms < a.elapsed_ms ? b : a;\n      }\n      return b.run_id < a.run_id ? b : a;\n    });\n\n    const times = group.map((run) => run.elapsed_ms).sort((a, b) => a - b);\n\n    summaries.push({\n      assistant,\n      run_count: group.length,\n      best_score: best.score,\n      best_run_id: best.run_id,\n      median_elapsed_ms: median(times),\n    });\n  }\n\n  summaries.sort((a, b) => (a.assistant < b.assistant ? -1 : a.assistant > b.assistant ? 1 : 0));\n\n  return summaries;\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-ZVdwCT/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","time":{"start":1787443470532,"end":1787443470542}},"id":"prt_02beee0bc0010D32KF5C5ZRdUv","sessionID":"ses_fd41153a5ffelEronWM5wISfOh","messageID":"msg_02beed6bc0010YWrdRkjqnm0Bd"}}
