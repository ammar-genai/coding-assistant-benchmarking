{"type":"tool_use","timestamp":1787443476550,"sessionID":"ses_fd41153a5ffelEronWM5wISfOh","part":{"type":"tool","tool":"write","callID":"call_75be33xb","state":{"status":"completed","input":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"throws TypeError when runs is not an array\", () => {\n  assert.throws(() => summarizeAssistants(null), TypeError);\n  assert.throws(() => summarizeAssistants({}), TypeError);\n  assert.throws(() => summarizeAssistants(\"runs\"), TypeError);\n});\n\ntest(\"throws TypeError for invalid eligible run fields\", () => {\n  const missingRunId = {\n    assistant: \"A\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    score: 50,\n    elapsed_ms: 100,\n  };\n  assert.throws(() => summarizeAssistants([missingRunId]), TypeError);\n\n  const badScore = {\n    run_id: \"r1\",\n    assistant: \"A\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    score: 150,\n    elapsed_ms: 100,\n  };\n  assert.throws(() => summarizeAssistants([badScore]), TypeError);\n\n  const negativeElapsed = {\n    run_id: \"r1\",\n    assistant: \"A\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    score: 50,\n    elapsed_ms: -1,\n  };\n  assert.throws(() => summarizeAssistants([negativeElapsed]), TypeError);\n\n  const nanScore = {\n    run_id: \"r1\",\n    assistant: \"A\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    score: Number.NaN,\n    elapsed_ms: 100,\n  };\n  assert.throws(() => summarizeAssistants([nanScore]), TypeError);\n});\n\ntest(\"does not validate fields on ineligible runs\", () => {\n  const ineligible = {\n    status: \"failed\",\n    acceptance_status: \"fail\",\n    run_id: \"\",\n    assistant: \"\",\n    score: 999,\n    elapsed_ms: -5,\n  };\n  assert.deepEqual(summarizeAssistants([ineligible]), []);\n});\n\ntest(\"computes median across all eligible runs and does not mutate input\", () => {\n  const runs = Object.freeze([\n    Object.freeze({\n      run_id: \"c\",\n      assistant: \"Gamma\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 70,\n      elapsed_ms: 3_000,\n    }),\n    Object.freeze({\n      run_id: \"a\",\n      assistant: \"Alpha\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 1_000,\n    }),\n    Object.freeze({\n      run_id: \"b\",\n      assistant: \"Alpha\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 1_200,\n    }),\n    Object.freeze({\n      run_id: \"d\",\n      assistant: \"Alpha\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 60,\n      elapsed_ms: 2_000,\n    }),\n  ]);\n\n  const result = summarizeAssistants(runs);\n\n  assert.deepEqual(\n    result.map((s) => s.assistant),\n    [\"Alpha\", \"Gamma\"],\n  );\n\n  const alpha = result[0];\n  assert.equal(alpha.run_count, 3);\n  assert.equal(alpha.best_score, 80);\n  assert.equal(alpha.best_run_id, \"b\");\n  assert.equal(alpha.median_elapsed_ms, 1_200);\n\n  assert.equal(runs.length, 4);\n});\n\ntest(\"throws TypeError when a summary lacks required output fields\", () => {\n  assert.throws(() => renderComparisonTable(null), TypeError);\n  assert.throws(() => renderComparisonTable([{ assistant: \"A\" }]), TypeError);\n  assert.throws(\n    () =>\n      renderComparisonTable([\n        {\n          assistant: \"A\",\n          run_count: 1,\n          best_score: 50,\n          best_run_id: \"r\",\n          median_elapsed_ms: Number.NaN,\n        },\n      ]),\n    TypeError,\n  );\n});\n\ntest(\"renders median in seconds with exactly three decimal places\", () => {\n  const summaries = [\n    {\n      assistant: \"Alpha\",\n      run_count: 2,\n      best_score: 95,\n      best_run_id: \"run-1\",\n      median_elapsed_ms: 1_250,\n    },\n    {\n      assistant: \"Beta\",\n      run_count: 1,\n      best_score: 88.25,\n      best_run_id: \"run|2\",\n      median_elapsed_ms: 1_000,\n    },\n  ];\n\n  const output = renderComparisonTable(summaries);\n  assert.match(output, /\\| 1\\.250 s \\|/);\n  assert.match(output, /\\| 1\\.000 s \\|/);\n  assert.match(output, /\\| run\\\\\\|2 \\|/);\n  assert.ok(output.indexOf(\"| Assistant | Runs | Best score | Best run | Median time |\") === 0);\n});\n","filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-ZVdwCT/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-ZVdwCT/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/student-tests.mjs","time":{"start":1787443476541,"end":1787443476548}},"id":"prt_02beef838001I8OESvog6kpitQ","sessionID":"ses_fd41153a5ffelEronWM5wISfOh","messageID":"msg_02beee8f4001bgw6egfBzrgXsU"}}
