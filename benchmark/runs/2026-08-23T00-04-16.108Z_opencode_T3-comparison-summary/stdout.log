{"type":"tool_use","timestamp":1787443472391,"sessionID":"ses_fd41153a5ffelEronWM5wISfOh","part":{"type":"tool","tool":"write","callID":"call_rrshwem8","state":{"status":"completed","input":{"content":"/**\n * Render assistant summaries as a stable Markdown table.\n */\nfunction isSummary(summary) {\n  return (\n    summary !== null &&\n    typeof summary === \"object\" &&\n    typeof summary.assistant === \"string\" &&\n    typeof summary.run_count === \"number\" &&\n    Number.isFinite(summary.run_count) &&\n    typeof summary.best_score === \"number\" &&\n    Number.isFinite(summary.best_score) &&\n    typeof summary.best_run_id === \"string\" &&\n    typeof summary.median_elapsed_ms === \"number\" &&\n    Number.isFinite(summary.median_elapsed_ms)\n  );\n}\n\nfunction escape(value) {\n  return String(value).replaceAll(\"|\", \"\\\\|\");\n}\n\nexport function renderComparisonTable(summaries) {\n  if (!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n  if (!summaries.every(isSummary)) {\n    throw new TypeError(\"each summary must have the required output fields and value types\");\n  }\n\n  const header = [\n    \"| Assistant | Runs | Best score | Best run | Median time |\",\n    \"|---|---:|---:|---|---:|\",\n  ];\n\n  if (summaries.length === 0) {\n    return [...header, \"\", \"_No eligible runs._\"].join(\"\\n\");\n  }\n\n  const rows = summaries.map(\n    (s) =>\n      `| ${escape(s.assistant)} | ${s.run_count} | ${s.best_score} | ${escape(s.best_run_id)} | ${(s.median_elapsed_ms / 1000).toFixed(3)} s |`,\n  );\n\n  return [...header, ...rows].join(\"\\n\");\n}\n","filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-ZVdwCT/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-ZVdwCT/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","time":{"start":1787443472381,"end":1787443472388}},"id":"prt_02beee7f60012d7zGUyw4pN6Ke","sessionID":"ses_fd41153a5ffelEronWM5wISfOh","messageID":"msg_02beee155001xHB4tyneZPGLjt"}}
