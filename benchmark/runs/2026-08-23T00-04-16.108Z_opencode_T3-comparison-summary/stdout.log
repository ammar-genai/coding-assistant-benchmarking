nt: \"Codex\",\n45:       status: \"complete\",\n46:       acceptance_status: \"pass\",\n47:       comparison_eligible: false,\n48:       score: 100,\n49:       elapsed_ms: 10,\n50:     }),\n51:   ]);\n52: \n53:   assert.deepEqual(summarizeAssistants(runs), [\n54:     {\n55:       assistant: \"Claude Code\",\n56:       run_count: 1,\n57:       best_score: 96,\n58:       best_run_id: \"claude-best\",\n59:       median_elapsed_ms: 1_250,\n60:     },\n61:     {\n62:       assistant: \"Codex\",\n63:       run_count: 2,\n64:       best_score: 95,\n65:       best_run_id: \"codex-best\",\n66:       median_elapsed_ms: 1_500,\n67:     },\n68:   ]);\n69: });\n70: \n71: test(\"breaks a best-score tie with elapsed time\", () => {\n72:   const runs = [\n73:     {\n74:       run_id: \"slower\",\n75:       assistant: \"OpenCode\",\n76:       status: \"complete\",\n77:       acceptance_status: \"pass\",\n78:       score: 94,\n79:       elapsed_ms: 1_100,\n80:     },\n81:     {\n82:       run_id: \"faster\",\n83:       assistant: \"OpenCode\",\n84:       status: \"complete\",\n85:       acceptance_status: \"pass\",\n86:       score: 94,\n87:       elapsed_ms: 900,\n88:     },\n89:   ];\n90: \n91:   assert.equal(summarizeAssistants(runs)[0].best_run_id, \"faster\");\n92: });\n93: \n94: test(\"renders the exact Markdown table format\", () => {\n95:   const summaries = [\n96:     {\n97:       assistant: \"Open|Code\",\n98:       run_count: 2,\n99:       best_score: 95.5,\n100:       best_run_id: \"run|2\",\n101:       median_elapsed_ms: 1_250,\n102:     },\n103:   ];\n104: \n105:   assert.equal(\n106:     renderComparisonTable(summaries),\n107:     [\n108:       \"| Assistant | Runs | Best score | Best run | Median time |\",\n109:       \"|---|---:|---:|---|---:|\",\n110:       \"| Open\\\\|Code | 2 | 95.5 | run\\\\|2 | 1.250 s |\",\n111:     ].join(\"\\n\"),\n112:   );\n113: });\n114: \n115: test(\"renders an explicit empty state below the table header\", () => {\n116:   assert.equal(\n117:     renderComparisonTable([]),\n118:     [\n119:       \"| Assistant | Runs | Best score | Best run | Median time |\",\n120:       \"|---|---:|---:|---|---:|\",\n121:       \"\",\n122:       \"_No eligible runs._\",\n123:     ].join(\"\\n\"),\n124:   );\n125: });\n\n(End of file - total 125 lines)\n</content>","metadata":{"preview":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"summarizes eligible runs by assistant in stable order\", () => {\n  const runs = Object.freeze([\n    Object.freeze({\n      run_id: \"codex-slow\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 91,\n      elapsed_ms: 2_000,\n    }),\n    Object.freeze({\n      run_id: \"claude-best\",\n      assistant: \"Claude Code\",\n      status: \"complete\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-ZVdwCT/checkout/benchmark/fixtures/T3-comparison-summary/comparison-summary.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"summarizes eligible runs by assistant in stable order\", () => {\n  const runs = Object.freeze([\n    Object.freeze({\n      run_id: \"codex-slow\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 91,\n      elapsed_ms: 2_000,\n    }),\n    Object.freeze({\n      run_id: \"claude-best\",\n      assistant: \"Claude Code\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 96,\n      elapsed_ms: 1_250,\n      comparison_eligible: true,\n    }),\n    Object.freeze({\n      run_id: \"codex-best\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 95,\n      elapsed_ms: 1_000,\n    }),\n    Object.freeze({\n      run_id: \"failed-run\",\n      assistant: \"Claude Code\",\n      status: \"complete\",\n      acceptance_status: \"fail\",\n      score: 100,\n      elapsed_ms: 10,\n    }),\n    Object.freeze({\n      run_id: \"excluded-run\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      comparison_eligible: false,\n      score: 100,\n      elapsed_ms: 10,\n    }),\n  ]);\n\n  assert.deepEqual(summarizeAssistants(runs), [\n    {\n      assistant: \"Claude Code\",\n      run_count: 1,\n      best_score: 96,\n      best_run_id: \"claude-best\",\n      median_elapsed_ms: 1_250,\n    },\n    {\n      assistant: \"Codex\",\n      run_count: 2,\n      best_score: 95,\n      best_run_id: \"codex-best\",\n      median_elapsed_ms: 1_500,\n    },\n  ]);\n});\n\ntest(\"breaks a best-score tie with elapsed time\", () => {\n  const runs = [\n    {\n      run_id: \"slower\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 94,\n      elapsed_ms: 1_100,\n    },\n    {\n      run_id: \"faster\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 94,\n      elapsed_ms: 900,\n    },\n  ];\n\n  assert.equal(summarizeAssistants(runs)[0].best_run_id, \"faster\");\n});\n\ntest(\"renders the exact Markdown table format\", () => {\n  const summaries = [\n    {\n      assistant: \"Open|Code\",\n      run_count: 2,\n      best_score: 95.5,\n      best_run_id: \"run|2\",\n      median_elapsed_ms: 1_250,\n    },\n  ];\n\n  assert.equal(\n    renderComparisonTable(summaries),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"| Open\\\\|Code | 2 | 95.5 | run\\\\|2 | 1.250 s |\",\n    ].join(\"\\n\"),\n  );\n});\n\ntest(\"renders an explicit empty state below the table header\", () => {\n  assert.equal(\n    renderComparisonTable([]),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"\",\n      \"_No eligible runs._\",\n    ].join(\"\\n\"),\n  );\n});","lineStart":1,"lineEnd":125,"totalLines":125,"truncated":false}},"title":"benchmark/fixtures/T3-comparison-summary/comparison-summary.test.mjs","time":{"start":1787443460298,"end":1787443460332}},"id":"prt_02beeb8bd001kxKBP51RJvEbv7","sessionID":"ses_fd41153a5ffelEronWM5wISfOh","messageID":"msg_02beead2d0012b1ccCKIcvJ9Bv"}}
