return copyState(next);\n  }\n\n  async function project(rawEvent) {\n    // Validate synchronously-shaped concerns before queueing, using a\n    // defensive copy so later caller mutation cannot affect processing.\n    const event = structuredClone(rawEvent);\n    validateEvent(event);\n\n    const previous = queues.get(event.tradeId) ?? Promise.resolve();\n    const run = previous.catch(() => {}).then(() => handle(event));\n    // Keep the per-trade queue alive even when this event fails.\n    queues.set(\n      event.tradeId,\n      run.catch(() => {}),\n    );\n    return run;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n"}}
