") {\n    return {\n      tradeId: event.tradeId,\n      version: event.version,\n      status: \"active\",\n      notional: event.payload.notional,\n      owner: event.payload.owner,\n    };\n  }\n  if (event.type === \"AMENDED\") {\n    const next = { ...previous, version: event.version };\n    if (\"notional\" in event.payload) {\n      if (!isValidNotional(event.payload.notional)) {\n        throw new TypeError(\"AMENDED notional must be positive and finite\");\n      }\n      next.notional = event.payload.notional;\n    }\n    if (\"owner\" in event.payload) {\n      if (!isValidOwner(event.payload.owner)) {\n        throw new TypeError(\"AMENDED owner must be a non-empty string\");\n      }\n      next.owner = event.payload.owner;\n    }\n    return next;\n  }\n  // CANCELLED\n  return { ...previous, version: event.version, status: \"cancelled\" };\n}\n\nexport function createEventProjector(applyToStore) {\n  if (typeof applyToStore !== \"function\") {\n    throw new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map();\n  const queues = new Map();\n\n  async function handle(event) {\n    const current = states.get(event.tradeId);\n\n    if (!current) {\n      if (event.type !== \"CREATED\" || event.version !== 1) {\n        throw new RangeError(\n          \"first event for a trade must be CREATED at version 1\",\n        );\n      }\n    } else {\n      if (event.version <= current.version) {\n        // Duplicate or stale event: return current snapshot, do not persist.\n        return copyState(current);\n      }\n      if (current.status === \"cancelled\") {\n        throw new RangeError(\"trade is cancelled and cannot accept new events\");\n      }\n      if (event.version !== current.version + 1) {\n        throw new RangeError(\n          `version gap: expected ${current.version + 1}, got ${event.version}`,\n        );\n      }\n      if (event.type === \"CREATED\") {\n        throw new RangeError(\"CREATED is only valid as the first event\");\n      }\n    }\n\n    const next = reduceEvent(current, event);\n    // Persist first; commit only after applyToStore succeeds.\n    await applyToStore(event.tradeId, copyState(next), structuredClone(event));\n    states.set(event.tradeId, next);\n    return copyState(next);\n  }\n\n  async function project(rawEvent) {\n    // Validate synchronously-shaped concerns before queueing, using a\n    // defensive copy so later caller mutation cannot affect processing.\n    const event = structuredClone(rawEvent);\n    validateEvent(event);\n\n    const previous = queues.get(event.tradeId) ?? Promise.resolve();\n    const run = previous.catch(() => {}).then(() => handle(event));\n    // Keep the per-trade queue alive even when this event fails.\n    queues.set(\n      event.tradeId,\n      run.catch(() => {}),\n    );\n    return run;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n"}}}}
