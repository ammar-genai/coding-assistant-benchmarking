+test("different trades make progress independently of a stalled trade", async () => {
+  let releaseA;
+  const gateA = new Promise((resolve) => {
+    releaseA = resolve;
+  });
+  const order = [];
+  const projector = createEventProjector(async (tradeId) => {
+    if (tradeId === "trade-a") {
+      await gateA;
+    }
+    order.push(tradeId);
+  });
+
+  const slow = projector.project(created("trade-a"));
+  const fast = projector.project(created("trade-b"));
+
+  // trade-b must persist even though trade-a is still blocked.
+  assert.equal((await fast).tradeId, "trade-b");
+  assert.deepEqual(order, ["trade-b"]);
+
+  releaseA();
+  await slow;
+  assert.deepEqual(order, ["trade-b", "trade-a"]);
+});
+
+test("duplicate or stale versions return the snapshot without persisting", async () => {
+  const calls = [];
+  const projector = createEventProjector(async (_tradeId, state) => {
+    calls.push(state.version);
