deId, copyState(next), structuredClone(event));\n    states.set(event.tradeId, next);\n    return copyState(next);\n  }\n\n  function project(event) {\n    const tradeId = event && event.tradeId;\n    const prev = queues.get(tradeId) || Promise.resolve();\n    const run = prev.then(() => processEvent(event), () => processEvent(event));\n    // Keep the per-trade chain alive regardless of this event's outcome so a\n    // rejection never poisons later work for the same trade (or another).\n    queues.set(tradeId, run.then(\n      () => {},\n      () => {},\n    ));\n    return run;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n","path":"benchmark/fixtures/T10-event-projector/event-projector.mjs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.2","usage":{"input":654,"output":7410,"cacheRead":3776,"cacheWrite":0,"reasoning":6257,"totalTokens":11840,"cost":{"input":0.0006317639999999999,"output":0.02249676,"cacheRead":0.0007295232,"cacheWrite":0,"total":0.0238580472}},"stopReason":"toolUse","timestamp":1787544348601,"responseId":"gen-1787544348-zTUgwWu8gAUvDrD586m4","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_d090642e03814d62841897f6","toolName":"write","content":[{"type":"text","text":"Successfully wrote 4552 bytes to benchmark/fixtures/T10-event-projector/event-projector.mjs"}],"isError":false,"timestamp":1787544489010},{"role":"assistant","content":[{"type":"text","text":"Now let me write the student regression tests."},{"type":"toolCall","id":"call_825b6afda08249b7b9feb2d5","name":"write","arguments":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createEventProjector } from \"./event-projector.mjs\";\n\nconst created = (tradeId = \"trade-1\", overrides = {}) => ({\n  tradeId,\n  version: 1,\n  type: \"CREATED\",\n  payload: { notional: 100, owner: \"desk-a\" },\n  ...overrides