, {\n    tradeId: \"trade-1\",\n    version: 1,\n    status: \"active\",\n    notional: 100,\n    owner: \"desk-a\",\n  });\n  const stale = await projector.project(amended(\"trade-1\", 2, { notional: 1 }));\n  const staleSnapshot = await projector.project(amended(\"trade-1\", 2, { notional: 2 }));\n  assert.deepEqual(stale, { tradeId: \"trade-1\", version: 2, status: \"active\", notional: 1, owner: \"desk-a\" });\n  assert.deepEqual(staleSnapshot, stale);\n  // Only CREATED@1 and AMENDED@2 ever reached the store.\n  assert.deepEqual(persisted, [\"CREATED@1\", \"AMENDED@2\"]);\n});\n\ntest(\"version gap and invalid first event reject without changing state\", async () => {\n  const persisted = [];\n  const projector = createEventProjector(async (_id, _s, event) => {\n    persisted.push(event.version);\n  });\n\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 1, { notional: 5 })),\n    /first event must be CREATED/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\"), null);\n\n  await projector.project(created());\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 5, { notional: 9 })),\n    /version gap/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 1);\n  assert.deepEqual(persisted, [1]);\n});\n\ntest(\"a cancelled trade is terminal and rejects later new versions\", async () => {\n  const projector = createEventProjector(async () => {});\n  await projector.project(created(\"t\"));\n  await projector.project(amended(\"t\", 2, { notional: 250 }));\n  await projector.project(cancelled(\"t\", 3));\n  const terminal = projector.getSnapshot(\"t\");\n  assert.equal(terminal.status, \"cancelled\");\n  assert.equal(terminal.version, 3);\n\n  await assert.rejects(\n    projector.project(amended(\"t\", 4, { notional: 1 })),\n    /already cancelled/,\n  );\n  // A duplicate of the terminal event still returns the snapshot.\n  const dup = await projector.project(cancelled(\"t\", 3));\n  assert.deepEqual(dup, terminal);\n  assert.deepEqual(projector.getSnapshot(\"t\"), terminal);\n});\n\ntest(\"malformed events and invalid fields reject with TypeError\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({ tradeId: \"t\", version: 1, type: \"FROBNICATE\", payload: {} }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t\", { payload: { notional: -5, owner: \"x\" } })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t\", { payload: { notional: 10, owner: \"\" } })),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"t\"), null);\n\n  await projector.project(created(\"t\"));\n  await assert.rejects(\n    projector.project(amended(\"t\", 2, { notional: Number.NaN })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(amended(\"t\", 2, { owner: 42 })),\n    TypeError,\n  );\n  // Failed AMENDED did not advance the version.\n  const ok = await projector.project(amended(\"t\", 2, { notional: 77 }));\n  assert.equal(ok.version, 2);\n  assert.equal(ok.notional, 77);\n});\n\ntest(\"returned states and snapshots do not expose mutable internal state\", async () => {\n  const projector = createEventProjector(async () => {});\n  const first = await projector.project(created(\"t\"));\n  first.notional = 9999;\n  first.owner = \"mutated\";\n  first.version = 50;\n\n  const snap = projector.getSnapshot(\"t\");\n  assert.equal(snap.notional, 100);\n  assert.equal(snap.owner, \"desk-a\");\n  assert.equal(snap.version, 1);\n\n  const second = await projector.project(amended(\"t\", 2, { notional: 200 }));\n  assert.equal(second.notional, 200);\n  assert.equal(projector.getSnapshot(\"t\").notional, 200);\n\n  // applyToStore must receive copies, not internal references.\n  let captured;\n  const p2 = createEventProjector(async (_id, state, event) => {\n    captured = { state, event };\n  });\n  await p2.project(created(\"u\"));\n  captured.state.notional = -1;\n  captured.event.version = 99;\n  assert.equal(p2.getSnapshot(\"u\").notional, 100);\n  assert.equal(p2.getSnapshot(\"u\").version, 1);\n});\n","path":"benchmark/fixtures/T10-event-projector/student-tests.mjs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.2","usage":{"input":88,"output":1486,"cacheRead":11776,"cacheWrite":0,"reasoning":1,"totalTokens":13350,"cost":{"input":0.000085008,"output":0.004511496,"cacheRead":0.0022751232,"cacheWrite":0,"total":0.006871627200000001}},"stopReason":"toolUse","timestamp":1787544489011,"responseId":"gen-1787544489-jEet5ofKNdLkTOpsYr4c","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call_825b6afda08249b7b9feb2d5","toolName":"write","content":[{"type":"text","text":"Successfully wrote 5634 bytes to benchmark/fixtures/T10-event-projector/student-tests.mjs"}],"isError":false,"timestamp":1787544519995}]}
