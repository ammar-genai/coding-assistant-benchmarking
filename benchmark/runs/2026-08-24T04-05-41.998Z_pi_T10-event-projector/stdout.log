ious.status,\n      tradeId: previous.tradeId,\n    };\n    return validateStateShape(next);\n  }\n  // CANCELLED\n  if (!previous) {\n    throw new TypeError(\"CANCELLED event without prior state\");\n  }\n  return {\n    tradeId: previous.tradeId,\n    version: event.version,\n    status: \"cancelled\",\n    notional: previous.notional,\n    owner: previous.owner,\n  };\n}\n\nexport function createEventProjector(applyToStore) {\n  if (typeof applyToStore !== \"function\") {\n    throw new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map(); // tradeId -> committed state\n  const queues = new Map(); // tradeId -> always-resolved chain for serialization\n\n  async function processEvent(event) {\n    if (event === null || typeof event !== \"object\") {\n      throw new TypeError(\"event must be an object\");\n    }\n    if (!SUPPORTED_TYPES.has(event.type)) {\n      throw new TypeError(`unsupported event type: ${event.type}`);\n    }\n\n    const current = states.get(event.tradeId) || null;\n    const currentVersion = current ? current.version : 0;\n\n    // First event for a trade must be CREATED at version 1.\n    if (!current) {\n      if (event.type !== \"CREATED\" || event.version !== 1) {\n        throw new Error(\"first event must be CREATED at version 1\");\n      }\n      const next = reduceEvent(null, event);\n      await applyToStore(event.tradeId, copyState(next), structuredClone(event));\n      states.set(event.tradeId, next);\n      return copyState(next);\n    }\n\n    // Duplicate or stale version: return current snapshot, do not persist.\n    if (event.version <= currentVersion) {\n      return copyState(current);\n    }\n\n    // Terminal trade rejects any later new version.\n    if (current.status === \"cancelled\") {\n      throw new Error(\"trade is already cancelled (terminal)\");\n    }\n\n    // Version gap.\n    if (event.version !== currentVersion + 1) {\n      throw new Error(\n        `version gap: expected ${currentVersion + 1}, got ${event.version}`,\n      );\n    }\n\n    const next = reduceEvent(current, event);\n    await applyToStore(event.tradeId, copyState(next), structuredClone(event));\n    states.set(event.tradeId, next);\n    return copyState(next);\n  }\n\n  function project(event) {\n    const tradeId = event && event.tradeId;\n    const prev = queues.get(tradeId) || Promise.resolve();\n    const run = prev.then(() => processEvent(event), () => processEvent(event));\n    // Keep the per-trade chain alive regardless of this event's outcome so a\n    // rejection never poisons later work for the same trade (or another).\n    queues.set(tradeId, run.then(\n      () => {},\n      () => {},\n    ));\n    return run;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n","path":"benchmark/fixtures/T10-event-projector/event-projector.mjs"}}
