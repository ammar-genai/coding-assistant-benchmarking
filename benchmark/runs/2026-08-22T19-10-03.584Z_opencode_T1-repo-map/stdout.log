{"type":"tool_use","timestamp":1787425809106,"sessionID":"ses_fd51eaec7ffehwG0fu6RiLBPJO","part":{"type":"tool","tool":"read","callID":"call_rve37plh","state":{"status":"completed","input":{"filePath":"/Users/ammarbinayaz/Documents/coding-assistant-benchmarking/app/page.tsx"},"output":"<path>/Users/ammarbinayaz/Documents/coding-assistant-benchmarking/app/page.tsx</path>\n<type>file</type>\n<content>\n1: \"use client\";\n2: \n3: import { useEffect, useMemo, useState } from \"react\";\n4: \n5: const assistantCards = [\n6:   {\n7:     name: \"Codex\",\n8:     role: \"Primary assistant\",\n9:     mark: \"CX\",\n10:     summary:\n11:       \"Use it for the strongest OpenAI-native workflow: planning, implementation, parallel subagents, review, browser checks, and long-running work.\",\n12:     test: \"App and CLI flow, worktrees, custom agents, skills, plugins, MCP, hooks, approvals, structured non-interactive output.\",\n13:   },\n14:   {\n15:     name: \"Claude Code\",\n16:     role: \"Primary assistant\",\n17:     mark: \"CC\",\n18:     summary:\n19:       \"Use it for Anthropic-native coding, long tasks, careful planning, and its mature set of subagents, teams, hooks, MCP, and plugins.\",\n20:     test: \"Plan mode, subagents, agent view, agent teams, worktrees, plugin marketplace, hooks, MCP, permissions, print/JSON mode.\",\n21:   },\n22:   {\n23:     name: \"OpenCode\",\n24:     role: \"Primary assistant\",\n25:     mark: \"OC\",\n26:     summary:\n27:       \"Use it as the provider-flexible assistant. It is the cleanest place to compare local, cloud, and paid models without changing your daily interface.\",\n28:     test: \"Provider switching, Ollama discovery, agents, skills, MCP, plugins, permissions, session handling, run/server modes.\",\n29:   },\n30:   {\n31:     name: \"Pi\",\n32:     role: \"Neutral lab bench\",\n33:     mark: \"PI\",\n34:     summary:\n35:       \"Use Pi to compare models inside one minimal harness. It supports your OpenAI and Anthropic subscriptions plus custom local providers.\",\n36:     test: \"Model portability, extensions, skills, packages, JSON/RPC/SDK modes, session branching, and the cost of adding missing controls.\",\n37:   },\n38: ];\n39: \n40: const modelRows = [\n41:   {\n42:     model: \"GPT-5.6 Sol\",\n43:     maker: \"OpenAI\",\n44:     lane: \"Frontier\",\n45:     access: \"Codex subscription; API optional\",\n46:     use: \"Top-level planning, hardest fixes, final review\",\n47:     priority: \"Required\",\n48:   },\n49:   {\n50:     model: \"GPT-5.6 Terra\",\n51:     maker: \"OpenAI\",\n52:     lane: \"Efficient frontier\",\n53:     access: \"Codex subscription where listed; API optional\",\n54:     use: \"Exploration, review, medium-complexity worker\",\n55:     priority: \"Required\",\n56:   },\n57:   {\n58:     model: \"GPT-5.6 Luna\",\n59:     maker: \"OpenAI\",\n60:     lane: \"Low cost\",\n61:     access: \"API or catalog access\",\n62:     use: \"Simple scans, formatting, repetitive checks\",\n63:     priority: \"Optional\",\n64:   },\n65:   {\n66:     model: \"Claude Opus 5\",\n67:     maker: \"Anthropic\",\n68:     lane: \"Frontier\",\n69:     access: \"Claude subscription, plan dependent\",\n70:     use: \"Top-level planning, long work, difficult review\",\n71:     priority: \"Required\",\n72:   },\n73:   {\n74:     model: \"Claude Sonnet 5\",\n75:     maker: \"Anthropic\",\n76:     lane: \"Workhorse\",\n77:     access: \"Claude Code subscription\",\n78:     use: \"Daily coding baseline and moderate workers\",\n79:     priority: \"Required\",\n80:   },\n81:   {\n82:     model: \"Claude Fable 5\",\n83:     maker: \"Anthropic\",\n84:     lane: \"Frontier ceiling\",\n85:     access: \"Usage credits / account availability\",\n86:     use: \"One or two hardest runs only\",\n87:     priority: \"Stretch\",\n88:   },\n89:   {\n90:     model: \"Claude Haiku 4.5\",\n91:     maker: \"Anthropic\",\n92:     lane: \"Low cost\",\n93:     access: \"API or subscription catalog\",\n94:     use: \"Fast small worker and parallel scans\",\n95:     priority: \"Optional\",\n96:   },\n97:   {\n98:     model: \"Qwen3 Coder 480B Cloud\",\n99:     maker: \"Qwen\",\n100:     lane: \"Hosted open weight\",\n101:     access: \"Ollama Cloud\",\n102:     use: \"Optional third hosted coding model after the pilot\",\n103:     priority: \"Optional\",\n104:   },\n105:   {\n106:     model: \"Kimi K2.7 Code\",\n107:     maker: \"Moonshot AI\",\n108:     lane: \"Hosted open weight\",\n109:     access: \"Ollama Cloud\",\n110:     use: \"Long coding tasks and tool-heavy worker runs\",\n111:     priority: \"Required\",\n112:   },\n113:   {\n114:     model: \"DeepSeek V4 Flash\",\n115:     maker: \"DeepSeek\",\n116:     lane: \"Hosted open weight\",\n117:     access: \"Ollama Cloud\",\n118:     use: \"Long-context and cost-aware worker runs\",\n119:     priority: \"Required\",\n120:   },\n121:   {\n122:     model: \"Qwen3 8B\",\n123:     maker: \"Qwen\",\n124:     lane: \"Small local control\",\n125:     access: \"Ollama\",\n126:     use: \"Measure the quality and speed tradeoff of a laptop-sized worker\",\n127:     priority: \"Optional\",\n128:   },\n129: ];\n130: \n131: const benchmarkLanes = [\n132:   {\n133:     number: \"01\",\n134:     title: \"Compare the assistants\",\n135:     lock: \"Keep the model fixed\",\n136:     body: \"Run deepseek-v4-flash:cloud through Codex, Claude Code, OpenCode, and Pi. The same hosted model avoids turning laptop limits into an assistant advantage.\",\n137:     runs: \"4 assistants × 4 tasks × 2 runs = 32\",\n138:     answers: \"Which assistant plans better, uses tools better, stays in scope, recovers from errors, and needs fewer interventions?\",\n139:   },\n140:   {\n141:     number: \"02\",\n142:     title: \"Compare the models\",\n143:     lock: \"Keep the assistant fixed\",\n144:     body: \"Use Pi as the intended neutral harness after access is verified. Test the selected OpenAI and Anthropic models plus DeepSeek, Kimi, and an optional Qwen Cloud model with identical conditions.\",\n145:     runs: \"7 models × 4 tasks × 2 runs = 56\",\n146:     answers: \"Which model gives the best quality, time, and cost when the surrounding assistant is unchanged?\",\n147:   },\n148:   {\n149:     number: \"03\",\n150:     title: \"Compare real daily use\",\n151:     lock: \"Use each native best pairing\",\n152:     body: \"Run Codex + Sol, Claude Code + Opus or Sonnet, and OpenCode + the best open model from the pilot on two hard tasks.\",\n153:     runs: \"3 native pairs × 2 tasks × 1 run = 6\",\n154:     answers: \"Which full product would you choose when fairness matters less than getting the work done?\",\n155:   },\n156: ];\n157: \n158: const taskRows = [\n159:   {\n160:     id: \"T1\",\n161:     kind: \"Core\",\n162:     title: \"Understand an unfamiliar repository\",\n163:     setup: \"Ask for an architecture map, main request flow, risky areas, and a short change plan. Read-only.\",\n164:     pass: \"Matches a maintainer-written answer key; cites the right files; makes no edits.\",\n165:   },\n166:   {\n167:     id: \"T2\",\n168:     kind: \"Core\",\n169:     title: \"Fix a real bug\",\n170:     setup: \"Seed one edge-case bug with visible tests and hidden tests. Give only the issue report and reproduction.\",\n171:     pass: \"All tests pass, the root cause is fixed, and the diff does not include unrelated cleanup.\",\n172:   },\n173:   {\n174:     id: \"T3\",\n175:     kind: \"Core\",\n176:     title: \"Build a multi-file feature\",\n177:     setup: \"Add one API or data feature that needs schema, business logic, validation, tests, and docs.\",\n178:     pass: \"Acceptance tests pass; error paths work; existing behavior remains stable.\",\n179:   },\n180:   {\n181:     id: \"T4\",\n182:     kind: \"Core\",\n183:     title: \"Build and verify a user interface\",\n184:     setup: \"Provide a screenshot plus written behavior for desktop and mobile. Require keyboard use and browser verification.\",\n185:     pass: \"Functional checks, visual checks, accessibility checks, and console checks pass.\",\n186:   },\n187:   {\n188:     id: \"T5\",\n189:     kind: \"Challenge\",\n190:     title: \"Refactor without changing behavior\",\n191:     setup: \"Give a large, awkward module and freeze behavior with characterization tests before the refactor.\",\n192:     pass: \"Same public behavior, smaller clear units, no snapshot churn, and measured complexity improvement.\",\n193:   },\n194:   {\n195:     id: \"T6\",\n196:     kind: \"Challenge\",\n197:     title: \"Upgrade a dependency or API\",\n198:     setup: \"Pin an older library, provide current docs, and require a safe migration with a rollback note.\",\n199:     pass: \"Build and tests pass; deprecated usage is gone; no unnecessary dependency changes.\",\n200:   },\n201:   {\n202:     id: \"T7\",\n203:     kind: \"Challenge\",\n204:     title: \"Investigate an incident and a security flaw\",\n205:     setup: \"Use a controlled fixture with logs, one vulnerable path, noise, and a safe reproduction.\",\n206:     pass: \"Finds the real cause, ranks risk correctly, patches it, adds regression tests, and avoids unsafe actions.\",\n207:   },\n208:   {\n209:     id: \"T8\",\n210:     kind: \"Challenge\",\n211:     title: \"Repair CI and improve project guidance\",\n212:     setup: \"Give a broken pipeline, weak README, and missing assistant instructions.\",\n213:     pass: \"CI passes; setup is reproducible; AGENTS.md is short, specific, and useful across assistants.\",\n214:   },\n215: ];\n216: \n217: const scoreRows = [\n218:   [\"Correctness\", \"35\", \"Acceptance tests and hidden tests\"],\n219:   [\"No regressions\", \"15\", \"Existing tests and behavior stay intact\"],\n220:   [\"Scope discipline\", \"10\", \"Only necessary files and changes\"],\n221:   [\"Code quality\", \"10\", \"Clear, maintainable, and consistent with the repo\"],\n222:   [\"Autonomy\", \"8\", \"Few human corrections or repeated instructions\"],\n223:   [\"Tool and safety discipline\", \"7\", \"Good permission choices; no risky shortcuts\"],\n224:   [\"Time\", \"5\", \"Time to an accepted result, not time to first answer\"],\n225:   [\"Usage or cost\", \"5\", \"Tokens, subscription quota, cloud units, or local energy proxy\"],\n226:   [\"Explanation\", \"5\", \"Accurate summary, verification, and remaining risks\"],\n227: ];\n228: \n229: const extensionRows = [\n230:   {\n231:     surface: \"Project rules\",\n232:     common: \"Keep AGENTS.md as the single source. Claude's CLAUDE.md should import it with @AGENTS.md.\",\n233:     measure: \"Rule following and context size\",\n234:   },\n235:   {\n236:     surface: \"Skills\",\n237:     common: \"Reuse one small SKILL.md workflow through each assistant's discovery path.\",\n238:     measure: \"Portability, setup time, and quality gain\",\n239:   },\n240:   {\n241:     surface: \"MCP\",\n242:     common: \"Configure the same read-only docs or issue-tracker server in each assistant.\",\n243:     measure: \"Connection reliability, tool accuracy, permission clarity\",\n244:   },\n245:   {\n246:     surface: \"Hooks and guards\",\n247:     common: \"Apply the same policy: block secrets, format changed files, and run a focused check after edits.\",\n248:     measure: \"Coverage, false blocks, debuggability\",\n249:   },\n250:   {\n251:     surface: \"Plugins and extensions\",\n252:     common: \"Package the rule, skill, tool, and guard only after the loose version works.\",\n253:     measure: \"Install, update, permissions, versioning, and removal\",\n254:   },\n255: ];\n256: \n257: const stages = [\n258:   {\n259:     id: \"stage-0\",\n260:     week: \"Day 1\",\n261:     title: \"Freeze the study\",\n262:     goal: \"Write the question before seeing results.\",\n263:     items: [\n264:       \"Create STUDY.md with the three comparison lanes, the scorecard, and your stop rules.\",\n265:       \"Record machine, operating system, RAM/VRAM, assistant versions, model IDs, and subscription tier.\",\n266:       \"Turn off auto-updates for the study window where practical, or record every update as a new study block.\",\n267:       \"Set a hard optional-spend cap. Start with subscriptions and Ollama; add paid API runs only after the pilot.\",\n268:     ],\n269:   },\n270:   {\n271:     id: \"stage-1\",\n272:     week: \"Days 2–4\",\n273:     title: \"Build the task pack\",\n274:     goal: \"Make the result gradeable without model judgment.\",\n275:     items: [\n276:       \"Prepare T1–T4 first. Use small real repositories or frozen fixtures with clean reset commits.\",\n277:       \"Write visible acceptance criteria and separate hidden tests before any assistant sees the task.\",\n278:       \"Create one prompt per task. Do not mention the assistant or model name inside the prompt.\",\n279:       \"Manually solve each task once so you know it is possible and know the expected effort.\",\n280:     ],\n281:   },\n282:   {\n283:     id: \"stage-2\",\n284:     week: \"Days 5–7\",\n285:     title: \"Build the runner\",\n286:     goal: \"Capture the same evidence for every run.\",\n287:     items: [\n288:       \"Start each run from the same Git commit in its own worktree.\",\n289:       \"Wrap codex exec, claude -p, opencode run, and Pi print/JSON mode behind one run command.\",\n290:       \"Save prompt, settings, stdout, stderr, event log, patch, tests, elapsed time, interventions, and final answer.\",\n291:       \"Use a run ID and never overwrite a prior run.\",\n292:     ],\n293:   },\n294:   {\n295:     id: \"stage-3\",\n296:     week: \"Week 2\",\n297:     title: \"Run the 28-run pilot\",\n298:     goal: \"Find broken tasks and weak candidates cheaply.\",\n299:     items: [\n300:       \"Assistant pilot: 4 assistants × T1 and T2 × 1 run = 8.\",\n301:       \"Model pilot: 7 models in Pi × T1 and T2 × 1 run = 14.\",\n302:       \"Native pilot: 3 native pairings × T1 and T2 × 1 run = 6.\",\n303:       \"Fix the harness, prompts, or hidden tests only if the issue affects everyone. Version every change.\",\n304:     ],\n305:   },\n306:   {\n307:     id: \"stage-4\",\n308:     week: \"Weeks 3–4\",\n309:     title: \"Complete the 94-run core study\",\n310:     goal: \"Collect repeatable evidence, not impressions.\",\n311:     items: [\n312:       \"Complete the assistant lane: 32 total runs across T1–T4.\",\n313:       \"Complete the model lane: 56 total runs across T1–T4.\",\n314:       \"Complete the native lane: 6 runs on two challenge tasks.\",\n315:       \"Randomize run order, clear sessions, restore the repository, and grade before revealing model identity where possible.\",\n316:     ],\n317:   },\n318:   {\n319:     id: \"stage-5\",\n320:     week: \"Week 5\",\n321:     title: \"Test the extension ecosystems\",\n322:     goal: \"Measure what customization actually buys you.\",\n323:     items: [\n324:       \"Run one task with no extensions, then with a shared rule, one skill, one MCP server, and one safety guard.\",\n325:       \"Record install time, failures, context overhead, permission prompts, and whether the extension improved the final score.\",\n326:       \"Treat skills and MCP as portable building blocks. Treat plugin packaging and hooks as assistant-specific.\",\n327:       \"Do not install a large plugin bundle until you have reviewed its code, permissions, and external connections.\",\n328:     ],\n329:   },\n330:   {\n331:     id: \"stage-6\",\n332:     week: \"Week 6\",\n333:     title: \"Run the distributed project\",\n334:     goal: \"Prove that a frontier planner can direct smaller workers.\",\n335:     items: [\n336:       \"Use GPT-5.6 Sol as the first lead. Repeat once with Claude Opus 5 as lead.\",\n337:       \"Give each worker a separate worktree, owned files, acceptance tests, and a machine-readable task file.\",\n338:       \"Use DeepSeek for a bounded implementation, Kimi or Qwen Cloud for a larger worker task, and Terra or Sonnet for the difficult middle layer.\",\n339:       \"Use the other vendor's frontier model as final reviewer, then run all tests and make the merge decision yourself.\",\n340:     ],\n341:   },\n342:   {\n343:     id: \"stage-7\",\n344:     week: \"Final 2 days\",\n345:     title: \"Analyze and publish\",\n346:     goal: \"Make the conclusion honest and reusable.\",\n347:     items: [\n348:       \"Report medians and ranges; show every failure and intervention, not only the best run.\",\n349:       \"Separate assistant effects, model effects, and native-pair results in the report.\",\n350:       \"Write recommendations by task type: best planner, best daily driver, best local worker, best value, best extension system.\",\n351:       \"Publish prompts, task versions, runner code, scoring rules, and raw results where licenses and privacy allow.\",\n352:     ],\n353:   },\n354: ];\n355: \n356: const sources = [\n357:   [\"OpenAI model guidance\", \"https://developers.openai.com/api/docs/guides/latest-model\"],\n358:   [\"OpenAI model catalog\", \"https://developers.openai.com/api/docs/models\"],\n359:   [\"Claude Code parallel agents\", \"https://code.claude.com/docs/en/agents\"],\n360:   [\"Claude Code extension map\", \"https://code.claude.com/docs/en/features-overview\"],\n361:   [\"Claude Code plugins\", \"https://code.claude.com/docs/en/plugins\"],\n362:   [\"OpenCode providers\", \"https://opencode.ai/docs/providers\"],\n363:   [\"OpenCode agents\", \"https://opencode.ai/docs/agents/\"],\n364:   [\"OpenCode skills\", \"https://opencode.ai/docs/skills\"],\n365:   [\"Pi agent harness\", \"https://github.com/earendil-works/pi\"],\n366:   [\"Ollama launch integrations\", \"https://ollama.com/blog/launch\"],\n367:   [\"Qwen3 Coder on Ollama\", \"https://ollama.com/library/qwen3-coder\"],\n368:   [\"Kimi K2.7 Code on Ollama\", \"https://ollama.com/library/kimi-k2.7-code\"],\n369:   [\"DeepSeek V4 Flash on Ollama\", \"https://ollama.com/library/deepseek-v4-flash\"],\n370:   [\"Claude Opus 5\", \"https://www.anthropic.com/news/claude-opus-5\"],\n371:   [\"Claude Sonnet 5\", \"https://www.anthropic.com/news/claude-sonnet-5\"],\n372: ];\n373: \n374: const navItems = [\n375:   [\"scope\", \"Scope\"],\n376:   [\"models\", \"Models\"],\n377:   [\"design\", \"Study design\"],\n378:   [\"tasks\", \"Tasks\"],\n379:   [\"score\", \"Scoring\"],\n380:   [\"ecosystem\", \"Extensions\"],\n381:   [\"workflow\", \"Distributed work\"],\n382:   [\"steps\", \"Step-by-step\"],\n383:   [\"start\", \"Start here\"],\n384: ];\n385: \n386: function CheckIcon({ checked }: { checked: boolean }) {\n387:   return <span aria-hidden=\"true\">{checked ? \"✓\" : \"\"}</span>;\n388: }\n389: \n390: export default function Home() {\n391:   const [completed, setCompleted] = useState<string[]>([]);\n392: \n393:   useEffect(() => {\n394:     let timer: number | undefined;\n395:     try {\n396:       const saved = window.localStorage.getItem(\"assistant-study-progress\");\n397:       const parsed = saved ? JSON.parse(saved) : [];\n398:       if (Array.isArray(parsed)) {\n399:         timer = window.setTimeout(\n400:           () => setCompleted(parsed.filter((item) => typeof item === \"string\")),\n401:           0,\n402:         );\n403:       }\n404:     } catch {\n405:       // Progress is a convenience. The plan still works without browser storage.\n406:     }\n407:     return () => {\n408:       if (timer !== undefined) window.clearTimeout(timer);\n409:     };\n410:   }, []);\n411: \n412:   const completeCount = completed.length;\n413:   const percent = Math.round((completeCount / stages.length) * 100);\n414:   const progressText = useMemo(\n415:     () => `${completeCount} of ${stages.length} stages complete`,\n416:     [completeCount],\n417:   );\n418: \n419:   function toggleStage(id: string) {\n420:     const next = completed.includes(id)\n421:       ? completed.filter((item) => item !== id)\n422:       : [...completed, id];\n423:     setCompleted(next);\n424:     try {\n425:       window.localStorage.setItem(\n426:         \"assistant-study-progress\",\n427:         JSON.stringify(next),\n428:       );\n429:     } catch {\n430:       // Ignore storage failures.\n431:     }\n432:   }\n433: \n434:   function resetProgress() {\n435:     setCompleted([]);\n436:     try {\n437:       window.localStorage.removeItem(\"assistant-study-progress\");\n438:     } catch {\n439:       // Ignore storage failures.\n440:     }\n441:   }\n442: \n443:   return (\n444:     <>\n445:       <a className=\"skip-link\" href=\"#main-content\">\n446:         Skip to the plan\n447:       </a>\n448: \n449:       <header className=\"site-header\">\n450:         <a className=\"brand\" href=\"#top\" aria-label=\"Coding assistant study home\">\n451:           <span className=\"brand-mark\">LAB / 01</span>\n452:           <span>Coding assistant study</span>\n453:         </a>\n454:         <div className=\"header-actions\">\n455:           <div className=\"mini-progress\" aria-label={progressText}>\n456:             <span>{progressText}</span>\n457:             <span className=\"mini-track\" aria-hidden=\"true\">\n458:               <span style={{ width: `${percent}%` }} />\n459:             </span>\n460:           </div>\n461:           <button className=\"text-button print-button\" onClick={() => window.print()}>\n462:             Print / save PDF\n463:           </button>\n464:         </div>\n465:       </header>\n466: \n467:       <div className=\"page-shell\" id=\"top\">\n468:         <aside className=\"side-nav\" aria-label=\"Plan sections\">\n469:           <p className=\"eyebrow\">On this page</p>\n470:           <nav>\n471:             {navItems.map(([id, label], index) => (\n472:               <a href={`#${id}`} key={id}>\n473:                 <span>{String(index + 1).padStart(2, \"0\")}</span>\n474:                 {label}\n475:               </a>\n476:             ))}\n477:           </nav>\n478:           <div className=\"side-note\">\n479:             <p>Study size</p>\n480:             <strong>94 core runs</strong>\n481:             <span>plus one distributed project</span>\n482:           </div>\n483:         </aside>\n484: \n485:         <main id=\"main-content\">\n486:           <section className=\"hero\" aria-labelledby=\"hero-title\">\n487:             <div className=\"hero-copy\">\n488:               <p className=\"kicker\">A practical six-week benchmark</p>\n489:               <h1 id=\"hero-title\">\n490:                 Find the right <em>assistant</em>, the right <em>model</em>, and the\n491:                 right way to combine them.\n492:               </h1>\n493:               <p className=\"hero-lede\">\n494:                 A repeatable study of Codex, Claude Code, and OpenCode—with Pi as\n495:                 a neutral model lab, and Ollama for local and hosted open models.\n496:               </p>\n497:               <div className=\"hero-actions\">\n498:                 <a className=\"primary-button\" href=\"#start\">\n499:                   Begin with Day 1\n500:                 </a>\n501:                 <a className=\"secondary-button\" href=\"#design\">\n502:                   See the study design\n503:                 </a>\n504:               </div>\n505:             </div>\n506:             <div className=\"hero-brief\" aria-label=\"Key recommendation\">\n507:               <p className=\"eyebrow\">My recommendation</p>\n508:               <p className=\"brief-big\">Do not run every model in every assistant.</p>\n509:               <p>\n510:                 First hold the model fixed to measure the assistant. Then hold the\n511:                 assistant fixed to measure the model. Finally test each native\n512:                 pairing as a complete product.\n513:               </p>\n514:               <dl>\n515:                 <div>\n516:                   <dt>Lead model</dt>\n517:                   <dd>GPT-5.6 Sol, then Opus 5</dd>\n518:                 </div>\n519:                 <div>\n520:                   <dt>Shared baseline</dt>\n521:                   <dd>DeepSeek V4 Flash Cloud</dd>\n522:                 </div>\n523:                 <div>\n524:                   <dt>Neutral harness</dt>\n525:                   <dd>Pi</dd>\n526:                 </div>\n527:               </dl>\n528:             </div>\n529:           </section>\n530: \n531:           <section className=\"section-block\" id=\"scope\">\n532:             <div className=\"section-heading\">\n533:               <p className=\"section-number\">01 / Scope</p>\n534:               <h2>Four programs, with three in the final ranking.</h2>\n535:               <p>\n536:                 Here, “assistant” or “harness” means the program around the model:\n537:                 its tools, planning, permissions, memory, plugins, and user\n538:                 experience. Pi is a control instrument, not a fourth primary winner.\n539:               </p>\n540:             </div>\n541:             <div className=\"assistant-grid\">\n542:               {assistantCards.map((assistant) => (\n543:                 <article className=\"assistant-card\" key={assistant.name}>\n544:                   <div className=\"assistant-top\">\n545:                     <span className=\"assistant-mark\">{assistant.mark}</span>\n546:                     <span className=\"role-pill\">{assistant.role}</span>\n547:                   </div>\n548:                   <h3>{assistant.name}</h3>\n549:                   <p>{assistant.summary}</p>\n550:                   <div className=\"test-note\">\n551:                     <span>Inspect</span>\n552:                     <p>{assistant.test}</p>\n553:                   </div>\n554:                 </article>\n555:               ))}\n556:             </div>\n557:             <div className=\"callout plain\">\n558:               <strong>Boundary:</strong> compare Codex, Claude Code, and OpenCode\n559:               as the products you may keep using. Use Pi to make the model test\n560:               fair and to explore custom orchestration.\n561:             </div>\n562:           </section>\n563: \n564:           <section className=\"section-block\" id=\"models\">\n565:             <div className=\"section-heading split-heading\">\n566:               <div>\n567:                 <p className=\"section-number\">02 / Models</p>\n568:                 <h2>A small, current model shortlist.</h2>\n569:               </div>\n570:               <p>\n571:                 Exact catalogs change quickly. Record the full model ID visible on\n572:                 the day of each run. “Open weight” is used for downloadable models\n573:                 because their licenses and definitions of open source differ.\n574:               </p>\n575:             </div>\n576:             <div className=\"table-wrap model-table-wrap\" tabIndex={0}>\n577:               <table>\n578:                 <thead>\n579:                   <tr>\n580:                     <th>Model</th>\n581:                     <th>Class</th>\n582:                     <th>Access</th>\n583:                     <th>Use in this study</th>\n584:                     <th>Priority</th>\n585:                   </tr>\n586:                 </thead>\n587:                 <tbody>\n588:                   {modelRows.map((row) => (\n589:                     <tr key={row.model}>\n590:                       <td>\n591:                         <strong>{row.model}</strong>\n592:                         <span>{row.maker}</span>\n593:                       </td>\n594:                       <td>{row.lane}</td>\n595:                       <td>{row.access}</td>\n596:                       <td>{row.use}</td>\n597:                       <td>\n598:                         <span\n599:                           className={`priority priority-${row.priority.toLowerCase()}`}\n600:                         >\n601:                           {row.priority}\n602:                         </span>\n603:                       </td>\n604:                     </tr>\n605:                   ))}\n606:                 </tbody>\n607:               </table>\n608:             </div>\n609:             <div className=\"model-rule-grid\">\n610:               <div>\n611:                 <span>Hardware rule</span>\n612:                 <p>\n613:                   With 16 GB of unified memory, keep large open-weight models in\n614:                   Ollama Cloud. Use Qwen3 8B only as a labeled small local control,\n615:                   not as a substitute inside the shared-model lane.\n616:                 </p>\n617:               </div>\n618:               <div>\n619:                 <span>Budget rule</span>\n620:                 <p>\n621:                   Use subscription access first. Use Ollama Cloud for Kimi and\n622:                   DeepSeek. Treat Fable, Luna, Haiku, and paid APIs as optional until\n623:                   the pilot proves they add a useful comparison.\n624:                 </p>\n625:               </div>\n626:             </div>\n627:           </section>\n628: \n629:           <section className=\"section-block\" id=\"design\">\n630:             <div className=\"section-heading\">\n631:               <p className=\"section-number\">03 / Study design</p>\n632:               <h2>Three lanes prevent the wrong conclusion.</h2>\n633:               <p>\n634:                 A great result may come from the model, the surrounding program, or\n635:                 both. These lanes separate those effects before you judge the full\n636:                 product.\n637:               </p>\n638:             </div>\n639:             <div className=\"lane-list\">\n640:               {benchmarkLanes.map((lane) => (\n641:                 <article className=\"lane-card\" key={lane.number}>\n642:                   <span className=\"lane-number\">{lane.number}</span>\n643:                   <div className=\"lane-content\">\n644:                     <div className=\"lane-title-row\">\n645:                       <h3>{lane.title}</h3>\n646:                       <span>{lane.lock}</span>\n647:                     </div>\n648:                     <p>{lane.body}</p>\n649:                     <div className=\"lane-meta\">\n650:                       <p>\n651:                         <strong>Target:</strong> {lane.runs}\n652:                       </p>\n653:                       <p>\n654:                         <strong>Answers:</strong> {lane.answers}\n655:                       </p>\n656:                     </div>\n657:                   </div>\n658:                 </article>\n659:               ))}\n660:             </div>\n661:             <div className=\"method-strip\">\n662:               <div>\n663:                 <span>Same start</span>\n664:                 <p>Clean commit and new session</p>\n665:               </div>\n666:               <div>\n667:                 <span>Same prompt</span>\n668:                 <p>Versioned and hashed</p>\n669:               </div>\n670:               <div>\n671:                 <span>Two runs</span>\n672:                 <p>Report median and range</p>\n673:               </div>\n674:               <div>\n675:                 <span>Blind grade</span>\n676:                 <p>Hide identity when possible</p>\n677:               </div>\n678:               <div>\n679:                 <span>Stop rule</span>\n680:                 <p>Maximum time and interventions</p>\n681:               </div>\n682:             </div>\n683:           </section>\n684: \n685:           <section className=\"section-block\" id=\"tasks\">\n686:             <div className=\"section-heading split-heading\">\n687:               <div>\n688:                 <p className=\"section-number\">04 / Task pack</p>\n689:                 <h2>Eight tasks that resemble real work.</h2>\n690:               </div>\n691:               <p>\n692:                 Use T1–T4 for the controlled comparison. Use T5–T8 for native\n693:                 product tests, plugin tests, and the distributed project.\n694:               </p>\n695:             </div>\n696:             <div className=\"task-grid\">\n697:               {taskRows.map((task) => (\n698:                 <article className=\"task-card\" key={task.id}>\n699:                   <div className=\"task-labels\">\n700:                     <span>{task.id}</span>\n701:                     <span>{task.kind}</span>\n702:                   </div>\n703:                   <h3>{task.title}</h3>\n704:                   <p>{task.setup}</p>\n705:                   <div className=\"pass-line\">\n706:                     <span>Pass when</span>\n707:                     <p>{task.pass}</p>\n708:                   </div>\n709:                 </article>\n710:               ))}\n711:             </div>\n712:             <div className=\"callout warning\">\n713:               <strong>Do not use public benchmark tasks as your main evidence.</strong>\n714:               Models may have seen them. Use private, frozen fixtures modeled on\n715:               work you actually do. Public suites can be a small secondary check.\n716:             </div>\n717:           </section>\n718: \n719:           <section className=\"section-block\" id=\"score\">\n720:             <div className=\"section-heading\">\n721:               <p className=\"section-number\">05 / Scoring</p>\n722:               <h2>One 100-point score, backed by raw evidence.</h2>\n723:               <p>\n724:                 The score makes comparison easier. The patch, tests, event log, and\n725:                 human notes remain the source of truth.\n726:               </p>\n727:             </div>\n728:             <div className=\"score-layout\">\n729:               <div className=\"score-ring\" aria-label=\"100 point score\">\n730:                 <span>100</span>\n731:                 <p>total points</p>\n732:               </div>\n733:               <div className=\"score-list\">\n734:                 {scoreRows.map(([label, points, proof]) => (\n735:                   <div className=\"score-row\" key={label}>\n736:                     <span className=\"score-points\">{points}</span>\n737:                     <strong>{label}</strong>\n738:                     <p>{proof}</p>\n739:                   </div>\n740:                 ))}\n741:               </div>\n742:             </div>\n743:             <div className=\"evidence-grid\">\n744:               <div>\n745:                 <h3>Always record</h3>\n746:                 <ul>\n747:                   <li>Assistant version and exact model ID</li>\n748:                   <li>Prompt version and repository commit</li>\n749:                   <li>Context size, reasoning setting, permissions, and plugins</li>\n750:                   <li>Elapsed time and time to an accepted result</li>\n751:                   <li>Human interventions and permission prompts</li>\n752:                 </ul>\n753:               </div>\n754:               <div>\n755:                 <h3>Always save</h3>\n756:                 <ul>\n757:                   <li>Event log or full transcript</li>\n758:                   <li>Standard output and error output</li>\n759:                   <li>Git patch and changed-file list</li>\n760:                   <li>Visible and hidden test results</li>\n761:                   <li>Final response and grader notes</li>\n762:                 </ul>\n763:               </div>\n764:               <div>\n765:                 <h3>Count an intervention when</h3>\n766:                 <ul>\n767:                   <li>You correct a wrong plan or false claim</li>\n768:                   <li>You provide a file location it should have found</li>\n769:                   <li>You ask it to run a required check again</li>\n770:                   <li>You approve a normal expected action only if comparing UX</li>\n771:                   <li>You restart after a crash or unrecoverable loop</li>\n772:                 </ul>\n773:               </div>\n774:             </div>\n775:           </section>\n776: \n777:           <section className=\"section-block\" id=\"ecosystem\">\n778:             <div className=\"section-heading\">\n779:               <p className=\"section-number\">06 / Skills, plugins, MCP, and hooks</p>\n780:               <h2>Share the simple pieces. Keep product-specific wiring thin.</h2>\n781:               <p>\n782:                 Skills and MCP are the most portable layer. Plugin packaging,\n783:                 lifecycle hooks, and permissions differ, so compare them as product\n784:                 features rather than forcing one configuration everywhere.\n785:               </p>\n786:             </div>\n787:             <div className=\"portable-stack\" aria-label=\"Portable extension stack\">\n788:               <div>\n789:                 <span>Shared rules</span>\n790:                 <strong>AGENTS.md</strong>\n791:               </div>\n792:               <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n793:               <div>\n794:                 <span>Shared workflow</span>\n795:                 <strong>SKILL.md</strong>\n796:               </div>\n797:               <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n798:               <div>\n799:                 <span>Shared tools</span>\n800:                 <strong>MCP servers</strong>\n801:               </div>\n802:               <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n803:               <div>\n804:                 <span>Local enforcement</span>\n805:                 <strong>Hooks + permissions</strong>\n806:               </div>\n807:             </div>\n808:             <div className=\"table-wrap\" tabIndex={0}>\n809:               <table className=\"extension-table\">\n810:                 <thead>\n811:                   <tr>\n812:                     <th>Layer</th>\n813:                     <th>How to use it across assistants</th>\n814:                     <th>What to measure</th>\n815:                   </tr>\n816:                 </thead>\n817:                 <tbody>\n818:                   {extensionRows.map((row) => (\n819:                     <tr key={row.surface}>\n820:                       <td><strong>{row.surface}</strong></td>\n821:                       <td>{row.common}</td>\n822:                       <td>{row.measure}</td>\n823:                     </tr>\n824:                   ))}\n825:                 </tbody>\n826:               </table>\n827:             </div>\n828:             <div className=\"ecosystem-notes\">\n829:               <article>\n830:                 <span>Codex</span>\n831:                 <p>\n832:                   Test project instructions, skills, installable plugins, MCP,\n833:                   hooks, custom agents, subagents, and structured exec output.\n834:                 </p>\n835:               </article>\n836:               <article>\n837:                 <span>Claude Code</span>\n838:                 <p>\n839:                   Test CLAUDE.md importing AGENTS.md, skills, marketplace plugins,\n840:                   MCP, deterministic hooks, subagents, agent teams, and worktrees.\n841:                 </p>\n842:               </article>\n843:               <article>\n844:                 <span>OpenCode</span>\n845:                 <p>\n846:                   Test AGENTS.md, shared skills, provider plugins, custom tools, MCP,\n847:                   fine-grained permissions, and its evolving V2 plugin API.\n848:                 </p>\n849:               </article>\n850:               <article>\n851:                 <span>Pi</span>\n852:                 <p>\n853:                   Test AGENTS.md, Agent Skills, TypeScript extensions, packages,\n854:                   JSON/RPC/SDK use, and external sandboxing because Pi has no built-in\n855:                   permission boundary.\n856:                 </p>\n857:               </article>\n858:             </div>\n859:             <div className=\"callout plain\">\n860:               <strong>Cross-tool rule file:</strong> keep the real project guidance in\n861:               <code> AGENTS.md</code>. Put <code>@AGENTS.md</code> at the top of\n862:               Claude Code&apos;s <code>CLAUDE.md</code>. Do not maintain two copies.\n863:             </div>\n864:           </section>\n865: \n866:           <section className=\"section-block\" id=\"workflow\">\n867:             <div className=\"section-heading\">\n868:               <p className=\"section-number\">07 / Distributed project</p>\n869:               <h2>Let one frontier model direct smaller workers.</h2>\n870:               <p>\n871:                 The assistants should not edit one checkout together. Coordinate\n872:                 them through task files and Git worktrees, then merge only verified\n873:                 patches.\n874:               </p>\n875:             </div>\n876:             <div className=\"workflow-diagram\" aria-label=\"Distributed coding workflow\">\n877:               <div className=\"workflow-node lead-node\">\n878:                 <span>1 / Lead</span>\n879:                 <strong>GPT-5.6 Sol</strong>\n880:                 <p>Clarify scope, acceptance checks, boundaries, and task split.</p>\n881:               </div>\n882:               <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n883:               <div className=\"workflow-node contract-node\">\n884:                 <span>2 / Contract</span>\n885:                 <strong>Versioned task JSON</strong>\n886:                 <p>Goal, owned files, read-only context, checks, limits, output path.</p>\n887:               </div>\n888:               <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n889:               <div className=\"worker-grid\">\n890:                 <div className=\"workflow-node worker-node\">\n891:                   <span>3A / Bounded worker</span>\n892:                   <strong>OpenCode + DeepSeek</strong>\n893:                   <p>Tests, fixtures, boilerplate, or a clearly isolated module.</p>\n894:                 </div>\n895:                 <div className=\"workflow-node worker-node\">\n896:                   <span>3B / Larger worker</span>\n897:                   <strong>Pi + Kimi/Qwen Cloud</strong>\n898:                   <p>Longer isolated implementation with machine-readable output.</p>\n899:                 </div>\n900:                 <div className=\"workflow-node worker-node\">\n901:                   <span>3C / Strong worker</span>\n902:                   <strong>Codex Terra / Sonnet 5</strong>\n903:                   <p>Difficult integration point, migration, or cross-file logic.</p>\n904:                 </div>\n905:               </div>\n906:               <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n907:               <div className=\"workflow-node review-node\">\n908:                 <span>4 / Independent review</span>\n909:                 <strong>Claude Opus 5</strong>\n910:                 <p>Review patches from the other vendor, run full checks, and list merge risks.</p>\n911:               </div>\n912:               <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n913:               <div className=\"workflow-node human-node\">\n914:                 <span>5 / Decision</span>\n915:                 <strong>Tests + human approval</strong>\n916:                 <p>Merge one patch at a time. Re-run the full suite after every merge.</p>\n917:               </div>\n918:             </div>\n919:             <div className=\"contract-grid\">\n920:               <article>\n921:                 <span>Task file must say</span>\n922:                 <ul>\n923:                   <li>One clear outcome</li>\n924:                   <li>Files the worker owns</li>\n925:                   <li>Files it may read but not edit</li>\n926:                   <li>Acceptance and verification commands</li>\n927:                   <li>Time, tool, and permission limits</li>\n928:                 </ul>\n929:               </article>\n930:               <article>\n931:                 <span>Worker must return</span>\n932:                 <ul>\n933:                   <li>Status: complete, failed, or blocked</li>\n934:                   <li>Patch and changed-file list</li>\n935:                   <li>Commands run and results</li>\n936:                   <li>Assumptions and remaining risks</li>\n937:                   <li>No merge, push, deploy, or hidden side effect</li>\n938:                 </ul>\n939:               </article>\n940:               <article>\n941:                 <span>Rotate bias</span>\n942:                 <ul>\n943:                   <li>Run once with Sol leading and Opus reviewing</li>\n944:                   <li>Run once with Opus leading and Sol reviewing</li>\n945:                   <li>Keep worker tasks and acceptance checks unchanged</li>\n946:                   <li>Compare coordination time and integration failures</li>\n947:                 </ul>\n948:               </article>\n949:             </div>\n950:           </section>\n951: \n952:           <section className=\"section-block\" id=\"steps\">\n953:             <div className=\"section-heading steps-heading\">\n954:               <div>\n955:                 <p className=\"section-number\">08 / Step-by-step</p>\n956:                 <h2>Follow this sequence.</h2>\n957:                 <p>Check a stage when its evidence is saved, not when it has merely started.</p>\n958:               </div>\n959:               <div className=\"large-progress\" aria-label={progressText}>\n960:                 <div>\n961:                   <strong>{percent}%</strong>\n962:                   <button onClick={resetProgress}>Reset</button>\n963:                 </div>\n964:                 <span aria-hidden=\"true\"><span style={{ width: `${percent}%` }} /></span>\n965:                 <p>{progressText}</p>\n966:               </div>\n967:             </div>\n968:             <div className=\"timeline\">\n969:               {stages.map((stage, index) => {\n970:                 const isDone = completed.includes(stage.id);\n971:                 return (\n972:                   <article className={`stage-card ${isDone ? \"is-done\" : \"\"}`} key={stage.id}>\n973:                     <button\n974:                       className=\"stage-check\"\n975:                       aria-label={`${isDone ? \"Mark incomplete\" : \"Mark complete\"}: ${stage.title}`}\n976:                       aria-pressed={isDone}\n977:                       onClick={() => toggleStage(stage.id)}\n978:                     >\n979:                       <CheckIcon checked={isDone} />\n980:                     </button>\n981:                     <div className=\"stage-index\">{String(index + 1).padStart(2, \"0\")}</div>\n982:                     <div className=\"stage-copy\">\n983:                       <span>{stage.week}</span>\n984:                       <h3>{stage.title}</h3>\n985:                       <p>{stage.goal}</p>\n986:                     </div>\n987:                     <ul>\n988:                       {stage.items.map((item) => <li key={item}>{item}</li>)}\n989:                     </ul>\n990:                   </article>\n991:                 );\n992:               })}\n993:             </div>\n994:           </section>\n995: \n996:           <section className=\"section-block start-section\" id=\"start\">\n997:             <div className=\"section-heading\">\n998:               <p className=\"section-number\">09 / Start here</p>\n999:               <h2>Your first working session.</h2>\n1000:               <p>\n1001:                 Do only these actions first. Do not download every model or build a\n1002:                 large dashboard before the first end-to-end run works.\n1003:               </p>\n1004:             </div>\n1005:             <div className=\"start-grid\">\n1006:               <article className=\"command-card\">\n1007:                 <div className=\"command-title\">\n1008:                   <span>1</span>\n1009:                   <h3>Record the environment</h3>\n1010:                 </div>\n1011:                 <pre><code>{`codex --version\n1012: claude --version\n1013: opencode --version\n1014: pi --version\n1015: ollama --version\n1016: ollama list\n1017: git rev-parse HEAD\n1018: system_profiler SPHardwareDataType`}</code></pre>\n1019:               </article>\n1020:               <article className=\"command-card\">\n1021:                 <div className=\"command-title\">\n1022:                   <span>2</span>\n1023:                   <h3>Confirm the common model</h3>\n1024:                 </div>\n1025:                 <pre><code>{`ollama pull deepseek-v4-flash:cloud\n1026: ollama run deepseek-v4-flash:cloud\n1027: ollama pull kimi-k2.7-code:cloud\n1028: \n1029: # Optional laptop-sized local control:\n1030: ollama pull qwen3:8b`}</code></pre>\n1031:               </article>\n1032:               <article className=\"command-card wide-card\">\n1033:                 <div className=\"command-title\">\n1034:                   <span>3</span>\n1035:                   <h3>Create the evidence folders</h3>\n1036:                 </div>\n1037:                 <pre><code>{`benchmark/\n1038: ├── STUDY.md\n1039: ├── tasks/T1-repo-map/\n1040: │   ├── prompt.md\n1041: │   ├── rubric.json\n1042: │   └── fixture.lock\n1043: ├── schemas/{run,task,result}.schema.json\n1044: ├── runner/\n1045: └── runs/<run-id>/\n1046:     ├── metadata.json\n1047:     ├── prompt.md\n1048:     ├── events.jsonl\n1049:     ├── stdout.log\n1050:     ├── stderr.log\n1051:     ├── changes.patch\n1052:     ├── tests.json\n1053:     ├── result.json\n1054:     └── grader.json`}</code></pre>\n1055:               </article>\n1056:             </div>\n1057:             <div className=\"first-run\">\n1058:               <div>\n1059:                 <p className=\"eyebrow\">The first proof</p>\n1060:                 <h3>Run T1 once in OpenCode with DeepSeek V4 Flash Cloud.</h3>\n1061:                 <p>\n1062:                   Start from a clean repository. Ask for the repository map in\n1063:                   read-only mode. Save every artifact, run the grader, then reset.\n1064:                   Only after that succeeds should you add Codex, Claude Code, and Pi.\n1065:                 </p>\n1066:               </div>\n1067:               <ol>\n1068:                 <li>One task</li>\n1069:                 <li>One model</li>\n1070:                 <li>One assistant</li>\n1071:                 <li>One complete evidence folder</li>\n1072:               </ol>\n1073:             </div>\n1074:           </section>\n1075: \n1076:           <section className=\"section-block guardrails-section\">\n1077:             <div className=\"section-heading\">\n1078:               <p className=\"section-number\">Guardrails</p>\n1079:               <h2>Rules that keep the project credible.</h2>\n1080:             </div>\n1081:             <div className=\"guardrail-grid\">\n1082:               <p><span>01</span> Freeze prompt and task versions before comparison.</p>\n1083:               <p><span>02</span> Never let two workers write the same worktree.</p>\n1084:               <p><span>03</span> Do not grade only the final answer; grade the patch and tests.</p>\n1085:               <p><span>04</span> Record failures, refusals, crashes, and abandoned runs.</p>\n1086:               <p><span>05</span> Keep credentials outside prompts, logs, patches, and repositories.</p>\n1087:               <p><span>06</span> Require human approval for merges, pushes, deploys, and destructive actions.</p>\n1088:               <p><span>07</span> Review third-party plugins and MCP servers before installation.</p>\n1089:               <p><span>08</span> Re-run a study block when a model or assistant version changes materially.</p>\n1090:             </div>\n1091:           </section>\n1092: \n1093:           <section className=\"section-block sources-section\">\n1094:             <div className=\"section-heading split-heading\">\n1095:               <div>\n1096:                 <p className=\"section-number\">Current references</p>\n1097:                 <h2>Primary sources used for this plan.</h2>\n1098:               </div>\n1099:               <p>\n1100:                 Model and product details were checked on August 22, 2026. Recheck\n1101:                 the catalogs immediately before the first recorded run.\n1102:               </p>\n1103:             </div>\n1104:             <div className=\"source-grid\">\n1105:               {sources.map(([label, href], index) => (\n1106:                 <a href={href} target=\"_blank\" rel=\"noreferrer\" key={href}>\n1107:                   <span>{String(index + 1).padStart(2, \"0\")}</span>\n1108:                   {label}\n1109:                   <span aria-hidden=\"true\">↗</span>\n1110:                 </a>\n1111:               ))}\n1112:             </div>\n1113:           </section>\n1114: \n1115:           <footer>\n1116:             <p>Coding assistant study plan</p>\n1117:             <p>Prepared August 22, 2026 · Keep the evidence, not just the winner.</p>\n1118:           </footer>\n1119:         </main>\n1120:       </div>\n1121:     </>\n1122:   );\n1123: }\n\n(End of file - total 1123 lines)\n</content>","metadata":{"preview":"\"use client\";\n\nimport { useEffect, useMemo, useState } from \"react\";\n\nconst assistantCards = [\n  {\n    name: \"Codex\",\n    role: \"Primary assistant\",\n    mark: \"CX\",\n    summary:\n      \"Use it for the strongest OpenAI-native workflow: planning, implementation, parallel subagents, review, browser checks, and long-running work.\",\n    test: \"App and CLI flow, worktrees, custom agents, skills, plugins, MCP, hooks, approvals, structured non-interactive output.\",\n  },\n  {\n    name: \"Claude Code\",\n    role: \"Primary assistant\",\n    mark: \"CC\",\n    summary:\n      \"Use it for Anthropic-native coding, long tasks, careful planning, and its mature set of subagents, teams, hooks, MCP, and plugins.\",\n    test: \"Plan mode, subagents, agent view, agent teams, worktrees, plugin marketplace, hooks, MCP, permissions, print/JSON mode.\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/ammarbinayaz/Documents/coding-assistant-benchmarking/app/page.tsx","text":"\"use client\";\n\nimport { useEffect, useMemo, useState } from \"react\";\n\nconst assistantCards = [\n  {\n    name: \"Codex\",\n    role: \"Primary assistant\",\n    mark: \"CX\",\n    summary:\n      \"Use it for the strongest OpenAI-native workflow: planning, implementation, parallel subagents, review, browser checks, and long-running work.\",\n    test: \"App and CLI flow, worktrees, custom agents, skills, plugins, MCP, hooks, approvals, structured non-interactive output.\",\n  },\n  {\n    name: \"Claude Code\",\n    role: \"Primary assistant\",\n    mark: \"CC\",\n    summary:\n      \"Use it for Anthropic-native coding, long tasks, careful planning, and its mature set of subagents, teams, hooks, MCP, and plugins.\",\n    test: \"Plan mode, subagents, agent view, agent teams, worktrees, plugin marketplace, hooks, MCP, permissions, print/JSON mode.\",\n  },\n  {\n    name: \"OpenCode\",\n    role: \"Primary assistant\",\n    mark: \"OC\",\n    summary:\n      \"Use it as the provider-flexible assistant. It is the cleanest place to compare local, cloud, and paid models without changing your daily interface.\",\n    test: \"Provider switching, Ollama discovery, agents, skills, MCP, plugins, permissions, session handling, run/server modes.\",\n  },\n  {\n    name: \"Pi\",\n    role: \"Neutral lab bench\",\n    mark: \"PI\",\n    summary:\n      \"Use Pi to compare models inside one minimal harness. It supports your OpenAI and Anthropic subscriptions plus custom local providers.\",\n    test: \"Model portability, extensions, skills, packages, JSON/RPC/SDK modes, session branching, and the cost of adding missing controls.\",\n  },\n];\n\nconst modelRows = [\n  {\n    model: \"GPT-5.6 Sol\",\n    maker: \"OpenAI\",\n    lane: \"Frontier\",\n    access: \"Codex subscription; API optional\",\n    use: \"Top-level planning, hardest fixes, final review\",\n    priority: \"Required\",\n  },\n  {\n    model: \"GPT-5.6 Terra\",\n    maker: \"OpenAI\",\n    lane: \"Efficient frontier\",\n    access: \"Codex subscription where listed; API optional\",\n    use: \"Exploration, review, medium-complexity worker\",\n    priority: \"Required\",\n  },\n  {\n    model: \"GPT-5.6 Luna\",\n    maker: \"OpenAI\",\n    lane: \"Low cost\",\n    access: \"API or catalog access\",\n    use: \"Simple scans, formatting, repetitive checks\",\n    priority: \"Optional\",\n  },\n  {\n    model: \"Claude Opus 5\",\n    maker: \"Anthropic\",\n    lane: \"Frontier\",\n    access: \"Claude subscription, plan dependent\",\n    use: \"Top-level planning, long work, difficult review\",\n    priority: \"Required\",\n  },\n  {\n    model: \"Claude Sonnet 5\",\n    maker: \"Anthropic\",\n    lane: \"Workhorse\",\n    access: \"Claude Code subscription\",\n    use: \"Daily coding baseline and moderate workers\",\n    priority: \"Required\",\n  },\n  {\n    model: \"Claude Fable 5\",\n    maker: \"Anthropic\",\n    lane: \"Frontier ceiling\",\n    access: \"Usage credits / account availability\",\n    use: \"One or two hardest runs only\",\n    priority: \"Stretch\",\n  },\n  {\n    model: \"Claude Haiku 4.5\",\n    maker: \"Anthropic\",\n    lane: \"Low cost\",\n    access: \"API or subscription catalog\",\n    use: \"Fast small worker and parallel scans\",\n    priority: \"Optional\",\n  },\n  {\n    model: \"Qwen3 Coder 480B Cloud\",\n    maker: \"Qwen\",\n    lane: \"Hosted open weight\",\n    access: \"Ollama Cloud\",\n    use: \"Optional third hosted coding model after the pilot\",\n    priority: \"Optional\",\n  },\n  {\n    model: \"Kimi K2.7 Code\",\n    maker: \"Moonshot AI\",\n    lane: \"Hosted open weight\",\n    access: \"Ollama Cloud\",\n    use: \"Long coding tasks and tool-heavy worker runs\",\n    priority: \"Required\",\n  },\n  {\n    model: \"DeepSeek V4 Flash\",\n    maker: \"DeepSeek\",\n    lane: \"Hosted open weight\",\n    access: \"Ollama Cloud\",\n    use: \"Long-context and cost-aware worker runs\",\n    priority: \"Required\",\n  },\n  {\n    model: \"Qwen3 8B\",\n    maker: \"Qwen\",\n    lane: \"Small local control\",\n    access: \"Ollama\",\n    use: \"Measure the quality and speed tradeoff of a laptop-sized worker\",\n    priority: \"Optional\",\n  },\n];\n\nconst benchmarkLanes = [\n  {\n    number: \"01\",\n    title: \"Compare the assistants\",\n    lock: \"Keep the model fixed\",\n    body: \"Run deepseek-v4-flash:cloud through Codex, Claude Code, OpenCode, and Pi. The same hosted model avoids turning laptop limits into an assistant advantage.\",\n    runs: \"4 assistants × 4 tasks × 2 runs = 32\",\n    answers: \"Which assistant plans better, uses tools better, stays in scope, recovers from errors, and needs fewer interventions?\",\n  },\n  {\n    number: \"02\",\n    title: \"Compare the models\",\n    lock: \"Keep the assistant fixed\",\n    body: \"Use Pi as the intended neutral harness after access is verified. Test the selected OpenAI and Anthropic models plus DeepSeek, Kimi, and an optional Qwen Cloud model with identical conditions.\",\n    runs: \"7 models × 4 tasks × 2 runs = 56\",\n    answers: \"Which model gives the best quality, time, and cost when the surrounding assistant is unchanged?\",\n  },\n  {\n    number: \"03\",\n    title: \"Compare real daily use\",\n    lock: \"Use each native best pairing\",\n    body: \"Run Codex + Sol, Claude Code + Opus or Sonnet, and OpenCode + the best open model from the pilot on two hard tasks.\",\n    runs: \"3 native pairs × 2 tasks × 1 run = 6\",\n    answers: \"Which full product would you choose when fairness matters less than getting the work done?\",\n  },\n];\n\nconst taskRows = [\n  {\n    id: \"T1\",\n    kind: \"Core\",\n    title: \"Understand an unfamiliar repository\",\n    setup: \"Ask for an architecture map, main request flow, risky areas, and a short change plan. Read-only.\",\n    pass: \"Matches a maintainer-written answer key; cites the right files; makes no edits.\",\n  },\n  {\n    id: \"T2\",\n    kind: \"Core\",\n    title: \"Fix a real bug\",\n    setup: \"Seed one edge-case bug with visible tests and hidden tests. Give only the issue report and reproduction.\",\n    pass: \"All tests pass, the root cause is fixed, and the diff does not include unrelated cleanup.\",\n  },\n  {\n    id: \"T3\",\n    kind: \"Core\",\n    title: \"Build a multi-file feature\",\n    setup: \"Add one API or data feature that needs schema, business logic, validation, tests, and docs.\",\n    pass: \"Acceptance tests pass; error paths work; existing behavior remains stable.\",\n  },\n  {\n    id: \"T4\",\n    kind: \"Core\",\n    title: \"Build and verify a user interface\",\n    setup: \"Provide a screenshot plus written behavior for desktop and mobile. Require keyboard use and browser verification.\",\n    pass: \"Functional checks, visual checks, accessibility checks, and console checks pass.\",\n  },\n  {\n    id: \"T5\",\n    kind: \"Challenge\",\n    title: \"Refactor without changing behavior\",\n    setup: \"Give a large, awkward module and freeze behavior with characterization tests before the refactor.\",\n    pass: \"Same public behavior, smaller clear units, no snapshot churn, and measured complexity improvement.\",\n  },\n  {\n    id: \"T6\",\n    kind: \"Challenge\",\n    title: \"Upgrade a dependency or API\",\n    setup: \"Pin an older library, provide current docs, and require a safe migration with a rollback note.\",\n    pass: \"Build and tests pass; deprecated usage is gone; no unnecessary dependency changes.\",\n  },\n  {\n    id: \"T7\",\n    kind: \"Challenge\",\n    title: \"Investigate an incident and a security flaw\",\n    setup: \"Use a controlled fixture with logs, one vulnerable path, noise, and a safe reproduction.\",\n    pass: \"Finds the real cause, ranks risk correctly, patches it, adds regression tests, and avoids unsafe actions.\",\n  },\n  {\n    id: \"T8\",\n    kind: \"Challenge\",\n    title: \"Repair CI and improve project guidance\",\n    setup: \"Give a broken pipeline, weak README, and missing assistant instructions.\",\n    pass: \"CI passes; setup is reproducible; AGENTS.md is short, specific, and useful across assistants.\",\n  },\n];\n\nconst scoreRows = [\n  [\"Correctness\", \"35\", \"Acceptance tests and hidden tests\"],\n  [\"No regressions\", \"15\", \"Existing tests and behavior stay intact\"],\n  [\"Scope discipline\", \"10\", \"Only necessary files and changes\"],\n  [\"Code quality\", \"10\", \"Clear, maintainable, and consistent with the repo\"],\n  [\"Autonomy\", \"8\", \"Few human corrections or repeated instructions\"],\n  [\"Tool and safety discipline\", \"7\", \"Good permission choices; no risky shortcuts\"],\n  [\"Time\", \"5\", \"Time to an accepted result, not time to first answer\"],\n  [\"Usage or cost\", \"5\", \"Tokens, subscription quota, cloud units, or local energy proxy\"],\n  [\"Explanation\", \"5\", \"Accurate summary, verification, and remaining risks\"],\n];\n\nconst extensionRows = [\n  {\n    surface: \"Project rules\",\n    common: \"Keep AGENTS.md as the single source. Claude's CLAUDE.md should import it with @AGENTS.md.\",\n    measure: \"Rule following and context size\",\n  },\n  {\n    surface: \"Skills\",\n    common: \"Reuse one small SKILL.md workflow through each assistant's discovery path.\",\n    measure: \"Portability, setup time, and quality gain\",\n  },\n  {\n    surface: \"MCP\",\n    common: \"Configure the same read-only docs or issue-tracker server in each assistant.\",\n    measure: \"Connection reliability, tool accuracy, permission clarity\",\n  },\n  {\n    surface: \"Hooks and guards\",\n    common: \"Apply the same policy: block secrets, format changed files, and run a focused check after edits.\",\n    measure: \"Coverage, false blocks, debuggability\",\n  },\n  {\n    surface: \"Plugins and extensions\",\n    common: \"Package the rule, skill, tool, and guard only after the loose version works.\",\n    measure: \"Install, update, permissions, versioning, and removal\",\n  },\n];\n\nconst stages = [\n  {\n    id: \"stage-0\",\n    week: \"Day 1\",\n    title: \"Freeze the study\",\n    goal: \"Write the question before seeing results.\",\n    items: [\n      \"Create STUDY.md with the three comparison lanes, the scorecard, and your stop rules.\",\n      \"Record machine, operating system, RAM/VRAM, assistant versions, model IDs, and subscription tier.\",\n      \"Turn off auto-updates for the study window where practical, or record every update as a new study block.\",\n      \"Set a hard optional-spend cap. Start with subscriptions and Ollama; add paid API runs only after the pilot.\",\n    ],\n  },\n  {\n    id: \"stage-1\",\n    week: \"Days 2–4\",\n    title: \"Build the task pack\",\n    goal: \"Make the result gradeable without model judgment.\",\n    items: [\n      \"Prepare T1–T4 first. Use small real repositories or frozen fixtures with clean reset commits.\",\n      \"Write visible acceptance criteria and separate hidden tests before any assistant sees the task.\",\n      \"Create one prompt per task. Do not mention the assistant or model name inside the prompt.\",\n      \"Manually solve each task once so you know it is possible and know the expected effort.\",\n    ],\n  },\n  {\n    id: \"stage-2\",\n    week: \"Days 5–7\",\n    title: \"Build the runner\",\n    goal: \"Capture the same evidence for every run.\",\n    items: [\n      \"Start each run from the same Git commit in its own worktree.\",\n      \"Wrap codex exec, claude -p, opencode run, and Pi print/JSON mode behind one run command.\",\n      \"Save prompt, settings, stdout, stderr, event log, patch, tests, elapsed time, interventions, and final answer.\",\n      \"Use a run ID and never overwrite a prior run.\",\n    ],\n  },\n  {\n    id: \"stage-3\",\n    week: \"Week 2\",\n    title: \"Run the 28-run pilot\",\n    goal: \"Find broken tasks and weak candidates cheaply.\",\n    items: [\n      \"Assistant pilot: 4 assistants × T1 and T2 × 1 run = 8.\",\n      \"Model pilot: 7 models in Pi × T1 and T2 × 1 run = 14.\",\n      \"Native pilot: 3 native pairings × T1 and T2 × 1 run = 6.\",\n      \"Fix the harness, prompts, or hidden tests only if the issue affects everyone. Version every change.\",\n    ],\n  },\n  {\n    id: \"stage-4\",\n    week: \"Weeks 3–4\",\n    title: \"Complete the 94-run core study\",\n    goal: \"Collect repeatable evidence, not impressions.\",\n    items: [\n      \"Complete the assistant lane: 32 total runs across T1–T4.\",\n      \"Complete the model lane: 56 total runs across T1–T4.\",\n      \"Complete the native lane: 6 runs on two challenge tasks.\",\n      \"Randomize run order, clear sessions, restore the repository, and grade before revealing model identity where possible.\",\n    ],\n  },\n  {\n    id: \"stage-5\",\n    week: \"Week 5\",\n    title: \"Test the extension ecosystems\",\n    goal: \"Measure what customization actually buys you.\",\n    items: [\n      \"Run one task with no extensions, then with a shared rule, one skill, one MCP server, and one safety guard.\",\n      \"Record install time, failures, context overhead, permission prompts, and whether the extension improved the final score.\",\n      \"Treat skills and MCP as portable building blocks. Treat plugin packaging and hooks as assistant-specific.\",\n      \"Do not install a large plugin bundle until you have reviewed its code, permissions, and external connections.\",\n    ],\n  },\n  {\n    id: \"stage-6\",\n    week: \"Week 6\",\n    title: \"Run the distributed project\",\n    goal: \"Prove that a frontier planner can direct smaller workers.\",\n    items: [\n      \"Use GPT-5.6 Sol as the first lead. Repeat once with Claude Opus 5 as lead.\",\n      \"Give each worker a separate worktree, owned files, acceptance tests, and a machine-readable task file.\",\n      \"Use DeepSeek for a bounded implementation, Kimi or Qwen Cloud for a larger worker task, and Terra or Sonnet for the difficult middle layer.\",\n      \"Use the other vendor's frontier model as final reviewer, then run all tests and make the merge decision yourself.\",\n    ],\n  },\n  {\n    id: \"stage-7\",\n    week: \"Final 2 days\",\n    title: \"Analyze and publish\",\n    goal: \"Make the conclusion honest and reusable.\",\n    items: [\n      \"Report medians and ranges; show every failure and intervention, not only the best run.\",\n      \"Separate assistant effects, model effects, and native-pair results in the report.\",\n      \"Write recommendations by task type: best planner, best daily driver, best local worker, best value, best extension system.\",\n      \"Publish prompts, task versions, runner code, scoring rules, and raw results where licenses and privacy allow.\",\n    ],\n  },\n];\n\nconst sources = [\n  [\"OpenAI model guidance\", \"https://developers.openai.com/api/docs/guides/latest-model\"],\n  [\"OpenAI model catalog\", \"https://developers.openai.com/api/docs/models\"],\n  [\"Claude Code parallel agents\", \"https://code.claude.com/docs/en/agents\"],\n  [\"Claude Code extension map\", \"https://code.claude.com/docs/en/features-overview\"],\n  [\"Claude Code plugins\", \"https://code.claude.com/docs/en/plugins\"],\n  [\"OpenCode providers\", \"https://opencode.ai/docs/providers\"],\n  [\"OpenCode agents\", \"https://opencode.ai/docs/agents/\"],\n  [\"OpenCode skills\", \"https://opencode.ai/docs/skills\"],\n  [\"Pi agent harness\", \"https://github.com/earendil-works/pi\"],\n  [\"Ollama launch integrations\", \"https://ollama.com/blog/launch\"],\n  [\"Qwen3 Coder on Ollama\", \"https://ollama.com/library/qwen3-coder\"],\n  [\"Kimi K2.7 Code on Ollama\", \"https://ollama.com/library/kimi-k2.7-code\"],\n  [\"DeepSeek V4 Flash on Ollama\", \"https://ollama.com/library/deepseek-v4-flash\"],\n  [\"Claude Opus 5\", \"https://www.anthropic.com/news/claude-opus-5\"],\n  [\"Claude Sonnet 5\", \"https://www.anthropic.com/news/claude-sonnet-5\"],\n];\n\nconst navItems = [\n  [\"scope\", \"Scope\"],\n  [\"models\", \"Models\"],\n  [\"design\", \"Study design\"],\n  [\"tasks\", \"Tasks\"],\n  [\"score\", \"Scoring\"],\n  [\"ecosystem\", \"Extensions\"],\n  [\"workflow\", \"Distributed work\"],\n  [\"steps\", \"Step-by-step\"],\n  [\"start\", \"Start here\"],\n];\n\nfunction CheckIcon({ checked }: { checked: boolean }) {\n  return <span aria-hidden=\"true\">{checked ? \"✓\" : \"\"}</span>;\n}\n\nexport default function Home() {\n  const [completed, setCompleted] = useState<string[]>([]);\n\n  useEffect(() => {\n    let timer: number | undefined;\n    try {\n      const saved = window.localStorage.getItem(\"assistant-study-progress\");\n      const parsed = saved ? JSON.parse(saved) : [];\n      if (Array.isArray(parsed)) {\n        timer = window.setTimeout(\n          () => setCompleted(parsed.filter((item) => typeof item === \"string\")),\n          0,\n        );\n      }\n    } catch {\n      // Progress is a convenience. The plan still works without browser storage.\n    }\n    return () => {\n      if (timer !== undefined) window.clearTimeout(timer);\n    };\n  }, []);\n\n  const completeCount = completed.length;\n  const percent = Math.round((completeCount / stages.length) * 100);\n  const progressText = useMemo(\n    () => `${completeCount} of ${stages.length} stages complete`,\n    [completeCount],\n  );\n\n  function toggleStage(id: string) {\n    const next = completed.includes(id)\n      ? completed.filter((item) => item !== id)\n      : [...completed, id];\n    setCompleted(next);\n    try {\n      window.localStorage.setItem(\n        \"assistant-study-progress\",\n        JSON.stringify(next),\n      );\n    } catch {\n      // Ignore storage failures.\n    }\n  }\n\n  function resetProgress() {\n    setCompleted([]);\n    try {\n      window.localStorage.removeItem(\"assistant-study-progress\");\n    } catch {\n      // Ignore storage failures.\n    }\n  }\n\n  return (\n    <>\n      <a className=\"skip-link\" href=\"#main-content\">\n        Skip to the plan\n      </a>\n\n      <header className=\"site-header\">\n        <a className=\"brand\" href=\"#top\" aria-label=\"Coding assistant study home\">\n          <span className=\"brand-mark\">LAB / 01</span>\n          <span>Coding assistant study</span>\n        </a>\n        <div className=\"header-actions\">\n          <div className=\"mini-progress\" aria-label={progressText}>\n            <span>{progressText}</span>\n            <span className=\"mini-track\" aria-hidden=\"true\">\n              <span style={{ width: `${percent}%` }} />\n            </span>\n          </div>\n          <button className=\"text-button print-button\" onClick={() => window.print()}>\n            Print / save PDF\n          </button>\n        </div>\n      </header>\n\n      <div className=\"page-shell\" id=\"top\">\n        <aside className=\"side-nav\" aria-label=\"Plan sections\">\n          <p className=\"eyebrow\">On this page</p>\n          <nav>\n            {navItems.map(([id, label], index) => (\n              <a href={`#${id}`} key={id}>\n                <span>{String(index + 1).padStart(2, \"0\")}</span>\n                {label}\n              </a>\n            ))}\n          </nav>\n          <div className=\"side-note\">\n            <p>Study size</p>\n            <strong>94 core runs</strong>\n            <span>plus one distributed project</span>\n          </div>\n        </aside>\n\n        <main id=\"main-content\">\n          <section className=\"hero\" aria-labelledby=\"hero-title\">\n            <div className=\"hero-copy\">\n              <p className=\"kicker\">A practical six-week benchmark</p>\n              <h1 id=\"hero-title\">\n                Find the right <em>assistant</em>, the right <em>model</em>, and the\n                right way to combine them.\n              </h1>\n              <p className=\"hero-lede\">\n                A repeatable study of Codex, Claude Code, and OpenCode—with Pi as\n                a neutral model lab, and Ollama for local and hosted open models.\n              </p>\n              <div className=\"hero-actions\">\n                <a className=\"primary-button\" href=\"#start\">\n                  Begin with Day 1\n                </a>\n                <a className=\"secondary-button\" href=\"#design\">\n                  See the study design\n                </a>\n              </div>\n            </div>\n            <div className=\"hero-brief\" aria-label=\"Key recommendation\">\n              <p className=\"eyebrow\">My recommendation</p>\n              <p className=\"brief-big\">Do not run every model in every assistant.</p>\n              <p>\n                First hold the model fixed to measure the assistant. Then hold the\n                assistant fixed to measure the model. Finally test each native\n                pairing as a complete product.\n              </p>\n              <dl>\n                <div>\n                  <dt>Lead model</dt>\n                  <dd>GPT-5.6 Sol, then Opus 5</dd>\n                </div>\n                <div>\n                  <dt>Shared baseline</dt>\n                  <dd>DeepSeek V4 Flash Cloud</dd>\n                </div>\n                <div>\n                  <dt>Neutral harness</dt>\n                  <dd>Pi</dd>\n                </div>\n              </dl>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"scope\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">01 / Scope</p>\n              <h2>Four programs, with three in the final ranking.</h2>\n              <p>\n                Here, “assistant” or “harness” means the program around the model:\n                its tools, planning, permissions, memory, plugins, and user\n                experience. Pi is a control instrument, not a fourth primary winner.\n              </p>\n            </div>\n            <div className=\"assistant-grid\">\n              {assistantCards.map((assistant) => (\n                <article className=\"assistant-card\" key={assistant.name}>\n                  <div className=\"assistant-top\">\n                    <span className=\"assistant-mark\">{assistant.mark}</span>\n                    <span className=\"role-pill\">{assistant.role}</span>\n                  </div>\n                  <h3>{assistant.name}</h3>\n                  <p>{assistant.summary}</p>\n                  <div className=\"test-note\">\n                    <span>Inspect</span>\n                    <p>{assistant.test}</p>\n                  </div>\n                </article>\n              ))}\n            </div>\n            <div className=\"callout plain\">\n              <strong>Boundary:</strong> compare Codex, Claude Code, and OpenCode\n              as the products you may keep using. Use Pi to make the model test\n              fair and to explore custom orchestration.\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"models\">\n            <div className=\"section-heading split-heading\">\n              <div>\n                <p className=\"section-number\">02 / Models</p>\n                <h2>A small, current model shortlist.</h2>\n              </div>\n              <p>\n                Exact catalogs change quickly. Record the full model ID visible on\n                the day of each run. “Open weight” is used for downloadable models\n                because their licenses and definitions of open source differ.\n              </p>\n            </div>\n            <div className=\"table-wrap model-table-wrap\" tabIndex={0}>\n              <table>\n                <thead>\n                  <tr>\n                    <th>Model</th>\n                    <th>Class</th>\n                    <th>Access</th>\n                    <th>Use in this study</th>\n                    <th>Priority</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  {modelRows.map((row) => (\n                    <tr key={row.model}>\n                      <td>\n                        <strong>{row.model}</strong>\n                        <span>{row.maker}</span>\n                      </td>\n                      <td>{row.lane}</td>\n                      <td>{row.access}</td>\n                      <td>{row.use}</td>\n                      <td>\n                        <span\n                          className={`priority priority-${row.priority.toLowerCase()}`}\n                        >\n                          {row.priority}\n                        </span>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n            <div className=\"model-rule-grid\">\n              <div>\n                <span>Hardware rule</span>\n                <p>\n                  With 16 GB of unified memory, keep large open-weight models in\n                  Ollama Cloud. Use Qwen3 8B only as a labeled small local control,\n                  not as a substitute inside the shared-model lane.\n                </p>\n              </div>\n              <div>\n                <span>Budget rule</span>\n                <p>\n                  Use subscription access first. Use Ollama Cloud for Kimi and\n                  DeepSeek. Treat Fable, Luna, Haiku, and paid APIs as optional until\n                  the pilot proves they add a useful comparison.\n                </p>\n              </div>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"design\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">03 / Study design</p>\n              <h2>Three lanes prevent the wrong conclusion.</h2>\n              <p>\n                A great result may come from the model, the surrounding program, or\n                both. These lanes separate those effects before you judge the full\n                product.\n              </p>\n            </div>\n            <div className=\"lane-list\">\n              {benchmarkLanes.map((lane) => (\n                <article className=\"lane-card\" key={lane.number}>\n                  <span className=\"lane-number\">{lane.number}</span>\n                  <div className=\"lane-content\">\n                    <div className=\"lane-title-row\">\n                      <h3>{lane.title}</h3>\n                      <span>{lane.lock}</span>\n                    </div>\n                    <p>{lane.body}</p>\n                    <div className=\"lane-meta\">\n                      <p>\n                        <strong>Target:</strong> {lane.runs}\n                      </p>\n                      <p>\n                        <strong>Answers:</strong> {lane.answers}\n                      </p>\n                    </div>\n                  </div>\n                </article>\n              ))}\n            </div>\n            <div className=\"method-strip\">\n              <div>\n                <span>Same start</span>\n                <p>Clean commit and new session</p>\n              </div>\n              <div>\n                <span>Same prompt</span>\n                <p>Versioned and hashed</p>\n              </div>\n              <div>\n                <span>Two runs</span>\n                <p>Report median and range</p>\n              </div>\n              <div>\n                <span>Blind grade</span>\n                <p>Hide identity when possible</p>\n              </div>\n              <div>\n                <span>Stop rule</span>\n                <p>Maximum time and interventions</p>\n              </div>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"tasks\">\n            <div className=\"section-heading split-heading\">\n              <div>\n                <p className=\"section-number\">04 / Task pack</p>\n                <h2>Eight tasks that resemble real work.</h2>\n              </div>\n              <p>\n                Use T1–T4 for the controlled comparison. Use T5–T8 for native\n                product tests, plugin tests, and the distributed project.\n              </p>\n            </div>\n            <div className=\"task-grid\">\n              {taskRows.map((task) => (\n                <article className=\"task-card\" key={task.id}>\n                  <div className=\"task-labels\">\n                    <span>{task.id}</span>\n                    <span>{task.kind}</span>\n                  </div>\n                  <h3>{task.title}</h3>\n                  <p>{task.setup}</p>\n                  <div className=\"pass-line\">\n                    <span>Pass when</span>\n                    <p>{task.pass}</p>\n                  </div>\n                </article>\n              ))}\n            </div>\n            <div className=\"callout warning\">\n              <strong>Do not use public benchmark tasks as your main evidence.</strong>\n              Models may have seen them. Use private, frozen fixtures modeled on\n              work you actually do. Public suites can be a small secondary check.\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"score\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">05 / Scoring</p>\n              <h2>One 100-point score, backed by raw evidence.</h2>\n              <p>\n                The score makes comparison easier. The patch, tests, event log, and\n                human notes remain the source of truth.\n              </p>\n            </div>\n            <div className=\"score-layout\">\n              <div className=\"score-ring\" aria-label=\"100 point score\">\n                <span>100</span>\n                <p>total points</p>\n              </div>\n              <div className=\"score-list\">\n                {scoreRows.map(([label, points, proof]) => (\n                  <div className=\"score-row\" key={label}>\n                    <span className=\"score-points\">{points}</span>\n                    <strong>{label}</strong>\n                    <p>{proof}</p>\n                  </div>\n                ))}\n              </div>\n            </div>\n            <div className=\"evidence-grid\">\n              <div>\n                <h3>Always record</h3>\n                <ul>\n                  <li>Assistant version and exact model ID</li>\n                  <li>Prompt version and repository commit</li>\n                  <li>Context size, reasoning setting, permissions, and plugins</li>\n                  <li>Elapsed time and time to an accepted result</li>\n                  <li>Human interventions and permission prompts</li>\n                </ul>\n              </div>\n              <div>\n                <h3>Always save</h3>\n                <ul>\n                  <li>Event log or full transcript</li>\n                  <li>Standard output and error output</li>\n                  <li>Git patch and changed-file list</li>\n                  <li>Visible and hidden test results</li>\n                  <li>Final response and grader notes</li>\n                </ul>\n              </div>\n              <div>\n                <h3>Count an intervention when</h3>\n                <ul>\n                  <li>You correct a wrong plan or false claim</li>\n                  <li>You provide a file location it should have found</li>\n                  <li>You ask it to run a required check again</li>\n                  <li>You approve a normal expected action only if comparing UX</li>\n                  <li>You restart after a crash or unrecoverable loop</li>\n                </ul>\n              </div>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"ecosystem\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">06 / Skills, plugins, MCP, and hooks</p>\n              <h2>Share the simple pieces. Keep product-specific wiring thin.</h2>\n              <p>\n                Skills and MCP are the most portable layer. Plugin packaging,\n                lifecycle hooks, and permissions differ, so compare them as product\n                features rather than forcing one configuration everywhere.\n              </p>\n            </div>\n            <div className=\"portable-stack\" aria-label=\"Portable extension stack\">\n              <div>\n                <span>Shared rules</span>\n                <strong>AGENTS.md</strong>\n              </div>\n              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n              <div>\n                <span>Shared workflow</span>\n                <strong>SKILL.md</strong>\n              </div>\n              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n              <div>\n                <span>Shared tools</span>\n                <strong>MCP servers</strong>\n              </div>\n              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n              <div>\n                <span>Local enforcement</span>\n                <strong>Hooks + permissions</strong>\n              </div>\n            </div>\n            <div className=\"table-wrap\" tabIndex={0}>\n              <table className=\"extension-table\">\n                <thead>\n                  <tr>\n                    <th>Layer</th>\n                    <th>How to use it across assistants</th>\n                    <th>What to measure</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  {extensionRows.map((row) => (\n                    <tr key={row.surface}>\n                      <td><strong>{row.surface}</strong></td>\n                      <td>{row.common}</td>\n                      <td>{row.measure}</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n            <div className=\"ecosystem-notes\">\n              <article>\n                <span>Codex</span>\n                <p>\n                  Test project instructions, skills, installable plugins, MCP,\n                  hooks, custom agents, subagents, and structured exec output.\n                </p>\n              </article>\n              <article>\n                <span>Claude Code</span>\n                <p>\n                  Test CLAUDE.md importing AGENTS.md, skills, marketplace plugins,\n                  MCP, deterministic hooks, subagents, agent teams, and worktrees.\n                </p>\n              </article>\n              <article>\n                <span>OpenCode</span>\n                <p>\n                  Test AGENTS.md, shared skills, provider plugins, custom tools, MCP,\n                  fine-grained permissions, and its evolving V2 plugin API.\n                </p>\n              </article>\n              <article>\n                <span>Pi</span>\n                <p>\n                  Test AGENTS.md, Agent Skills, TypeScript extensions, packages,\n                  JSON/RPC/SDK use, and external sandboxing because Pi has no built-in\n                  permission boundary.\n                </p>\n              </article>\n            </div>\n            <div className=\"callout plain\">\n              <strong>Cross-tool rule file:</strong> keep the real project guidance in\n              <code> AGENTS.md</code>. Put <code>@AGENTS.md</code> at the top of\n              Claude Code&apos;s <code>CLAUDE.md</code>. Do not maintain two copies.\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"workflow\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">07 / Distributed project</p>\n              <h2>Let one frontier model direct smaller workers.</h2>\n              <p>\n                The assistants should not edit one checkout together. Coordinate\n                them through task files and Git worktrees, then merge only verified\n                patches.\n              </p>\n            </div>\n            <div className=\"workflow-diagram\" aria-label=\"Distributed coding workflow\">\n              <div className=\"workflow-node lead-node\">\n                <span>1 / Lead</span>\n                <strong>GPT-5.6 Sol</strong>\n                <p>Clarify scope, acceptance checks, boundaries, and task split.</p>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"workflow-node contract-node\">\n                <span>2 / Contract</span>\n                <strong>Versioned task JSON</strong>\n                <p>Goal, owned files, read-only context, checks, limits, output path.</p>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"worker-grid\">\n                <div className=\"workflow-node worker-node\">\n                  <span>3A / Bounded worker</span>\n                  <strong>OpenCode + DeepSeek</strong>\n                  <p>Tests, fixtures, boilerplate, or a clearly isolated module.</p>\n                </div>\n                <div className=\"workflow-node worker-node\">\n                  <span>3B / Larger worker</span>\n                  <strong>Pi + Kimi/Qwen Cloud</strong>\n                  <p>Longer isolated implementation with machine-readable output.</p>\n                </div>\n                <div className=\"workflow-node worker-node\">\n                  <span>3C / Strong worker</span>\n                  <strong>Codex Terra / Sonnet 5</strong>\n                  <p>Difficult integration point, migration, or cross-file logic.</p>\n                </div>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"workflow-node review-node\">\n                <span>4 / Independent review</span>\n                <strong>Claude Opus 5</strong>\n                <p>Review patches from the other vendor, run full checks, and list merge risks.</p>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"workflow-node human-node\">\n                <span>5 / Decision</span>\n                <strong>Tests + human approval</strong>\n                <p>Merge one patch at a time. Re-run the full suite after every merge.</p>\n              </div>\n            </div>\n            <div className=\"contract-grid\">\n              <article>\n                <span>Task file must say</span>\n                <ul>\n                  <li>One clear outcome</li>\n                  <li>Files the worker owns</li>\n                  <li>Files it may read but not edit</li>\n                  <li>Acceptance and verification commands</li>\n                  <li>Time, tool, and permission limits</li>\n                </ul>\n              </article>\n              <article>\n                <span>Worker must return</span>\n                <ul>\n                  <li>Status: complete, failed, or blocked</li>\n                  <li>Patch and changed-file list</li>\n                  <li>Commands run and results</li>\n                  <li>Assumptions and remaining risks</li>\n                  <li>No merge, push, deploy, or hidden side effect</li>\n                </ul>\n              </article>\n              <article>\n                <span>Rotate bias</span>\n                <ul>\n                  <li>Run once with Sol leading and Opus reviewing</li>\n                  <li>Run once with Opus leading and Sol reviewing</li>\n                  <li>Keep worker tasks and acceptance checks unchanged</li>\n                  <li>Compare coordination time and integration failures</li>\n                </ul>\n              </article>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"steps\">\n            <div className=\"section-heading steps-heading\">\n              <div>\n                <p className=\"section-number\">08 / Step-by-step</p>\n                <h2>Follow this sequence.</h2>\n                <p>Check a stage when its evidence is saved, not when it has merely started.</p>\n              </div>\n              <div className=\"large-progress\" aria-label={progressText}>\n                <div>\n                  <strong>{percent}%</strong>\n                  <button onClick={resetProgress}>Reset</button>\n                </div>\n                <span aria-hidden=\"true\"><span style={{ width: `${percent}%` }} /></span>\n                <p>{progressText}</p>\n              </div>\n            </div>\n            <div className=\"timeline\">\n              {stages.map((stage, index) => {\n                const isDone = completed.includes(stage.id);\n                return (\n                  <article className={`stage-card ${isDone ? \"is-done\" : \"\"}`} key={stage.id}>\n                    <button\n                      className=\"stage-check\"\n                      aria-label={`${isDone ? \"Mark incomplete\" : \"Mark complete\"}: ${stage.title}`}\n                      aria-pressed={isDone}\n                      onClick={() => toggleStage(stage.id)}\n                    >\n                      <CheckIcon checked={isDone} />\n                    </button>\n                    <div className=\"stage-index\">{String(index + 1).padStart(2, \"0\")}</div>\n                    <div className=\"stage-copy\">\n                      <span>{stage.week}</span>\n                      <h3>{stage.title}</h3>\n                      <p>{stage.goal}</p>\n                    </div>\n                    <ul>\n                      {stage.items.map((item) => <li key={item}>{item}</li>)}\n                    </ul>\n                  </article>\n                );\n              })}\n            </div>\n          </section>\n\n          <section className=\"section-block start-section\" id=\"start\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">09 / Start here</p>\n              <h2>Your first working session.</h2>\n              <p>\n                Do only these actions first. Do not download every model or build a\n                large dashboard before the first end-to-end run works.\n              </p>\n            </div>\n            <div className=\"start-grid\">\n              <article className=\"command-card\">\n                <div className=\"command-title\">\n                  <span>1</span>\n                  <h3>Record the environment</h3>\n                </div>\n                <pre><code>{`codex --version\nclaude --version\nopencode --version\npi --version\nollama --version\nollama list\ngit rev-parse HEAD\nsystem_profiler SPHardwareDataType`}</code></pre>\n              </article>\n              <article className=\"command-card\">\n                <div className=\"command-title\">\n                  <span>2</span>\n                  <h3>Confirm the common model</h3>\n                </div>\n                <pre><code>{`ollama pull deepseek-v4-flash:cloud\nollama run deepseek-v4-flash:cloud\nollama pull kimi-k2.7-code:cloud\n\n# Optional laptop-sized local control:\nollama pull qwen3:8b`}</code></pre>\n              </article>\n              <article className=\"command-card wide-card\">\n                <div className=\"command-title\">\n                  <span>3</span>\n                  <h3>Create the evidence folders</h3>\n                </div>\n                <pre><code>{`benchmark/\n├── STUDY.md\n├── tasks/T1-repo-map/\n│   ├── prompt.md\n│   ├── rubric.json\n│   └── fixture.lock\n├── schemas/{run,task,result}.schema.json\n├── runner/\n└── runs/<run-id>/\n    ├── metadata.json\n    ├── prompt.md\n    ├── events.jsonl\n    ├── stdout.log\n    ├── stderr.log\n    ├── changes.patch\n    ├── tests.json\n    ├── result.json\n    └── grader.json`}</code></pre>\n              </article>\n            </div>\n            <div className=\"first-run\">\n              <div>\n                <p className=\"eyebrow\">The first proof</p>\n                <h3>Run T1 once in OpenCode with DeepSeek V4 Flash Cloud.</h3>\n                <p>\n                  Start from a clean repository. Ask for the repository map in\n                  read-only mode. Save every artifact, run the grader, then reset.\n                  Only after that succeeds should you add Codex, Claude Code, and Pi.\n                </p>\n              </div>\n              <ol>\n                <li>One task</li>\n                <li>One model</li>\n                <li>One assistant</li>\n                <li>One complete evidence folder</li>\n              </ol>\n            </div>\n          </section>\n\n          <section className=\"section-block guardrails-section\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">Guardrails</p>\n              <h2>Rules that keep the project credible.</h2>\n            </div>\n            <div className=\"guardrail-grid\">\n              <p><span>01</span> Freeze prompt and task versions before comparison.</p>\n              <p><span>02</span> Never let two workers write the same worktree.</p>\n              <p><span>03</span> Do not grade only the final answer; grade the patch and tests.</p>\n              <p><span>04</span> Record failures, refusals, crashes, and abandoned runs.</p>\n              <p><span>05</span> Keep credentials outside prompts, logs, patches, and repositories.</p>\n              <p><span>06</span> Require human approval for merges, pushes, deploys, and destructive actions.</p>\n              <p><span>07</span> Review third-party plugins and MCP servers before installation.</p>\n              <p><span>08</span> Re-run a study block when a model or assistant version changes materially.</p>\n            </div>\n          </section>\n\n          <section className=\"section-block sources-section\">\n            <div className=\"section-heading split-heading\">\n              <div>\n                <p className=\"section-number\">Current references</p>\n                <h2>Primary sources used for this plan.</h2>\n              </div>\n              <p>\n                Model and product details were checked on August 22, 2026. Recheck\n                the catalogs immediately before the first recorded run.\n              </p>\n            </div>\n            <div className=\"source-grid\">\n              {sources.map(([label, href], index) => (\n                <a href={href} target=\"_blank\" rel=\"noreferrer\" key={href}>\n                  <span>{String(index + 1).padStart(2, \"0\")}</span>\n                  {label}\n                  <span aria-hidden=\"true\">↗</span>\n                </a>\n              ))}\n            </div>\n          </section>\n\n          <footer>\n            <p>Coding assistant study plan</p>\n            <p>Prepared August 22, 2026 · Keep the evidence, not just the winner.</p>\n          </footer>\n        </main>\n      </div>\n    </>\n  );\n}","lineStart":1,"lineEnd":1123,"totalLines":1123,"truncated":false}},"title":"app/page.tsx","time":{"start":1787425809056,"end":1787425809103}},"id":"prt_02ae1629c001xtPlgxYmSi28Ey","sessionID":"ses_fd51eaec7ffehwG0fu6RiLBPJO","messageID":"msg_02ae15e480026eNf45B9U4Q1pF"}}
