s\",\n    \"install or update dependencies\",\n    \"change Git state\",\n    \"start external services\",\n    \"use network access\"\n  ],\n  \"acceptance_checks\": [\n    {\n      \"id\": \"read-only\",\n      \"description\": \"The workspace snapshot is unchanged after the run.\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/ammarbinayaz/Documents/coding-assistant-benchmarking/benchmark/tasks/T1-repo-map/task.json","text":"{\n  \"schema_version\": \"1.0\",\n  \"id\": \"T1-repo-map\",\n  \"version\": \"1.0.0\",\n  \"title\": \"Map an unfamiliar repository\",\n  \"type\": \"analysis\",\n  \"mode\": \"read-only\",\n  \"prompt_path\": \"prompt.md\",\n  \"allowed_paths\": [\"**/*\"],\n  \"forbidden_actions\": [\n    \"edit, create, rename, or delete files\",\n    \"install or update dependencies\",\n    \"change Git state\",\n    \"start external services\",\n    \"use network access\"\n  ],\n  \"acceptance_checks\": [\n    {\n      \"id\": \"read-only\",\n      \"description\": \"The workspace snapshot is unchanged after the run.\"\n    },\n    {\n      \"id\": \"evidence\",\n      \"description\": \"Important claims cite concrete repository paths.\"\n    },\n    {\n      \"id\": \"coverage\",\n      \"description\": \"The answer covers architecture, request flow, verification, risks, and a small change plan.\"\n    }\n  ],\n  \"limits\": {\n    \"max_wall_time_seconds\": 600,\n    \"max_human_interventions\": 0\n  }\n}","lineStart":1,"lineEnd":35,"totalLines":35,"truncated":false}},"title":"benchmark/tasks/T1-repo-map/task.json","time":{"start":1787425813256,"end":1787425813283}},"id":"prt_02ae17301001f5J0xmcfKUZ1eT","sessionID":"ses_fd51eaec7ffehwG0fu6RiLBPJO","messageID":"msg_02ae16e55001kHJ7fduW1sWUgK"}}
