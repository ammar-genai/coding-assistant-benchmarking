staff    1697 Aug 22 15:18 vite.config.ts\ndrwxr-xr-x@  3 ammarbinayaz  staff      96 Aug 22 15:18 worker\n---\n{\n  \"name\": \"coding-assistant-study-plan\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=22.13.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev\",\n    \"build\": \"WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build\",\n    \"start\": \"WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start\",\n    \"test\": \"npm run build && node --test tests/rendered-html.test.mjs\",\n    \"lint\": \"eslint . --ignore-pattern dist --ignore-pattern .next\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"verify\": \"npm run typecheck && npm run lint && npm test && npm run benchmark:validate\",\n    \"benchmark:env\": \"node scripts/benchmark-env.mjs\",\n    \"benchmark:env:write\": \"node scripts/benchmark-env.mjs --write\",\n    \"benchmark:validate\": \"node scripts/benchmark-validate.mjs\",\n    \"benchmark:run\": \"node scripts/benchmark-run.mjs\",\n    \"db:generate\": \"drizzle-kit generate\"\n  },\n  \"dependencies\": {\n    \"drizzle-orm\": \"0.45.2\",\n    \"next\": \"16.2.6\",\n    \"react\": \"19.2.6\",\n    \"react-dom\": \"19.2.6\"\n  },\n  \"devDependencies\": {\n    \"@cloudflare/vite-plugin\": \"1.37.1\",\n    \"@cloudflare/workers-types\": \"^4.20260702.1\",\n    \"@tailwindcss/postcss\": \"4.2.1\",\n    \"@types/node\": \"22.19.19\",\n    \"@types/react\": \"19.2.14\",\n    \"@types/react-dom\": \"19.2.3\",\n    \"@vitejs/plugin-react\": \"6.0.2\",\n    \"@vitejs/plugin-rsc\": \"0.5.26\",\n    \"drizzle-kit\": \"0.31.10\",\n    \"eslint\": \"9.39.4\",\n    \"eslint-config-next\": \"16.2.6\",\n    \"react-server-dom-webpack\": \"19.2.6\",\n    \"tailwindcss\": \"4.2.1\",\n    \"typescript\": \"5.9.3\",\n    \"vinext\": \"0.0.50\",\n    \"vite\": \"8.0.13\",\n    \"wrangler\": \"4.92.0\"\n  },\n  \"type\": \"module\"\n}\n","exit_code":0,"status":"completed"}}
