\n777:          <section className=\"section-block\" id=\"ecosystem\">\n866:          <section className=\"section-block\" id=\"workflow\">\n952:          <section className=\"section-block\" id=\"steps\">\n970:                const isDone = completed.includes(stage.id);\n971:                return (\n996:          <section className=\"section-block start-section\" id=\"start\">\n1076:          <section className=\"section-block guardrails-section\">\n1093:          <section className=\"section-block sources-section\">\n","exit_code":0,"status":"completed"}}
