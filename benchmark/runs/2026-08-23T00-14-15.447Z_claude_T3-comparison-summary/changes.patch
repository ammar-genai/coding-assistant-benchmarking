diff --git a/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs b/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
index 40fbc04..198bb75 100644
--- a/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
+++ b/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
@@ -1,3 +1,10 @@
+const HEADER = "| Assistant | Runs | Best score | Best run | Median time |";
+const DIVIDER = "|---|---:|---:|---|---:|";
+
+function escapePipes(value) {
+  return value.replaceAll("|", "\\|");
+}
+
 /**
  * Render assistant summaries as a stable Markdown table.
  */
@@ -6,5 +13,55 @@ export function renderComparisonTable(summaries) {
     throw new TypeError("summaries must be an array");
   }
 
-  return "";
+  for (const summary of summaries) {
+    if (
+      !summary ||
+      typeof summary.assistant !== "string" ||
+      summary.assistant.length === 0
+    ) {
+      throw new TypeError("assistant must be a non-empty string");
+    }
+    if (
+      typeof summary.best_run_id !== "string" ||
+      summary.best_run_id.length === 0
+    ) {
+      throw new TypeError("best_run_id must be a non-empty string");
+    }
+    if (
+      !Number.isInteger(summary.run_count) ||
+      summary.run_count <= 0
+    ) {
+      throw new TypeError("run_count must be a positive integer");
+    }
+    if (
+      typeof summary.best_score !== "number" ||
+      !Number.isFinite(summary.best_score) ||
+      summary.best_score < 0 ||
+      summary.best_score > 100
+    ) {
+      throw new TypeError(
+        "best_score must be a finite number from 0 through 100",
+      );
+    }
+    if (
+      typeof summary.median_elapsed_ms !== "number" ||
+      !Number.isFinite(summary.median_elapsed_ms) ||
+      summary.median_elapsed_ms < 0
+    ) {
+      throw new TypeError(
+        "median_elapsed_ms must be a finite number greater than or equal to zero",
+      );
+    }
+  }
+
+  if (summaries.length === 0) {
+    return [HEADER, DIVIDER, "", "_No eligible runs._"].join("\n");
+  }
+
+  const rows = summaries.map((summary) => {
+    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);
+    return `| ${escapePipes(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapePipes(summary.best_run_id)} | ${seconds} s |`;
+  });
+
+  return [HEADER, DIVIDER, ...rows].join("\n");
 }
diff --git a/benchmark/fixtures/T3-comparison-summary/student-tests.mjs b/benchmark/fixtures/T3-comparison-summary/student-tests.mjs
index 27384fc..bc94f53 100644
--- a/benchmark/fixtures/T3-comparison-summary/student-tests.mjs
+++ b/benchmark/fixtures/T3-comparison-summary/student-tests.mjs
@@ -1,2 +1,101 @@
 // Add at least two meaningful node:test cases for the feature contract.
 // Do not copy or modify the committed comparison-summary.test.mjs suite.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { renderComparisonTable } from "./render-comparison-table.mjs";
+import { summarizeAssistants } from "./summarize-assistants.mjs";
+
+test("summarizeAssistants throws TypeError for non-array input", () => {
+  assert.throws(() => summarizeAssistants("not-an-array"), TypeError);
+});
+
+test("summarizeAssistants ignores invalid fields on ineligible runs but validates eligible ones", () => {
+  const runs = [
+    {
+      run_id: "bad-score",
+      assistant: "Codex",
+      status: "complete",
+      acceptance_status: "fail",
+      score: "not-a-number",
+      elapsed_ms: 500,
+    },
+    {
+      run_id: "good-run",
+      assistant: "Codex",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 80,
+      elapsed_ms: 500,
+    },
+  ];
+
+  assert.deepEqual(summarizeAssistants(runs), [
+    {
+      assistant: "Codex",
+      run_count: 1,
+      best_score: 80,
+      best_run_id: "good-run",
+      median_elapsed_ms: 500,
+    },
+  ]);
+
+  const invalidRuns = [
+    {
+      run_id: "bad-score",
+      assistant: "Codex",
+      status: "complete",
+      acceptance_status: "pass",
+      score: "not-a-number",
+      elapsed_ms: 500,
+    },
+  ];
+  assert.throws(() => summarizeAssistants(invalidRuns), TypeError);
+});
+
+test("summarizeAssistants computes the median for an odd count of eligible runs", () => {
+  const runs = [
+    {
+      run_id: "a",
+      assistant: "OpenCode",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 70,
+      elapsed_ms: 300,
+    },
+    {
+      run_id: "b",
+      assistant: "OpenCode",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 90,
+      elapsed_ms: 100,
+    },
+    {
+      run_id: "c",
+      assistant: "OpenCode",
+      status: "complete",
+      acceptance_status: "pass",
+      score: 80,
+      elapsed_ms: 200,
+    },
+  ];
+
+  const [summary] = summarizeAssistants(runs);
+  assert.equal(summary.median_elapsed_ms, 200);
+  assert.equal(summary.best_run_id, "b");
+});
+
+test("renderComparisonTable throws TypeError for an invalid summary field", () => {
+  const summaries = [
+    {
+      assistant: "Codex",
+      run_count: 0,
+      best_score: 90,
+      best_run_id: "run-1",
+      median_elapsed_ms: 100,
+    },
+  ];
+
+  assert.throws(() => renderComparisonTable(summaries), TypeError);
+});
diff --git a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
index 3fe2216..3cb16f6 100644
--- a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
+++ b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs
@@ -6,5 +6,79 @@ export function summarizeAssistants(runs) {
     throw new TypeError("runs must be an array");
   }
 
-  return [];
+  const eligible = runs.filter(
+    (run) =>
+      run &&
+      run.status === "complete" &&
+      run.acceptance_status === "pass" &&
+      run.comparison_eligible !== false,
+  );
+
+  for (const run of eligible) {
+    if (typeof run.run_id !== "string" || run.run_id.length === 0) {
+      throw new TypeError("run_id must be a non-empty string");
+    }
+    if (typeof run.assistant !== "string" || run.assistant.length === 0) {
+      throw new TypeError("assistant must be a non-empty string");
+    }
+    if (
+      typeof run.score !== "number" ||
+      !Number.isFinite(run.score) ||
+      run.score < 0 ||
+      run.score > 100
+    ) {
+      throw new TypeError("score must be a finite number from 0 through 100");
+    }
+    if (
+      typeof run.elapsed_ms !== "number" ||
+      !Number.isFinite(run.elapsed_ms) ||
+      run.elapsed_ms < 0
+    ) {
+      throw new TypeError(
+        "elapsed_ms must be a finite number greater than or equal to zero",
+      );
+    }
+  }
+
+  const byAssistant = new Map();
+  for (const run of eligible) {
+    if (!byAssistant.has(run.assistant)) {
+      byAssistant.set(run.assistant, []);
+    }
+    byAssistant.get(run.assistant).push(run);
+  }
+
+  const summaries = [];
+  for (const [assistant, assistantRuns] of byAssistant) {
+    const best = assistantRuns.reduce((a, b) => {
+      if (b.score !== a.score) {
+        return b.score > a.score ? b : a;
+      }
+      if (b.elapsed_ms !== a.elapsed_ms) {
+        return b.elapsed_ms < a.elapsed_ms ? b : a;
+      }
+      return b.run_id < a.run_id ? b : a;
+    });
+
+    const sortedElapsed = assistantRuns
+      .map((run) => run.elapsed_ms)
+      .sort((a, b) => a - b);
+    const mid = Math.floor(sortedElapsed.length / 2);
+    const median =
+      sortedElapsed.length % 2 === 0
+        ? (sortedElapsed[mid - 1] + sortedElapsed[mid]) / 2
+        : sortedElapsed[mid];
+
+    summaries.push({
+      assistant,
+      run_count: assistantRuns.length,
+      best_score: best.score,
+      best_run_id: best.run_id,
+      median_elapsed_ms: median,
+    });
+  }
+
+  summaries.sort((a, b) => (a.assistant < b.assistant ? -1 : a.assistant > b.assistant ? 1 : 0));
+
+  return summaries;
 }
