{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CeJiStzZUygDJuzywKZyB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0155Ab8HonCd4B6kzyCyEFgJ","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-mL9V6l/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","content":"const HEADER = \"| Assistant | Runs | Best score | Best run | Median time |\";\nconst DIVIDER = \"|---|---:|---:|---|---:|\";\n\nfunction escapePipes(value) {\n  return value.replaceAll(\"|\", \"\\\\|\");\n}\n\n/**\n * Render assistant summaries as a stable Markdown table.\n */\nexport function renderComparisonTable(summaries) {\n  if (!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n\n  for (const summary of summaries) {\n    if (\n      !summary ||\n      typeof summary.assistant !== \"string\" ||\n      summary.assistant.length === 0\n    ) {\n      throw new TypeError(\"assistant must be a non-empty string\");\n    }\n    if (\n      typeof summary.best_run_id !== \"string\" ||\n      summary.best_run_id.length === 0\n    ) {\n      throw new TypeError(\"best_run_id must be a non-empty string\");\n    }\n    if (\n      !Number.isInteger(summary.run_count) ||\n      summary.run_count <= 0\n    ) {\n      throw new TypeError(\"run_count must be a positive integer\");\n    }\n    if (\n      typeof summary.best_score !== \"number\" ||\n      !Number.isFinite(summary.best_score) ||\n      summary.best_score < 0 ||\n      summary.best_score > 100\n    ) {\n      throw new TypeError(\n        \"best_score must be a finite number from 0 through 100\",\n      );\n    }\n    if (\n      typeof summary.median_elapsed_ms !== \"number\" ||\n      !Number.isFinite(summary.median_elapsed_ms) ||\n      summary.median_elapsed_ms < 0\n    ) {\n      throw new TypeError(\n        \"median_elapsed_ms must be a finite number greater than or equal to zero\",\n      );\n    }\n  }\n\n  if (summaries.length === 0) {\n    return [HEADER, DIVIDER, \"\", \"_No eligible runs._\"].join(\"\\n\");\n  }\n\n  const rows = summaries.map((summary) => {\n    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);\n    return `| ${escapePipes(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapePipes(summary.best_run_id)} | ${seconds} s |`;\n  });\n\n  return [HEADER, DIVIDER, ...rows].join(\"\\n\");\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1499,"cache_read_input_tokens":22328,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1499},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a663fbdb-6f03-43a8-82ce-69954a141642","uuid":"c36e0d88-e688-4d4e-bf3f-776c695bbb5d","timestamp":"2026-08-23T00:14:41.905Z","request_id":"req_011CeJiStDgFTxuspJbfKkhj"}
