{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CeJiS7sgLir7oziryYmZk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013GtAwtMdLaEzThvDoNMZq9","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-mL9V6l/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","content":"/**\n * Build one comparison summary per assistant from raw benchmark run records.\n */\nexport function summarizeAssistants(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const eligible = runs.filter(\n    (run) =>\n      run &&\n      run.status === \"complete\" &&\n      run.acceptance_status === \"pass\" &&\n      run.comparison_eligible !== false,\n  );\n\n  for (const run of eligible) {\n    if (typeof run.run_id !== \"string\" || run.run_id.length === 0) {\n      throw new TypeError(\"run_id must be a non-empty string\");\n    }\n    if (typeof run.assistant !== \"string\" || run.assistant.length === 0) {\n      throw new TypeError(\"assistant must be a non-empty string\");\n    }\n    if (\n      typeof run.score !== \"number\" ||\n      !Number.isFinite(run.score) ||\n      run.score < 0 ||\n      run.score > 100\n    ) {\n      throw new TypeError(\"score must be a finite number from 0 through 100\");\n    }\n    if (\n      typeof run.elapsed_ms !== \"number\" ||\n      !Number.isFinite(run.elapsed_ms) ||\n      run.elapsed_ms < 0\n    ) {\n      throw new TypeError(\n        \"elapsed_ms must be a finite number greater than or equal to zero\",\n      );\n    }\n  }\n\n  const byAssistant = new Map();\n  for (const run of eligible) {\n    if (!byAssistant.has(run.assistant)) {\n      byAssistant.set(run.assistant, []);\n    }\n    byAssistant.get(run.assistant).push(run);\n  }\n\n  const summaries = [];\n  for (const [assistant, assistantRuns] of byAssistant) {\n    const best = assistantRuns.reduce((a, b) => {\n      if (b.score !== a.score) {\n        return b.score > a.score ? b : a;\n      }\n      if (b.elapsed_ms !== a.elapsed_ms) {\n        return b.elapsed_ms < a.elapsed_ms ? b : a;\n      }\n      return b.run_id < a.run_id ? b : a;\n    });\n\n    const sortedElapsed = assistantRuns\n      .map((run) => run.elapsed_ms)\n      .sort((a, b) => a - b);\n    const mid = Math.floor(sortedElapsed.length / 2);\n    const median =\n      sortedElapsed.length % 2 === 0\n        ? (sortedElapsed[mid - 1] + sortedElapsed[mid]) / 2\n        : sortedElapsed[mid];\n\n    summaries.push({\n      assistant,\n      run_count: assistantRuns.length,\n      best_score: best.score,\n      best_run_id: best.run_id,\n      median_elapsed_ms: median,\n    });\n  }\n\n  summaries.sort((a, b) => (a.assistant < b.assistant ? -1 : a.assistant > b.assistant ? 1 : 0));\n\n  return summaries;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2486,"cache_read_input_tokens":19842,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2486},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a663fbdb-6f03-43a8-82ce-69954a141642","uuid":"7fdbeedf-1a58-4eca-a546-b3ab57ad4f34","timestamp":"2026-08-23T00:14:34.372Z","request_id":"req_011CeJiS79meFgnnnrzHVHij"}
