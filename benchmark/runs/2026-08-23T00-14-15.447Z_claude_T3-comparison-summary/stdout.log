{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CeJiTTeqmSEPvjEbujv7z","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ThQjzYoghKoUGiyJPBm5ri","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-mL9V6l/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs","content":"// Add at least two meaningful node:test cases for the feature contract.\n// Do not copy or modify the committed comparison-summary.test.mjs suite.\nimport assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"summarizeAssistants throws TypeError for non-array input\", () => {\n  assert.throws(() => summarizeAssistants(\"not-an-array\"), TypeError);\n});\n\ntest(\"summarizeAssistants ignores invalid fields on ineligible runs but validates eligible ones\", () => {\n  const runs = [\n    {\n      run_id: \"bad-score\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"fail\",\n      score: \"not-a-number\",\n      elapsed_ms: 500,\n    },\n    {\n      run_id: \"good-run\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 500,\n    },\n  ];\n\n  assert.deepEqual(summarizeAssistants(runs), [\n    {\n      assistant: \"Codex\",\n      run_count: 1,\n      best_score: 80,\n      best_run_id: \"good-run\",\n      median_elapsed_ms: 500,\n    },\n  ]);\n\n  const invalidRuns = [\n    {\n      run_id: \"bad-score\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: \"not-a-number\",\n      elapsed_ms: 500,\n    },\n  ];\n  assert.throws(() => summarizeAssistants(invalidRuns), TypeError);\n});\n\ntest(\"summarizeAssistants computes the median for an odd count of eligible runs\", () => {\n  const runs = [\n    {\n      run_id: \"a\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 70,\n      elapsed_ms: 300,\n    },\n    {\n      run_id: \"b\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 90,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \"c\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 200,\n    },\n  ];\n\n  const [summary] = summarizeAssistants(runs);\n  assert.equal(summary.median_elapsed_ms, 200);\n  assert.equal(summary.best_run_id, \"b\");\n});\n\ntest(\"renderComparisonTable throws TypeError for an invalid summary field\", () => {\n  const summaries = [\n    {\n      assistant: \"Codex\",\n      run_count: 0,\n      best_score: 90,\n      best_run_id: \"run-1\",\n      median_elapsed_ms: 100,\n    },\n  ];\n\n  assert.throws(() => renderComparisonTable(summaries), TypeError);\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1154,"cache_read_input_tokens":23827,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1154},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a663fbdb-6f03-43a8-82ce-69954a141642","uuid":"186fe312-7371-4025-83b7-689fc2df5127","timestamp":"2026-08-23T00:14:53.460Z","request_id":"req_011CeJiTSdpgwVXHZoGRAXPU"}
