 border-color: var(--ink);\n}\n\n.hero-brief {\n  position: relative;\n  overflow: hidden;\n  border: 1px solid var(--ink);\n  border-radius: var(--radius);\n  background: var(--ink);\n  color: var(--white);\n  padding: 28px;\n  box-shadow: var(--shadow);\n}\n\n.hero-brief::after {\n  position: absolute;\n  right: -50px;\n  bottom: -70px;\n  width: 170px;\n  height: 170px;\n  border: 32px solid var(--orange);\n  border-radius: 50%;\n  content: \"\";\n  opacity: 0.94;\n}\n\n.hero-brief > * {\n  position: relative;\n  z-index: 1;\n}\n\n.hero-brief .eyebrow {\n  color: #a7b6b1;\n}\n\n.hero-brief > p:not(.eyebrow):not(.brief-big) {\n  max-width: 360px;\n","exit_code":0,"status":"completed"}}
