   \"eslint-config-next\": \"16.2.6\",\n    \"react-server-dom-webpack\": \"19.2.6\",\n    \"tailwindcss\": \"4.2.1\",\n    \"typescript\": \"5.9.3\",\n    \"vinext\": \"0.0.50\",\n    \"vite\": \"8.0.13\",\n    \"wrangler\": \"4.92.0\"\n  },\n  \"type\": \"module\"\n}\n","exit_code":0,"status":"completed"}}
