{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NbPotd8RAtKPnuLuFavaJw","type":"tool_result","content":"1\timport assert from \"node:assert/strict\";\n2\timport { spawnSync } from \"node:child_process\";\n3\timport { createHash } from \"node:crypto\";\n4\timport { existsSync, readFileSync } from \"node:fs\";\n5\timport { resolve } from \"node:path\";\n6\t\n7\tconst root = resolve(import.meta.dirname, \"..\");\n8\t\n9\tfunction readJson(relativePath) {\n10\t  return JSON.parse(readFileSync(resolve(root, relativePath), \"utf8\"));\n11\t}\n12\t\n13\tfor (const name of [\"task\", \"run\", \"result\"]) {\n14\t  const schema = readJson(`benchmark/schemas/${name}.schema.json`);\n15\t  assert.equal(schema.$schema, \"https://json-schema.org/draft/2020-12/schema\");\n16\t  assert.equal(schema.type, \"object\");\n17\t  assert.ok(Array.isArray(schema.required) && schema.required.length > 0);\n18\t}\n19\t\n20\tconst task = readJson(\"benchmark/tasks/T1-repo-map/task.json\");\n21\tassert.equal(task.schema_version, \"1.0\");\n22\tassert.equal(task.id, \"T1-repo-map\");\n23\tassert.equal(task.mode, \"read-only\");\n24\tassert.ok(task.forbidden_actions.length > 0);\n25\tassert.ok(task.limits.max_wall_time_seconds > 0);\n26\t\n27\tconst prompt = readFileSync(resolve(root, \"benchmark/tasks/T1-repo-map/prompt.md\"), \"utf8\");\n28\tfor (const heading of [\"Architecture\", \"Main request flow\", \"Verification\", \"Risks and unknowns\", \"Small change plan\"]) {\n29\t  assert.match(prompt, new RegExp(`^## ${heading}$`, \"m\"));\n30\t}\n31\t\n32\tconst rubric = readJson(\"benchmark/tasks/T1-repo-map/rubric.json\");\n33\tconst points = rubric.criteria.reduce((total, criterion) => total + criterion.points, 0);\n34\tassert.equal(points, rubric.total_points);\n35\tassert.equal(points, 100);\n36\t\n37\tfunction validateWriteTask(taskId, expectedAllowedPaths) {\n38\t  const writeTask = readJson(`benchmark/tasks/${taskId}/task.json`);\n39\t  assert.equal(writeTask.schema_version, \"1.0\");\n40\t  assert.equal(writeTask.id, taskId);\n41\t  assert.equal(writeTask.mode, \"workspace-write\");\n42\t  assert.deepEqual(writeTask.allowed_paths, expectedAllowedPaths);\n43\t  assert.ok(writeTask.verification.visible_commands.length > 0);\n44\t  assert.equal(writeTask.verification.hidden_suite, taskId);\n45\t  assert.match(writeTask.verification.hidden_sha256, /^[a-f0-9]{64}$/);\n46\t  assert.ok(writeTask.limits.max_wall_time_seconds > 0);\n47\t\n48\t  const writeRubric = readJson(`benchmark/tasks/${taskId}/rubric.json`);\n49\t  const writePoints = writeRubric.criteria.reduce(\n50\t    (total, criterion) => total + criterion.points,\n51\t    0,\n52\t  );\n53\t  assert.equal(writeRubric.task_id, writeTask.id);\n54\t  assert.equal(writeRubric.task_version, writeTask.version);\n55\t  assert.equal(writePoints, writeRubric.total_points);\n56\t  assert.equal(writePoints, 100);\n57\t\n58\t  const privateSuite = resolve(\n59\t    root,\n60\t    \"benchmark/private\",\n61\t    `${writeTask.verification.hidden_suite}.test.mjs`,\n62\t  );\n63\t  assert.ok(existsSync(privateSuite), `Missing local private suite: ${privateSuite}`);\n64\t  const privateDigest = createHash(\"sha256\").update(readFileSync(privateSuite)).digest(\"hex\");\n65\t  assert.equal(privateDigest, writeTask.verification.hidden_sha256);\n66\t\n67\t  const seededFailure = spawnSync(\n68\t    \"/bin/sh\",\n69\t    [\"-lc\", writeTask.verification.visible_commands[0]],\n70\t    { cwd: root, encoding: \"utf8\", timeout: 30_000 },\n71\t  );\n72\t  assert.notEqual(seededFailure.status, 0, `${taskId} must retain its seeded failing behavior`);\n73\t}\n74\t\n75\tvalidateWriteTask(\"T2-filter-valid-runs\", [\n76\t  \"benchmark/fixtures/T2-run-filter/select-comparison-runs.mjs\",\n77\t]);\n78\tvalidateWriteTask(\"T3-comparison-summary\", [\n79\t  \"benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs\",\n80\t  \"benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs\