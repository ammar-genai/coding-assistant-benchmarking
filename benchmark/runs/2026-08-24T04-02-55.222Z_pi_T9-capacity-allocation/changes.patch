+import { allocateCapacity } from "./allocation-engine.mjs";
+
+const validRequest = (overrides = {}) => ({
+  id: "a",
+  desk: "ABS",
+  requested: 10,
+  priority: 1,
+  submittedAt: "2026-08-23T10:00:00Z",
+  ...overrides,
+});
+
+test("allocates per desk by priority, then submittedAt, then id", () => {
+  const requests = [
+    validRequest({ id: "z", desk: "D1", requested: 50, priority: 1, submittedAt: "2026-08-23T09:00:00Z" }),
+    validRequest({ id: "y", desk: "D1", requested: 50, priority: 2, submittedAt: "2026-08-23T10:00:00Z" }),
+    validRequest({ id: "b", desk: "D1", requested: 50, priority: 2, submittedAt: "2026-08-23T10:00:00Z" }),
+    validRequest({ id: "a", desk: "D2", requested: 99, priority: 0, submittedAt: "2026-08-23T08:00:00Z" }),
+  ];
+
+  // D1 (capacity 60): y and b tie on priority; b has the smaller id, so b gets
+  // 50 first and y gets the remaining 10. D2 (capacity 30): a gets 30.
+  assert.deepEqual(
+    allocateCapacity(requests, { D1: 60, D2: 30 }),
+    [
+      { id: "z", allocated: 0, unfilled: 50 },
+      { id: "y", allocated: 10, unfilled: 40 },
+      { id: "b", allocated: 50, unfilled: 0 },
+      { id: "a", allocated: 30, unfilled: 69 },
+    ],
+  );
+});
+
+test("returns rows in original input order and never mutates inputs", () => {
+  const requests = [
+    validRequest({ id: "late", priority: 0, submittedAt: "2026-08-23T12:00:00Z" }),
+    validRequest({ id: "early", priority: 5, submittedAt: "2026-08-23T09:00:00Z" }),
+  ];
+  const capacityByDesk = { ABS: 5 };
+  const requestsBefore = structuredClone(requests);
+  const capacityBefore = structuredClone(capacityByDesk);
+
+  const result = allocateCapacity(requests, capacityByDesk);
+
+  assert.deepEqual(
+    result,
+    [
+      { id: "late", allocated: 0, unfilled: 10 },
+      { id: "early", allocated: 5, unfilled: 5 },
+    ],
+  );
+  assert.deepEqual(requests, requestsBefore);
+  assert.deepEqual(capacityByDesk, capacityBefore);
+  assert.notDeepEqual(result, requests);
+});
+
+test("throws TypeError on invalid input without allocating", () => {
+  const cases = [
+    // duplicate id
+    [[validRequest(), validRequest({ id: "a", desk: "D2" })], { ABS: 1, D2: 1 }],
+    // empty id
+    [[validRequest({ id: "" })], { ABS: 1 }],
+    // non-positive requested
+    [[validRequest({ requested: 0 })], { ABS: 1 }],
+    // non-finite requested
+    [[validRequest({ requested: Number.POSITIVE_INFINITY })], { ABS: 1 }],
+    // non-integer priority
+    [[validRequest({ priority: 1.5 })], { ABS: 1 }],
+    // invalid timestamp
+    [[validRequest({ submittedAt: "not-a-date" })], { ABS: 1 }],
+    // missing capacity for a referenced desk
+    [[validRequest(), validRequest({ id: "b", desk: "D2" })], { ABS: 1 }],
+    // negative capacity
+    [[validRequest()], { ABS: -1 }],
+    // non-finite capacity
+    [[validRequest()], { ABS: Number.NaN }],
+  ];
+
+  for (const [requests, capacityByDesk] of cases) {
+    const requestsBefore = structuredClone(requests);
+    const capacityBefore = structuredClone(capacityByDesk);
+    assert.throws(
+      () => allocateCapacity(requests, capacityByDesk),
+      TypeError,
+      `expected TypeError for ${JSON.stringify(requests)}`,
+    );
+    assert.deepEqual(requests, requestsBefore);
+    assert.deepEqual(capacityByDesk, capacityBefore);
+  }
+});
+
+test("zero capacity leaves every request fully unfilled", () => {
+  const requests = [
+    validRequest({ id: "a" }),
+    validRequest({ id: "b", priority: 9 }),
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { ABS: 0 }), [
+    { id: "a", allocated: 0, unfilled: 10 },
+    { id: "b", allocated: 0, unfilled: 10 },
+  ]);
+});
+
+test("partial fills respect per-desk caps and fractional requests", () => {
+  const requests = [
+    validRequest({ id: "a", desk: "D1", requested: 2.5 }),
+    validRequest({ id: "b", desk: "D1", requested: 2.5 }),
+    validRequest({ id: "c", desk: "D2", requested: 4 }),
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { D1: 3, D2: 10 }), [
+    { id: "a", allocated: 2.5, unfilled: 0 },
+    { id: "b", allocated: 0.5, unfilled: 2 },
+    { id: "c", allocated: 4, unfilled: 0 },
+  ]);
 });
