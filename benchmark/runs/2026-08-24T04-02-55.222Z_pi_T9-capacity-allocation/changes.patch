--- a/benchmark/fixtures/T9-capacity-allocation/allocation-engine.mjs
+++ b/benchmark/fixtures/T9-capacity-allocation/allocation-engine.mjs
@@ -3,14 +3,87 @@ function validateInputs(requests, capacityByDesk) {
   if (!capacityByDesk || typeof capacityByDesk !== "object" || Array.isArray(capacityByDesk)) {
     throw new TypeError("capacityByDesk must be an object");
   }
+
+  const seenIds = new Set();
+  const desks = new Set();
+
+  for (const request of requests) {
+    if (!request || typeof request !== "object" || Array.isArray(request)) {
+      throw new TypeError("each request must be an object");
+    }
+    if (typeof request.id !== "string" || request.id.length === 0) {
+      throw new TypeError("request.id must be a non-empty string");
+    }
+    if (seenIds.has(request.id)) {
+      throw new TypeError(`duplicate request id: ${request.id}`);
+    }
+    seenIds.add(request.id);
+    if (typeof request.desk !== "string" || request.desk.length === 0) {
+      throw new TypeError("request.desk must be a non-empty string");
+    }
+    desks.add(request.desk);
+    if (
+      typeof request.requested !== "number" ||
+      !Number.isFinite(request.requested) ||
+      request.requested <= 0
+    ) {
+      throw new TypeError("request.requested must be a positive finite number");
+    }
+    if (!Number.isInteger(request.priority)) {
+      throw new TypeError("request.priority must be an integer");
+    }
+    if (
+      typeof request.submittedAt !== "string" ||
+      !Number.isFinite(Date.parse(request.submittedAt))
+    ) {
+      throw new TypeError("request.submittedAt must be a valid timestamp");
+    }
+  }
+
+  for (const desk of desks) {
+    const capacity = capacityByDesk[desk];
+    if (typeof capacity !== "number" || !Number.isFinite(capacity) || capacity < 0) {
+      throw new TypeError(
+        `capacityByDesk[${JSON.stringify(desk)}] must be a finite non-negative number`,
+      );
+    }
+  }
 }
 
 export function allocateCapacity(requests, capacityByDesk) {
   validateInputs(requests, capacityByDesk);
 
-  return requests.map((request) => ({
-    id: request.id,
-    allocated: request.requested,
-    unfilled: 0,
-  }));
+  const allocatedById = new Map();
+  const requestsByDesk = new Map();
+
+  for (const request of requests) {
+    allocatedById.set(request.id, 0);
+    const list = requestsByDesk.get(request.desk);
+    if (list) {
+      list.push(request);
+    } else {
+      requestsByDesk.set(request.desk, [request]);
+    }
+  }
+
+  for (const [desk, deskRequests] of requestsByDesk) {
+    const ordered = [...deskRequests].sort(
+      (a, b) =>
+        b.priority - a.priority ||
+        Date.parse(a.submittedAt) - Date.parse(b.submittedAt) ||
+        (a.id < b.id ? -1 : a.id > b.id ? 1 : 0),
+    );
+
+    let remaining = capacityByDesk[desk];
+    for (const request of ordered) {
+      const granted = Math.min(request.requested, remaining);
+      allocatedById.set(request.id, granted);
+      remaining -= granted;
+    }
+  }
+
+  return requests.map((request) => {
+    const allocated = allocatedById.get(request.id);
+    return { id: request.id, allocated, unfilled: request.requested - allocated };
+  });
 }
diff --git a/benchmark/fixtures/T9-capacity-allocation/student-tests.mjs b/benchmark/fixtures/T9-capacity-allocation/student-tests.mjs
