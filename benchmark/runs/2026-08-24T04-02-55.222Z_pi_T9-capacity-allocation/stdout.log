{"type":"message_update","usage":{"input":45,"output":1539,"cacheRead":6272,"cacheWrite":0,"reasoning":43,"totalTokens":7856,"cost":{"input":0.00002025,"output":0.0049248,"cacheRead":0.00031360000000000003,"cacheWrite":0,"total":0.00525865}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"chatcmpl-tool-960861c12e9801ba","name":"write","arguments":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { allocateCapacity } from \"./allocation-engine.mjs\";\n\nconst validRequest = (overrides = {}) => ({\n  id: \"a\",\n  desk: \"ABS\",\n  requested: 10,\n  priority: 1,\n  submittedAt: \"2026-08-23T10:00:00Z\",\n  ...overrides,\n});\n\ntest(\"allocates per desk by priority, then submittedAt, then id\", () => {\n  const requests = [\n    validRequest({ id: \"z\", desk: \"D1\", requested: 50, priority: 1, submittedAt: \"2026-08-23T09:00:00Z\" }),\n    validRequest({ id: \"y\", desk: \"D1\", requested: 50, priority: 2, submittedAt: \"2026-08-23T10:00:00Z\" }),\n    validRequest({ id: \"b\", desk: \"D1\", requested: 50, priority: 2, submittedAt: \"2026-08-23T10:00:00Z\" }),\n    validRequest({ id: \"a\", desk: \"D2\", requested: 99, priority: 0, submittedAt: \"2026-08-23T08:00:00Z\" }),\n  ];\n\n  // D1 (capacity 60): y and b tie on priority; b has the smaller id, so b gets\n  // 50 first and y gets the remaining 10. D2 (capacity 30): a gets 30.\n  assert.deepEqual(\n    allocateCapacity(requests, { D1: 60, D2: 30 }),\n    [\n      { id: \"z\", allocated: 0, unfilled: 50 },\n      { id: \"y\", allocated: 10, unfilled: 40 },\n      { id: \"b\", allocated: 50, unfilled: 0 },\n      { id: \"a\", allocated: 30, unfilled: 69 },\n    ],\n  );\n});\n\ntest(\"returns rows in original input order and never mutates inputs\", () => {\n  const requests = [\n    validRequest({ id: \"late\", priority: 0, submittedAt: \"2026-08-23T12:00:00Z\" }),\n    validRequest({ id: \"early\", priority: 5, submittedAt: \"2026-08-23T09:00:00Z\" }),\n  ];\n  const capacityByDesk = { ABS: 5 };\n  const requestsBefore = structuredClone(requests);\n  const capacityBefore = structuredClone(capacityByDesk);\n\n  const result = allocateCapacity(requests, capacityByDesk);\n\n  assert.deepEqual(\n    result,\n    [\n      { id: \"late\", allocated: 0, unfilled: 10 },\n      { id: \"early\", allocated: 5, unfilled: 5 },\n    ],\n  );\n  assert.deepEqual(requests, requestsBefore);\n  assert.deepEqual(capacityByDesk, capacityBefore);\n  assert.notDeepEqual(result, requests);\n});\n\ntest(\"throws TypeError on invalid input without allocating\", () => {\n  const cases = [\n    // duplicate id\n    [[validRequest(), validRequest({ id: \"a\", desk: \"D2\" })], { ABS: 1, D2: 1 }],\n    // empty id\n    [[validRequest({ id: \"\" })], { ABS: 1 }],\n    // non-positive requested\n    [[validRequest({ requested: 0 })], { ABS: 1 }],\n    // non-finite requested\n    [[validRequest({ requested: Number.POSITIVE_INFINITY })], { ABS: 1 }],\n    // non-integer priority\n    [[validRequest({ priority: 1.5 })], { ABS: 1 }],\n    // invalid timestamp\n    [[validRequest({ submittedAt: \"not-a-date\" })], { ABS: 1 }],\n    // missing capacity for a referenced desk\n    [[validRequest(), validRequest({ id: \"b\", desk: \"D2\" })], { ABS: 1 }],\n    // negative capacity\n    [[validRequest()], { ABS: -1 }],\n    // non-finite capacity\n    [[validRequest()], { ABS: Number.NaN }],\n  ];\n\n  for (const [requests, capacityByDesk] of cases) {\n    const requestsBefore = structuredClone(requests);\n    const capacityBefore = structuredClone(capacityByDesk);\n    assert.throws(\n      () => allocateCapacity(requests, capacityByDesk),\n      TypeError,\n      `expected TypeError for ${JSON.stringify(requests)}`,\n    );\n    assert.deepEqual(requests, requestsBefore);\n    assert.deepEqual(capacityByDesk, capacityBefore);\n  }\n});\n\ntest(\"zero capacity leaves every request fully unfilled\", () => {\n  const requests = [\n    validRequest({ id: \"a\" }),\n    validRequest({ id: \"b\", priority: 9 }),\n  ];\n\n  assert.deepEqual(allocateCapacity(requests, { ABS: 0 }), [\n    { id: \"a\", allocated: 0, unfilled: 10 },\n    { id: \"b\", allocated: 0, unfilled: 10 },\n  ]);\n});\n\ntest(\"partial fills respect per-desk caps and fractional requests\", () => {\n  const requests = [\n    validRequest({ id: \"a\", desk: \"D1\", requested: 2.5 }),\n    validRequest({ id: \"b\", desk: \"D1\", requested: 2.5 }),\n    validRequest({ id: \"c\", desk: \"D2\", requested: 4 }),\n  ];\n\n  assert.deepEqual(allocateCapacity(requests, { D1: 3, D2: 10 }), [\n    { id: \"a\", allocated: 2.5, unfilled: 0 },\n    { id: \"b\", allocated: 0.5, unfilled: 2 },\n    { id: \"c\", allocated: 4, unfilled: 0 },\n  ]);\n});\n","path":"benchmark/fixtures/T9-capacity-allocation/student-tests.mjs"}}}}
