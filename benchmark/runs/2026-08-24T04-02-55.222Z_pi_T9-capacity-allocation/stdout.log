ve finite number\");\n    }\n    if (!Number.isInteger(request.priority)) {\n      throw new TypeError(\"request.priority must be an integer\");\n    }\n    if (\n      typeof request.submittedAt !== \"string\" ||\n      !Number.isFinite(Date.parse(request.submittedAt))\n    ) {\n      throw new TypeError(\"request.submittedAt must be a valid timestamp\");\n    }\n  }\n\n  for (const desk of desks) {\n    const capacity = capacityByDesk[desk];\n    if (typeof capacity !== \"number\" || !Number.isFinite(capacity) || capacity < 0) {\n      throw new TypeError(\n        `capacityByDesk[${JSON.stringify(desk)}] must be a finite non-negative number`,\n      );\n    }\n  }\n}\n\nexport function allocateCapacity(requests, capacityByDesk) {\n  validateInputs(requests, capacityByDesk);\n\n  const allocatedById = new Map();\n  const requestsByDesk = new Map();\n\n  for (const request of requests) {\n    allocatedById.set(request.id, 0);\n    const list = requestsByDesk.get(request.desk);\n    if (list) {\n      list.push(request);\n    } else {\n      requestsByDesk.set(request.desk, [request]);\n    }\n  }\n\n  for (const [desk, deskRequests] of requestsByDesk) {\n    const ordered = [...deskRequests].sort(\n      (a, b) =>\n        b.priority - a.priority ||\n        Date.parse(a.submittedAt) - Date.parse(b.submittedAt) ||\n        (a.id < b.id ? -1 : a.id > b.id ? 1 : 0),\n    );\n\n    let remaining = capacityByDesk[desk];\n    for (const request of ordered) {\n      const granted = Math.min(request.requested, remaining);\n      allocatedById.set(request.id, granted);\n      remaining -= granted;\n    }\n  }\n\n  return requests.map((request) => {\n    const allocated = allocatedById.get(request.id);\n    return { id: request.id, allocated, unfilled: request.requested - allocated };\n  });\n}\n"}}],"api":"openai-completions","provider":"openrouter","model":"qwen/qwen3.8-27b","usage":{"input":896,"output":2248,"cacheRead":3136,"cacheWrite":0,"reasoning":1403,"totalTokens":