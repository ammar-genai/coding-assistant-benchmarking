nal order and return the original record objects.\n */\nexport function selectComparisonRuns(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  return runs.filter(\n    (run) =>\n      run.status === \"complete\" ||\n      run.acceptance_status === \"pass\" ||\n      run.comparison_eligible !== false,\n  );\n}","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"benchmark/fixtures/T2-run-filter/select-comparison-runs.mjs","time":{"start":1787505020915,"end":1787505020924}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"To match the code style conventions, let me look at the T2/T3 fixture implementations (these are sibling fixtures, and the same \"student\" pattern probably already exists). Let me check T2's `select-comparison-runs.mjs` and T3's `student-tests.mjs` to confirm the conventions.\n","format":"unknown","index":0}]}},"id":"prt_02f9a0fec001SVwrmBr1PLHAoI","sessionID":"ses_fd06f755cffevoqtwk45u3vUdj","messageID":"msg_02f99d441001hEMFg8JKg0QlS4"}}
