253:   claude: \"subscription-default\",\n254:   opencode: \"ollama/deepseek-v4-flash:cloud\",\n255:   pi: \"ollama/deepseek-v4-flash:cloud\",\n256: };\n257: const model = options.model ?? defaults[options.assistant];\n258: if (!model) throw new Error(`No default model for ${options.assistant}`);\n259: \n260: const taskDirectory = resolve(projectRoot, \"benchmark\", \"tasks\", options.task);\n261: const task = JSON.parse(readFileSync(resolve(taskDirectory, \"task.json\"), \"utf8\"));\n262: const prompt = readFileSync(resolve(taskDirectory, task.prompt_path), \"utf8\");\n263: \n264: if (!options.execute) {\n265:   const selected = adapter(options.assistant, model, prompt, \"<isolated-worktree>\");\n266:   console.log(JSON.stringify({\n267:     mode: \"preview\",\n268:     task: `${task.id}@${task.version}`,\n269:     assistant: options.assistant,\n270:     model,\n271:     command: [selected.command, ...selected.args.slice(0, -1), \"<prompt.md>\"],\n272:     timeout_seconds: task.limits.max_wall_time_seconds,\n273:   }, null, 2));\n274:   process.exit(0);\n275: }\n276: \n277: const createdAt = new Date();\n278: const runId = `${createdAt.toISOString().replaceAll(\":\", \"-\")}_${options.assistant}_${task.id}`;\n279: const runDirectory = resolve(projectRoot, \"benchmark\", \"runs\", runId);\n280: mkdirSync(runDirectory, { recursive: false });\n281: \n282: const gitCommit = gitValue([\"rev-parse\", \"--verify\", \"HEAD\"]);\n283: if (!gitCommit) throw new Error(\"A baseline Git commit is required before executing a benchmark.\");\n284: const trackedChanges = gitValue([\"status\", \"--porcelain\", \"--untracked-files=no\"]);\n285: if (trackedChanges) throw new Error(\"Commit or restore tracked workspace changes before executing a benchmark.\");\n286: \n287: const isolatedWorktree = createIsolatedWorktree(gitCommit);\n288: const targetRoot = isolatedWorktree.checkout;\n289: const selected = adapter(options.assistant, model, prompt, targetRoot);\n290: const before = snaps