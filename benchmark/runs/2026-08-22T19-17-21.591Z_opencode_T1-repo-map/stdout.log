{"type":"tool_use","timestamp":1787426253267,"sessionID":"ses_fd518000affe6KchMdNdr1keVe","part":{"type":"tool","tool":"read","callID":"call_44gvmg0d","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-c30U4X/checkout/scripts/benchmark-run.mjs"},"output":"<path>/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-c30U4X/checkout/scripts/benchmark-run.mjs</path>\n<type>file</type>\n<content>\n1: import { spawn, spawnSync } from \"node:child_process\";\n2: import { createHash } from \"node:crypto\";\n3: import { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmdirSync, statSync, writeFileSync } from \"node:fs\";\n4: import { tmpdir } from \"node:os\";\n5: import { dirname, relative, resolve } from \"node:path\";\n6: import { fileURLToPath } from \"node:url\";\n7: \n8: const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), \"..\");\n9: const ignoredDirectories = new Set([\n10:   \".git\",\n11:   \".next\",\n12:   \".vinext\",\n13:   \".wrangler\",\n14:   \"dist\",\n15:   \"node_modules\",\n16:   \"runs\",\n17: ]);\n18: \n19: function usage() {\n20:   console.log(`Usage:\n21:   npm run benchmark:run -- --assistant <codex|claude|opencode|pi> [options]\n22: \n23: Options:\n24:   --task <id>       Task directory name (default: T1-repo-map)\n25:   --model <id>      Exact model ID. Defaults to the assistant's normal baseline.\n26:   --execute         Execute and record the run. Without this flag, print a preview.\n27:   --help            Show this message.\n28: \n29: Examples:\n30:   npm run benchmark:run -- --assistant opencode\n31:   npm run benchmark:run -- --assistant opencode --model ollama/deepseek-v4-flash:cloud --execute`);\n32: }\n33: \n34: function parseArgs(argv) {\n35:   const options = { task: \"T1-repo-map\", execute: false };\n36:   for (let index = 0; index < argv.length; index += 1) {\n37:     const value = argv[index];\n38:     if (value === \"--execute\") options.execute = true;\n39:     else if (value === \"--help\") options.help = true;\n40:     else if (value === \"--assistant\" || value === \"--task\" || value === \"--model\") {\n41:       const next = argv[index + 1];\n42:       if (!next) throw new Error(`${value} requires a value`);\n43:       options[value.slice(2)] = next;\n44:       index += 1;\n45:     } else {\n46:       throw new Error(`Unknown option: ${value}`);\n47:     }\n48:   }\n49:   return options;\n50: }\n51: \n52: function version(command) {\n53:   const result = spawnSync(command, [\"--version\"], { encoding: \"utf8\", timeout: 10_000 });\n54:   return result.status === 0 ? (result.stdout || result.stderr).trim().split(\"\\n\")[0] : null;\n55: }\n56: \n57: function gitValue(args, workingDirectory = projectRoot) {\n58:   const result = spawnSync(\"git\", args, { cwd: workingDirectory, encoding: \"utf8\", timeout: 10_000 });\n59:   return result.status === 0 ? result.stdout.trim() : null;\n60: }\n61: \n62: function createIsolatedWorktree(commit) {\n63:   const container = mkdtempSync(resolve(tmpdir(), \"coding-assistant-benchmark-\"));\n64:   const checkout = resolve(container, \"checkout\");\n65:   const result = spawnSync(\"git\", [\"worktree\", \"add\", \"--detach\", checkout, commit], {\n66:     cwd: projectRoot,\n67:     encoding: \"utf8\",\n68:     timeout: 60_000,\n69:   });\n70:   if (result.status !== 0) {\n71:     rmdirSync(container);\n72:     throw new Error(`Could not create isolated worktree: ${result.stderr || result.stdout}`);\n73:   }\n74:   return { container, checkout };\n75: }\n76: \n77: function removeIsolatedWorktree({ container, checkout }) {\n78:   const result = spawnSync(\"git\", [\"worktree\", \"remove\", \"--force\", checkout], {\n79:     cwd: projectRoot,\n80:     encoding: \"utf8\",\n81:     timeout: 60_000,\n82:   });\n83:   if (result.status === 0) rmdirSync(container);\n84:   return result.status === 0 ? null : (result.stderr || result.stdout || \"Unknown worktree cleanup error\").trim();\n85: }\n86: \n87: function sha256(value) {\n88:   return createHash(\"sha256\").update(value).digest(\"hex\");\n89: }\n90: \n91: function ollamaAccessPath(model) {\n92:   if (!model.startsWith(\"ollama/\")) return null;\n93:   return model.endsWith(\":cloud\") ? \"ollama-cloud\" : \"ollama-local\";\n94: }\n95: \n96: function snapshotDirectory(root = projectRoot) {\n97:   const files = new Map();\n98: \n99:   function visit(directory) {\n100:     for (const entry of readdirSync(directory, { withFileTypes: true })) {\n101:       if (entry.name === \".git\") continue;\n102:       if (entry.isDirectory() && ignoredDirectories.has(entry.name)) continue;\n103:       const absolutePath = resolve(directory, entry.name);\n104:       const relativePath = relative(root, absolutePath);\n105:       if (relativePath.startsWith(\"benchmark/runs/\")) continue;\n106:       if (entry.isDirectory()) visit(absolutePath);\n107:       else if (entry.isFile() && statSync(absolutePath).size <= 25_000_000) {\n108:         files.set(relativePath, sha256(readFileSync(absolutePath)));\n109:       }\n110:     }\n111:   }\n112: \n113:   visit(root);\n114:   return files;\n115: }\n116: \n117: function compareSnapshots(before, after) {\n118:   return [...new Set([...before.keys(), ...after.keys()])]\n119:     .filter((path) => before.get(path) !== after.get(path))\n120:     .sort();\n121: }\n122: \n123: function adapter(assistant, model, prompt, targetRoot) {\n124:   if (assistant === \"codex\") {\n125:     const args = [\n126:       \"exec\",\n127:       \"--ephemeral\",\n128:       \"--json\",\n129:       \"--ignore-user-config\",\n130:       \"--sandbox\",\n131:       \"read-only\",\n132:       \"--cd\",\n133:       targetRoot,\n134:     ];\n135:     if (model.startsWith(\"ollama/\")) {\n136:       args.push(\"--oss\", \"--local-provider\", \"ollama\", \"--model\", model.slice(\"ollama/\".length));\n137:     } else if (model !== \"subscription-default\") args.push(\"--model\", model);\n138:     args.push(prompt);\n139:     return { command: \"codex\", args, accessPath: ollamaAccessPath(model) ?? \"subscription\" };\n140:   }\n141: \n142:   if (assistant === \"claude\") {\n143:     const claudeArgs = [\n144:       \"--print\",\n145:       \"--output-format\",\n146:       \"stream-json\",\n147:       \"--verbose\",\n148:       \"--no-session-persistence\",\n149:       \"--setting-sources\",\n150:       \"project\",\n151:       \"--permission-mode\",\n152:       \"plan\",\n153:       \"--tools\",\n154:       \"Read,Glob,Grep\",\n155:     ];\n156:     if (model.startsWith(\"ollama/\")) {\n157:       const args = [\n158:         \"launch\",\n159:         \"claude\",\n160:         \"--model\",\n161:         model.slice(\"ollama/\".length),\n162:         \"--yes\",\n163:         \"--\",\n164:         ...claudeArgs,\n165:         \"--\",\n166:         prompt,\n167:       ];\n168:       return { command: \"ollama\", args, accessPath: ollamaAccessPath(model) };\n169:     }\n170:     if (model !== \"subscription-default\") claudeArgs.push(\"--model\", model);\n171:     claudeArgs.push(\"--\", prompt);\n172:     return { command: \"claude\", args: claudeArgs, accessPath: \"subscription\" };\n173:   }\n174: \n175:   if (assistant === \"opencode\") {\n176:     const args = [\"run\", \"--format\", \"json\", \"--agent\", \"plan\", \"--dir\", targetRoot, \"--model\", model, prompt];\n177:     return { command: \"opencode\", args, accessPath: ollamaAccessPath(model) ?? \"unknown\" };\n178:   }\n179: \n180:   if (assistant === \"pi\") {\n181:     const piArgs = [\n182:       \"--print\",\n183:       \"--mode\",\n184:       \"json\",\n185:       \"--no-session\",\n186:       \"--no-extensions\",\n187:       \"--no-skills\",\n188:       \"--no-prompt-templates\",\n189:       \"--no-themes\",\n190:       \"--approve\",\n191:       \"--tools\",\n192:       \"read,grep,find,ls\",\n193:     ];\n194:     if (model.startsWit