\t    settlementDate: trade.settlementDate,\n51\t    side: trade.side,\n52\t    productType: trade.productType,\n53\t    securityId: trade.securityId,\n54\t    issuerDeal: trade.issuerDeal,\n55\t    trancheClass: trade.trancheClass,\n56\t    counterparty: trade.counterparty,\n57\t    book: trade.book,\n58\t    trader: trade.trader,\n59\t    currency: trade.currency,\n60\t    originalFace: trade.originalFace,\n61\t    factor: trade.factor,\n62\t    price: trade.price,\n63\t    coupon: trade.coupon,\n64\t    spreadBps: trade.spreadBps,\n65\t    accruedInterest: trade.accruedInterest,\n66\t    agency: trade.agency,\n67\t    poolNumber: trade.poolNumber,\n68\t    weightedAverageLife: trade.weightedAverageLife,\n69\t    collateralType: trade.collateralType,\n70\t    rating: trade.rating,\n71\t    modifier: trade.modifier,\n72\t    allocations: trade.allocations.map((allocation) => ({ ...allocation })),\n73\t    note: trade.note,\n74\t  };\n75\t}\n76\t\n77\tfunction existingTrade(state: TradeCaptureState): Trade | null {\n78\t  if (!state.editingTradeId) return null;\n79\t  return state.trades.find((trade) => trade.internalTradeId === state.editingTradeId) ?? null;\n80\t}\n81\t\n82\tfunction storeTrade(state: TradeCaptureState, trade: Trade): TradeCaptureState {\n83\t  const exists = state.trades.some((item) => item.internalTradeId === trade.internalTradeId);\n84\t  const trades = exists\n85\t    ? state.trades.map((item) => item.internalTradeId === trade.internalTradeId ? trade : item)\n86\t    : [...state.trades, trade];\n87\t\n88\t  return {\n89\t    ...state,\n90\t    trades,\n91\t    draft: emptyDraft(),\n92\t    exceptions: [],\n93\t    editingTradeId: null,\n94\t    selectedTradeId: trade.internalTradeId,\n95\t  };\n96\t}\n97\t\n98\tconst initialDraft = emptyDraft();\n99\t\n100\texport const INITIAL_STATE: TradeCaptureState = {\n101\t  trades: SEED_TRADES,\n102\t  draft: initialDraft,\n103\t  exceptions: validateTrade(initialDraft),\n104\t  editingTradeId: null,\n105\t  selectedTradeId: SEED_TRADES[0]?.internalTradeId ?? null,\n106\t  product: \"all\",\n107\t  status: \"all\",\n108\t  search: \"\",\n109\t  sort: \"execution-desc\",\n110\t};\n111\t\n112\texport function tradeCaptureReducer(state: TradeCaptureState, action: TradeCaptureAction): TradeCaptureState {\n113\t  switch (action.type) {\n114\t    case \"draft-changed\":\n115\t      return { ...state, draft: action.draft, exceptions: validateTrade(action.draft) };\n116\t    case \"reset\": {\n117\t      const draft = emptyDraft();\n118\t      return { ...state, draft, exceptions: validateTrade(draft), editingTradeId: null };\n119\t    }\n120\t    case \"save-draft\":\n121\t      return storeTrade(state, saveDraft(existingTrade(state), state.draft, action.context));\n122\t    case \"validate\":\n123\t      return storeTrade(state, validateTradeRecord(existingTrade(state), state.draft, action.context));\n124\t    case \"book\":\n125\t      return storeTrade(state, bookTrade(existingTrade(state), state.draft, action.context));\n126\t    case \"edit\": {\n127\t      const trade = state.trades.find((item) => item.internalTradeId === action.id);\n128\t      if (!trade || trade.status === \"cancelled\") return state;\n129\t      const draft = draftFromTrade(trade);\n130\t      return {\n131\t        ...state,\n132\t        draft,\n133\t        exceptions: validateTrade(draft),\n134\t        editingTradeId: trade.internalTradeId,\n135\t        selectedTradeId: trade.internalTradeId,\n136\t      };\n137\t    }\n138\t    case \"cancel\": {\n139\t      const trade = state.trades.find((item) => item.internalTradeId === action.id);\n140\t      if (!trade) return state;\n141\t      const cancelled = cancelTrade(trade, action.context);\n142\t      return {\n143\t        ...state,\n144\t        trades: state.trades.map((item) => item.internalTradeId === cancelled.internalTradeId ? cancelled : item),\n145\t        selectedTradeId: cancelled.internalTradeId,\n146\t      };\n147\t    }\n14