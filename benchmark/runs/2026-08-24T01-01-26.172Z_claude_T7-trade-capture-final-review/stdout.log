nction makeSeed(\n62\t  id: string,\n63\t  status: Trade[\"status\"],\n64\t  draft: TradeDraft,\n65\t  actions: Trade[\"auditEvents\"],\n66\t): Trade {\n67\t  const economics = calculateEconomics(draft.originalFace ?? 0, draft.factor ?? 0, draft.price ?? 0, draft.side);\n68\t  return {\n69\t    ...draft,\n70\t    internalTradeId: id,\n71\t    status,\n72\t    allocations: draft.allocations.map((allocation) => ({ ...allocation, currentFace: allocation.currentFace ?? 0 })),\n73\t    economics,\n74\t    exceptions: validateTrade(draft),\n75\t    auditEvents: actions,\n76\t    synthetic: true,\n77\t  };\n78\t}\n79\t\n80\tfunction events(id: string, at: string, status: Trade[\"status\"]): Trade[\"auditEvents\"] {\n81\t  const result: Trade[\"auditEvents\"] = [\n82\t    { id: `${id}-created`, at, action: \"created\", detail: \"Synthetic seed trade created.\" },\n83\t  ];\n84\t  if (status === \"draft\") return result;\n85\t  result.push({ id: `${id}-validated`, at, action: \"validated\", detail: \"Synthetic seed trade validated.\" });\n86\t  if (status === \"validated\") return result;\n87\t  result.push({ id: `${id}-booked`, at, action: \"booked\", detail: \"Synthetic seed trade booked.\" });\n88\t  if (status === \"cancelled\") {\n89\t    result.push({ id: `${id}-cancelled`, at, action: \"cancelled\", detail: \"Synthetic seed trade cancelled.\" });\n90\t  }\n91\t  return result;\n92\t}\n93\t\n94\tfunction deepFreeze<T>(value: T): T {\n95\t  if (value && typeof value === \"object\") {\n96\t    Object.freeze(value);\n97\t    for (const child of Object.values(value as Record<string, unknown>)) deepFreeze(child);\n98\t  }\n99\t  return value;\n100\t}\n101\t\n102\texport const SEED_TRADES: readonly Trade[] = deepFreeze([\n103\t  makeSeed(\n104\t    \"SYNTH-TRADE-001\",\n105\t    \"booked\",\n106\t    seedDraft({ productType: \"agency-rmbs\", allocations: [{ id: \"alloc-1\", label: \"Mock Account North\", currentFace: 950_000 }] }),\n107\t    events(\"SYNTH-TRADE-001\", \"202