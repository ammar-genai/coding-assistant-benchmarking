 pointer;\n406\t  transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;\n407\t}\n408\t\n409\t.tc-ticket-actions button:first-child,\n410\t.tc-ticket-actions button:last-child,\n411\t.tc-review-actions button:first-child {\n412\t  border-color: #b7c1bd;\n413\t  background: #ffffff;\n414\t  color: var(--tc-navy);\n415\t}\n416\t\n417\t.tc-ticket-actions button:hover:not(:disabled),\n418\t.tc-review-actions button:hover:not(:disabled),\n419\t.tc-row-action:hover {\n420\t  transform: translateY(-1px);\n421\t  border-color: var(--tc-teal);\n422\t  background: var(--tc-teal);\n423\t  color: #ffffff;\n424\t}\n425\t\n426\t.tc-ticket-actions button:disabled,\n427\t.tc-review-actions button:disabled {\n428\t  border-color: #d6dad6;\n429\t  background: #e8eae7;\n430\t  color: #8a9492;\n431\t  cursor: not-allowed;\n432\t}\n433\t\n434\t.tc-book-reason,\n435\t.tc-action-reason {\n436\t  margin: 9px 0 0;\n437\t  color: var(--tc-muted);\n438\t  font-size: 10px;\n439\t}\n440\t\n441\t.tc-review {\n442\t  position: sticky;\n443\t  top: 18px;\n444\t  max-height: calc(100vh - 36px);\n445\t  overflow-y: auto;\n446\t}\n447\t\n448\t.tc-review-heading {\n449\t  align-items: center;\n450\t}\n451\t\n452\t.tc-review-identity {\n453\t  display: grid;\n454\t  gap: 4px;\n455\t  border-radius: 12px;\n456\t  padding: 15px;\n457\t  background: var(--tc-navy);\n458\t  color: #ffffff;\n459\t}\n460\t\n461\t.tc-review-identity strong {\n462\t  font-family: var(--font-geist-mono), ui-monospace, monospace;\n463\t  font-size: 13px;\n464\t}\n465\t\n466\t.tc-review-identity span {\n467\t  color: #c5d5d2;\n468\t  font-size: 10px;\n469\t}\n470\t\n471\t.tc-review-section {\n472\t  margin-top: 20px;\n473\t  border-top: 1px solid var(--tc-line);\n474\t  padding-top: 17px;\n475\t}\n476\t\n477\t.tc-review-section h3 {\n478\t  display: flex;\n479\t  justify-content: space-between;\n480\t  gap: 12px;\n481\t  margin: 0 0 11px;\n482\t  color: var(--tc-navy);\n483\t  font-size: 11px;\n484\t  letter-spacing: 0.06em;\n485\t  text-transform: uppercase;\n486\t}\n487\t\n488\t.tc-review-section h3 span {\n489\t  color: var(--tc-muted);\n490\t  font-family: var(--font-geist-mono), ui-monospace, monospace;\n491\t}\n492\t\n493\t.tc-detail-grid {\n494\t  display: grid;\n495\t  grid-template-columns: repeat(2, minmax(0, 1fr));\n496\t  gap: 8px;\n497\t  margin: 0;\n498\t}\n499\t\n500\t.tc-detail-grid div {\n501\t  min-width: 0;\n502\t  border-radius: 8px;\n503\t  padding: 9px;\n504\t  background: #f1f3ef;\n505\t}\n506\t\n507\t.tc-detail-grid dt,\n508\t.tc-allocation-list dt {\n509\t  color: var(--tc-muted);\n510\t  font-size: 9px;\n511\t}\n512\t\n513\t.tc-detail-grid dd,\n514\t.tc-allocation-list dd {\n515\t  margin: 4px 0 0;\n516\t  overflow-wrap: anywhere;\n517\t  font-family: var(--font-geist-mono), ui-monospace, monospace;\n518\t  font-size: 11px;\n519\t  font-weight: 700;\n520\t}\n521\t\n522\t.tc-exception-list,\n523\t.tc-audit-list {\n524\t  display: grid;\n525\t  gap: 8px;\n526\t  margin: 0;\n527\t  padding: 0;\n528\t  list-style: none;\n529\t}\n530\t\n531\t.tc-exception {\n532\t  display: grid;\n533\t  gap: 3px;\n534\t  border-left: 3px solid;\n535\t  border-radius: 7px;\n536\t  padding: 9px 10px;\n537\t  font-size: 10px;\n538\t}\n539\t\n540\t.tc-exception strong {\n541\t  font-size: 8px;\n542\t  letter-spacing: 0.08em;\n543\t  text-transform: uppercase;\n544\t}\n545\t\n546\t.tc-exception-error {\n547\t  border-color: var(--tc-red);\n548\t  background: var(--tc-red-soft);\n549\t  color: #762d27;\n550\t}\n551\t\n552\t.tc-exception-warning {\n553\t  border-color: var(--tc-amber);\n554\t  background: var(--tc-amber-soft);\n555\t  color: #704801;\n556\t}\n557\t\n558\t.tc-review-clear,\n559\t.tc-review-muted,\n560\t.tc-review-note,\n561\t.tc-empty {\n562\t  margin: 0;\n563\t  color: var(--tc-muted);\n564\t  font-size: 11px;\n565\t  line-height: 1.55;\n566\t}\n567\t\n568\t.tc-review-clear {\n569\t  color: var(--tc-green);\n570\t}\n571\t\n572\t.tc-allocation-list {