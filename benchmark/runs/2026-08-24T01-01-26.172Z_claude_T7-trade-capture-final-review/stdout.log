{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XHuT9xwNuqdBMYKR2weyiB","type":"tool_result","content":"1\timport type {\n2\t  ProductType,\n3\t  Side,\n4\t  TradeDraft,\n5\t  TradeException,\n6\t  TradeModifier,\n7\t  TradeTicketProps,\n8\t} from \"../domain/types.ts\";\n9\t\n10\tconst SIDES: ReadonlyArray<{ value: Side; label: string }> = [\n11\t  { value: \"buy\", label: \"Buy\" },\n12\t  { value: \"sell\", label: \"Sell\" },\n13\t];\n14\t\n15\tconst PRODUCT_TYPES: ReadonlyArray<{ value: ProductType; label: string }> = [\n16\t  { value: \"agency-rmbs\", label: \"Agency RMBS\" },\n17\t  { value: \"non-agency-rmbs\", label: \"Non-agency RMBS\" },\n18\t  { value: \"cmbs\", label: \"CMBS\" },\n19\t  { value: \"abs\", label: \"ABS\" },\n20\t  { value: \"clo\", label: \"CLO\" },\n21\t  { value: \"tba-mbs\", label: \"TBA MBS\" },\n22\t];\n23\t\n24\tconst MODIFIERS: ReadonlyArray<{ value: TradeModifier; label: string }> = [\n25\t  { value: \"regular\", label: \"Regular\" },\n26\t  { value: \"specified-pool\", label: \"Specified pool\" },\n27\t  { value: \"stipulation\", label: \"Stipulation\" },\n28\t  { value: \"dollar-roll\", label: \"Dollar roll\" },\n29\t  { value: \"weighted-average-price\", label: \"Weighted-average price\" },\n30\t];\n31\t\n32\tfunction fieldExceptions(exceptions: readonly TradeException[], field: keyof TradeDraft): TradeException[] {\n33\t  return exceptions.filter((item) => item.field === field);\n34\t}\n35\t\n36\tfunction FieldMessages({ field, items }: { field: keyof TradeDraft; items: TradeException[] }) {\n37\t  if (items.length === 0) return null;\n38\t  return (\n39\t    <div id={`tc-error-${field}`} className=\"tc-field-messages\">\n40\t      {items.map((item) => (\n41\t        <p key={item.code} className={item.severity === \"error\" ? \"tc-field-error\" : \"tc-field-warning\"}>\n42\t          {item.message}\n43\t        </p>\n44\t      ))}\n45\t    </div>\n46\t  );\n47\t}\n48\t\n49\tinterface FieldControlProps {\n50\t  field: keyof TradeDraft;\n51\t  label: string;\n52\t  items: TradeException[];\n53\t}\n54\t\n55\tfunction TextField({\n56\t  field,\n57\t  label,\n58\t  value,\n59\t  items,\n60\t  type = \"text\",\n61\t  onValueChange,\n62\t}: FieldControlProps & { value: string; type?: \"text\" | \"date\"; onValueChange: (value: string) => void }) {\n63\t  const inputId = `tc-field-${field}`;\n64\t  const hasMessage = items.length > 0;\n65\t  const isInvalid = items.some((item) => item.severity === \"error\");\n66\t  return (\n67\t    <div className=\"tc-field\">\n68\t      <label htmlFor={inputId}>{label}</label>\n69\t      <input\n70\t        id={inputId}\n71\t        type={type}\n72\t        value={value}\n73\t        aria-invalid={isInvalid ? true : undefined}\n74\t        aria-describedby={hasMessage ? `tc-error-${field}` : undefined}\n75\t        onChange={(event) => onValueChange(event.target.value)}\n76\t      />\n77\t      <FieldMessages field={field} items={items} />\n78\t    </div>\n79\t  );\n80\t}\n81\t\n82\tfunction NumberField({\n83\t  field,\n84\t  label,\n85\t  value,\n86\t  items,\n87\t  onValueChange,\n88\t}: FieldControlProps & { value: number | null; onValueChange: (value: number | null) => void }) {\n89\t  const inputId = `tc-field-${field}`;\n90\t  const hasMessage = items.length > 0;\n91\t  const isInvalid = items.some((item) => item.severity === \"error\");\n92\t  return (\n93\t    <div className=\"tc-field\">\n94\t      <label htmlFor={inputId}>{label}</label>\n95\t      <input\n96\t        id={inputId}\n97\t        type=\"number\"\n98\t        value={value === null ? \"\" : value}\n99\t        aria-invalid={isInvalid ? true : undefined}\n100\t        aria-describedby={hasMessage ? `tc-error-${field}` : undefined}\n101\t        onChange={(event) => {\n102\t          const raw = event.target.value;\n103\t          if (raw === \"\") {\n104\t            onValueChange(null);\n105\t            return;\n106\t          }\n107\t          const parsed = Number(raw);\n108\t          if (Number.isFinite(parsed)) onValueChange(parsed);\n109\t        }}\n110\t      />\n111\t      <FieldMessages field={field} items={items} />\n112\t    </div>\n113\t  );\n114\t}\n115\t\n116\tfunction SelectField<Value extends string>({\n117\t  field,\n118\t  label,\n119\t  value,\n120\t  items,\n121\t  options,\n122\t  onValueChange,\n123\t}: FieldControlProps & {\n124\t  value: Value;\n125\t  options: ReadonlyArray<{ value: Value; label: string }>;\n126\t  onValueChange: (value: Value) => void;\n127\t}) {\n128\t  const inputId = `tc-field-${field}`;\n129\t  const hasMessage = items.length > 0;\n130\t  const isInvalid = items.some((item) => item.severity === \"error\");\n131\t  return (\n132\t    <div className=\"tc-field\">\n133\t      <label htmlFor={inputId}>{label}</label>\n134\t      <select\n135\t        id={inputId}\n136\t        value={value}\n137\t        aria-invalid={isInvalid ? true : undefined}\n138\t        aria-describedby={hasMessage ? `tc-error-${field}` : undefined}\n139\t        onChange={(event) => onValueChange(event.target.value as Value)}\n140\t      >\n141\t        {options.map((option) => (\n142\t          <option key={option.value} value={option.value}>\n143\t            {option.label}\n144\t          </option>\n145\t        ))}\n146\t      </select>\n147\t      <FieldMessages field={field} items={items} />\n148\t    </div>\n149\t  );\n150\t}\n151\t\n152\tfunction TextAreaField({\n153\t  field,\n154\t  label,\n155\t  value,\n156\t  items,\n157\t  onValueChange,\n158\t}: FieldControlProps & { value: string; onValueChange: (value: string) => void }) {\n159\t  const inputId = `tc-field-${field}`;\n160\t  const hasMessage = items.length > 0;\n161\t  const isInvalid = items.some((item) => item.severity === \"error\");\n162\t  return (\n163\t    <div className=\"tc-field\">\n164\t      <label htmlFor={inputId}>{label}</label>\n165\t      <textarea\n166\t        id={inputId}\n167\t        value={value}\n168\t        ari