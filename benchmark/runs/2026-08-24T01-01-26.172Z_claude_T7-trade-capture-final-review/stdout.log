: 12px;\n658\t  background: #fffefa;\n659\t}\n660\t\n661\t.tc-table {\n662\t  width: 100%;\n663\t  min-width: 1120px;\n664\t  border-collapse: collapse;\n665\t  font-size: 11px;\n666\t}\n667\t\n668\t.tc-table caption {\n669\t  position: absolute;\n670\t  width: 1px;\n671\t  height: 1px;\n672\t  overflow: hidden;\n673\t  clip: rect(0 0 0 0);\n674\t  white-space: nowrap;\n675\t}\n676\t\n677\t.tc-table thead {\n678\t  background: #173943;\n679\t  color: #eaf4f1;\n680\t}\n681\t\n682\t.tc-table th,\n683\t.tc-table td {\n684\t  border-bottom: 1px solid #e1e4df;\n685\t  padding: 12px 11px;\n686\t  text-align: left;\n687\t  vertical-align: middle;\n688\t}\n689\t\n690\t.tc-table thead th {\n691\t  font-size: 9px;\n692\t  font-weight: 700;\n693\t  letter-spacing: 0.055em;\n694\t  text-transform: uppercase;\n695\t  white-space: nowrap;\n696\t}\n697\t\n698\t.tc-table tbody tr {\n699\t  transition: background 120ms ease;\n700\t}\n701\t\n702\t.tc-table tbody tr:hover {\n703\t  background: #f1f6f2;\n704\t}\n705\t\n706\t.tc-row-selected {\n707\t  background: #e3f0eb !important;\n708\t}\n709\t\n710\t.tc-row-action {\n711\t  min-width: 55px;\n712\t  padding: 7px 9px;\n713\t  font-size: 9px;\n714\t}\n715\t\n716\t.tc-row-action[aria-pressed=\"true\"] {\n717\t  border-color: var(--tc-teal);\n718\t  background: var(--tc-teal);\n719\t}\n720\t\n721\t.tc-trade-id,\n722\t.tc-security-id {\n723\t  display: block;\n724\t  white-space: nowrap;\n725\t}\n726\t\n727\t.tc-trade-id {\n728\t  color: var(--tc-navy);\n729\t  font-family: var(--font-geist-mono), ui-monospace, monospace;\n730\t  font-size: 10px;\n731\t}\n732\t\n733\t.tc-security-id {\n734\t  margin-top: 3px;\n735\t  color: var(--tc-muted);\n736\t  font-size: 9px;\n737\t  font-weight: 400;\n738\t}\n739\t\n740\t.tc-number {\n741\t  font-family: var(--font-geist-mono), ui-monospace, monospace;\n742\t  text-align: right !important;\n743\t  white-space: nowrap;\n744\t}\n745\t\n746\t.tc-side,\n747\t.tc-status {\n748\t  display: inline-flex;\n749\t  align-items: center;\n750\t  border-radius: 999px;\n751\t  padding: 5px 8px;\n752\t  font-family: var(--font-geist-mono), ui-monospace, monospace;\n753\t  font-size: 8px;\n754\t  font-weight: 750;\n755\t  letter-spacing: 0.055em;\n756\t  text-transform: uppercase;\n757\t}\n758\t\n759\t.tc-side-buy {\n760\t  background: #dcece6;\n761\t  color: var(--tc-green);\n762\t}\n763\t\n764\t.tc-side-sell {\n765\t  background: #eee7dc;\n766\t  color: #80521a;\n767\t}\n768\t\n769\t.tc-status-draft {\n770\t  background: #e8e9e7;\n771\t  color: #596463;\n772\t}\n773\t\n774\t.tc-status-validated {\n775\t  background: #dfeaf2;\n776\t  color: #345c75;\n777\t}\n778\t\n779\t.tc-status-booked {\n780\t  background: var(--tc-green-soft);\n781\t  color: var(--tc-green);\n782\t}\n783\t\n784\t.tc-status-cancelled {\n785\t  background: var(--tc-red-soft);\n786\t  color: var(--tc-red);\n787\t}\n788\t\n789\t.tc-table-empty {\n790\t  padding: 40px !important;\n791\t  color: var(--tc-muted);\n792\t  text-align: center !important;\n793\t}\n794\t\n795\t.tc-shell button:focus-visible,\n796\t.tc-shell input:focus-visible,\n797\t.tc-shell select:focus-visible,\n798\t.tc-shell textarea:focus-visible,\n799\t.tc-table-region:focus-visible {\n800\t  outline: 3px solid #f0ad37;\n801\t  outline-offset: 2px;\n802\t}\n803\t\n804\t@media (max-width: 1120px) {\n805\t  .tc-insights {\n806\t    grid-template-columns: 1fr 1fr;\n807\t  }\n808\t\n809\t  .tc-insights .tc-panel-heading {\n810\t    grid-column: 1 / -1;\n811\t    border-right: 0;\n812\t    border-bottom: 1px solid var(--tc-line);\n813\t    padding: 0 0 16px;\n814\t  }\n815\t\n816\t  .tc-workspace {\n817\t    grid-template-columns: minmax(0, 1fr);\n818\t  }\n819\t\n820\t  .tc-review {\n821\t    position: static;\n822\t    max-height: none;\n823\t  }\n824\t\n825\t  .tc-field-group {\n826\t    grid-template-columns: repeat(3, minmax(0, 1fr));\n827\t  }\n828\t}\n829\t\n830\t@media (max-width: 760px) {\n831\t  .tc-shell {\n832\t    padding: 14px 12px 48px;\n833\t  }\n834\t\n835\t  .tc-hero {\n836\t    grid-template-columns: minmax(0, 1fr);\n837\t    gap: 22px;\n838\t    border-radius: 18px;\n839\t    padding: 27px 21px;\n840\t  }\n841\t\n842\t  .tc-hero-control {\n843\t    width: 100%;\n844\t    min-width: 0;\n845\t  }\n846\t\n847\t  .tc-synthetic-notice {\n848\t    grid-column: 1;\n849\t    margin-top: 0;\n850\t  }\n851\t\n852\t  .tc-insights {\n853\t    grid-template-columns: minmax(0, 1fr);\n854\t    gap: 18px;\n855\t    padding: 20px;\n856\t  }\n857\t\n858\t  .tc-insights .tc-panel-heading {\n859\t    grid-column: 1;\n860\t  }\n861\t\n862\t  .tc-metric-grid {\n863\t    grid-template-columns: repeat(2, minmax(0, 1fr));\n864\t  }\n865\t\n866\t  .tc-validation {\n867\t    align-items: start;\n868\t    flex-direction: column;\n869\t    gap: 4px;\n870\t  }\n871\t\n872\t  .tc-ticket,\n873\t  .tc-review,\n874\t  .tc-blotter {\n875\t    border-radius: 14px;\n876\t    padding: 18px 15px;\n877\t  }\n878\t\n879\t  .tc-field-group {\n880\t    grid-template-columns: minmax(0, 1fr);\n881\t    padding: 14px;\n882\t  }\n883\t\n884\t  .tc-filter-bar {\n885\t    grid-template-columns: minmax(0, 1fr);\n886\t  }\n887\t\n888\t  .tc-panel-heading {\n889\t    align-items: start;\n890\t  }\n891\t\n892\t  .tc-detail-grid {\n893\t    grid-template-columns: minmax(0, 1fr);\n894\t  }\n895\t\n896\t  .tc-ticket-actions button,\n897\t  .tc-review-actions button {\n898\t    flex: 1 1 44%;\n899\t  }\n900\t}\n901\t"}]},"parent_tool_use_id":null,"session_id":"f0534d7a-1d7b-4a4f-b438-f153dd9a57ff","uuid":"9cbe7635-ce1e-42f7-8268-2ae6e76bb98e","timestamp":"2026-08-24T01:03:09.459Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-o2LLK6/checkout/app/trade-capture/trade-capture.css","content":".tc-shell {\n  --tc-ink: #17252b;\n  --tc-navy: #123a48;\n  --tc-teal: #0b6b68;\n  --tc-teal-dark: #075451;\n  --tc-cyan: #bfe3dd;\n  --tc-paper: #f4f1e9;\n  --tc-card: #fffdf8;\n  --tc-line: #d8d7cf;\n  --tc-muted: #68777b;\n  --tc-red: #a83e34;\n  --tc-red-soft: #f8e4df;\n  --tc-amber: #a56805;\n  --tc-amber-soft: #f8edcf;\n  --tc-green: #176345;\n  --tc-green-soft: #dfeee5;\n  min-height: 100vh;\n  overflow-x: clip;\n  padding: 38px clamp(18px, 3.2vw, 54px) 72px;\n  background:\n    radial-gradient(circle at 88% 2%, rgba(39, 143, 135, 0.14), transparent 29rem),\n    linear-gradient(180deg, #eef2ed 0, var(--tc-paper) 22rem);\n  color: var(--tc-ink);\n}\n\n.tc-hero {\n  position: relative;\n  isolation: isolate;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 18px 36px;\n  max-width: 1480px;\n  margin: 0 auto 22px;\n  border-radius: 24px;\n  padding: clamp(28px, 4.5vw, 64px);\n  overflow: hidden;\n  background: linear-gradient(132deg, #0d2d39 0%, #123f4a 55%, #0e625e 100%);\n  box-shadow: 0 24px 70px rgba(18, 58, 72, 0.18);\n  color: #f7fbf8;\n}\n\n.tc-hero::after {\n  position: absolute;\n  z-index: -1;\n  top: 0;\n  right: 0;\n  width: 62%;\n  height: 100%;\n  background-image: linear-gradient(90deg, #123b48 0%, rgba(18, 59, 72, 0.08) 62%), url(\"/trade-capture-structure.png\");\n  background-position: center right;\n  background-size: cover;\n  content: \"\";\n  opacity: 0.52;\n}\n\n.tc-hero-copy {\n  align-self: center;\n  max-width: 790px;\n}\n\n.tc-hero-copy .tc-eyebrow {\n  color: #9fd8cf;\n}\n\n.tc-hero-copy h1 {\n  max-width: 800px;\n  margin: 12px 0 18px;\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: clamp(42px, 6.5vw, 92px);\n  font-weight: 500;\n  letter-spacing: -0.065em;\n  line-height: 0.9;\n}\n\n.tc-hero-summary {\n  max-width: 670px;\n  margin: 0;\n  color: #ccddd9;\n  font-size: clamp(14px, 1.4vw, 18px);\n  line-height: 1.55;\n}\n\n.tc-hero-control {\n  display: flex;\n  align-self: start;\n  align-items: center;\n  gap: 12px;\n  min-width: 220px;\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  border-radius: 14px;\n  padding: 13px 15px;\n  background: rgba(255, 255, 255, 0.07);\n}\n\n.tc-hero-control div {\n  display: grid;\n  gap: 2px;\n}\n\n.tc-hero-control strong {\n  font-size: 12px;\n  letter-spacing: 0.02em;\n}\n\n.tc-hero-control span {\n  color: #b8ceca;\n  font-size: 10px;\n}\n\n.tc-live-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 999px;\n  background: #75dfbb;\n  box-shadow: 0 0 0 5px rgba(117, 223, 187, 0.13);\n}\n\n.tc-synthetic-notice {\n  grid-column: 1 / -1;\n  margin: 18px 0 0;\n  border-top: 1px solid rgba(255, 255, 255, 0.15);\n  padding-top: 16px;\n  color: #c3d4d1;\n  font-size: 12px;\n}\n\n.tc-synthetic-notice strong {\n  color: #ffffff;\n}\n\n.tc-panel {\n  border: 1px solid var(--tc-line);\n  border-radius: 18px;\n  background: rgba(255, 253, 248, 0.94);\n  box-shadow: 0 14px 42px rgba(27, 47, 54, 0.07);\n}\n\n.tc-panel-heading {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.tc-panel-heading h2 {\n  margin: 3px 0 0;\n  color: var(--tc-navy);\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: clamp(24px, 2.5vw, 36px);\n  font-weight: 500;\n  letter-spacing: -0.035em;\n}\n\n.tc-eyebrow {\n  margin: 0;\n  color: var(--tc-teal);\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 10px;\n  font-weight: 750;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.tc-insights,\n.tc-validation,\n.tc-workspace,\n.tc-blotter {\n  width: 100%;\n  max-width: 1480px;\n  margin: 0 auto 22px;\n}\n\n.tc-insights {\n  display: grid;\n  grid-template-columns: minmax(180px, 0.42fr) minmax(0, 1fr) minmax(0, 1.35fr);\n  gap: 24px;\n  align-items: stretch;\n  padding: 24px;\n}\n\n.tc-insights .tc-panel-heading {\n  align-items: start;\n  margin: 0;\n  border-right: 1px solid var(--tc-line);\n  padding-right: 20px;\n}\n\n.tc-metric-group {\n  min-width: 0;\n}\n\n.tc-metric-group-title {\n  margin: 0 0 12px;\n  color: var(--tc-muted);\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 10px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.tc-metric-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(125px, 1fr));\n  gap: 8px;\n  margin: 0;\n}\n\n.tc-metric {\n  min-width: 0;\n  border-radius: 11px;\n  padding: 12px;\n  background: #f2f5f1;\n}\n\n.tc-metric-label {\n  color: var(--tc-muted);\n  font-size: 10px;\n  font-weight: 650;\n  letter-spacing: 0.03em;\n}\n\n.tc-metric-value {\n  margin: 6px 0 0;\n  overflow: hidden;\n  color: var(--tc-navy);\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: clamp(15px, 1.4vw, 20px);\n  font-weight: 700;\n  letter-spacing: -0.04em;\n  text-overflow: ellipsis;\n}\n\n.tc-positive {\n  color: var(--tc-green);\n}\n\n.tc-negative {\n  color: var(--tc-red);\n}\n\n.tc-neutral {\n  color: var(--tc-navy);\n}\n\n.tc-alert {\n  color: var(--tc-red);\n}\n\n.tc-validation {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  border: 1px solid;\n  border-radius: 13px;\n  padding: 13px 16px;\n  font-size: 12px;\n}\n\n.tc-validation span {\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 10px;\n  text-transform: uppercase;\n}\n\n.tc-validation-error {\n  border-color: #e2b3a9;\n  background: var(--tc-red-soft);\n  color: #762d27;\n}\n\n.tc-validation-ready {\n  border-color: #a7cfba;\n  background: var(--tc-green-soft);\n  color: var(--tc-green);\n}\n\n.tc-workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1.62fr) minmax(330px, 0.78fr);\n  gap: 22px;\n  align-items: start;\n}\n\n.tc-ticket,\n.tc-review,\n.tc-blotter {\n  padding: clamp(20px, 2.4vw, 32px);\n}\n\n.tc-ticket {\n  min-width: 0;\n}\n\n.tc-field-group {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 16px;\n  margin: 0 0 18px;\n  border: 1px solid var(--tc-line);\n  border-radius: 13px;\n  padding: 18px;\n  background: rgba(244, 246, 242, 0.62);\n}\n\n.tc-field-group legend {\n  padding: 0 8px;\n  color: var(--tc-navy);\n  font-size: 11px;\n  font-weight: 750;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.tc-field {\n  display: grid;\n  align-content: start;\n  gap: 6px;\n  min-width: 0;\n}\n\n.tc-field label,\n.tc-filter span {\n  color: #41545a;\n  font-size: 10px;\n  font-weight: 720;\n  letter-spacing: 0.045em;\n  text-transform: uppercase;\n}\n\n.tc-field input,\n.tc-field select,\n.tc-field textarea,\n.tc-filter input,\n.tc-filter select {\n  width: 100%;\n  min-width: 0;\n  border: 1px solid #c9d0cc;\n  border-radius: 9px;\n  padding: 10px 11px;\n  background: #fffefa;\n  color: var(--tc-ink);\n  font: inherit;\n  font-size: 12px;\n  transition: border-color 140ms ease, box-shadow 140ms ease, background 140ms ease;\n}\n\n.tc-field textarea {\n  min-height: 84px;\n  resize: vertical;\n}\n\n.tc-field input:disabled {\n  background: #e8ece8;\n  color: #5d6b6d;\n}\n\n.tc-field input[aria-invalid=\"true\"],\n.tc-field select[aria-invalid=\"true\"],\n.tc-field textarea[aria-invalid=\"true\"] {\n  border-color: #c96558;\n  background: #fff9f7;\n}\n\n.tc-field-messages {\n  display: grid;\n  gap: 3px;\n}\n\n.tc-field-error,\n.tc-field-warning {\n  margin: 0;\n  font-size: 10px;\n  line-height: 1.35;\n}\n\n.tc-field-error {\n  color: var(--tc-red);\n}\n\n.tc-field-warning {\n  color: var(--tc-amber);\n}\n\n.tc-ticket-actions,\n.tc-review-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 9px;\n  margin-top: 22px;\n}\n\n.tc-ticket-actions button,\n.tc-review-actions button,\n.tc-row-action {\n  border: 1px solid var(--tc-navy);\n  border-radius: 9px;\n  padding: 10px 15px;\n  background: var(--tc-navy);\n  color: #ffffff;\n  font: inherit;\n  font-size: 11px;\n  font-weight: 720;\n  cursor: pointer;\n  transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;\n}\n\n.tc-ticket-actions button:first-child,\n.tc-ticket-actions button:last-child,\n.tc-review-actions button:first-child {\n  border-color: #b7c1bd;\n  background: #ffffff;\n  color: var(--tc-navy);\n}\n\n.tc-ticket-actions button:hover:not(:disabled),\n.tc-review-actions button:hover:not(:disabled),\n.tc-row-action:hover {\n  transform: translateY(-1px);\n  border-color: var(--tc-teal);\n  background: var(--tc-teal);\n  color: #ffffff;\n}\n\n.tc-ticket-actions button:disabled,\n.tc-review-actions button:disabled {\n  border-color: #d6dad6;\n  background: #e8eae7;\n  color: #8a9492;\n  cursor: not-allowed;\n}\n\n.tc-book-reason,\n.tc-action-reason {\n  margin: 9px 0 0;\n  color: var(--tc-muted);\n  font-size: 10px;\n}\n\n.tc-review {\n  position: sticky;\n  top: 18px;\n  max-height: calc(100vh - 36px);\n  overflow-y: auto;\n}\n\n.tc-review-heading {\n  align-items: center;\n}\n\n.tc-review-identity {\n  display: grid;\n  gap: 4px;\n  border-radius: 12px;\n  padding: 15px;\n  background: var(--tc-navy);\n  color: #ffffff;\n}\n\n.tc-review-identity strong {\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 13px;\n}\n\n.tc-review-identity span {\n  color: #c5d5d2;\n  font-size: 10px;\n}\n\n.tc-review-section {\n  margin-top: 20px;\n  border-top: 1px solid var(--tc-line);\n  padding-top: 17px;\n}\n\n.tc-review-section h3 {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  margin: 0 0 11px;\n  color: var(--tc-navy);\n  font-size: 11px;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.tc-review-section h3 span {\n  color: var(--tc-muted);\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n}\n\n.tc-detail-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n  margin: 0;\n}\n\n.tc-detail-grid div {\n  min-width: 0;\n  border-radius: 8px;\n  padding: 9px;\n  background: #f1f3ef;\n}\n\n.tc-detail-grid dt,\n.tc-allocation-list dt {\n  color: var(--tc-muted);\n  font-size: 9px;\n}\n\n.tc-detail-grid dd,\n.tc-allocation-list dd {\n  margin: 4px 0 0;\n  overflow-wrap: anywhere;\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.tc-exception-list,\n.tc-audit-list {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.tc-exception {\n  display: grid;\n  gap: 3px;\n  border-left: 3px solid;\n  border-radius: 7px;\n  padding: 9px 10px;\n  font-size: 10px;\n}\n\n.tc-exception strong {\n  font-size: 8px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.tc-exception-error {\n  border-color: var(--tc-red);\n  background: var(--tc-red-soft);\n  color: #762d27;\n}\n\n.tc-exception-warning {\n  border-color: var(--tc-amber);\n  background: var(--tc-amber-soft);\n  color: #704801;\n}\n\n.tc-review-clear,\n.tc-review-muted,\n.tc-review-note,\n.tc-empty {\n  margin: 0;\n  color: var(--tc-muted);\n  font-size: 11px;\n  line-height: 1.55;\n}\n\n.tc-review-clear {\n  color: var(--tc-green);\n}\n\n.tc-allocation-list {\n  display: grid;\n  gap: 5px;\n  margin: 0;\n}\n\n.tc-allocation-list div {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  border-bottom: 1px solid var(--tc-line);\n  padding: 7px 0;\n}\n\n.tc-audit-list li {\n  display: grid;\n  grid-template-columns: 10px minmax(0, 1fr);\n  gap: 8px;\n}\n\n.tc-audit-list li > div {\n  display: grid;\n  gap: 2px;\n}\n\n.tc-audit-list strong {\n  color: var(--tc-ink);\n  font-size: 10px;\n  text-transform: capitalize;\n}\n\n.tc-audit-list span,\n.tc-audit-list time {\n  color: var(--tc-muted);\n  font-size: 9px;\n}\n\n.tc-audit-marker {\n  width: 7px;\n  height: 7px;\n  margin-top: 4px;\n  border-radius: 999px;\n  background: var(--tc-teal);\n  box-shadow: 0 0 0 3px rgba(11, 107, 104, 0.12);\n}\n\n.tc-danger-action {\n  border-color: var(--tc-red) !important;\n  background: var(--tc-red) !important;\n}\n\n.tc-blotter-heading {\n  align-items: center;\n}\n\n.tc-result-count {\n  border-radius: 999px;\n  padding: 7px 10px;\n  background: #e4ece7;\n  color: var(--tc-teal-dark);\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 9px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.tc-filter-bar {\n  display: grid;\n  grid-template-columns: minmax(220px, 1.5fr) repeat(3, minmax(150px, 0.7fr));\n  gap: 10px;\n  margin-bottom: 17px;\n  border-radius: 12px;\n  padding: 12px;\n  background: #edf1ed;\n}\n\n.tc-filter {\n  display: grid;\n  gap: 5px;\n  min-width: 0;\n}\n\n.tc-table-region {\n  overflow-x: auto;\n  border: 1px solid var(--tc-line);\n  border-radius: 12px;\n  background: #fffefa;\n}\n\n.tc-table {\n  width: 100%;\n  min-width: 1120px;\n  border-collapse: collapse;\n  font-size: 11px;\n}\n\n.tc-table caption {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.tc-table thead {\n  background: #173943;\n  color: #eaf4f1;\n}\n\n.tc-table th,\n.tc-table td {\n  border-bottom: 1px solid #e1e4df;\n  padding: 12px 11px;\n  text-align: left;\n  vertical-align: middle;\n}\n\n.tc-table thead th {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.055em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.tc-table tbody tr {\n  transition: background 120ms ease;\n}\n\n.tc-table tbody tr:hover {\n  background: #f1f6f2;\n}\n\n.tc-row-selected {\n  background: #e3f0eb !important;\n}\n\n.tc-row-action {\n  min-width: 55px;\n  padding: 7px 9px;\n  font-size: 9px;\n}\n\n.tc-row-action[aria-pressed=\"true\"] {\n  border-color: var(--tc-teal);\n  background: var(--tc-teal);\n}\n\n.tc-trade-id,\n.tc-security-id {\n  display: block;\n  white-space: nowrap;\n}\n\n.tc-trade-id {\n  color: var(--tc-navy);\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 10px;\n}\n\n.tc-security-id {\n  margin-top: 3px;\n  color: var(--tc-muted);\n  font-size: 9px;\n  font-weight: 400;\n}\n\n.tc-number {\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  text-align: right !important;\n  white-space: nowrap;\n}\n\n.tc-side,\n.tc-status {\n  display: inline-flex;\n  align-items: center;\n  border-radius: 999px;\n  padding: 5px 8px;\n  font-family: var(--font-geist-mono), ui-monospace, monospace;\n  font-size: 8px;\n  font-weight: 750;\n  letter-spacing: 0.055em;\n  text-transform: uppercase;\n}\n\n.tc-side-buy {\n  background: #dcece6;\n  color: var(--tc-green);\n}\n\n.tc-side-sell {\n  background: #eee7dc;\n  color: #80521a;\n}\n\n.tc-status-draft {\n  background: #e8e9e7;\n  color: #596463;\n}\n\n.tc-status-validated {\n  background: #dfeaf2;\n  color: #345c75;\n}\n\n.tc-status-booked {\n  background: var(--tc-green-soft);\n  color: var(--tc-green);\n}\n\n.tc-status-cancelled {\n  background: var(--tc-red-soft);\n  color: var(--tc-red);\n}\n\n.tc-table-empty {\n  padding: 40px !important;\n  color: var(--tc-muted);\n  text-align: center !important;\n}\n\n.tc-shell button:focus-visible,\n.tc-shell input:focus-visible,\n.tc-shell select:focus-visible,\n.tc-shell textarea:focus-visible,\n.tc-table-region:focus-visible {\n  outline: 3px solid #f0ad37;\n  outline-offset: 2px;\n}\n\n@media (max-width: 1120px) {\n  .tc-insights {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .tc-insights .tc-panel-heading {\n    grid-column: 1 / -1;\n    border-right: 0;\n    border-bottom: 1px solid var(--tc-line);\n    padding: 0 0 16px;\n  }\n\n  .tc-workspace {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .tc-review {\n    position: static;\n    max-height: none;\n  }\n\n  .tc-field-group {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 760px) {\n  .tc-shell {\n    padding: 14px 12px 48px;\n  }\n\n  .tc-hero {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 22px;\n    border-radius: 18px;\n    padding: 27px 21px;\n  }\n\n  .tc-hero-control {\n    width: 100%;\n    min-width: 0;\n  }\n\n  .tc-synthetic-notice {\n    grid-column: 1;\n    margin-top: 0;\n  }\n\n  .tc-insights {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 18px;\n    padding: 20px;\n  }\n\n  .tc-insights .tc-panel-heading {\n    grid-column: 1;\n  }\n\n  .tc-metric-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .tc-validation {\n    align-items: start;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .tc-ticket,\n  .tc-review,\n  .tc-blotter {\n    border-radius: 14px;\n    padding: 18px 15px;\n  }\n\n  .tc-field-group {\n    grid-template-columns: minmax(0, 1fr);\n    padding: 14px;\n  }\n\n  .tc-filter-bar {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .tc-panel-heading {\n    align-items: start;\n  }\n\n  .tc-detail-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .tc-ticket-actions button,\n  .tc-review-actions button {\n    flex: 1 1 44%;\n  }\n}\n","numLines":901,"startLine":1,"totalLines":901}}}
