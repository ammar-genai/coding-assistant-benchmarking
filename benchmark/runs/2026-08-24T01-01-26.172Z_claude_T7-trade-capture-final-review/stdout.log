{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XjWyFxFxZHypRKqVhLtyVp","type":"tool_result","content":"1\timport { calculateEconomics } from \"./calculations.ts\";\n2\timport type { AuditAction, LifecycleContext, Trade, TradeDraft } from \"./types.ts\";\n3\timport { validateTrade } from \"./validation.ts\";\n4\t\n5\tfunction audit(context: LifecycleContext, action: AuditAction, detail: string) {\n6\t  return { id: `${context.id}-${action}`, at: context.at, action, detail };\n7\t}\n8\t\n9\tfunction record(\n10\t  existing: Trade | null,\n11\t  draft: TradeDraft,\n12\t  context: LifecycleContext,\n13\t  status: Trade[\"status\"],\n14\t  action: AuditAction,\n15\t  exceptions = validateTrade(draft),\n16\t): Trade {\n17\t  const identity = existing?.internalTradeId ?? context.id;\n18\t  const history = existing\n19\t    ? [...existing.auditEvents, audit(context, \"updated\", \"Synthetic trade updated.\")]\n20\t    : [audit(context, \"created\", \"Synthetic trade created.\")];\n21\t  const originalFace = draft.originalFace ?? 0;\n22\t  const factor = draft.factor ?? 0;\n23\t  const price = draft.price ?? 0;\n24\t\n25\t  return {\n26\t    ...draft,\n27\t    internalTradeId: identity,\n28\t    status,\n29\t    allocations: draft.allocations.map((allocation) => ({ ...allocation, currentFace: allocation.currentFace ?? 0 })),\n30\t    economics: calculateEconomics(originalFace, factor, price, draft.side),\n31\t    exceptions: [...exceptions],\n32\t    auditEvents: [...history, audit(context, action, `Synthetic trade ${action}.`)],\n33\t    synthetic: true,\n34\t  };\n35\t}\n36\t\n37\texport function saveDraft(existing: Trade | null, draft: TradeDraft, context: LifecycleContext): Trade {\n38\t  return record(existing, draft, context, \"draft\", \"draft-saved\");\n39\t}\n40\t\n41\texport function validateTradeRecord(existing: Trade | null, draft: TradeDraft, context: LifecycleContext): Trade {\n42\t  return record(existing, draft, context, \"validated\", \"validated\");\n43\t}\n44\t\n45\texport function bookTrade(existing: Trade | null, draft: TradeDraft, context: LifecycleContext): Trade {\n46\t  const exceptions = validateTrade(draft);\n47\t  if (exceptions.some((item) => item.severity === \"error\")) {\n48\t    throw new Error(\"Cannot book a trade with validation errors.\");\n49\t  }\n50\t  return record(existing, draft, context, \"booked\", \"booked\", exceptions);\n51\t}\n52\t\n53\texport function cancelTrade(trade: Trade, context: LifecycleContext): Trade {\n54\t  if (trade.status !== \"booked\") {\n55\t    throw new Error(\"Only booked trades can be cancelled.\");\n56\t  }\n57\t  return {\n58\t    ...trade,\n59\t    status: \"cancelled\",\n60\t    allocations: trade.allocations.map((allocation) => ({ ...allocation })),\n61\t    exceptions: [...trade.exceptions],\n62\t    auditEvents: [...trade.auditEvents, audit(context, \"cancelled\", \"Synthetic trade cancelled.\")],\n63\t  };\n64\t}\n65\t"}]},"parent_tool_use_id":null,"session_id":"f0534d7a-1d7b-4a4f-b438-f153dd9a57ff","uuid":"c26aa453-ac0d-4c67-95bf-3a4aa467fd8f","timestamp":"2026-08-24T01:01:56.746Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-o2LLK6/checkout/app/trade-capture/domain/lifecycle.ts","content":"import { calculateEconomics } from \"./calculations.ts\";\nimport type { AuditAction, LifecycleContext, Trade, TradeDraft } from \"./types.ts\";\nimport { validateTrade } from \"./validation.ts\";\n\nfunction audit(context: LifecycleContext, action: AuditAction, detail: string) {\n  return { id: `${context.id}-${action}`, at: context.at, action, detail };\n}\n\nfunction record(\n  existing: Trade | null,\n  draft: TradeDraft,\n  context: LifecycleContext,\n  status: Trade[\"status\"],\n  action: AuditAction,\n  exceptions = validateTrade(draft),\n): Trade {\n  const identity = existing?.internalTradeId ?? context.id;\n  const history = existing\n    ? [...existing.auditEvents, audit(context, \"updated\", \"Synthetic trade updated.\")]\n    : [audit(context, \"created\", \"Synthetic trade created.\")];\n  const originalFace = draft.originalFace ?? 0;\n  const factor = draft.factor ?? 0;\n  const price = draft.price ?? 0;\n\n  return {\n    ...draft,\n    internalTradeId: identity,\n    status,\n    allocations: draft.allocations.map((allocation) => ({ ...allocation, currentFace: allocation.currentFace ?? 0 })),\n    economics: calculateEconomics(originalFace, factor, price, draft.side),\n    exceptions: [...exceptions],\n    auditEvents: [...history, audit(context, action, `Synthetic trade ${action}.`)],\n    synthetic: true,\n  };\n}\n\nexport function saveDraft(existing: Trade | null, draft: TradeDraft, context: LifecycleContext): Trade {\n  return record(existing, draft, context, \"draft\", \"draft-saved\");\n}\n\nexport function validateTradeRecord(existing: Trade | null, draft: TradeDraft, context: LifecycleContext): Trade {\n  return record(existing, draft, context, \"validated\", \"validated\");\n}\n\nexport function bookTrade(existing: Trade | null, draft: TradeDraft, context: LifecycleContext): Trade {\n  const exceptions = validateTrade(draft);\n  if (exceptions.some((item) => item.severity === \"error\")) {\n    throw new Error(\"Cannot book a trade with validation errors.\");\n  }\n  return record(existing, draft, context, \"booked\", \"booked\", exceptions);\n}\n\nexport function cancelTrade(trade: Trade, context: LifecycleContext): Trade {\n  if (trade.status !== \"booked\") {\n    throw new Error(\"Only booked trades can be cancelled.\");\n  }\n  return {\n    ...trade,\n    status: \"cancelled\",\n    allocations: trade.allocations.map((allocation) => ({ ...allocation })),\n    exceptions: [...trade.exceptions],\n    auditEvents: [...trade.auditEvents, audit(context, \"cancelled\", \"Synthetic trade cancelled.\")],\n  };\n}\n","numLines":65,"startLine":1,"totalLines":65}}}
