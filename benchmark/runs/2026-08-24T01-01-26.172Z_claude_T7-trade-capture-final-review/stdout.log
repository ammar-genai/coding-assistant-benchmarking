{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016pr6TS4Au3FuQ1VEbDuVrB","type":"tool_result","content":"1\timport assert from \"node:assert/strict\";\n2\timport test from \"node:test\";\n3\t\n4\timport {\n5\t  calculateEconomics,\n6\t  summarizeDesk,\n7\t  withinOneCent,\n8\t} from \"../app/trade-capture/domain/calculations.ts\";\n9\timport { bookTrade, cancelTrade, saveDraft, validateTradeRecord } from \"../app/trade-capture/domain/lifecycle.ts\";\n10\timport { EMPTY_TRADE_DRAFT, SEED_TRADES } from \"../app/trade-capture/domain/seed.ts\";\n11\timport { validateTrade } from \"../app/trade-capture/domain/validation.ts\";\n12\t\n13\ttest(\"calculates current face, principal, and signed exposure\", () => {\n14\t  assert.deepEqual(calculateEconomics(1_000_000, 0.8, 99.5, \"buy\"), {\n15\t    currentFace: 800_000,\n16\t    grossPrincipal: 796_000,\n17\t    signedExposure: 796_000,\n18\t  });\n19\t  assert.equal(calculateEconomics(1_000_000, 0.8, 99.5, \"sell\").signedExposure, -796_000);\n20\t});\n21\t\n22\ttest(\"uses rounded cents for allocation tolerance\", () => {\n23\t  assert.equal(withinOneCent(100, 100.01), true);\n24\t  assert.equal(withinOneCent(100, 100.02), false);\n25\t});\n26\t\n27\ttest(\"summarizes an empty desk\", () => {\n28\t  assert.deepEqual(summarizeDesk([]), {\n29\t    activeTradeCount: 0,\n30\t    bookedTradeCount: 0,\n31\t    exceptionCount: 0,\n32\t    buyExposure: 0,\n33\t    sellExposure: 0,\n34\t    netExposure: 0,\n35\t    grossPrincipal: 0,\n36\t  });\n37\t});\n38\t\n39\tfunction validDraft(overrides = {}) {\n40\t  return {\n41\t    ...EMPTY_TRADE_DRAFT,\n42\t    securityId: \"SYNTH1234\",\n43\t    counterparty: \"Demo Counterparty\",\n44\t    book: \"Mock Book\",\n45\t    trader: \"Sample Trader\",\n46\t    agency: \"Mock Agency\",\n47\t    originalFace: 100,\n48\t    factor: 0.5,\n49\t    price: 100,\n50\t    ...overrides,\n51\t  };\n52\t}\n53\t\n54\ttest(\"validates required fields, product rules, and rounded allocation boundaries\", () => {\n55\t  const invalid = validDraft({\n56\t    securityId: \"bad\",\n57\t    settlementDate: \"2026-08-22\",\n58\t    agency: \"\",\n59\t    modifier: \"specified-pool\",\n60\t    poolNumber: \"\",\n61\t    allocations: [{ id: \"a\", label: \"A\", currentFace: 50.011 }],\n62\t  });\n63\t  assert.deepEqual(\n64\t    validateTrade(invalid).map((item) => item.code),\n65\t    [\"invalid-security-id\", \"missing-client-trade-id\", \"settlement-before-trade\", \"required-agency\", \"required-pool\"],\n66\t  );\n67\t  assert.equal(validateTrade(validDraft({ allocations: [{ id: \"a\", label: \"A\", currentFace: 50.02 }] })).at(-1)?.code, \"allocation-mismatch\");\n68\t  assert.equal(validateTrade(validDraft({ allocations: [{ id: \"a\", label: \"A\", currentFace: 50.01 }] })).some((item) => item.code === \"allocation-mismatch\"), false);\n69\t  assert.equal(validateTrade(validDraft({ productType: \"clo\", modifier: \"dollar-roll\" })).some((item) => item.code === \"invalid-modifier-for-product\"), true);\n70\t});\n71\t\n72\ttest(\"lifecycle actions are immutable, deterministic, and enforce transitions\", () => {\n73\t  const draft = validDraft();\n74\t  const saved = saveDraft(null, draft, { id: \"NEW-1\", at: \"2026-08-23T15:00:00.000Z\" });\n75\t  assert.equal(saved.internalTradeId, \"NEW-1\");\n76\t  assert.deepEqual(saved.auditEvents.map((event) => event.action), [\"created\", \"draft-saved\"]);\n77\t  const validated = validateTradeRecord(\n78\t    saved,\n79\t    { ...draft, internalTradeId: \"IGNORED\" },\n80\t    { id: \"EVENT-2\", at: \"2026-08-23T15:01:00.000Z\" },\n81\t  );\n82\t  assert.equal(validated.internalTradeId, \"NEW-1\");\n83\t  assert.deepEqual(validated.auditEvents.map((event) => event.action), [\"created\", \"draft-saved\", \"updated\", \"validated\"]);\n84\t  const booked = bookTrade(validated, draft, { id: \"EVENT-3\", at: \"2026-08-23T15:02:00.000Z\" });\n85\t  const cancelled = cancelTrade(booked, { id: \"EVENT-4\", at: \"2026-08-23T15:03:00.000Z\" });\n86\t  assert.equal(booked.status, \"booked\");\n87\t  assert.equal(cancelled.status, \"cancelled\");\n88\t  assert.equal(booked.status, \"booked\");\n89\t  assert.throws(() => bookTrade(null, validDraft({ price: 0 }), { id: \"BAD\", at: \"2026-08-23T15:04:00.000Z\" }));\n90\t  assert.throws(() => cancelTrade(saved, { id: \"NO\", at: \"2026-08-23T15:05:00.000Z\" }));\n91\t});\n92\t\n93\ttest(\"seed trades are immutable, synthetic, complete, and excluded when cancelled\", () => {\n94\t  assert.equal(SEED_TRADES.length, 6);\n95\t  assert.equal(new Set(SEED_TRADES.map((trade) => trade.productType)).size, 6);\n96\t  assert.equal(Object.isFrozen(SEED_TRADES[0]), true);\n97\t  const summary = summarizeDesk(SEED_TRADES);\n98\t  assert.equal(summary.activeTradeCount, 5);\n99\t  assert.equal(summary.bookedTradeCount, 3);\n100\t  assert.equal(summary.exceptionCount, 0);\n101\t  assert.ok(summary.sellExposure < 0);\n102\t});\n103\t"}]},"parent_tool_use_id":null,"session_id":"f0534d7a-1d7b-4a4f-b438-f153dd9a57ff","uuid":"268f01f8-de18-4169-853e-66fca44fdbec","timestamp":"2026-08-24T01:03:35.933Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-o2LLK6/checkout/tests/trade-domain.test.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport {\n  calculateEconomics,\n  summarizeDesk,\n  withinOneCent,\n} from \"../app/trade-capture/domain/calculations.ts\";\nimport { bookTrade, cancelTrade, saveDraft, validateTradeRecord } from \"../app/trade-capture/domain/lifecycle.ts\";\nimport { EMPTY_TRADE_DRAFT, SEED_TRADES } from \"../app/trade-capture/domain/seed.ts\";\nimport { validateTrade } from \"../app/trade-capture/domain/validation.ts\";\n\ntest(\"calculates current face, principal, and signed exposure\", () => {\n  assert.deepEqual(calculateEconomics(1_000_000, 0.8, 99.5, \"buy\"), {\n    currentFace: 800_000,\n    grossPrincipal: 796_000,\n    signedExposure: 796_000,\n  });\n  assert.equal(calculateEconomics(1_000_000, 0.8, 99.5, \"sell\").signedExposure, -796_000);\n});\n\ntest(\"uses rounded cents for allocation tolerance\", () => {\n  assert.equal(withinOneCent(100, 100.01), true);\n  assert.equal(withinOneCent(100, 100.02), false);\n});\n\ntest(\"summarizes an empty desk\", () => {\n  assert.deepEqual(summarizeDesk([]), {\n    activeTradeCount: 0,\n    bookedTradeCount: 0,\n    exceptionCount: 0,\n    buyExposure: 0,\n    sellExposure: 0,\n    netExposure: 0,\n    grossPrincipal: 0,\n  });\n});\n\nfunction validDraft(overrides = {}) {\n  return {\n    ...EMPTY_TRADE_DRAFT,\n    securityId: \"SYNTH1234\",\n    counterparty: \"Demo Counterparty\",\n    book: \"Mock Book\",\n    trader: \"Sample Trader\",\n    agency: \"Mock Agency\",\n    originalFace: 100,\n    factor: 0.5,\n    price: 100,\n    ...overrides,\n  };\n}\n\ntest(\"validates required fields, product rules, and rounded allocation boundaries\", () => {\n  const invalid = validDraft({\n    securityId: \"bad\",\n    settlementDate: \"2026-08-22\",\n    agency: \"\",\n    modifier: \"specified-pool\",\n    poolNumber: \"\",\n    allocations: [{ id: \"a\", label: \"A\", currentFace: 50.011 }],\n  });\n  assert.deepEqual(\n    validateTrade(invalid).map((item) => item.code),\n    [\"invalid-security-id\", \"missing-client-trade-id\", \"settlement-before-trade\", \"required-agency\", \"required-pool\"],\n  );\n  assert.equal(validateTrade(validDraft({ allocations: [{ id: \"a\", label: \"A\", currentFace: 50.02 }] })).at(-1)?.code, \"allocation-mismatch\");\n  assert.equal(validateTrade(validDraft({ allocations: [{ id: \"a\", label: \"A\", currentFace: 50.01 }] })).some((item) => item.code === \"allocation-mismatch\"), false);\n  assert.equal(validateTrade(validDraft({ productType: \"clo\", modifier: \"dollar-roll\" })).some((item) => item.code === \"invalid-modifier-for-product\"), true);\n});\n\ntest(\"lifecycle actions are immutable, deterministic, and enforce transitions\", () => {\n  const draft = validDraft();\n  const saved = saveDraft(null, draft, { id: \"NEW-1\", at: \"2026-08-23T15:00:00.000Z\" });\n  assert.equal(saved.internalTradeId, \"NEW-1\");\n  assert.deepEqual(saved.auditEvents.map((event) => event.action), [\"created\", \"draft-saved\"]);\n  const validated = validateTradeRecord(\n    saved,\n    { ...draft, internalTradeId: \"IGNORED\" },\n    { id: \"EVENT-2\", at: \"2026-08-23T15:01:00.000Z\" },\n  );\n  assert.equal(validated.internalTradeId, \"NEW-1\");\n  assert.deepEqual(validated.auditEvents.map((event) => event.action), [\"created\", \"draft-saved\", \"updated\", \"validated\"]);\n  const booked = bookTrade(validated, draft, { id: \"EVENT-3\", at: \"2026-08-23T15:02:00.000Z\" });\n  const cancelled = cancelTrade(booked, { id: \"EVENT-4\", at: \"2026-08-23T15:03:00.000Z\" });\n  assert.equal(booked.status, \"booked\");\n  assert.equal(cancelled.status, \"cancelled\");\n  assert.equal(booked.status, \"booked\");\n  assert.throws(() => bookTrade(null, validDraft({ price: 0 }), { id: \"BAD\", at: \"2026-08-23T15:04:00.000Z\" }));\n  assert.throws(() => cancelTrade(saved, { id: \"NO\", at: \"2026-08-23T15:05:00.000Z\" }));\n});\n\ntest(\"seed trades are immutable, synthetic, complete, and excluded when cancelled\", () => {\n  assert.equal(SEED_TRADES.length, 6);\n  assert.equal(new Set(SEED_TRADES.map((trade) => trade.productType)).size, 6);\n  assert.equal(Object.isFrozen(SEED_TRADES[0]), true);\n  const summary = summarizeDesk(SEED_TRADES);\n  assert.equal(summary.activeTradeCount, 5);\n  assert.equal(summary.bookedTradeCount, 3);\n  assert.equal(summary.exceptionCount, 0);\n  assert.ok(summary.sellExposure < 0);\n});\n","numLines":103,"startLine":1,"totalLines":103}}}
