{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs <<'EOF'\n/**\n * Build one comparison summary per assistant from raw benchmark run records.\n */\nexport function summarizeAssistants(runs) {\n  if (\"'!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const groups = new Map();\n\n  for (const run of runs) {\n    if (\n      run?.status !== \"complete\" ||\n      run?.acceptance_status !== \"pass\" ||\n      run?.comparison_eligible === false\n    ) {\n      continue;\n    }\n\n    if (typeof run.run_id !== \"string\" || run.run_id.length === 0) {\n      throw new TypeError(\"eligible run must have a non-empty run_id string\");\n    }\n    if (typeof run.assistant !== \"string\" || run.assistant.length === 0) {\n      throw new TypeError(\"eligible run must have a non-empty assistant string\");\n    }\n    if (!Number.isFinite(run.score) || run.score < 0 || run.score > 100) {\n      throw new TypeError(\"eligible run score must be a finite number from 0 through 100\");\n    }\n    if (!Number.isFinite(run.elapsed_ms) || run.elapsed_ms < 0) {\n      throw new TypeError(\"eligible run elapsed_ms must be a finite number >= 0\");\n    }\n\n    const list = groups.get(run.assistant);\n    if (list) {\n      list.push(run);\n    } else {\n      groups.set(run.assistant, [run]);\n    }\n  }\n\n  const summaries = [];\n  for (const [assistant, list] of groups) {\n    let best = list[0];\n    for (const run of list) {\n      if (\n        run.score > best.score ||\n        (run.score === best.score && run.elapsed_ms < best.elapsed_ms) ||\n        (run.score === best.score &&\n          run.elapsed_ms === best.elapsed_ms &&\n          run.run_id < best.run_id)\n      ) {\n        best = run;\n      }\n    }\n\n    const times = list.map((run) => run.elapsed_ms).sort((a, b) => a - b);\n    const mid = Math.floor(times.length / 2);\n    const median =\n      times.length % 2 === 1\n        ? times[mid]\n        : (times[mid - 1] + times[mid]) / 2;\n\n    summaries.push({\n      assistant,\n      run_count: list.length,\n      best_score: best.score,\n      best_run_id: best.run_id,\n      median_elapsed_ms: median,\n    });\n  }\n\n  summaries.sort((a, b) => (a.assistant < b.assistant ? -1 : 1));\n  return summaries;\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
