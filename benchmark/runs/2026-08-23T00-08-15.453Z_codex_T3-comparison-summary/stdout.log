{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmark/fixtures/T3-comparison-summary/student-tests.mjs <<'EOF'\n// Add at least two meaningful node:test cases for the feature contract.\n// Do not copy or modify the committed comparison-summary.test.mjs suite.\n\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\n\nimport { renderComparisonTable } from \\\"./render-comparison-table.mjs\\\";\nimport { summarizeAssistants } from \\\"./summarize-assistants.mjs\\\";\n\ntest(\\\"ignores ineligible runs and does not validate their fields\\\", () => {\n  const runs = [\n    {\n      run_id: \\\"\\\",\n      assistant: \\\"\\\",\n      status: \\\"running\\\",\n      acceptance_status: \\\"pass\\\",\n      score: -5,\n      elapsed_ms: -10,\n    },\n    {\n      run_id: \\\"good\\\",\n      assistant: \\\"A\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 80,\n      elapsed_ms: 500,\n    },\n    {\n      run_id: \\\"failed\\\",\n      assistant: \\\"B\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"fail\\\",\n      score: 100,\n      elapsed_ms: 100,\n      comparison_eligible: true,\n    },\n    {\n      run_id: \\\"excluded\\\",\n      assistant: \\\"A\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      comparison_eligible: false,\n      score: 100,\n      elapsed_ms: 100,\n    },\n  ];\n\n  assert.deepEqual(summarizeAssistants(runs), [\n    {\n      assistant: \\\"A\\\",\n      run_count: 1,\n      best_score: 80,\n      best_run_id: \\\"good\\\",\n      median_elapsed_ms: 500,\n    },\n  ]);\n});\n\ntest(\\\"breaks a tie using run_id when score and elapsed time are equal\\\", () => {\n  const runs = [\n    {\n      run_id: \\\"beta\\\",\n      assistant: \\\"TieBot\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 88,\n      elapsed_ms: 600,\n    },\n    {\n      run_id: \\\"alpha\\\",\n      assistant: \\\"TieBot\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 88,\n      elapsed_ms: 600,\n    },\n  ];\n\n  assert.equal(summarizeAssistants(runs)[0].best_run_id, \\\"alpha\\\");\n});\n\ntest(\\\"averages median elapsed time for an even number of runs\\\", () => {\n  const runs = [\n    {\n      run_id: \\\"a\\\",\n      assistant: \\\"EvenBot\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 70,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \\\"b\\\",\n      assistant: \\\"EvenBot\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 75,\n      elapsed_ms: 300,\n    },\n  ];\n\n  assert.equal(summarizeAssistants(runs)[0].median_elapsed_ms, 200);\n});\n\ntest(\\\"summarizeAssistants throws TypeError for invalid eligible data\\\", () => {\n  assert.throws(\n    () =>\n      summarizeAssistants([\n        {\n          run_id: 123,\n          assistant: \\\"Bot\\\",\n          status: \\\"complete\\\",\n          acceptance_status: \\\"pass\\\",\n          score: 50,\n          elapsed_ms: 0,\n        },\n      ]),\n    TypeError,\n  );\n});\n\ntest(\\\"renderComparisonTable throws TypeError for invalid summary fields\\\", () => {\n  assert.throws(\n    () =>\n      renderComparisonTable([\n        {\n          assistant: \\\"Bot\\\",\n          run_count: 0,\n          best_score: 90,\n          best_run_id: \\\"run\\\",\n          median_elapsed_ms: 1000,\n        },\n      ]),\n    TypeError,\n  );\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
