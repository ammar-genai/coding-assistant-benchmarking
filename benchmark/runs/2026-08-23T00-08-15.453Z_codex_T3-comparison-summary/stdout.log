,\n    },\n    {\n      run_id: \\\"alpha\\\",\n      assistant: \\\"TieBot\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 88,\n      elapsed_ms: 600,\n    },\n  ];\n\n  assert.equal(summarizeAssistants(runs)[0].best_run_id, \\\"alpha\\\");\n});\n\ntest(\\\"averages median elapsed time for an even number of runs\\\", () => {\n  const runs = [\n    {\n      run_id: \\\"a\\\",\n      assistant: \\\"EvenBot\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 70,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \\\"b\\\",\n      assistant: \\\"EvenBot\\\",\n      status: \\\"complete\\\",\n      acceptance_status: \\\"pass\\\",\n      score: 75,\n      elapsed_ms: 300,\n    },\n  ];\n\n  assert.equal(summarizeAssistants(runs)[0].median_elapsed_ms, 200);\n});\n\ntest(\\\"summarizeAssistants throws TypeError for invalid eligible data\\\", () => {\n  assert.throws(\n    () =>\n      summarizeAssistants([\n        {\n          run_id: 123,\n          assistant: \\\"Bot\\\",\n          status: \\\"complete\\\",\n          acceptance_status: \\\"pass\\\",\n          score: 50,\n          elapsed_ms: 0,\n        },\n      ]),\n    TypeError,\n  );\n});\n\ntest(\\\"renderComparisonTable throws TypeError for invalid summary fields\\\", () => {\n  assert.throws(\n    () =>\n      renderComparisonTable([\n        {\n          assistant: \\\"Bot\\\",\n          run_count: 0,\n          best_score: 90,\n          best_run_id: \\\"run\\\",\n          median_elapsed_ms: 1000,\n        },\n      ]),\n    TypeError,\n  );\n});\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
