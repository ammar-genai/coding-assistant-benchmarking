{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs <<'EOF'\n/**\n * Render assistant summaries as a stable Markdown table.\n */\nexport function renderComparisonTable(summaries) {\n  if (\"'!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n\n  for (const summary of summaries) {\n    if (typeof summary?.assistant !== \"string\" || summary.assistant.length === 0) {\n      throw new TypeError(\"summary assistant must be a non-empty string\");\n    }\n    if (typeof summary?.best_run_id !== \"string\" || summary.best_run_id.length === 0) {\n      throw new TypeError(\"summary best_run_id must be a non-empty string\");\n    }\n    if (\n      !Number.isInteger(summary?.run_count) ||\n      summary.run_count <= 0\n    ) {\n      throw new TypeError(\"summary run_count must be a positive integer\");\n    }\n    if (\n      !Number.isFinite(summary?.best_score) ||\n      summary.best_score < 0 ||\n      summary.best_score > 100\n    ) {\n      throw new TypeError(\"summary best_score must be a finite number from 0 through 100\");\n    }\n    if (\n      !Number.isFinite(summary?.median_elapsed_ms) ||\n      summary.median_elapsed_ms < 0\n    ) {\n      throw new TypeError(\"summary median_elapsed_ms must be a finite number >= 0\");\n    }\n  }\n\n  const header = \"| Assistant | Runs | Best score | Best run | Median time |\";\n  const separator = \"|---|---:|---:|---|---:|\";\n\n  const lines = [header, separator];\n\n  if (summaries.length === 0) {\n    lines.push(\"\", \"_No eligible runs._\");\n  } else {\n    for (const summary of summaries) {\n      const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);\n      lines.push(\n        `| ${escapePipe(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapePipe(summary.best_run_id)} | ${seconds} s |`,\n      );\n    }\n  }\n\n  return lines.join(\"'\"\\\\n\\\");\n}\n\nfunction escapePipe(value) {\n  return String(value).replaceAll(\\\"|\\\", \\\"\\\\\\\\|\\\");\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
