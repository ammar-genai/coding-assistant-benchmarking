{"type":"tool_use","timestamp":1787458414110,"sessionID":"ses_fd32dbadbffeNokwlDABHEwXNJ","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-9de7e8d7e65cd8cb","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-F03MdX/checkout/scripts/benchmark-run.mjs"},"output":"<path>/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-F03MdX/checkout/scripts/benchmark-run.mjs</path>\n<type>file</type>\n<content>\n1: import { spawn, spawnSync } from \"node:child_process\";\n2: import { createHash } from \"node:crypto\";\n3: import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmdirSync, statSync, writeFileSync } from \"node:fs\";\n4: import { tmpdir } from \"node:os\";\n5: import { dirname, relative, resolve } from \"node:path\";\n6: import { fileURLToPath } from \"node:url\";\n7: \n8: const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), \"..\");\n9: const ignoredDirectories = new Set([\n10:   \".git\",\n11:   \".next\",\n12:   \".vinext\",\n13:   \".wrangler\",\n14:   \"dist\",\n15:   \"node_modules\",\n16:   \"runs\",\n17: ]);\n18: \n19: function usage() {\n20:   console.log(`Usage:\n21:   npm run benchmark:run -- --assistant <codex|claude|opencode|pi> [options]\n22: \n23: Options:\n24:   --task <id>       Task directory name (default: T1-repo-map)\n25:   --model <id>      Exact model ID. Defaults to the assistant's normal baseline.\n26:   --execute         Execute and record the run. Without this flag, print a preview.\n27:   --help            Show this message.\n28: \n29: Examples:\n30:   npm run benchmark:run -- --assistant opencode\n31:   npm run benchmark:run -- --assistant opencode --model ollama/deepseek-v4-flash:cloud --execute`);\n32: }\n33: \n34: function parseArgs(argv) {\n35:   const options = { task: \"T1-repo-map\", execute: false };\n36:   for (let index = 0; index < argv.length; index += 1) {\n37:     const value = argv[index];\n38:     if (value === \"--execute\") options.execute = true;\n39:     else if (value === \"--help\") options.help = true;\n40:     else if (value === \"--assistant\" || value === \"--task\" || value === \"--model\") {\n41:       const next = argv[index + 1];\n42:       if (!next) throw new Error(`${value} requires a value`);\n43:       options[value.slice(2)] = next;\n44:       index += 1;\n45:     } else {\n46:       throw new Error(`Unknown option: ${value}`);\n47:     }\n48:   }\n49:   return options;\n50: }\n51: \n52: function version(command) {\n53:   const result = spawnSync(command, [\"--version\"], { encoding: \"utf8\", timeout: 10_000 });\n54:   return result.status === 0 ? (result.stdout || result.stderr).trim().split(\"\\n\")[0] : null;\n55: }\n56: \n57: function gitValue(args, workingDirectory = projectRoot) {\n58:   const result = spawnSync(\"git\", args, { cwd: workingDirectory, encoding: \"utf8\", timeout: 10_000 });\n59:   return result.status === 0 ? result.stdout.trim() : null;\n60: }\n61: \n62: function gitOutput(args, workingDirectory = projectRoot) {\n63:   const result = spawnSync(\"git\", args, { cwd: workingDirectory, encoding: \"utf8\", timeout: 10_000 });\n64:   return result.status === 0 ? result.stdout : null;\n65: }\n66: \n67: function createIsolatedWorktree(commit) {\n68:   const container = mkdtempSync(resolve(tmpdir(), \"coding-assistant-benchmark-\"));\n69:   const checkout = resolve(container, \"checkout\");\n70:   const result = spawnSync(\"git\", [\"worktree\", \"add\", \"--detach\", checkout, commit], {\n71:     cwd: projectRoot,\n72:     encoding: \"utf8\",\n73:     timeout: 60_000,\n74:   });\n75:   if (result.status !== 0) {\n76:     rmdirSync(container);\n77:     throw new Error(`Could not create isolated worktree: ${result.stderr || result.stdout}`);\n78:   }\n79:   return { container, checkout };\n80: }\n81: \n82: function removeIsolatedWorktree({ container, checkout }) {\n83:   const result = spawnSync(\"git\", [\"worktree\", \"remove\", \"--force\", checkout], {\n84:     cwd: projectRoot,\n85:     encoding: \"utf8\",\n86:     timeout: 60_000,\n87:   });\n88:   if (result.status === 0) rmdirSync(container);\n89:   return result.status === 0 ? null : (result.stderr || result.stdout || \"Unknown worktree cleanup error\").trim();\n90: }\n91: \n92: function sha256(value) {\n93:   return createHash(\"sha256\").update(value).digest(\"hex\");\n94: }\n95: \n96: function modelAccessPath(model) {\n97:   if (model.startsWith(\"ollama/\")) {\n98:     return model.endsWith(\":cloud\") ? \"ollama-cloud\" : \"ollama-local\";\n99:   }\n100:   if (model.startsWith(\"openrouter/\")) return \"api\";\n101:   return null;\n102: }\n103: \n104: function snapshotDirectory(root = projectRoot) {\n105:   const files = new Map();\n106: \n107:   function visit(directory) {\n108:     for (const entry of readdirSync(directory, { withFileTypes: true })) {\n109:       if (entry.name === \".git\") continue;\n110:       if (entry.isDirectory() && ignoredDirectories.has(entry.name)) continue;\n111:       const absolutePath = resolve(directory, entry.name);\n112:       const relativePath = relative(root, absolutePath);\n113:       if (relativePath.startsWith(\"benchmark/runs/\")) continue;\n114:       if (entry.isDirectory()) visit(absolutePath);\n115:       else if (entry.isFile() && statSync(absolutePath).size <= 25_000_000) {\n116:         files.set(relativePath, sha256(readFileSync(absolutePath)));\n117:       }\n118:     }\n119:   }\n120: \n121:   visit(root);\n122:   return files;\n123: }\n124: \n125: function compareSnapshots(before, after) {\n126:   return [...new Set([...before.keys(), ...after.keys()])]\n127:     .filter((path) => before.get(path) !== after.get(path))\n128:     .sort();\n129: }\n130: \n131: function pathIsAllowed(changedPath, allowedPaths) {\n132:   const normalizedPath = changedPath.replaceAll(\"\\\\\", \"/\");\n133:   return allowedPaths.some((pattern) => {\n134:     const normalizedPattern = pattern.replaceAll(\"\\\\\", \"/\");\n135:     if (normalizedPattern === \"**/*\" || normalizedPattern === \"*\") return true;\n136:     if (normalizedPattern.endsWith(\"/**\")) {\n137:       return normalizedPath.startsWith(normalizedPattern.slice(0, -2));\n138:     }\n139:     return normalizedPath === normalizedPattern;\n140:   });\n141: }\n142: \n143: function openCodePermissions(task) {\n144:   const readOnly = task.mode === \"read-only\";\n145:   const editRules = { \"*\": \"deny\" };\n146:   const bashRules = { \"*\": \"deny\" };\n147: \n148:   if (!readOnly) {\n149:     for (const allowedPath of task.allowed_paths) {\n150:       editRules[allowedPath === \"**/*\" ? \"*\" : allowedPath] = \"allow\";\n151:     }\n152:     for (const command of task.verification?.visible_commands ?? []) {\n153:       bashRules[command] = \"allow\";\n154:     }\n155:   }\n156: \n157:   return {\n158:     permission: {\n159:       \"*\": \"deny\",\n160:       read: \"allow\",\n161:       glob: \"allow\",\n162:       grep: \"allow\",\n163:       lsp: \"allow\",\n164:       edit: editRules,\n165:       bash: bashRules,\n166:       task: \"deny\",\n167:       question: \"deny\",\n168:       webfetch: \"deny\",\n169:       websearch: \"deny\",\n170:       external_directory: \"deny\",\n171:     },\n172:   };\n173: }\n174: \n175: function adapter(assistant, model, prompt, targetRoot, task) {\n176:   if (assistant === \"codex\") {\n177:     const args = [\n178:       \"exec\",\n179:       \"--ephemeral\",\n180:       \"--json\",\n181:       \"--ignore-user-config\",\n182:       \"--sandbox\",\n183:       task.mode === \"workspace-write\" ? \"workspace-write\" : \"read-only\",\n184:       \"--cd\",\n185:       targetRoot,\n186:     ];\n187:     if (model.startsWith(\"ollama/\")) {\n188:       args.push(\"--oss\", \"--local-provider\", \"ollama\", \"--model\", model.slice(\"ollama/\".length));\n189:     } else if (model !== \"subscription-default\") args.push(\"--model\", model);\n190:     args.push(prompt);\n191:     return { command: \"codex\", args, accessPath: modelAccessPath(model) ?? \"subscription\" };\n192:   }\n193: \n194:   if (assistant === \"claude\") {\n195:     const writeMode = task.mode === \"workspace-write\";\n196:     const claudeArgs = [\n197:       \"--print\",\n198:       \"--output-format\",\n199:       \"stream-json\",\n200:       \"--verbose\",\n201:       \"--no-session-persistence\",\n202:       \"--setting-sources\",\n203:       \"project\",\n204:       \"--permission-mode\",\n205:       writeMode ? \"acceptEdits\" : \"plan\",\n206:       \"--tools\",\n207:       writeMode ? \"Read,Glob,Grep,Edit,Write,Bash\" : \"Read,Glob,Grep\",\n208:     ];\n209:     if (writeMode && task.verification?.visible_commands?.length > 0) {\n210:       claudeArgs.push(\n211:         \"--allowedTools\",\n212:         ...task.verification.visible_commands.map((command) => `Bash(${command})`),\n213:       );\n214:     }\n215:     if (model.startsWith(\"ollama/\")) {\n216:       const args = [\n217:         \"launch\",\n218:         \"claude\",\n219:         \"--model\",\n220:         model.slice(\"ollama/\".length),\n221:         \"--yes\",\n222:         \"--\",\n223:         ...claudeArgs,\n224:         \"--\",\n225:         prompt,\n226:       ];\n227:       return { command: \"ollama\", args, accessPath: modelAccessPath(model) };\n228:     }\n229:     if (model !== \"subscription-default\") claudeArgs.push(\"--model\", model);\n230:     claudeArgs.push(\"--\", prompt);\n231:     return { command: \"claude\", args: claudeArgs, accessPath: \"subscription\" };\n232:   }\n233: \n234:   if (assistant === \"opencode\") {\n235:     const args = [\n236:       \"run\",\n237:       \"--pure\",\n238:       \"--format\",\n239:       \"json\",\n240:       \"--agent\",\n241:       task.mode === \"workspace-write\" ? \"build\" : \"plan\",\n242:       \"--dir\",\n243:       targetRoot,\n244:       \"--model\",\n245:       model,\n246:       prompt,\n247:     ];\n248:     return {\n249:       command: \"opencode\",\n250:       args,\n251:       accessPath: modelAccessPath(model) ?? \"unknown\",\n252:       env: {\n253:         ...process.env,\n254:         OPENCODE_CONFIG_CONTENT: JSON.stringify(openCodePermissions(task)),\n255:       },\n256:     };\n257:   }\n258: \n259:   if (assistant === \"pi\") {\n260:     const piArgs = [\n261:       \"--print\",\n262:       \"--mode\",\n263:       \"json\",\n264:       \"--no-session\",\n265:       \"--no-extensions\",\n266:       \"--no-skills\",\n267:       \"--no-prompt-templates\",\n268:       \"--no-themes\",\n269:       \"--approve\",\n270:       \"--tools\",\n271:       task.mode === \"workspace-write\" ? \"read,grep,find,ls,edit,write,bash\" : \"read,grep,find,ls\",\n272:     ];\n273:     if (model.startsWith(\"ollama/\")) {\n274:       const args = [\n275:         \"launch\",\n276:         \"pi\",\n277:         \"--model\",\n278:         model.slice(\"ollama/\".length),\n279:         \"--yes\",\n280:         \"--\",\n281:         ...piArgs,\n282:         prompt,\n283:       ];\n284:       return { command: \"ollama\", args, accessPath: modelAccessPath(model) };\n285:     }\n286:     piArgs.push(\"--model\", model, prompt);\n287:     return { command: \"pi\", args: piArgs, accessPath: \"unknown\" };\n288:   }\n289: \n290:   throw new Error(`Unsupported assistant: ${assistant}`);\n291: }\n292: \n293: async function execute(command, args, timeoutMs, workingDirectory, environment = process.env) {\n294:   return new Promise((resolveRun) => {\n295:     const child = spawn(command, args, {\n296:       cwd: workingDirectory,\n297:       env: environment,\n298:       stdio: [\"ignore\", \"pipe\", \"pipe\"],\n299:     });\n300:     let stdout = \"\";\n301:     let stderr = \"\";\n302:     let timedOut = false;\n303:     child.stdout.on(\"data\", (chunk) => { stdout += chunk; });\n304:     child.stderr.on(\"data\", (chunk) => { stderr += chunk; });\n305:     const timer = setTimeout(() => {\n306:       timedOut = true;\n307:       child.kill(\"SIGTERM\");\n308:     }, timeoutMs);\n309:     child.on(\"error\", (error) => {\n310:       clearTimeout(timer);\n311:       resolveRun({ exitCode: null, signal: null, timedOut, stdout, stderr: `${stderr}${error.stack ?? error.message}\\n` });\n312:     });\n313:     child.on(\"close\", (exitCode, signal) => {\n314:       clearTimeout(timer);\n315:       resolveRun({ exitCode, signal, timedOut, stdout, stderr });\n316:     });\n317:   });\n318: }\n319: \n320: async function runVerification(task, targetRoot) {\n321:   const results = [];\n322:   const infrastructureErrors = [];\n323:   const timeoutMs = task.limits.max_wall_time_seconds * 1000;\n324: \n325:   for (const [index, command] of (task.verification?.visible_commands ?? []).entries()) {\n326:     const startedAt = Date.now();\n327:     const outcome = await execute(\"/bin/sh\", [\"-lc\", command], timeoutMs, targetRoot);\n328:     results.push({\n329:       id: `visible-${index + 1}`,\n330:       kind: \"visible\",\n331:       command,\n332:       elapsed_ms: Date.now() - startedAt,\n333:       exit_code: outcome.exitCode,\n334:       signal: outcome.signal,\n335:       timed_out: outcome.timedOut,\n336:       stdout: outcome.stdout,\n337:       stderr: outcome.stderr,\n338:     });\n339:   }\n340: \n341:   if (task.verification?.hidden_suite) {\n342:     const hiddenPath = resolve(projectRoot, \"benchmark\", \"private\", `${task.verification.hidden_suite}.test.mjs`);\n343:     if (!existsSync(hiddenPath)) {\n344:       infrastructureErrors.push(`Private suite is missing: ${task.verification.hidden_suite}`);\n345:     } else if (sha256(readFileSync(hiddenPath)) !== task.verification.hidden_sha256) {\n346:       infrastructureErrors.push(`Private suite hash does not match the task contract: ${task.verification.hidden_suite}`);\n347:     } else {\n348:       const startedAt = Date.now();\n349:       const outcome = await execute(\n350:         process.execPath,\n351:         [\"--test\", hiddenPath],\n352:         timeoutMs,\n353:         targetRoot,\n354:         { ...process.env, BENCHMARK_TARGET_ROOT: targetRoot },\n355:       );\n356:       results.push({\n357:         id: \"private-1\",\n358:         kind: \"private\",\n359:         command: `[private suite: ${task.verification.hidden_suite}]`,\n360:         elapsed_ms: Date.now() - startedAt,\n361:         exit_code: outcome.exitCode,\n362:         signal: outcome.signal,\n363:         timed_out: outcome.timedOut,\n364:         stdout: outcome.stdout,\n365:         stderr: outcome.stderr,\n366:       });\n367:     }\n368:   }\n369: \n370:   return { results, infrastructure_errors: infrastructureErrors };\n371: }\n372: \n373: const options = parseArgs(process.argv.slice(2));\n374: if (options.help) {\n375:   usage();\n376:   process.exit(0);\n377: }\n378: if (!options.assistant) {\n379:   usage();\n380:   throw new Error(\"--assistant is required\");\n381: }\n382: \n383: const defaults = {\n384:   codex: \"subscription-default\",\n385:   claude: \"subscription-default\",\n386:   opencode: \"ollama/deepseek-v4-flash:cloud\",\n387:   pi: \"ollama/deepseek-v4-flash:cloud\",\n388: };\n389: const model = options.model ?? defaults[options.assistant];\n390: if (!model) throw new Error(`No default model for ${options.assistant}`);\n391: \n392: const taskDirectory = resolve(projectRoot, \"benchmark\", \"tasks\", options.task);\n393: const task = JSON.parse(readFileSync(resolve(taskDirectory, \"task.json\"), \"utf8\"));\n394: const prompt = readFileSync(resolve(taskDirectory, task.prompt_path), \"utf8\");\n395: \n396: if (!options.execute) {\n397:   const selected = adapter(options.assistant, model, prompt, \"<isolated-worktree>\", task);\n398:   console.log(JSON.stringify({\n399:     mode: \"preview\",\n400:     task: `${task.id}@${task.version}`,\n401:     assistant: options.assistant,\n402:     model,\n403:     command: [selected.command, ...selected.args.slice(0, -1), \"<prompt.md>\"],\n404:     timeout_seconds: task.limits.max_wall_time_seconds,\n405:   }, null, 2));\n406:   process.exit(0);\n407: }\n408: \n409: const createdAt = new Date();\n410: const runId = `${createdAt.toISOString().replaceAll(\":\", \"-\")}_${options.assistant}_${task.id}`;\n411: const runDirectory = resolve(projectRoot, \"benchmark\", \"runs\", runId);\n412: mkdirSync(runDirectory, { recursive: false });\n413: \n414: const gitCommit = gitValue([\"rev-parse\", \"--verify\", \"HEAD\"]);\n415: if (!gitCommit) throw new Error(\"A baseline Git commit is required before executing a benchmark.\");\n416: const trackedChanges = gitValue([\"status\", \"--porcelain\", \"--untracked-files=no\"]);\n417: if (trackedChanges) throw new Error(\"Commit or restore tracked workspace changes before executing a benchmark.\");\n418: \n419: const isolatedWorktree = createIsolatedWorktree(gitCommit);\n420: const targetRoot = isolatedWorktree.checkout;\n421: const selected = adapter(options.assistant, model, prompt, targetRoot, task);\n422: const before = snapshotDirectory(targetRoot);\n423: const startedAt = new Date();\n424: const manifest = {\n425:   schema_version: \"1.0\",\n426:   run_id: runId,\n427:   task: { id: task.id, version: task.version },\n428:   assistant: options.assistant,\n429:   assistant_version: version({ codex: \"codex\", claude: \"claude\", opencode: \"opencode\", pi: \"pi\" }[options.assistant]),\n430:   model,\n431:   access_path: selected.accessPath,\n432:   repository: {\n433:     path: targetRoot,\n434:     git_commit: gitCommit,\n435:     dirty_at_start: Boolean(gitValue([\"status\", \"--porcelain\"], targetRoot)),\n436:   },\n437:   prompt_sha256: sha256(prompt),\n438:   command: [selected.command, ...selected.args.slice(0, -1), \"<prompt.md>\"],\n439:   started_at: startedAt.toISOString(),\n440:   settings: {\n441:     task_mode: task.mode,\n442:     max_wall_time_seconds: task.limits.max_wall_time_seconds,\n443:     max_human_interventions: task.limits.max_human_interventions,\n444:   },\n445: };\n446: \n447: writeFileSync(resolve(runDirectory, \"manifest.json\"), `${JSON.stringify(manifest, null, 2)}\\n`, { flag: \"wx\" });\n448: writeFileSync(resolve(runDirectory, \"prompt.md\"), prompt, { flag: \"wx\" });\n449: \n450: const outcome = await execute(\n451:   selected.command,\n452:   selected.args,\n453:   task.limits.max_wall_time_seconds * 1000,\n454:   targetRoot,\n455:   selected.env,\n456: );\n457: const finishedAt = new Date();\n458: let status = \"complete\";\n459: if (outcome.timedOut) status = \"timeout\";\n460: else if (outcome.exitCode !== 0) status = \"failed\";\n461: \n462: const verification = status === \"complete\" && task.mode === \"workspace-write\"\n463:   ? await runVerification(task, targetRoot)\n464:   : { results: [], infrastructure_errors: [] };\n465: const after = snapshotDirectory(targetRoot);\n466: const changedPaths = compareSnapshots(before, after);\n467: const outOfScopePaths = changedPaths.filter((changedPath) => !pathIsAllowed(changedPath, task.allowed_paths));\n468: const patch = gitOutput([\"diff\", \"--binary\", \"--no-ext-diff\", \"HEAD\"], targetRoot) ?? \"\";\n469: const cleanupError = removeIsolatedWorktree(isolatedWorktree);\n470: \n471: writeFileSync(resolve(runDirectory, \"stdout.log\"), outcome.stdout, { flag: \"wx\" });\n472: writeFileSync(resolve(runDirectory, \"stderr.log\"), outcome.stderr, { flag: \"wx\" });\n473: writeFileSync(resolve(runDirectory, \"changes.json\"), `${JSON.stringify({\n474:   changed_paths: changedPaths,\n475:   out_of_scope_paths: outOfScopePaths,\n476: }, null, 2)}\\n`, { flag: \"wx\" });\n477: writeFileSync(resolve(runDirectory, \"changes.patch\"), patch, { flag: \"wx\" });\n478: writeFileSync(resolve(runDirectory, \"verification.json\"), `${JSON.stringify(verification, null, 2)}\\n`, { flag: \"wx\" });\n479: \n480: let acceptanceStatus = \"not-graded\";\n481: if (status === \"complete\" && task.mode === \"read-only\") {\n482:   acceptanceStatus = changedPaths.length > 0 ? \"fail\" : \"pending\";\n483: } else if (status === \"complete\" && task.mode === \"workspace-write\") {\n484:   if (verification.infrastructure_errors.length > 0 || !task.verification) {\n485:     acceptanceStatus = \"invalid\";\n486:   } else {\n487:     const checksPassed = verification.results.length > 0 && verification.results.every(\n488:       (check) => check.exit_code === 0 && !check.timed_out,\n489:     );\n490:     acceptanceStatus = changedPaths.length > 0 && outOfScopePaths.length === 0 && checksPassed\n491:       ? \"pass\"\n492:       : \"fail\";\n493:   }\n494: }\n495: \n496: const notes = [];\n497: if (task.mode === \"read-only\" && changedPaths.length > 0) notes.push(\"Read-only workspace change caused an automatic failure.\");\n498: if (task.mode === \"workspace-write\" && changedPaths.length === 0) notes.push(\"The assistant did not change the workspace.\");\n499: if (outOfScopePaths.length > 0) notes.push(`Out-of-scope changes: ${outOfScopePaths.join(\", \")}`);\n500: if (verification.results.some((check) => check.exit_code !== 0 || check.timed_out)) notes.push(\"One or more verification checks failed.\");\n501: notes.push(...verification.infrastructure_errors);\n502: if (cleanupError) notes.push(`Temporary worktree cleanup failed: ${cleanupError}`);\n503: \n504: const result = {\n505:   schema_version: \"1.0\",\n506:   run_id: runId,\n507:   status,\n508:   acceptance_status: acceptanceStatus,\n509:   started_at: startedAt.toISOString(),\n510:   finished_at: finishedAt.toISOString(),\n511:   elapsed_ms: finishedAt.getTime() - startedAt.getTime(),\n512:   exit_code: outcome.exitCode,\n513:   signal: outcome.signal,\n514:   timed_out: outcome.timedOut,\n515:   workspace_changed: changedPaths.length > 0,\n516:   changed_paths: changedPaths,\n517:   artifacts: {\n518:     manifest: \"manifest.json\",\n519:     prompt: \"prompt.md\",\n520:     stdout: \"stdout.log\",\n521:     