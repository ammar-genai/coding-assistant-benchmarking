{"type":"tool_use","timestamp":1787443560453,"sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","part":{"type":"tool","tool":"read","callID":"functions.read:7","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs"},"output":"<path>/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs</path>\n<type>file</type>\n<content>\n1: /**\n2:  * Build one comparison summary per assistant from raw benchmark run records.\n3:  */\n4: export function summarizeAssistants(runs) {\n5:   if (!Array.isArray(runs)) {\n6:     throw new TypeError(\"runs must be an array\");\n7:   }\n8: \n9:   const byAssistant = new Map();\n10: \n11:   for (const run of runs) {\n12:     if (!isEligible(run)) {\n13:       continue;\n14:     }\n15: \n16:     validateEligibleRun(run);\n17: \n18:     const list = byAssistant.get(run.assistant);\n19:     if (list === undefined) {\n20:       byAssistant.set(run.assistant, [run]);\n21:     } else {\n22:       list.push(run);\n23:     }\n24:   }\n25: \n26:   const summaries = [];\n27:   for (const [assistant, list] of byAssistant) {\n28:     summaries.push({\n29:       assistant,\n30:       run_count: list.length,\n31:       best_score: pickBest(list).score,\n32:       best_run_id: pickBest(list).run_id,\n33:       median_elapsed_ms: median(list.map((run) => run.elapsed_ms)),\n34:     });\n35:   }\n36: \n37:   summaries.sort((a, b) => (a.assistant > b.assistant ? 1 : -1));\n38:   return summaries;\n39: }\n40: \n41: \n42: function isEligible(run) {\n43:   return (\n44:     run != null &&\n45:     run.status === \"complete\" &&\n46:     run.acceptance_status === \"pass\" &&\n47:     run.comparison_eligible !== false\n48:   );\n49: }\n50: \n51: function validateEligibleRun(run) {\n52:   if (typeof run.run_id !== \"string\" || run.run_id.length === 0) {\n53:     throw new TypeError(\"run_id must be a non-empty string\");\n54:   }\n55:   if (typeof run.assistant !== \"string\" || run.assistant.length === 0) {\n56:     throw new TypeError(\"assistant must be a non-empty string\");\n57:   }\n58:   if (!isValidScore(run.score)) {\n59:     throw new TypeError(\"score must be a finite number from 0 through 100\");\n60:   }\n61:   if (!isValidElapsed(run.elapsed_ms)) {\n62:     throw new TypeError(\"elapsed_ms must be a finite number greater than or equal to zero\");\n63:   }\n64: }\n65: \n66: function isValidScore(value) {\n67:   return typeof value === \"number\" && Number.isFinite(value) && value >= 0 && value <= 100;\n68: }\n69: \n70: function isValidElapsed(value) {\n71:   return typeof value === \"number\" && Number.isFinite(value) && value >= 0;\n72: }\n73: \n74: function pickBest(list) {\n75:   let best = list[0];\n76:   for (let i = 1; i < list.length; i++) {\n77:     const current = list[i];\n78:     if (\n79:       current.score > best.score ||\n80:       (current.score === best.score && current.elapsed_ms < best.elapsed_ms) ||\n81:       (current.score === best.score &&\n82:         current.elapsed_ms === best.elapsed_ms &&\n83:         current.run_id < best.run_id)\n84:     ) {\n85:       best = current;\n86:     }\n87:   }\n88:   return best;\n89: }\n90: \n91: function median(values) {\n92:   const sorted = values.slice().sort((a, b) => a - b);\n93:   const mid = Math.floor(sorted.length / 2);\n94:   if (sorted.length % 2 === 1) {\n95:     return sorted[mid];\n96:   }\n97:   return (sorted[mid - 1] + sorted[mid]) / 2;\n98: }\n\n(End of file - total 98 lines)\n</content>","metadata":{"preview":"/**\n * Build one comparison summary per assistant from raw benchmark run records.\n */\nexport function summarizeAssistants(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const byAssistant = new Map();\n\n  for (const run of runs) {\n    if (!isEligible(run)) {\n      continue;\n    }\n\n    validateEligibleRun(run);\n\n    const list = byAssistant.get(run.assistant);\n    if (list === undefined) {\n      byAssistant.set(run.assistant, [run]);","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","text":"/**\n * Build one comparison summary per assistant from raw benchmark run records.\n */\nexport function summarizeAssistants(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const byAssistant = new Map();\n\n  for (const run of runs) {\n    if (!isEligible(run)) {\n      continue;\n    }\n\n    validateEligibleRun(run);\n\n    const list = byAssistant.get(run.assistant);\n    if (list === undefined) {\n      byAssistant.set(run.assistant, [run]);\n    } else {\n      list.push(run);\n    }\n  }\n\n  const summaries = [];\n  for (const [assistant, list] of byAssistant) {\n    summaries.push({\n      assistant,\n      run_count: list.length,\n      best_score: pickBest(list).score,\n      best_run_id: pickBest(list).run_id,\n      median_elapsed_ms: median(list.map((run) => run.elapsed_ms)),\n    });\n  }\n\n  summaries.sort((a, b) => (a.assistant > b.assistant ? 1 : -1));\n  return summaries;\n}\n\n\nfunction isEligible(run) {\n  return (\n    run != null &&\n    run.status === \"complete\" &&\n    run.acceptance_status === \"pass\" &&\n    run.comparison_eligible !== false\n  );\n}\n\nfunction validateEligibleRun(run) {\n  if (typeof run.run_id !== \"string\" || run.run_id.length === 0) {\n    throw new TypeError(\"run_id must be a non-empty string\");\n  }\n  if (typeof run.assistant !== \"string\" || run.assistant.length === 0) {\n    throw new TypeError(\"assistant must be a non-empty string\");\n  }\n  if (!isValidScore(run.score)) {\n    throw new TypeError(\"score must be a finite number from 0 through 100\");\n  }\n  if (!isValidElapsed(run.elapsed_ms)) {\n    throw new TypeError(\"elapsed_ms must be a finite number greater than or equal to zero\");\n  }\n}\n\nfunction isValidScore(value) {\n  return typeof value === \"number\" && Number.isFinite(value) && value >= 0 && value <= 100;\n}\n\nfunction isValidElapsed(value) {\n  return typeof value === \"number\" && Number.isFinite(value) && value >= 0;\n}\n\nfunction pickBest(list) {\n  let best = list[0];\n  for (let i = 1; i < list.length; i++) {\n    const current = list[i];\n    if (\n      current.score > best.score ||\n      (current.score === best.score && current.elapsed_ms < best.elapsed_ms) ||\n      (current.score === best.score &&\n        current.elapsed_ms === best.elapsed_ms &&\n        current.run_id < best.run_id)\n    ) {\n      best = current;\n    }\n  }\n  return best;\n}\n\nfunction median(values) {\n  const sorted = values.slice().sort((a, b) => a - b);\n  const mid = Math.floor(sorted.length / 2);\n  if (sorted.length % 2 === 1) {\n    return sorted[mid];\n  }\n  return (sorted[mid - 1] + sorted[mid]) / 2;\n}","lineStart":1,"lineEnd":98,"totalLines":98,"truncated":false}},"title":"benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","time":{"start":1787443560443,"end":1787443560450}},"id":"prt_02bf03ff7001xdfe4jOMJ9A2kC","sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","messageID":"msg_02bf03c64001E4O7T2bie9bLpq"}}
