{"type":"tool_use","timestamp":1787443564037,"sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","part":{"type":"tool","tool":"write","callID":"functions.write:8","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","content":"/**\n * Render assistant summaries as a stable Markdown table.\n */\nexport function renderComparisonTable(summaries) {\n  if (!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n\n  for (const summary of summaries) {\n    validateSummary(summary);\n  }\n\n  const lines = [\n    \"| Assistant | Runs | Best score | Best run | Median time |\",\n    \"|---|---:|---:|---|---:|\",\n  ];\n\n  if (summaries.length === 0) {\n    lines.push(\"\", \"_No eligible runs._\");\n  } else {\n    for (const summary of summaries) {\n      const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);\n      lines.push(\n        `| ${escapePipe(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapePipe(summary.best_run_id)} | ${seconds} s |`,\n      );\n    }\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction validateSummary(summary) {\n  if (summary == null) {\n    throw new TypeError(\"summary must be an object\");\n  }\n  if (typeof summary.assistant !== \"string\" || summary.assistant.length === 0) {\n    throw new TypeError(\"assistant must be a non-empty string\");\n  }\n  if (typeof summary.best_run_id !== \"string\" || summary.best_run_id.length === 0) {\n    throw new TypeError(\"best_run_id must be a non-empty string\");\n  }\n  if (!Number.isInteger(summary.run_count) || summary.run_count <= 0) {\n    throw new TypeError(\"run_count must be a positive integer\");\n  }\n  if (\n    typeof summary.best_score !== \"number\" ||\n    !Number.isFinite(summary.best_score) ||\n    summary.best_score < 0 ||\n    summary.best_score > 100\n  ) {\n    throw new TypeError(\"best_score must be a finite number from 0 through 100\");\n  }\n  if (\n    typeof summary.median_elapsed_ms !== \"number\" ||\n    !Number.isFinite(summary.median_elapsed_ms) ||\n    summary.median_elapsed_ms < 0\n  ) {\n    throw new TypeError(\"median_elapsed_ms must be a finite number greater than or equal to zero\");\n  }\n}\n\nfunction escapePipe(value) {\n  return value.replace(/\\|/g, \"\\\\|\");\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","time":{"start":1787443564027,"end":1787443564034}},"id":"prt_02bf04df7001FSOUmxRD9UGeN0","sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","messageID":"msg_02bf0404600168o3wqNLdS7W6L"}}
