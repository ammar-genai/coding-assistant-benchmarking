{"type":"tool_use","timestamp":1787443569546,"sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","part":{"type":"tool","tool":"write","callID":"functions.write:9","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"summarizeAssistants ignores ineligible runs and does not mutate input\", () => {\n  const runs = [\n    {\n      run_id: \"bad-score\",\n      assistant: \"AgentA\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: Infinity,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \"ineligible\",\n      assistant: \"AgentA\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      comparison_eligible: false,\n      score: 100,\n      elapsed_ms: 50,\n    },\n    {\n      run_id: \"good\",\n      assistant: \"AgentA\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 88,\n      elapsed_ms: 200,\n    },\n  ];\n  const original = structuredClone(runs);\n\n  assert.throws(() => summarizeAssistants(runs), TypeError);\n  assert.deepEqual(runs, original);\n});\n\ntest(\"summarizeAssistants breaks score and elapsed ties with run_id\", () => {\n  const runs = [\n    {\n      run_id: \"b-run\",\n      assistant: \"TieBot\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 500,\n    },\n    {\n      run_id: \"a-run\",\n      assistant: \"TieBot\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 80,\n      elapsed_ms: 500,\n    },\n  ];\n\n  const result = summarizeAssistants(runs);\n  assert.equal(result[0].best_run_id, \"a-run\");\n  assert.equal(result[0].median_elapsed_ms, 500);\n});\n\ntest(\"summarizeAssistants computes median for even run counts\", () => {\n  const runs = [\n    {\n      run_id: \"fast\",\n      assistant: \"EvenBot\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 70,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \"slow\",\n      assistant: \"EvenBot\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 72,\n      elapsed_ms: 300,\n    },\n    {\n      run_id: \"mid\",\n      assistant: \"EvenBot\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 71,\n      elapsed_ms: 500,\n    },\n    {\n      run_id: \"last\",\n      assistant: \"EvenBot\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 69,\n      elapsed_ms: 700,\n    },\n  ];\n\n  const result = summarizeAssistants(runs);\n  assert.equal(result[0].run_count, 4);\n  assert.equal(result[0].median_elapsed_ms, 400);\n});\n\ntest(\"renderComparisonTable throws on invalid summary fields\", () => {\n  assert.throws(\n    () =>\n      renderComparisonTable([\n        {\n          assistant: \"Bot\",\n          run_count: 0,\n          best_score: 90,\n          best_run_id: \"r1\",\n          median_elapsed_ms: 100,\n        },\n      ]),\n    TypeError,\n  );\n});\n\ntest(\"renderComparisonTable preserves order and formats median seconds\", () => {\n  const summaries = [\n    {\n      assistant: \"Zeta\",\n      run_count: 1,\n      best_score: 99,\n      best_run_id: \"z1\",\n      median_elapsed_ms: 1500,\n    },\n    {\n      assistant: \"Alpha\",\n      run_count: 3,\n      best_score: 0,\n      best_run_id: \"a1\",\n      median_elapsed_ms: 0,\n    },\n  ];\n\n  assert.equal(\n    renderComparisonTable(summaries),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"| Zeta | 1 | 99 | z1 | 1.500 s |\",\n      \"| Alpha | 3 | 0 | a1 | 0.000 s |\",\n    ].join(\"\\n\"),\n  );\n});\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/student-tests.mjs","time":{"start":1787443569536,"end":1787443569543}},"id":"prt_02bf0637b001fBm3dJBUfPpGbk","sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","messageID":"msg_02bf04e620019Oco0F4KY9Z2K2"}}
