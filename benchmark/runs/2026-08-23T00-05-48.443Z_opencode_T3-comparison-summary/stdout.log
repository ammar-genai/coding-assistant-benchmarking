{"type":"tool_use","timestamp":1787443557794,"sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","part":{"type":"tool","tool":"write","callID":"functions.write:5","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","content":"/**\n * Build one comparison summary per assistant from raw benchmark run records.\n */\nexport function summarizeAssistants(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const byAssistant = new Map();\n\n  for (const run of runs) {\n    if (!isEligible(run)) {\n      continue;\n    }\n\n    validateEligibleRun(run);\n\n    const list = byAssistant.get(run.assistant);\n    if (list === undefined) {\n      byAssistant.set(run.assistant, [run]);\n    } else {\n      list.push(run);\n    }\n  }\n\n  const summaries = [];\n  for (const [assistant, list] of byAssistant) {\n    summaries.push({\n      assistant,\n      run_count: list.length,\n      best_score: pickBest(list).score,\n      best_run_id: pickBest(list).run_id,\n      median_elapsed_ms: median(list.map((run) => run.elapsed_ms)),\n    });\n  }\n\n  summaries.sort((a, b) => (a.assistant > b.assistant ? 1 : -1));\n  return summaries;\n}\n\nfunction isEligible(run) {\n  return (\n    run != null &&\n    run.status === \"complete\" &&\n    run.acceptance_status === \"pass\" &&\n    run.comparison_eligible !== false\n  );\n}\n\nfunction validateEligibleRun(run) {\n  if (typeof run.run_id !== \"string\" || run.run_id.length === 0) {\n    throw new TypeError(\"run_id must be a non-empty string\");\n  }\n  if (typeof run.assistant !== \"string\" || run.assistant.length === 0) {\n    throw new TypeError(\"assistant must be a non-empty string\");\n  }\n  if (!isValidScore(run.score)) {\n    throw new TypeError(\"score must be a finite number from 0 through 100\");\n  }\n  if (!isValidElapsed(run.elapsed_ms)) {\n    throw new TypeError(\"elapsed_ms must be a finite number greater than or equal to zero\");\n  }\n}\n\nfunction isValidScore(value) {\n  return typeof value === \"number\" && Number.isFinite(value) && value >= 0 && value <= 100;\n}\n\nfunction isValidElapsed(value) {\n  return typeof value === \"number\" && Number.isFinite(value) && value >= 0;\n}\n\nfunction pickBest(list) {\n  let best = list[0];\n  for (let i = 1; i < list.length; i++) {\n    const current = list[i];\n    if (\n      current.score > best.score ||\n      (current.score === best.score && current.elapsed_ms < best.elapsed_ms) ||\n      (current.score === best.score &&\n        current.elapsed_ms === best.elapsed_ms &&\n        current.run_id < best.run_id)\n    ) {\n      best = current;\n    }\n  }\n  return best;\n}\n\nfunction median(values) {\n  const sorted = values.slice().sort((a, b) => a - b);\n  const mid = Math.floor(sorted.length / 2);\n  if (sorted.length % 2 === 1) {\n    return sorted[mid];\n  }\n  return (sorted[mid - 1] + sorted[mid]) / 2;\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-IQBqgL/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","time":{"start":1787443557781,"end":1787443557792}},"id":"prt_02bf0358f0015xeiLBl8rxAK3C","sessionID":"ses_fd40febdbffeutsjoBqRpIpPPf","messageID":"msg_02bf02504001loEHxm40wOJWrU"}}
