+.run-metrics {
+  display: grid;
+  grid-template-columns: 0.8fr 1fr 1.2fr;
+  margin: 0;
+}
+
+.run-metrics > div {
+  padding-left: 20px;
+  border-left: 1px solid var(--line);
+}
+
+.metric-label {
+  margin-bottom: 4px;
+  color: var(--muted);
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.055em;
+  text-transform: uppercase;
+}
+
+.metric-value {
+  margin: 0;
+  font-size: 0.91rem;
+  font-weight: 680;
+  font-variant-numeric: tabular-nums;
+}
+
+.empty-state {
+  padding: 58px 24px;
+  border: 1px dashed #b9beb7;
+  border-radius: 12px;
+  background: rgba(251, 250, 246, 0.55);
+  text-align: center;
+}
+
+.empty-state[hidden] {
+  display: none;
+}
+
+.empty-state div {
+  display: grid;
+  width: 44px;
+  height: 44px;
+  margin: 0 auto 16px;
+  place-items: center;
+  border: 1px solid #b7c1bb;
+  border-radius: 50%;
+  color: var(--green);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 1.35rem;
+}
+
+.empty-state h3 {
+  margin-bottom: 7px;
+  font-size: 1.05rem;
+}
+
+.empty-state p {
+  margin-bottom: 0;
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+@media (max-width: 900px) {
+  .summary {
+    grid-template-columns: 1fr;
+    gap: 20px;
+  }
+
+  .summary-grid > div:first-child {
+    padding-left: 0;
+    border-left: 0;
+  }
+
+  .run-card {
+    grid-template-columns: 36px minmax(160px, 1fr) 80px;
+  }
+
+  .run-metrics {
+    grid-column: 2 / -1;
+  }
+}
+
+@media (max-width: 720px) {
+  main {
+    width: min(100% - 32px, 620px);
+    padding: 42px 0 56px;
+  }
+
+  .intro {
+    display: block;
+    margin-bottom: 32px;
+  }
+
+  h1 {
+    font-size: clamp(3rem, 16vw, 4.75rem);
+  }
+
+  .sample-badge {
+    display: inline-flex;
+    margin-top: 22px;
+  }
+
+  .filter-panel {
+    padding: 22px 20px 20px;
+  }
+
+  .controls {
+    grid-template-columns: 1fr;
+  }
+
+  .summary-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    row-gap: 24px;
+  }
+
+  .summary-grid > div,
+  .summary-grid > div:first-child {
+    padding: 0 14px;
+    border-left: 1px solid var(--line);
+  }
+
+  .summary-grid > div:nth-child(odd) {
+    padding-left: 0;
+    border-left: 0;
+  }
+
+  .results-heading {
+    display: block;
+  }
+
+  .status {
+    margin-top: 10px;
+  }
+
+  .run-card {
+    grid-template-columns: 34px minmax(0, 1fr) auto;
+    gap: 15px;
+    padding: 18px 16px;
+  }
+
+  .run-metrics {
+    grid-column: 2 / -1;
+  }
+
+  .run-metrics > div {
+    padding-left: 12px;
+  }
+}
+
+@media (max-width: 440px) {
+  .filter-panel .section-heading {
+    align-items: flex-start;
+  }
+
+  #reset-filters {
+    flex: 0 0 auto;
+  }
+
+  .run-card {
+    grid-template-columns: minmax(0, 1fr) auto;
+  }
+
+  .run-rank {
+    display: none;
+  }
+
+  .run-metrics {
+    grid-column: 1 / -1;
+  }
 }
 
-/* Implement the responsive run-explorer design. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+  }
+}
