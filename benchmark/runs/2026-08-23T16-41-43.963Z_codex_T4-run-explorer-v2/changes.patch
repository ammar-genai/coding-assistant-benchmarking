+      (filters.outcome === "all" || run.outcome === filters.outcome),
+  );
+}
+
+export function sortRuns(runs, order) {
+  requireRunsArray(runs);
+
+  const byId = (left, right) => (left.id < right.id ? -1 : left.id > right.id ? 1 : 0);
+  const comparators = {
+    "score-desc": (left, right) =>
+      right.score - left.score || left.elapsedSeconds - right.elapsedSeconds || byId(left, right),
+    "time-asc": (left, right) =>
+      left.elapsedSeconds - right.elapsedSeconds || right.score - left.score || byId(left, right),
+    "cost-asc": (left, right) => {
+      const leftKnown = Number.isFinite(left.costUsd);
+      const rightKnown = Number.isFinite(right.costUsd);
+
+      if (leftKnown !== rightKnown) return leftKnown ? -1 : 1;
+      if (leftKnown && left.costUsd !== right.costUsd) return left.costUsd - right.costUsd;
+      return right.score - left.score || byId(left, right);
+    },
+  };
+  const comparator = comparators[order];
+
+  if (!comparator) {
+    throw new TypeError(`Unsupported sort order: ${order}`);
+  }
+
+  return [...runs].sort(comparator);
+}
+
+export function summarizeRuns(runs) {
+  requireRunsArray(runs);
+
+  if (runs.length === 0) {
+    return {
+      visibleCount: 0,
+      passRatePct: 0,
+      medianElapsedSeconds: 0,
+      totalCostUsd: 0,
+      costedRunCount: 0,
+    };
+  }
+
+  const passCount = runs.filter((run) => run.outcome === "pass").length;
+  const elapsed = runs.map((run) => run.elapsedSeconds).sort((left, right) => left - right);
+  const middle = Math.floor(elapsed.length / 2);
+  const medianElapsedSeconds =
+    elapsed.length % 2 === 0 ? (elapsed[middle - 1] + elapsed[middle]) / 2 : elapsed[middle];
+  const knownCosts = runs.map((run) => run.costUsd).filter(Number.isFinite);
+  const totalCostUsd = Number(
+    knownCosts.reduce((total, cost) => total + cost, 0).toFixed(12),
+  );
+
+  return {
+    visibleCount: runs.length,
+    passRatePct: Math.round((passCount / runs.length) * 1000) / 10,
+    medianElapsedSeconds,
+    totalCostUsd,
+    costedRunCount: knownCosts.length,
+  };
+}
+
+function appendTextElement(parent, tagName, className, text) {
+  const element = document.createElement(tagName);
+  element.className = className;
+  element.textContent = text;
