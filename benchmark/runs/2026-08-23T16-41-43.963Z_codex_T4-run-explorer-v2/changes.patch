@@ -1,2 +1,69 @@
-// Add at least two meaningful node:test cases for the run explorer.
-// Do not copy or modify the committed run-explorer.test.mjs suite.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { filterRuns, sortRuns, summarizeRuns } from "./run-explorer.mjs";
+
+const run = (overrides) => ({
+  id: "base",
+  assistant: "Codex",
+  model: "Sol",
+  outcome: "pass",
+  score: 90,
+  elapsedSeconds: 10,
+  costUsd: null,
+  ...overrides,
+});
+
+test("rejects invalid run collections and unsupported sort orders", () => {
+  assert.throws(() => filterRuns(null, { assistant: "all", outcome: "all" }), TypeError);
+  assert.throws(() => sortRuns({}, "score-desc"), TypeError);
+  assert.throws(() => summarizeRuns("runs"), TypeError);
+  assert.throws(() => sortRuns([], "newest"), TypeError);
+});
+
+test("cost sorting puts numeric costs first and applies score and ID ties", () => {
+  const runs = [
+    run({ id: "unknown-low", score: 50 }),
+    run({ id: "paid-b", score: 92, costUsd: 0.1 }),
+    run({ id: "paid-a", score: 92, costUsd: 0.1 }),
+    run({ id: "paid-cheap", score: 70, costUsd: 0.02 }),
+    run({ id: "unknown-high", score: 95 }),
+  ];
+
+  assert.deepEqual(sortRuns(runs, "cost-asc").map(({ id }) => id), [
+    "paid-cheap",
+    "paid-a",
+    "paid-b",
+    "unknown-high",
+    "unknown-low",
+  ]);
+});
+
+test("summaries handle empty input, even medians, and decimal cost residue", () => {
+  assert.deepEqual(summarizeRuns([]), {
+    visibleCount: 0,
+    passRatePct: 0,
+    medianElapsedSeconds: 0,
+    totalCostUsd: 0,
+    costedRunCount: 0,
+  });
+
+  const summary = summarizeRuns([
+    run({ id: "a", elapsedSeconds: 2, costUsd: 0.1 }),
+    run({ id: "b", elapsedSeconds: 8, costUsd: 0.2, outcome: "fail" }),
+  ]);
+  assert.equal(summary.medianElapsedSeconds, 5);
+  assert.equal(summary.passRatePct, 50);
+  assert.equal(summary.totalCostUsd, 0.3);
+  assert.equal(summary.costedRunCount, 2);
+});
+
+test("filter matching is exact and case-sensitive while preserving record identity", () => {
+  const codex = run({ id: "codex" });
+  const runs = [codex, run({ id: "lowercase", assistant: "codex" })];
+  const result = filterRuns(runs, { assistant: "Codex", outcome: "pass" });
+
+  assert.deepEqual(result, [codex]);
+  assert.notEqual(result, runs);
+  assert.equal(result[0], codex);
+});
