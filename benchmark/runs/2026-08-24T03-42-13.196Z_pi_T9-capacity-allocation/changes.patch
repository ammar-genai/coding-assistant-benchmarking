-// Replace this placeholder with at least three meaningful node:test cases.
 import assert from "node:assert/strict";
 import test from "node:test";
 
-test("replace this placeholder with allocation contract tests", () => {
-  assert.fail("Add at least three meaningful tests");
+import { allocateCapacity } from "./allocation-engine.mjs";
+
+const T0 = "2026-01-01T00:00:00Z";
+const T1 = "2026-01-01T00:01:00Z";
+
+test("returns an empty array for an empty request list", () => {
+  assert.deepEqual(allocateCapacity([], { ABS: 10 }), []);
+});
+
+test("allocates nothing when a desk has zero capacity", () => {
+  const requests = [
+    { id: "a", desk: "ABS", requested: 10, priority: 1, submittedAt: T0 },
+    { id: "b", desk: "ABS", requested: 5, priority: 2, submittedAt: T0 },
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { ABS: 0 }), [
+    { id: "a", allocated: 0, unfilled: 10 },
+    { id: "b", allocated: 0, unfilled: 5 },
+  ]);
+});
+
+test("orders by priority, submission time, then id and returns rows in input order", () => {
+  // Two independent desks. Desk A exercises priority then submission time.
+  // Desk B exercises the id tie breaker at equal priority and submission time.
+  const requests = [
+    { id: "r3", desk: "A", requested: 25, priority: 1, submittedAt: T0 },
+    { id: "r1", desk: "A", requested: 10, priority: 5, submittedAt: T0 },
+    { id: "r2", desk: "A", requested: 10, priority: 5, submittedAt: T1 },
+    { id: "s2", desk: "B", requested: 5, priority: 2, submittedAt: T0 },
+    { id: "s1", desk: "B", requested: 40, priority: 2, submittedAt: T0 },
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { A: 30, B: 30 }), [
+    { id: "r3", allocated: 10, unfilled: 15 }, // priority 1, last on desk A
+    { id: "r1", allocated: 10, unfilled: 0 }, // priority 5, earlier submission
+    { id: "r2", allocated: 10, unfilled: 0 }, // priority 5, later submission
+    { id: "s2", allocated: 0, unfilled: 5 }, // id tie breaker: s1 served first
+    { id: "s1", allocated: 30, unfilled: 10 },
+  ]);
+});
+
+test("accepts Date instances as submittedAt timestamps", () => {
+  const requests = [
+    { id: "a", desk: "ABS", requested: 10, priority: 1, submittedAt: new Date(T0) },
+    { id: "b", desk: "ABS", requested: 10, priority: 2, submittedAt: new Date(T0) },
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { ABS: 15 }), [
+    { id: "a", allocated: 5, unfilled: 5 },
+    { id: "b", allocated: 10, unfilled: 0 },
+  ]);
+});
+
+test("handles fractional requested amounts and capacities exactly", () => {
+  const requests = [
+    { id: "a", desk: "ABS", requested: 2.5, priority: 1, submittedAt: T0 },
+    { id: "b", desk: "ABS", requested: 3.5, priority: 2, submittedAt: T0 },
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { ABS: 5 }), [
+    { id: "a", allocated: 1.5, unfilled: 1 },
+    { id: "b", allocated: 3.5, unfilled: 0 },
+  ]);
+});
+
+test("does not mutate the input array, request records, or capacity object", () => {
+  const requests = [
+    { id: "a", desk: "ABS", requested: 70, priority: 1, submittedAt: T0 },
+    { id: "b", desk: "ABS", requested: 60, priority: 3, submittedAt: T1 },
+  ];
+  const capacityByDesk = { ABS: 100 };
+
+  const firstRef = requests[0];
+  const beforeRequests = JSON.parse(JSON.stringify(requests));
+  const beforeCapacity = JSON.parse(JSON.stringify(capacityByDesk));
+
+  const result = allocateCapacity(requests, capacityByDesk);
+
+  // Inputs keep their values and identity.
+  assert.deepEqual(requests, beforeRequests);
+  assert.deepEqual(capacityByDesk, beforeCapacity);
+  assert.equal(requests[0], firstRef);
+  assert.equal(requests[0].requested, 70);
+  // A fresh array is returned.
+  assert.notEqual(result, requests);
+});
+
+test("rejects invalid inputs with TypeError", () => {
+  const base = {
+    id: "a",
+    desk: "ABS",
+    requested: 10,
+    priority: 1,
+    submittedAt: T0,
+  };
+  const cap = { ABS: 10 };
+  const withOverrides = (overrides) => ({ ...base, ...overrides });
+
+  assert.throws(() => allocateCapacity("nope", cap), TypeError);
+  assert.throws(() => allocateCapacity([], null), TypeError);
+  assert.throws(() => allocateCapacity([], []), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ id: "" })], cap), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ id: 5 })], cap), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ desk: "" })], cap), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ requested: 0 })], cap), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ requested: Infinity })], cap), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ priority: 1.5 })], cap), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ submittedAt: "nope" })], cap), TypeError);
+  assert.throws(() => allocateCapacity([withOverrides({ submittedAt: null })], cap), TypeError);
+  assert.throws(() => allocateCapacity([base], {}), TypeError); // missing desk capacity
+  assert.throws(() => allocateCapacity([base], { ABS: -1 }), TypeError); // negative capacity
+  assert.throws(() => allocateCapacity([base], { ABS: NaN }), TypeError); // NaN capacity
+  assert.throws(
+    () => allocateCapacity([base, { ...base }], cap), // duplicate ids
+    TypeError,
+  );
+});
+
+test("validation failures do not mutate inputs", () => {
+  const requests = [
+    { id: "a", desk: "ABS", requested: 10, priority: 1, submittedAt: T0 },
+    { id: "a", desk: "ABS", requested: 10, priority: 1, submittedAt: T0 },
+  ];
+  const capacityByDesk = { ABS: 10 };
+
+  const beforeRequests = JSON.parse(JSON.stringify(requests));
+  const beforeCapacity = JSON.parse(JSON.stringify(capacityByDesk));
+
+  assert.throws(() => allocateCapacity(requests, capacityByDesk), TypeError);
+
+  assert.deepEqual(requests, beforeRequests);
+  assert.deepEqual(capacityByDesk, beforeCapacity);
 });
