+// Deterministic desk-capacity allocation.
+//
+// Each desk is allocated independently. Within a desk, requests are served in
+// this deterministic order:
+//   1. higher `priority` first,
+//   2. earlier `submittedAt` first,
+//   3. lexicographically smaller `id` first.
+//
+// Each request receives at most its `requested` amount and each desk uses at
+// most its declared capacity. Results are returned in the original input order.
+// The inputs (array, request records, and capacity object) are never mutated.
+
+function toTimestamp(submittedAt) {
+  if (submittedAt instanceof Date) {
+    return submittedAt.getTime();
+  }
+  if (typeof submittedAt === "string" || typeof submittedAt === "number") {
+    return new Date(submittedAt).getTime();
+  }
+  return NaN;
+}
+
 function validateInputs(requests, capacityByDesk) {
-  if (!Array.isArray(requests)) throw new TypeError("requests must be an array");
-  if (!capacityByDesk || typeof capacityByDesk !== "object" || Array.isArray(capacityByDesk)) {
+  if (!Array.isArray(requests)) {
+    throw new TypeError("requests must be an array");
+  }
+  if (
+    capacityByDesk === null ||
+    typeof capacityByDesk !== "object" ||
+    Array.isArray(capacityByDesk)
+  ) {
     throw new TypeError("capacityByDesk must be an object");
   }
+
+  const seenIds = new Set();
+  for (let i = 0; i < requests.length; i++) {
+    const request = requests[i];
+    const where = `requests[${i}]`;
+    if (request === null || typeof request !== "object" || Array.isArray(request)) {
+      throw new TypeError(`${where} must be a request object`);
+    }
+
+    const { id, desk, requested, priority, submittedAt } = request;
+
+    if (typeof id !== "string" || id.length === 0) {
+      throw new TypeError(`${where}.id must be a non-empty string`);
+    }
+    if (seenIds.has(id)) {
+      throw new TypeError(`${where}.id "${id}" is not unique`);
+    }
+    seenIds.add(id);
+
+    if (typeof desk !== "string" || desk.length === 0) {
+      throw new TypeError(`${where}.desk must be a non-empty string`);
+    }
+    if (typeof requested !== "number" || !Number.isFinite(requested) || requested <= 0) {
+      throw new TypeError(`${where}.requested must be a positive finite number`);
+    }
+    if (!Number.isInteger(priority)) {
+      throw new TypeError(`${where}.priority must be an integer`);
+    }
+    if (Number.isNaN(toTimestamp(submittedAt))) {
+      throw new TypeError(`${where}.submittedAt must be a valid timestamp`);
+    }
+  }
+
+  // Every desk referenced by a request must have a finite, non-negative capacity.
+  for (const request of requests) {
+    const desk = request.desk;
+    if (!Object.prototype.hasOwnProperty.call(capacityByDesk, desk)) {
+      throw new TypeError(`capacityByDesk is missing capacity for desk "${desk}"`);
+    }
+    const capacity = capacityByDesk[desk];
+    if (typeof capacity !== "number" || !Number.isFinite(capacity) || capacity < 0) {
+      throw new TypeError(
+        `capacity for desk "${desk}" must be a finite, non-negative number`,
+      );
+    }
+  }
 }
 
 export function allocateCapacity(requests, capacityByDesk) {
   validateInputs(requests, capacityByDesk);
 
-  return requests.map((request) => ({
+  // Remaining capacity per desk, copied from the input without mutating it.
+  const remaining = new Map();
+  for (const request of requests) {
+    if (!remaining.has(request.desk)) {
+      remaining.set(request.desk, capacityByDesk[request.desk]);
+    }
+  }
+
+  // Build a working list of entries so the original array/records are untouched.
+  const order = requests.map((request, index) => ({
+    index,
     id: request.id,
-    allocated: request.requested,
-    unfilled: 0,
+    desk: request.desk,
+    wanted: request.requested,
+    priority: request.priority,
+    ts: toTimestamp(request.submittedAt),
   }));
+
+  // priority desc, then submittedAt asc, then id asc.
+  order.sort((a, b) => {
+    if (a.priority !== b.priority) return b.priority - a.priority;
+    if (a.ts !== b.ts) return a.ts - b.ts;
+    if (a.id < b.id) return -1;
+    if (a.id > b.id) return 1;
+    return 0;
+  });
+
+  // Allocate in deterministic order, but write results at the original index.
+  const result = new Array(requests.length);
+  for (const entry of order) {
+    const available = remaining.get(entry.desk);
+    const allocated = Math.min(entry.wanted, available);
+    remaining.set(entry.desk, available - allocated);
+    result[entry.index] = {
+      id: entry.id,
+      allocated,
+      unfilled: entry.wanted - allocated,
+    };
+  }
+
+  return result;
 }
diff --git a/benchmark/fixtures/T9-capacity-allocation/student-tests.mjs b/benchmark/fixtures/T9-capacity-allocation/student-tests.mjs
