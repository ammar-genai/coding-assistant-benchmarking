{"type":"message_update","usage":{"input":2,"output":2078,"cacheRead":7894,"cacheWrite":321,"reasoning":122,"totalTokens":10295,"cost":{"input":0.00002,"output":0.1039,"cacheRead":0.007894,"cacheWrite":0.0040125,"total":0.11582650000000001}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"toolu_vrtx_014Pifv32htgQ5Adn1S4hvNe","name":"write","arguments":{"path":"benchmark/fixtures/T10-event-projector/student-tests.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createEventProjector } from \"./event-projector.mjs\";\n\nconst created = (tradeId, payload = { notional: 100, owner: \"desk-a\" }) => ({\n  tradeId,\n  version: 1,\n  type: \"CREATED\",\n  payload,\n});\n\ntest(\"different trades progress concurrently instead of sharing one queue\", async () => {\n  let releaseSlow;\n  const slowGate = new Promise((resolve) => {\n    releaseSlow = resolve;\n  });\n  const order = [];\n  const projector = createEventProjector(async (tradeId) => {\n    if (tradeId === \"slow\") {\n      await slowGate;\n    }\n    order.push(tradeId);\n  });\n\n  const slow = projector.project(created(\"slow\"));\n  const fast = projector.project(created(\"fast\"));\n\n  // \"fast\" must complete while \"slow\" persistence is still blocked.\n  await fast;\n  assert.deepEqual(order, [\"fast\"]);\n  releaseSlow();\n  await slow;\n  assert.deepEqual(order, [\"fast\", \"slow\"]);\n});\n\ntest(\"duplicate and stale versions return the snapshot without persisting\", async () => {\n  const persisted = [];\n  const projector = createEventProjector(async (_tradeId, state) => {\n    persisted.push(state.version);\n  });\n\n  await projector.project(created(\"t1\"));\n  await projector.project({\n    tradeId: \"t1\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { owner: \"desk-b\" },\n  });\n\n  const dupe = await projector.project({\n    tradeId: \"t1\",\n    version: 1,\n    type: \"CREATED\",\n    payload: { notional: 999, owner: \"intruder\" },\n  });\n\n  assert.deepEqual(persisted, [1, 2]);\n  assert.equal(dupe.version, 2);\n  assert.equal(dupe.owner, \"desk-b\");\n});\n\ntest(\"version gaps and invalid first events reject without changing state\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t2\",\n      version: 1,\n      type: \"AMENDED\",\n      payload: { notional: 50 },\n    }),\n    /first event must be CREATED/,\n  );\n  assert.equal(projector.getSnapshot(\"t2\"), null);\n\n  await projector.project(created(\"t2\"));\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t2\",\n      version: 3,\n      type: \"AMENDED\",\n      payload: { notional: 50 },\n    }),\n    /version gap/,\n  );\n  assert.equal(projector.getSnapshot(\"t2\").version, 1);\n\n  // The rejection must not poison later valid work for the same trade.\n  const next = await projector.project({\n    tradeId: \"t2\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { notional: 50 },\n  });\n  assert.equal(next.version, 2);\n});\n\ntest(\"a cancelled trade is terminal\", async () => {\n  const projector = createEventProjector(async () => {});\n  await projector.project(created(\"t3\"));\n  await projector.project({ tradeId: \"t3\", version: 2, type: \"CANCELLED\" });\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t3\",\n      version: 3,\n      type: \"AMENDED\",\n      payload: { notional: 1 },\n    }),\n    /cancelled and terminal/,\n  );\n  assert.equal(projector.getSnapshot(\"t3\").status, \"cancelled\");\n});\n\ntest(\"malformed events and invalid payload values reject with TypeError\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({ tradeId: \"t4\", version: 1, type: \"SPLIT\", payload: {} }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t4\", { notional: -5, owner: \"desk-a\" })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t4\", { notional: Infinity, owner: \"desk-a\" })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t4\", { notional: 100, owner: \"\" })),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"t4\"), null);\n\n  await projector.project(created(\"t4\"));\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t4\",\n      version: 2,\n      type: \"AMENDED\",\n      payload: { owner: 42 },\n    }),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"t4\").owner, \"desk-a\");\n});\n\ntest(\"inputs, callback values, and snapshots do not expose mutable internals\", async () => {\n  let seenState;\n  const projector = createEventProjector(async (_tradeId, state) => {\n    seenState = state;\n  });\n\n  const event = created(\"t5\");\n  const result = await projector.project(event);\n\n  // Mutating the caller's event, the callback state, or the returned state\n  // must not affect the projector's internal state.\n  event.payload.notional = -1;\n  seenState.owner = \"hacked\";\n  result.status = \"hacked\";\n  const snap = projector.getSnapshot(\"t5\");\n  snap.notional = 0;\n\n  assert.deepEqual(projector.getSnapshot(\"t5\"), {\n    tradeId: \"t5\",\n    version: 1,\n    status: \"active\",\n    notional: 100,\n    owner: \"desk-a\",\n  });\n});\n"}}}}
