row new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map();\n  let pending = Promise.resolve();\n\n  async function project(event) {\n    pending = pending.then(async () => {\n      const next = reduceEvent(states.get(event.tradeId), event);\n      states.set(event.tradeId, next);\n      await applyToStore(event.tradeId, copyState(next), structuredClone(event));\n      return copyState(next);\n    });\n    return pending;\n  }\n\n  function getSnapshot(tradeId) {\n    return copyState(states.get(tradeId));\n  }\n\n  return { project, getSnapshot };\n}\n"}],"isError":false,"timestamp":1787544631732},{"role":"toolResult","toolCallId":"toolu_vrtx_01JyNmbreeoCvrbuz4HyCnFf","toolName":"read","content":[{"type":"text","text":"// Replace this placeholder with at least four meaningful node:test cases.\nimport assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\ntest(\"replace this placeholder with projector regression tests\", () => {\n  assert.fail(\"Add at least four meaningful tests\");\n});\n"}],"isError":false,"timestamp":1787544631732},{"role":"toolResult","toolCallId":"toolu_vrtx_01JJqRpLWSeFq4pcL1MtY5eF","toolName":"read","content":[{"type":"text","text":"# Event projector incident\n\nStatus: investigation pending\n\n## Impact\n\nComplete after diagnosing the fixture.\n\n## Root cause\n\nComplete after diagnosing the fixture.\n\n## Fix\n\nComplete after implementing the repair.\n\n## Regression coverage\n\nComplete after adding tests.\n\n## Remaining risk\n\nComplete after verification.\n"}],"isError":false,"timestamp":1787544631732},{"role":"toolResult","toolCallId":"toolu_vrtx_018RtPXn4SKMSd87yP3JwgHf","toolName":"read","content":[{"type":"text","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createEventProjector } from \"./event-projector.mjs\";\n\nconst created = (tradeId = \"trade-1\") => ({\n  tradeId,\n  version: 1,\n  type: \"CREATED\",\n  payload: { notional: 100, owner: \"desk-a\" },\n});\n\ntest(\"serializes concurrent events for one trade\", async () => {\n  const persisted = [];\n  const projector = createEventProjector(async (_tradeId, state) => {\n    await Promise.resolve();\n    persisted.push(state.version);\n  });\n\n  const first = projector.project(created());\n  const second = projector.project({\n    tradeId: \"trade-1\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { notional: 125 },\n  });\n\n  await Promise.all([first, second]);\n  assert.deepEqual(persisted, [1, 2]);\n  assert.deepEqual(projector.getSnapshot(\"trade-1\"), {\n    tradeId: \"trade-1\",\n    version: 2,\n    status: \"active\",\n    notional: 125,\n    owner: \"desk-a\",\n  });\n});\n\ntest(\"a persistence rejection does not commit state or poison later work\", async () => {\n  let fail = true;\n  const projector = createEventProjector(async () => {\n    if (fail) {\n      fail = false;\n      throw new Error(\"temporary store failure\");\n    }\n  });\n\n  await assert.rejects(projector.project(created()), /temporary store failure/);\n  assert.equal(projector.getSnapshot(\"trade-1\"), null);\n  assert.equal((await projector.project(created())).version, 1);\n});\n"}],"isError":false,"timestamp":1787544631732}]}
