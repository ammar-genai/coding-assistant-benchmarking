w new TypeError(\"CREATED requires a positive finite notional\");\n    }\n    if (!isNonEmptyString(event.payload.owner)) {\n      throw new TypeError(\"CREATED requires a non-empty owner\");\n    }\n    return {\n      tradeId: event.tradeId,\n      version: event.version,\n      status: \"active\",\n      notional: event.payload.notional,\n      owner: event.payload.owner,\n    };\n  }\n\n  if (previous === undefined) {\n    throw new Error(\"first event must be CREATED at version 1\");\n  }\n  if (previous.status === \"cancelled\") {\n    throw new Error(`trade ${event.tradeId} is cancelled and terminal`);\n  }\n  if (event.version !== previous.version + 1) {\n    throw new Error(\n      `version gap for trade ${event.tradeId}: expected ${previous.version + 1}, got ${event.version}`,\n    );\n  }\n\n  if (event.type === \"AMENDED\") {\n    const next = { ...previous, version: event.version };\n    if (\"notional\" in event.payload) {\n      if (!isValidNotional(event.payload.notional)) {\n        throw new TypeError(\"AMENDED notional must be positive and finite\");\n      }\n      next.notional = event.payload.notional;\n    }\n    if (\"owner\" in event.payload) {\n      if (!isNonEmptyString(event.payload.owner)) {\n        throw new TypeError(\"AMENDED owner must be a non-empty string\");\n      }\n      next.owner = event.payload.owner;\n    }\n    return next;\n  }\n\n  // CANCELLED\n  return { ...previous, version: event.version, status: \"cancelled\" };\n}\n\nexport function createEventProjector(applyToStore) {\n  if (typeof applyToStore !== \"function\") {\n    throw new TypeError(\"applyToStore must be a function\");\n  }\n\n  const states = new Map();\n  const queues = new Map();\n\n  async function apply(event) {\n    const previous = states.get(event.tradeId);\n\n    // Duplicate or stale version: return current snapshot, no persistence.\n    if (previous !== undefined && event.version <= previous.version) {\n      return copyState(previous);\n    }\