\"]);\n});\n\ntest(\"duplicate and stale versions return the snapshot without persisting\", async () => {\n  const persisted = [];\n  const projector = createEventProjector(async (_tradeId, state) => {\n    persisted.push(state.version);\n  });\n\n  await projector.project(created(\"t1\"));\n  await projector.project({\n    tradeId: \"t1\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { owner: \"desk-b\" },\n  });\n\n  const dupe = await projector.project({\n    tradeId: \"t1\",\n    version: 1,\n    type: \"CREATED\",\n    payload: { notional: 999, owner: \"intruder\" },\n  });\n\n  assert.deepEqual(persisted, [1, 2]);\n  assert.equal(dupe.version, 2);\n  assert.equal(dupe.owner, \"desk-b\");\n});\n\ntest(\"version gaps and invalid first events reject without changing state\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t2\",\n      version: 1,\n      type: \"AMENDED\",\n      payload: { notional: 50 },\n    }),\n    /first event must be CREATED/,\n  );\n  assert.equal(projector.getSnapshot(\"t2\"), null);\n\n  await projector.project(created(\"t2\"));\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t2\",\n      version: 3,\n      type: \"AMENDED\",\n      payload: { notional: 50 },\n    }),\n    /version gap/,\n  );\n  assert.equal(projector.getSnapshot(\"t2\").version, 1);\n\n  // The rejection must not poison later valid work for the same trade.\n  const next = await projector.project({\n    tradeId: \"t2\",\n    version: 2,\n    type: \"AMENDED\",\n    payload: { notional: 50 },\n  });\n  assert.equal(next.version, 2);\n});\n\ntest(\"a cancelled trade is terminal\", async () => {\n  const projector = createEventProjector(async () => {});\n  await projector.project(created(\"t3\"));\n  await projector.project({ tradeId: \"t3\", version: 2, type: \"CANCELLED\" });\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t3\",\n      version: 3,\n      type: \"AMENDED\",\n      payload: { notional: 1 },\n    }),\n    /cancelled and terminal/,\n  );\n  assert.equal(projector.getSnapshot(\"t3\").status, \"cancelled\");\n});\n\ntest(\"malformed events and invalid payload values reject with TypeError\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({ tradeId: \"t4\", version: 1, type: \"SPLIT\", payload: {} }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t4\", { notional: -5, owner: \"desk-a\" })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t4\", { notional: Infinity, owner: \"desk-a\" })),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project(created(\"t4\", { notional: 100, owner: \"\" })),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"t4\"), null);\n\n  await projector.project(created(\"t4\"));\n  await assert.rejects(\n    projector.project({\n      tradeId: \"t4\",\n      version: 2,\n      type: \"AMENDED\",\n      payload: { owner: 42 },\n    }),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"t4\").owner, \"desk-a\");\n});\n\ntest(\"inputs, callback values, and snapshots do not expose mutable internals\", async () => {\n  let seenState;\n  const projector = createEventProjector(async (_tradeId, state) => {\n    seenState = state;\n  });\n\n  const event = created(\"t5\");\n  const result = await projector.project(event);\n\n  // Mutating the caller's event, the callback state, or the returned state\n  // must not affect the projector's internal state.\n  event.payload.notional = -1;\n  seenState.owner = \"hacked\";\n  result.status = \"hacked\";\n  const snap = projector.getSnapshot(\"t5\");\n  snap.notional = 0;\n\n  assert.deepEqual(projector.getSnapshot(\"t5\"), {\n    tradeId: \"t5\",\n    version: 1,\n    status: \"active\",\n    notional: 100,\n    owner: \"desk-a\",\n  });\n});\n"}}],"api":"openai-completions","provider":"openrouter","model":"anthropic/claude-fable-5","usage":{"input":2,"output":2078,"cacheRead":7894,"cacheWrite":321,"reasoning":122,"totalTokens":10295,"cost":{"input":0.00002,"output":0.1039,"cacheRead":0.007894,"cacheWrite":0.0040125,"total":0.11582650000000001}},"stopReason":"toolUse","timestamp":1787544656692,"responseId":"gen-1787544656-naMUYaFDOgbHcBKTSTOc","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"toolu_vrtx_014Pifv32htgQ5Adn1S4hvNe","toolName":"write","content":[{"type":"text","text":"Successfully wrote 4680 bytes to benchmark/fixtures/T10-event-projector/student-tests.mjs"}],"isError":false,"timestamp":1787544675822},{"role":"assistant","content":[{"type":"toolCall","id":"toolu_vrtx_01P32j4RRdbobjontRqcTQES","name":"bash","arguments":{"command":"node --test benchmark/fixtures/T10-event-projector/event-projector.test.mjs benchmark/fixtures/T10-event-projector/student-tests.mjs 2>&1 | tail -20"}}],"api":"openai-completions","provider":"openrouter","model":"anthropic/claude-fable-5","usage":{"input":2,"output":113,"cacheRead":8215,"cacheWrite":2001,"reasoning":0,"totalTokens":10331,"cost":{"input":0.00002,"output":0.0056500000000000005,"cacheRead":0.008215,"cacheWrite":0.0250125,"total":0.0388975}},"stopReason":"toolUse","timestamp":1787544675823,"responseId":"gen-1787544675-GsCzJmBAQa5apmGanLfD","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"toolu_vrtx_01P32j4RRdbobjontRqcTQES","toolName":"bash","content":[{"type":"text","text":"✔ serializes concurrent events for one trade (1.316917ms)\n✔ a persistence rejection does not commit state or poison later work (0.291583ms)\n✔ different trades progress concurrently instead of sharing one queue (1.341375ms)\n✔ duplicate and stale versions return the snapshot without persisting (0.136875ms)\n✔ version gaps and invalid first events reject without changing state (0.320584ms)\n✔ a cancelled trade is terminal (0.128084ms)\n✔ malformed events and invalid payload values reject with TypeError (0.506417ms)\n✔ inputs, callback values, and snapshots do not expose mutable internals (0.107708ms)\nℹ tests 8\nℹ suites 0\nℹ pass 8\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 66.280958\n"}],"isError":false,"timestamp":1787544678348},{"role":"assistant","content":[{"type":"toolCall","id":"toolu_vrtx_01Dfn6KhxD2w1kynG3DdsHUN","name":"write","arguments":{"path":"benchmark/fixtures/T10-event-projector/INCIDENT.md","content":"# Event projector incident\n\nStatus: resolved\n\n## Impact\n\nTwo production-shaped failures in the synthetic trade event projector:\n\n1. After a single temporary persistence rejection, the projector stopped\n   accepting all subsequent events for every trade (permanent poisoning), and\n   the failed event's state had already been committed in memory, diverging\n   from the store.\n2. All trades shared one global promise chain, so a slow or blocked\n   persistence call for one trade halted progress for every unrelated trade.\n\nValidation gaps also allowed version gaps, out-of-order first events,\nevents after cancellation, invalid payloads, and unknown event types to be\nsilently applied, and internal state was mutated before persistence.\n\n## Root cause\n\n- One module-wide `pending` promise chained every `project` call for all\n  trades. When any link rejected, the rejected promise remained the chain\n  tail, so every later `.then` also rejected — the queue was poisoned and it\n  was global, not per trade.\n- `states.set(...)` ran before `await applyToStore(...)`, committing state\n  that the store rejected.\n- `reduceEvent` performed no ordering, terminality, or payload validation,\n  and events were consumed by reference (mutable input exposure).\n\n## Fix\n\nIn `event-projector.mjs`:\n\n- Replaced the global chain with a per-trade queue map. Each trade chains its\n  own events (serial per trade, concurrent across trades) and the queue tail\n  is settled via a swallow handler so a rejection never blocks later events.\n- Moved `states.set` after a successful `await applyToStore`, so state\n  commits only on persistence success.\n- Added full validation: structural checks (`TypeError` for malformed\n  events/unsupported types), first event must be `CREATED` at version 1 with\n  positive finite `notional` and non-empty `owner`, subsequent events must be\n  exactly `current version + 1`, duplicate/stale versions return the current\n  snapshot without persisting, `CANCELLED` is terminal, and `AMENDED`\n  payload fields are validated to keep state complete and valid.\n- Defensive copies everywhere: events are `structuredClone`d on intake, and\n  the callback state, returned states, and snapshots are all clones, so no\n  mutable internal state escapes.\n\n## Regression coverage\n\n`student-tests.mjs` (six tests, all node:test):\n\n1. Different trades progress concurrently instead of sharing one queue\n   (a blocked persistence call for one trade does not stall another).\n2. Duplicate/stale versions return the current snapshot without persisting.\n3. Version gaps and invalid first events reject without state change, and a\n   rejection does not poison later valid work for the same trade.\n4. A cancelled trade is terminal and rejects a later new version.\n5. Malformed events and invalid payload values reject with `TypeError`\n   without changing state.\n6. Mutating input events, callback state, returned state, or snapshots does\n   not affect internal state.\n\n## Remaining risk\n\n- Persistence and in-memory commit are not atomic: if the process dies after\n  `applyToStore` succeeds but before `states.set`, memory lags the store\n  until restart/replay. Acceptable for this in-memory fixture.\n- If `applyToStore` succeeds but the store later loses the write, the\n  projector has no reconciliation; recovery would need replay from the store.\n- Version numbers are validated as positive integers; extremely large trade\n  cardinality would grow the `states`/`queues` maps unbounded (no eviction).\n"}}],"api":"openai-completions","provider":"openrouter","model":"anthropic/claude-fable-5","usage":{"input":2,"output":1242,"cacheRead":10216,"cacheWrite":428,"reasoning":0,"totalTokens":11888,"cost":{"input":0.00002,"output":0.0621,"cacheRead":0.010216,"cacheWrite":0.00535,"total":0.07768599999999999}},"stopReason":"toolUse","timestamp":1787544678348,"responseId":"gen-1787544678-ZfzddVBSJsDF0FTjkMzG","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"toolu_vrtx_01Dfn6KhxD2w1kynG3DdsHUN","toolName":"write","content":[{"type":"text","text":"Successfully wrote 3484 bytes to benchmark/fixtures/T10-event-projector/INCIDENT.md"}],"isError":false,"timestamp":1787544695736},{"role":"assistant","content":[{"type":"thinking","thinking":"Let me double-check that no other files were changed before wrapping up and reporting back.","thinkingSignature":"reasoning"},{"type":"text","text":"All done. Summary:\n\n**Root cause** (two coupled bugs in `event-projector.mjs`):\n1. A single module-wide `pending` promise chained *all* trades' events. After any rejection, the rejected promise stayed as the chain tail, so every later `project` call rejected too — a globally poisoned queue that also blocked unrelated trades behind one slow persistence call.\n2. `states.set(next)` ran *before* `await applyToStore(...)`, so state committed even when persistence rejected. There was also no validation of ordering, first-event rules, terminality, payload validity, or event types, and inputs were held by reference.\n\n**Repair**:\n- Per-trade queue map (`Map<tradeId, Promise>`) — serial per trade, concurrent across trades; queue tails swallow rejections so one failure never blocks later events.\n- Commit `states.set` only after `applyToStore` resolves.\n- Full validation: `TypeError` for malformed events/unsupported types/invalid payloads; first event must be `CREATED` v1 with positive finite `notional` and non-empty `owner`; later events require exactly `version + 1`; duplicate/stale versions return the current snapshot without persisting; `CANCELLED` is terminal; `AMENDED` fields validated.\n- Defensive `structuredClone` on intake events, callback state, returned states, and snapshots.\n\n**Tests added** (`student-tests.mjs`, 6 tests): cross-trade concurrency (blocked trade doesn't stall another), duplicate/stale no-op behavior, gap/invalid-first rejection without poisoning, cancelled-is-terminal, `TypeError` on malformed events/payloads, and immutability of all exposed values.\n\n**Test result**:\n```\nℹ tests 8   (2 committed + 6 student)\nℹ pass 8\nℹ fail 0\n```\n\n**Remaining risk** (documented in `INCIDENT.md`): store-write vs. in-memory commit isn't atomic across a crash; no store reconciliation/replay; `states`/`queues` maps grow unbounded with trade cardinality.\n\nOnly the three permitted fixture files were changed."}],"api":"openai-completions","provider":"openrouter","model":"anthropic/claude-fable-5","usage":{"input":2,"output":735,"cacheRead":10644,"cacheWrite":1288,"reasoning":17,"totalTokens":12669,"cost":{"input":0.00002,"output":0.036750000000000005,"cacheRead":0.010643999999999999,"cacheWrite":0.0161,"total":0.063514}},"stopReason":"stop","timestamp":1787544695737,"responseId":"gen-1787544695-2Ls6DyGwmthdO72AJ07g","rawStopReason":"stop"}],"willRetry":false}
