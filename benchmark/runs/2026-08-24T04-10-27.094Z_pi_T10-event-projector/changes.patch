+import { createEventProjector } from "./event-projector.mjs";
+
+const created = (tradeId, payload = { notional: 100, owner: "desk-a" }) => ({
+  tradeId,
+  version: 1,
+  type: "CREATED",
+  payload,
+});
+
+test("different trades progress concurrently instead of sharing one queue", async () => {
+  let releaseSlow;
+  const slowGate = new Promise((resolve) => {
+    releaseSlow = resolve;
+  });
+  const order = [];
+  const projector = createEventProjector(async (tradeId) => {
+    if (tradeId === "slow") {
+      await slowGate;
+    }
+    order.push(tradeId);
+  });
+
+  const slow = projector.project(created("slow"));
+  const fast = projector.project(created("fast"));
+
+  // "fast" must complete while "slow" persistence is still blocked.
+  await fast;
+  assert.deepEqual(order, ["fast"]);
+  releaseSlow();
+  await slow;
+  assert.deepEqual(order, ["fast", "slow"]);
+});
+
+test("duplicate and stale versions return the snapshot without persisting", async () => {
+  const persisted = [];
+  const projector = createEventProjector(async (_tradeId, state) => {
+    persisted.push(state.version);
+  });
+
+  await projector.project(created("t1"));
+  await projector.project({
+    tradeId: "t1",
+    version: 2,
+    type: "AMENDED",
+    payload: { owner: "desk-b" },
+  });
+
+  const dupe = await projector.project({
+    tradeId: "t1",
+    version: 1,
+    type: "CREATED",
+    payload: { notional: 999, owner: "intruder" },
+  });
+
+  assert.deepEqual(persisted, [1, 2]);
+  assert.equal(dupe.version, 2);
+  assert.equal(dupe.owner, "desk-b");
+});
+
