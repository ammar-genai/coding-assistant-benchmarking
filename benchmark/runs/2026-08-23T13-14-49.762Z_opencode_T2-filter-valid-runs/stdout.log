nal order and return the original record objects.\n */\nexport function selectComparisonRuns(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  return runs.filter(\n    (run) =>\n      run.status === \"complete\" ||\n      run.acceptance_status === \"pass\" ||\n      run.comparison_eligible !== false,\n  );\n}","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"benchmark/fixtures/T2-run-filter/select-comparison-runs.mjs","time":{"start":1787490895890,"end":1787490895904}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"To understand the problem, let's start by reading the files that need to be modified.\n","format":"unknown","index":0}]}},"id":"prt_02ec28806001lXKqoZcf9z3Pn0","sessionID":"ses_fd13d8cacffehrzmGt11M7KId3","messageID":"msg_02ec27424001hecoIX8D26EV0X"}}
{"type":"tool_use","timestamp":1787490900327,"sessionID":"ses_fd13d8cacffehrzmGt11M7KId3","part":{"type":"tool","tool":"read","callID":"call-ff31e079-ff8b-469c-9284-dfa37dba2135","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-LGg3xM/checkout/benchmark/fixtures/T2-run-filter/select-comparison-runs.test.mjs"},"output":"<path>/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-LGg3xM/checkout/benchmark/fixtures/T2-run-filter/select-comparison-runs.test.mjs</path>\n<type>file</type>\n<content>\n1: import assert from \"node:assert/strict\";\n2: import test from \"node:test\";\n3: \n4: import { selectComparisonRuns } from \"./select-comparison-runs.mjs\";\n5: \n6: test(\"keeps only completed, accepted, comparison-eligible runs\", () => {\n7:   const accepted = {\n8:     id: \"accepted\",\n9:     status: \"complete\",\n10:     acceptance_status: \"pass\",\n11:     comparison_eligible: true,\n12:   };\n13: \n14:   const runs = [\n15:     accepted,\n16:     {\n17:       id: \"failed-checks\",\n18:       status: \"complete\",\n19:       acceptance_status: \"fail\",\n20:       comparison_eligible: true,\n21:     },\n22:     {\n23:       id: \"interrupted\",\n24:       status: \"failed\",\n25:       acceptance_status: \"pass\",\n26:       comparison_eligible: true,\n27:     },\n28:     {\n29:       id: \"excluded\",\n30:       status: \"complete\",\n31:       acceptance_status: \"pass\",\n32:       comparison_eligible: false,\n33:     },\n34:   ];\n35: \n36:   assert.deepEqual(selectComparisonRuns(runs), [accepted]);\n37: });\n38: \n39: test(\"preserves input order, object identity, and the input array\", () => {\n40:   const first = {\n41:     id: \"first\",\n42:     status: \"complete\",\n43:     acceptance_status: \"pass\",\n44:   };\n45:   const second = {\n46:     id: \"second\",\n47:     status: \"complete\",\n48:     acceptance_status: \"pass\",\n49:     comparison_eligible: true,\n50:   };\n51:   const runs = Object.freeze([first, second]);\n52: \n53:   const result = selectComparisonRuns(runs);\n54: \n55:   assert.deepEqual(result, [first, second]);\n56:   assert.equal(result[0], first);\n57:   assert.equal(result[1], second);\n58:   assert.notEqual(result, runs);\n59: });\n\n(End of file - total 59 lines)\n</content>","metadata":{"preview":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { selectComparisonRuns } from \"./select-comparison-runs.mjs\";\n\ntest(\"keeps only completed, accepted, comparison-eligible runs\", () => {\n  const accepted = {\n    id: \"accepted\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    comparison_eligible: true,\n  };\n\n  const runs = [\n    accepted,\n    {\n      id: \"failed-checks\",\n      status: \"complete\",\n      acceptance_status: \"fail\",\n      comparison_eligible: true,","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-LGg3xM/checkout/benchmark/fixtures/T2-run-filter/select-comparison-runs.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { selectComparisonRuns } from \"./select-comparison-runs.mjs\";\n\ntest(\"keeps only completed, accepted, comparison-eligible runs\", () => {\n  const accepted = {\n    id: \"accepted\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    comparison_eligible: true,\n  };\n\n  const runs = [\n    accepted,\n    {\n      id: \"failed-checks\",\n      status: \"complete\",\n      acceptance_status: \"fail\",\n      comparison_eligible: true,\n    },\n    {\n      id: \"interrupted\",\n      status: \"failed\",\n      acceptance_status: \"pass\",\n      comparison_eligible: true,\n    },\n    {\n      id: \"excluded\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      comparison_eligible: false,\n    },\n  ];\n\n  assert.deepEqual(selectComparisonRuns(runs), [accepted]);\n});\n\ntest(\"preserves input order, object identity, and the input array\", () => {\n  const first = {\n    id: \"first\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n  };\n  const second = {\n    id: \"second\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    comparison_eligible: true,\n  };\n  const runs = Object.freeze([first, second]);\n\n  const result = selectComparisonRuns(runs);\n\n  assert.deepEqual(result, [first, second]);\n  assert.equal(result[0], first);\n  assert.equal(result[1], second);\n  assert.notEqual(result, runs);\n});","lineStart":1,"lineEnd":59,"totalLines":59,"truncated":false}},"title":"benchmark/fixtures/T2-run-filter/select-comparison-runs.test.mjs","time":{"start":1787490900320,"end":1787490900326}},"id":"prt_02ec2995a001a9fARSUwoODE94","sessionID":"ses_fd13d8cacffehrzmGt11M7KId3","messageID":"msg_02ec27424001hecoIX8D26EV0X"}}
