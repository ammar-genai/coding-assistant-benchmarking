+
+  await projector.project(created());
+  await assert.rejects(
+    projector.project(amended("trade-1", 2, { notional: -5, owner: "desk-b" })),
+    TypeError,
+    "AMENDED must leave a valid complete state",
+  );
+  assert.equal(projector.getSnapshot("trade-1").notional, 100);
+});
+
+test("returned states and snapshots are immutable copies", async () => {
+  const stored = [];
+  const projector = createEventProjector(async (_tradeId, state) => {
+    stored.push(state);
+  });
+
+  const result = await projector.project(created());
+  result.notional = 999999;
+  result.owner = "tampered";
+  const snapshot = projector.getSnapshot("trade-1");
+  snapshot.notional = 42;
+
+  assert.deepEqual(projector.getSnapshot("trade-1"), {
+    tradeId: "trade-1",
+    version: 1,
+    status: "active",
+    notional: 100,
+    owner: "desk-a",
+  });
+  stored[0].notional = 1;
+  stored[0].owner = "tampered";
+  assert.equal(projector.getSnapshot("trade-1").notional, 100, "the store must receive a copy");
 });
