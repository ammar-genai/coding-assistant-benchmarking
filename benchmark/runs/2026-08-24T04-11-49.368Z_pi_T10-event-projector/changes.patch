-// Replace this placeholder with at least four meaningful node:test cases.
 import assert from "node:assert/strict";
 import test from "node:test";
 
-test("replace this placeholder with projector regression tests", () => {
-  assert.fail("Add at least four meaningful tests");
+import { createEventProjector } from "./event-projector.mjs";
+
+const created = (tradeId = "trade-1") => ({
+  tradeId,
+  version: 1,
+  type: "CREATED",
+  payload: { notional: 100, owner: "desk-a" },
+});
+
+const amended = (tradeId, version, payload) => ({ tradeId, version, type: "AMENDED", payload });
+
+test("different trades progress concurrently while one trade is blocked in the store", async () => {
+  let releaseA;
+  const gateA = new Promise((resolve) => {
+    releaseA = resolve;
+  });
+  const persisted = [];
+  const projector = createEventProjector(async (tradeId) => {
+    if (tradeId === "trade-a") await gateA;
+    persisted.push(tradeId);
+  });
+
+  const projectA = projector.project(created("trade-a"));
+  await new Promise((resolve) => setImmediate(resolve));
+
+  const projectB = projector.project(created("trade-b"));
+  await projectB;
+  assert.deepEqual(persisted, ["trade-b"], "trade-b must not be held behind trade-a");
+
+  releaseA();
+  await projectA;
+  assert.deepEqual(persisted, ["trade-b", "trade-a"]);
+});
+
+test("duplicate and stale versions return the current snapshot without persisting", async () => {
+  let storeCalls = 0;
+  const projector = createEventProjector(async () => {
+    storeCalls += 1;
+  });
+
+  await projector.project(created());
+  const duplicate = await projector.project(created());
+  await projector.project(amended("trade-1", 2, { notional: 125 }));
+  const stale = await projector.project(amended("trade-1", 2, { notional: 999 }));
+
+  assert.equal(storeCalls, 2, "only the two accepted events may be persisted");
+  assert.deepEqual(duplicate, {
+    tradeId: "trade-1",
+    version: 1,
+    status: "active",
+    notional: 100,
+    owner: "desk-a",
+  });
+  assert.deepEqual(stale, projector.getSnapshot("trade-1"));
+  assert.equal(projector.getSnapshot("trade-1").notional, 125);
+});
+
+test("version gaps and invalid first events reject without changing state", async () => {
+  const projector = createEventProjector(async () => {});
+
+  await assert.rejects(projector.project(amended("trade-1", 1, { notional: 50 })), RangeError);
+  await assert.rejects(projector.project({ ...created("trade-2"), version: 2 }), RangeError);
+  assert.equal(projector.getSnapshot("trade-1"), null);
+  assert.equal(projector.getSnapshot("trade-2"), null);
+
+  await projector.project(created());
+  await assert.rejects(projector.project(amended("trade-1", 3, { notional: 50 })), RangeError);
+  assert.equal(projector.getSnapshot("trade-1").version, 1);
+});
+
+test("a cancelled trade is terminal", async () => {
+  const projector = createEventProjector(async () => {});
+  await projector.project(created());
+  await projector.project({ tradeId: "trade-1", version: 2, type: "CANCELLED", payload: {} });
+  assert.equal(projector.getSnapshot("trade-1").status, "cancelled");
+
+  await assert.rejects(projector.project(amended("trade-1", 3, { notional: 1 })), /cancelled/);
+  const snap = projector.getSnapshot("trade-1");
+  assert.equal(snap.status, "cancelled");
+  assert.equal(snap.version, 2);
+});
+
+test("a store rejection leaves state unchanged and does not block the same or other trades", async () => {
+  const failures = new Set(["trade-1:v2"]);
+  const projector = createEventProjector(async (tradeId, state) => {
+    if (failures.has(`${tradeId}:v${state.version}`)) {
+      failures.delete(`${tradeId}:v${state.version}`);
+      throw new Error("temporary store failure");
+    }
+  });
+
+  await projector.project(created());
+  await assert.rejects(projector.project(amended("trade-1", 2, { notional: 50 })), /temporary store failure/);
+  assert.equal(projector.getSnapshot("trade-1").version, 1, "failed event must not commit state");
