+  const retry = projector.project(amended("trade-1", 2, { notional: 50 }));
+  const other = projector.project(created("trade-2"));
+  await Promise.all([retry, other]);
+  assert.equal(projector.getSnapshot("trade-1").notional, 50);
+  assert.equal(projector.getSnapshot("trade-2").version, 1);
+});
+
+test("malformed events and payloads reject with TypeError", async () => {
+  const projector = createEventProjector(async () => {});
+
+  await assert.rejects(projector.project(null), TypeError);
+  await assert.rejects(projector.project({ ...created(), type: "SETTLED" }), TypeError);
+  await assert.rejects(projector.project({ ...created(), version: 1.5 }), TypeError);
+  await assert.rejects(
+    projector.project({ tradeId: "trade-1", version: 1, type: "CREATED", payload: { notional: 0, owner: "desk-a" } }),
+    TypeError,
