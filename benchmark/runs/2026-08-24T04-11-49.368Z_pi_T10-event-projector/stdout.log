{"type":"message_update","usage":{"input":6063,"output":1755,"cacheRead":3136,"cacheWrite":0,"reasoning":8,"totalTokens":10954,"cost":{"input":0.00272835,"output":0.005616,"cacheRead":0.00015680000000000002,"cacheWrite":0,"total":0.00850115}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"chatcmpl-tool-ac73328deac0f7d4","name":"write","arguments":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createEventProjector } from \"./event-projector.mjs\";\n\nconst created = (tradeId = \"trade-1\") => ({\n  tradeId,\n  version: 1,\n  type: \"CREATED\",\n  payload: { notional: 100, owner: \"desk-a\" },\n});\n\nconst amended = (tradeId, version, payload) => ({ tradeId, version, type: \"AMENDED\", payload });\n\ntest(\"different trades progress concurrently while one trade is blocked in the store\", async () => {\n  let releaseA;\n  const gateA = new Promise((resolve) => {\n    releaseA = resolve;\n  });\n  const persisted = [];\n  const projector = createEventProjector(async (tradeId) => {\n    if (tradeId === \"trade-a\") await gateA;\n    persisted.push(tradeId);\n  });\n\n  const projectA = projector.project(created(\"trade-a\"));\n  await new Promise((resolve) => setImmediate(resolve));\n\n  const projectB = projector.project(created(\"trade-b\"));\n  await projectB;\n  assert.deepEqual(persisted, [\"trade-b\"], \"trade-b must not be held behind trade-a\");\n\n  releaseA();\n  await projectA;\n  assert.deepEqual(persisted, [\"trade-b\", \"trade-a\"]);\n});\n\ntest(\"duplicate and stale versions return the current snapshot without persisting\", async () => {\n  let storeCalls = 0;\n  const projector = createEventProjector(async () => {\n    storeCalls += 1;\n  });\n\n  await projector.project(created());\n  const duplicate = await projector.project(created());\n  await projector.project(amended(\"trade-1\", 2, { notional: 125 }));\n  const stale = await projector.project(amended(\"trade-1\", 2, { notional: 999 }));\n\n  assert.equal(storeCalls, 2, \"only the two accepted events may be persisted\");\n  assert.deepEqual(duplicate, {\n    tradeId: \"trade-1\",\n    version: 1,\n    status: \"active\",\n    notional: 100,\n    owner: \"desk-a\",\n  });\n  assert.deepEqual(stale, projector.getSnapshot(\"trade-1\"));\n  assert.equal(projector.getSnapshot(\"trade-1\").notional, 125);\n});\n\ntest(\"version gaps and invalid first events reject without changing state\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(projector.project(amended(\"trade-1\", 1, { notional: 50 })), RangeError);\n  await assert.rejects(projector.project(created(\"trade-2\") && { ...created(\"trade-2\"), version: 2 }), RangeError);\n  assert.equal(projector.getSnapshot(\"trade-1\"), null);\n  assert.equal(projector.getSnapshot(\"trade-2\"), null);\n\n  await projector.project(created());\n  await assert.rejects(projector.project(amended(\"trade-1\", 3, { notional: 50 })), RangeError);\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 1);\n});\n\ntest(\"a cancelled trade is terminal\", async () => {\n  const projector = createEventProjector(async () => {});\n  await projector.project(created());\n  await projector.project({ tradeId: \"trade-1\", version: 2, type: \"CANCELLED\", payload: {} });\n  assert.equal(projector.getSnapshot(\"trade-1\").status, \"cancelled\");\n\n  await assert.rejects(projector.project(amended(\"trade-1\", 3, { notional: 1 })), /cancelled/);\n  const snap = projector.getSnapshot(\"trade-1\");\n  assert.equal(snap.status, \"cancelled\");\n  assert.equal(snap.version, 2);\n});\n\ntest(\"a store rejection leaves state unchanged and does not block the same or other trades\", async () => {\n  const failures = new Set([\"trade-1:v2\"]);\n  const projector = createEventProjector(async (tradeId, state) => {\n    if (failures.has(`${tradeId}:v${state.version}`)) {\n      throw new Error(\"temporary store failure\");\n    }\n  });\n\n  await projector.project(created());\n  await assert.rejects(projector.project(amended(\"trade-1\", 2, { notional: 50 })), /temporary store failure/);\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 1, \"failed event must not commit state\");\n\n  const retry = projector.project(amended(\"trade-1\", 2, { notional: 50 }));\n  const other = projector.project(created(\"trade-2\"));\n  await Promise.all([retry, other]);\n  assert.equal(projector.getSnapshot(\"trade-1\").notional, 50);\n  assert.equal(projector.getSnapshot(\"trade-2\").version, 1);\n});\n\ntest(\"malformed events and payloads reject with TypeError\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(projector.project(null), TypeError);\n  await assert.rejects(projector.project({ ...created(), type: \"SETTLED\" }), TypeError);\n  await assert.rejects(projector.project({ ...created(), version: 1.5 }), TypeError);\n  await assert.rejects(\n    projector.project({ tradeId: \"trade-1\", version: 1, type: \"CREATED\", payload: { notional: 0, owner: \"desk-a\" } }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project({ tradeId: \"trade-1\", version: 1, type: \"CREATED\", payload: { notional: Number.NaN, owner: \"desk-a\" } }),\n    TypeError,\n  );\n  await assert.rejects(\n    projector.project({ tradeId: \"trade-1\", version: 1, type: \"CREATED\", payload: { notional: 100, owner: \"\" } }),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\"), null);\n\n  await projector.project(created());\n  await assert.rejects(\n    projector.project(amended(\"trade-1\", 2, { notional: -5, owner: \"desk-b\" })),\n    TypeError,\n    \"AMENDED must leave a valid complete state\",\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\").notional, 100);\n});\n\ntest(\"returned states and snapshots are immutable copies\", async () => {\n  const stored = [];\n  const projector = createEventProjector(async (_tradeId, state) => {\n    stored.push(state);\n  });\n\n  const result = await projector.project(created());\n  result.notional = 999999;\n  result.owner = \"tampered\";\n  const snapshot = projector.getSnapshot(\"trade-1\");\n  snapshot.notional = 42;\n\n  assert.deepEqual(projector.getSnapshot(\"trade-1\"), {\n    tradeId: \"trade-1\",\n    version: 1,\n    status: \"active\",\n    notional: 100,\n    owner: \"desk-a\",\n  });\n  stored[0].notional = 1;\n  stored[0].owner = \"tampered\";\n  assert.equal(projector.getSnapshot(\"trade-1\").notional, 100, \"the store must receive a copy\");\n});\n","path":"benchmark/fixtures/T10-event-projector/student-tests.mjs"}}}}
