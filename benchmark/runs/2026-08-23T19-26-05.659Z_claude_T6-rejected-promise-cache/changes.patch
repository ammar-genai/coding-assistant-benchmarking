+import { ConfigOriginError, createConfigCache } from "./config-cache.mjs";
+
+const CONFIG = Object.freeze({ version: "v1", features: Object.freeze(["search"]) });
+
+test("removes a failed load from the cache so the next read retries", async () => {
+  let calls = 0;
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    if (calls === 1) {
+      throw new ConfigOriginError("origin timeout");
+    }
+    return CONFIG;
+  });
+
+  await assert.rejects(cache.getConfig("acme"), ConfigOriginError);
+  assert.equal(cache.size(), 0);
+  assert.deepEqual(await cache.getConfig("acme"), CONFIG);
+  assert.equal(calls, 2);
+});
+
+test("shares one failure among concurrent waiters and retries on the next read", async () => {
+  let calls = 0;
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    throw new ConfigOriginError(`failure #${calls}`);
+  });
+
+  const first = cache.getConfig("acme").catch((error) => error);
+  const second = cache.getConfig("acme").catch((error) => error);
+  const [err1, err2] = await Promise.all([first, second]);
+
+  assert.equal(err1, err2);
+  assert.equal(err1.message, "failure #1");
+  assert.equal(calls, 1);
+
+  await assert.rejects(cache.getConfig("acme"), ConfigOriginError);
+  assert.equal(calls, 2);
+});
+
+test("a late failure from a replaced load does not evict the replacement", async () => {
+  function createDeferred() {
+    let resolve;
+    let reject;
+    const promise = new Promise((res, rej) => {
+      resolve = res;
+      reject = rej;
+    });
+    return { promise, resolve, reject };
+  }
+
+  const firstLoad = createDeferred();
+  const secondLoad = createDeferred();
+  let calls = 0;
+  const cache = createConfigCache(() => {
+    calls += 1;
+    return calls === 1 ? firstLoad.promise : secondLoad.promise;
+  });
+
+  const firstRequest = cache.getConfig("acme").catch(() => undefined);
+  await Promise.resolve();
+  cache.clear("acme");
+
+  const secondRequest = cache.getConfig("acme");
+  await Promise.resolve();
+  secondLoad.resolve(CONFIG);
+  assert.deepEqual(await secondRequest, CONFIG);
+  assert.equal(cache.size(), 1);
+
+  firstLoad.reject(new ConfigOriginError("late failure"));
+  await firstRequest;
+
+  assert.deepEqual(await cache.getConfig("acme"), CONFIG);
+  assert.equal(calls, 2);
