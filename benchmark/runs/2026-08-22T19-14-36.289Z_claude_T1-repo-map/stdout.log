{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_31r95nrg","type":"tool_result","content":"1\timport { env } from \"cloudflare:workers\";\n2\timport { drizzle } from \"drizzle-orm/d1\";\n3\timport * as schema from \"./schema\";\n4\t\n5\texport function getDb() {\n6\t  const bindings = env as unknown as { DB?: D1Database };\n7\t\n8\t  if (!bindings.DB) {\n9\t    throw new Error(\n10\t      \"Cloudflare D1 binding `DB` is unavailable. Set the `d1` field in .openai/hosting.json to `DB` or let your control plane inject the real binding values before using the database.\"\n11\t    );\n12\t  }\n13\t\n14\t  return drizzle(bindings.DB, { schema });\n15\t}\n16\t"}]},"parent_tool_use_id":null,"session_id":"84820143-4cfe-427a-81c0-b26fa7bef41e","uuid":"e9a91cce-7403-41c5-9f21-cc7a3679ea46","timestamp":"2026-08-22T19:14:44.167Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ammarbinayaz/Documents/coding-assistant-benchmarking/db/index.ts","content":"import { env } from \"cloudflare:workers\";\nimport { drizzle } from \"drizzle-orm/d1\";\nimport * as schema from \"./schema\";\n\nexport function getDb() {\n  const bindings = env as unknown as { DB?: D1Database };\n\n  if (!bindings.DB) {\n    throw new Error(\n      \"Cloudflare D1 binding `DB` is unavailable. Set the `d1` field in .openai/hosting.json to `DB` or let your control plane inject the real binding values before using the database.\"\n    );\n  }\n\n  return drizzle(bindings.DB, { schema });\n}\n","numLines":16,"startLine":1,"totalLines":16}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_bnvx6jw4","type":"tool_result","content":"1\t/** Cloudflare Worker entry point for the vinext-starter template. */\n2\timport { handleImageOptimization, DEFAULT_DEVICE_SIZES, DEFAULT_IMAGE_SIZES } from \"vinext/server/image-optimization\";\n3\timport handler from \"vinext/server/app-router-entry\";\n4\t\n5\tinterface Env {\n6\t  ASSETS: Fetcher;\n7\t  DB: D1Database;\n8\t  IMAGES: {\n9\t    input(stream: ReadableStream): {\n10\t      transform(options: Record<string, unknown>): {\n11\t        output(options: { format: string; quality: number }): Promise<{ response(): Response }>;\n12\t      };\n13\t    };\n14\t  };\n15\t}\n16\t\n17\tinterface ExecutionContext {\n18\t  waitUntil(promise: Promise<unknown>): void;\n19\t  passThroughOnException(): void;\n20\t}\n21\t\n22\t// Image security config. SVG sources with .svg extension auto-skip the\n23\t// optimization endpoint on the client side (served directly, no proxy).\n24\t// To route SVGs through the optimizer (with security headers), set\n25\t// dangerouslyAllowSVG: true in next.config.js and uncomment below:\n26\t// const imageConfig: ImageConfig = { dangerouslyAllowSVG: true };\n27\t\n28\tconst worker = {\n29\t  async fetch(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {\n30\t    const url = new URL(request.url);\n31\t\n32\t    if (url.pathname === \"/_vinext/image\") {\n33\t      const allowedWidths = [...DEFAULT_DEVICE_SIZES, ...DEFAULT_IMAGE_SIZES];\n34\t      return handleImageOptimization(request, {\n35\t        fetchAsset: (path) => env.ASSETS.fetch(new Request(new URL(path, request.url))),\n36\t        transformImage: async (body, { width, format, quality }) => {\n37\t          const result = await env.IMAGES.input(body).transform(width > 0 ? { width } : {}).output({ format, quality });\n38\t          return result.response();\n39\t        },\n40\t      }, allowedWidths);\n41\t    }\n42\t\n43\t    return handler.fetch(request, env, ctx);\n44\t  },\n45\t};\n46\t\n47\texport default worker;\n48\t"}]},"parent_tool_use_id":null,"session_id":"84820143-4cfe-427a-81c0-b26fa7bef41e","uuid":"2329c164-c6ec-46f9-bb96-ff45f89ecf0c","timestamp":"2026-08-22T19:14:44.168Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ammarbinayaz/Documents/coding-assistant-benchmarking/worker/index.ts","content":"/** Cloudflare Worker entry point for the vinext-starter template. */\nimport { handleImageOptimization, DEFAULT_DEVICE_SIZES, DEFAULT_IMAGE_SIZES } from \"vinext/server/image-optimization\";\nimport handler from \"vinext/server/app-router-entry\";\n\ninterface Env {\n  ASSETS: Fetcher;\n  DB: D1Database;\n  IMAGES: {\n    input(stream: ReadableStream): {\n      transform(options: Record<string, unknown>): {\n        output(options: { format: string; quality: number }): Promise<{ response(): Response }>;\n      };\n    };\n  };\n}\n\ninterface ExecutionContext {\n  waitUntil(promise: Promise<unknown>): void;\n  passThroughOnException(): void;\n}\n\n// Image security config. SVG sources with .svg extension auto-skip the\n// optimization endpoint on the client side (served directly, no proxy).\n// To route SVGs through the optimizer (with security headers), set\n// dangerouslyAllowSVG: true in next.config.js and uncomment below:\n// const imageConfig: ImageConfig = { dangerouslyAllowSVG: true };\n\nconst worker = {\n  async fetch(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {\n    const url = new URL(request.url);\n\n    if (url.pathname === \"/_vinext/image\") {\n      const allowedWidths = [...DEFAULT_DEVICE_SIZES, ...DEFAULT_IMAGE_SIZES];\n      return handleImageOptimization(request, {\n        fetchAsset: (path) => env.ASSETS.fetch(new Request(new URL(path, request.url))),\n        transformImage: async (body, { width, format, quality }) => {\n          const result = await env.IMAGES.input(body).transform(width > 0 ? { width } : {}).output({ format, quality });\n          return result.response();\n        },\n      }, allowedWidths);\n    }\n\n    return handler.fetch(request, env, ctx);\n  },\n};\n\nexport default worker;\n","numLines":48,"startLine":1,"totalLines":48}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_90232gok","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useEffect, useMemo, useState } from \"react\";\n4\t\n5\tconst assistantCards = [\n6\t  {\n7\t    name: \"Codex\",\n8\t    role: \"Primary assistant\",\n9\t    mark: \"CX\",\n10\t    summary:\n11\t      \"Use it for the strongest OpenAI-native workflow: planning, implementation, parallel subagents, review, browser checks, and long-running work.\",\n12\t    test: \"App and CLI flow, worktrees, custom agents, skills, plugins, MCP, hooks, approvals, structured non-interactive output.\",\n13\t  },\n14\t  {\n15\t    name: \"Claude Code\",\n16\t    role: \"Primary assistant\",\n17\t    mark: \"CC\",\n18\t    summary:\n19\t      \"Use it for Anthropic-native coding, long tasks, careful planning, and its mature set of subagents, teams, hooks, MCP, and plugins.\",\n20\t    test: \"Plan mode, subagents, agent view, agent teams, worktrees, plugin marketplace, hooks, MCP, permissions, print/JSON mode.\",\n21\t  },\n22\t  {\n23\t    name: \"OpenCode\",\n24\t    role: \"Primary assistant\",\n25\t    mark: \"OC\",\n26\t    summary:\n27\t      \"Use it as the provider-flexible assistant. It is the cleanest place to compare local, cloud, and paid models without changing your daily interface.\",\n28\t    test: \"Provider switching, Ollama discovery, agents, skills, MCP, plugins, permissions, session handling, run/server modes.\",\n29\t  },\n30\t  {\n31\t    name: \"Pi\",\n32\t    role: \"Neutral lab bench\",\n33\t    mark: \"PI\",\n34\t    summary:\n35\t      \"Use Pi to compare models inside one minimal harness. It supports your OpenAI and Anthropic subscriptions plus custom local providers.\",\n36\t    test: \"Model portability, extensions, skills, packages, JSON/RPC/SDK modes, session branching, and the cost of adding missing controls.\",\n37\t  },\n38\t];\n39\t\n40\tconst modelRows = [\n41\t  {\n42\t    model: \"GPT-5.6 Sol\",\n43\t    maker: \"OpenAI\",\n44\t    lane: \"Frontier\",\n45\t    access: \"Codex subscription; API optional\",\n46\t    use: \"Top-level planning, hardest fixes, final review\",\n47\t    priority: \"Required\",\n48\t  },\n49\t  {\n50\t    model: \"GPT-5.6 Terra\",\n51\t    maker: \"OpenAI\",\n52\t    lane: \"Efficient frontier\",\n53\t    access: \"Codex subscription where listed; API optional\",\n54\t    use: \"Exploration, review, medium-complexity worker\",\n55\t    priority: \"Required\",\n56\t  },\n57\t  {\n58\t    model: \"GPT-5.6 Luna\",\n59\t    maker: \"OpenAI\",\n60\t    lane: \"Low cost\",\n61\t    access: \"API or catalog access\",\n62\t    use: \"Simple scans, formatting, repetitive checks\",\n63\t    priority: \"Optional\",\n64\t  },\n65\t  {\n66\t    model: \"Claude Opus 5\",\n67\t    maker: \"Anthropic\",\n68\t    lane: \"Frontier\",\n69\t    access: \"Claude subscription, plan dependent\",\n70\t    use: \"Top-level planning, long work, difficult review\",\n71\t    priority: \"Required\",\n72\t  },\n73\t  {\n74\t    model: \"Claude Sonnet 5\",\n75\t    maker: \"Anthropic\",\n76\t    lane: \"Workhorse\",\n77\t    access: \"Claude Code subscription\",\n78\t    use: \"Daily coding baseline and moderate workers\",\n79\t    priority: \"Required\",\n80\t  },\n81\t  {\n82\t    model: \"Claude Fable 5\",\n83\t    maker: \"Anthropic\",\n84\t    lane: \"Frontier ceiling\",\n85\t    access: \"Usage credits / account availability\",\n86\t    use: \"One or two hardest runs only\",\n87\t    priority: \"Stretch\",\n88\t  },\n89\t  {\n90\t    model: \"Claude Haiku 4.5\",\n91\t    maker: \"Anthropic\",\n92\t    lane: \"Low cost\",\n93\t    access: \"API or subscription catalog\",\n94\t    use: \"Fast small worker and parallel scans\",\n95\t    priority: \"Optional\",\n96\t  },\n97\t  {\n98\t    model: \"Qwen3 Coder 480B Cloud\",\n99\t    maker: \"Qwen\",\n100\t    lane: \"Hosted open weight\",\n101\t    access: \"Ollama Cloud\",\n102\t    use: \"Optional third hosted coding model after the pilot\",\n103\t    priority: \"Optional\",\n104\t  },\n105\t  {\n106\t    model: \"Kimi K2.7 Code\",\n107\t    maker: \"Moonshot AI\",\n108\t    lane: \"Hosted open weight\",\n109\t    access: \"Ollama Cloud\",\n110\t    use: \"Long coding tasks and tool-heavy worker runs\",\n111\t    priority: \"Required\",\n112\t  },\n113\t  {\n114\t    model: \"DeepSeek V4 Flash\",\n115\t    maker: \"DeepSeek\",\n116\t    lane: \"Hosted open weight\",\n117\t    access: \"Ollama Cloud\",\n118\t    use: \"Long-context and cost-aware worker runs\",\n119\t    priority: \"Required\",\n120\t  },\n121\t  {\n122\t    model: \"Qwen3 8B\",\n123\t    maker: \"Qwen\",\n124\t    lane: \"Small local control\",\n125\t    access: \"Ollama\",\n126\t    use: \"Measure the quality and speed tradeoff of a laptop-sized worker\",\n127\t    priority: \"Optional\",\n128\t  },\n129\t];\n130\t\n131\tconst benchmarkLanes = [\n132\t  {\n133\t    number: \"01\",\n134\t    title: \"Compare the assistants\",\n135\t    lock: \"Keep the model fixed\",\n136\t    body: \"Run deepseek-v4-flash:cloud through Codex, Claude Code, OpenCode, and Pi. The same hosted model avoids turning laptop limits into an assistant advantage.\",\n137\t    runs: \"4 assistants × 4 tasks × 2 runs = 32\",\n138\t    answers: \"Which assistant plans better, uses tools better, stays in scope, recovers from errors, and needs fewer interventions?\",\n139\t  },\n140\t  {\n141\t    number: \"02\",\n142\t    title: \"Compare the models\",\n143\t    lock: \"Keep the assistant fixed\",\n144\t    body: \"Use Pi as the intended neutral harness after access is verified. Test the selected OpenAI and Anthropic models plus DeepSeek, Kimi, and an optional Qwen Cloud model with identical conditions.\",\n145\t    runs: \"7 models × 4 tasks × 2 runs = 56\",\n146\t    answers: \"Which model gives the best quality, time, and cost when the surrounding assistant is unchanged?\",\n147\t  },\n148\t  {\n149\t    number: \"03\",\n150\t    title: \"Compare real daily use\",\n151\t    lock: \"Use each native best pairing\",\n152\t    body: \"Run Codex + Sol, Claude Code + Opus or Sonnet, and OpenCode + the best open model from the pilot on two hard tasks.\",\n153\t    runs: \"3 native pairs × 2 tasks × 1 run = 6\",\n154\t    answers: \"Which full product would you choose when fairness matters less than getting the work done?\",\n155\t  },\n156\t];\n157\t\n158\tconst taskRows = [\n159\t  {\n160\t    id: \"T1\",\n161\t    kind: \"Core\",\n162\t    title: \"Understand an unfamiliar repository\",\n163\t    setup: \"Ask for an architecture map, main request flow, risky areas, and a short change plan. Read-only.\",\n164\t    pass: \"Matches a maintainer-written answer key; cites the right files; makes no edits.\",\n165\t  },\n166\t  {\n167\t    id: \"T2\",\n168\t    kind: \"Core\",\n169\t    title: \"Fix a real bug\",\n170\t    setup: \"Seed one edge-case bug with visible tests and hidden tests. Give only the issue report and reproduction.\",\n171\t    pass: \"All tests pass, the root cause is fixed, and the diff does not include unrelated cleanup.\",\n172\t  },\n173\t  {\n174\t    id: \"T3\",\n175\t    kind: \"Core\",\n176\t    title: \"Build a multi-file feature\",\n177\t    setup: \"Add one API or data feature that needs schema, business logic, validation, tests, and docs.\",\n178\t    pass: \"Acceptance tests pass; error paths work; existing behavior remains stable.\",\n179\t  },\n180\t  {\n181\t    id: \"T4\",\n182\t    kind: \"Core\",\n183\t    title: \"Build and verify a user interface\",\n184\t    setup: \"Provide a screenshot plus written behavior for desktop and mobile. Require keyboard use and browser verification.\",\n185\t    pass: \"Functional checks, visual checks, accessibility checks, and console checks pass.\",\n186\t  },\n187\t  {\n188\t    id: \"T5\",\n189\t    kind: \"Challenge\",\n190\t    title: \"Refactor without changing behavior\",\n191\t    setup: \"Give a large, awkward module and freeze behavior with characterization tests before the refactor.\",\n192\t    pass: \"Same public behavior, smaller clear units, no snapshot churn, and measured complexity improvement.\",\n193\t  },\n194\t  {\n195\t    id: \"T6\",\n196\t    kind: \"Challenge\",\n197\t    title: \"Upgrade a dependency or API\",\n198\t    setup: \"Pin an older library, provide current docs, and require a safe migration with a rollback note.\",\n199\t    pass: \"Build and tests pass; deprecated usage is gone; no unnecessary dependency changes.\",\n200\t  },\n201\t  {\n202\t    id: \"T7\",\n203\t    kind: \"Challenge\",\n204\t    title: \"Investigate an incident and a security flaw\",\n205\t    setup: \"Use a controlled fixture with logs, one vulnerable path, noise, and a safe reproduction.\",\n206\t    pass: \"Finds the real cause, ranks risk correctly, patches it, adds regression tests, and avoids unsafe actions.\",\n207\t  },\n208\t  {\n209\t    id: \"T8\",\n210\t    kind: \"Challenge\",\n211\t    title: \"Repair CI and improve project guidance\",\n212\t    setup: \"Give a broken pipeline, weak README, and missing assistant instructions.\",\n213\t    pass: \"CI passes; setup is reproducible; AGENTS.md is short, specific, and useful across assistants.\",\n214\t  },\n215\t];\n216\t\n217\tconst scoreRows = [\n218\t  [\"Correctness\", \"35\", \"Acceptance tests and hidden tests\"],\n219\t  [\"No regressions\", \"15\", \"Existing tests and behavior stay intact\"],\n220\t  [\"Scope discipline\", \"10\", \"Only necessary files and changes\"],\n221\t  [\"Code quality\", \"10\", \"Clear, maintainable, and consistent with the repo\"],\n222\t  [\"Autonomy\", \"8\", \"Few human corrections or repeated instructions\"],\n223\t  [\"Tool and safety discipline\", \"7\", \"Good permission choices; no risky shortcuts\"],\n224\t  [\"Time\", \"5\", \"Time to an accepted result, not time to first answer\"],\n225\t  [\"Usage or cost\", \"5\", \"Tokens, subscription quota, cloud units, or local energy proxy\"],\n226\t  [\"Explanation\", \"5\", \"Accurate summary, verification, and remaining risks\"],\n227\t];\n228\t\n229\tconst extensionRows = [\n230\t  {\n231\t    surface: \"Project rules\",\n232\t    common: \"Keep AGENTS.md as the single source. Claude's CLAUDE.md should import it with @AGENTS.md.\",\n233\t    measure: \"Rule following and context size\",\n234\t  },\n235\t  {\n236\t    surface: \"Skills\",\n237\t    common: \"Reuse one small SKILL.md workflow through each assistant's discovery path.\",\n238\t    measure: \"Portability, setup time, and quality gain\",\n239\t  },\n240\t  {\n241\t    surface: \"MCP\",\n242\t    common: \"Configure the same read-only docs or issue-tracker server in each assistant.\",\n243\t    measure: \"Connection reliability, tool accuracy, permission clarity\",\n244\t  },\n245\t  {\n246\t    surface: \"Hooks and guards\",\n247\t    common: \"Apply the same policy: block secrets, format changed files, and run a focused check after edits.\",\n248\t    measure: \"Coverage, false blocks, debuggability\",\n249\t  },\n250\t  {\n251\t    surface: \"Plugins and extensions\",\n252\t    common: \"Package the rule, skill, tool, and guard only after the loose version works.\",\n253\t    measure: \"Install, update, permissions, versioning, and removal\",\n254\t  },\n255\t];\n256\t\n257\tconst stages = [\n258\t  {\n259\t    id: \"stage-0\",\n260\t    week: \"Day 1\",\n261\t    title: \"Freeze the study\",\n262\t    goal: \"Write the question before seeing results.\",\n263\t    items: [\n264\t      \"Create STUDY.md with the three comparison lanes, the scorecard, and your stop rules.\",\n265\t      \"Record machine, operating system, RAM/VRAM, assistant versions, model IDs, and subscription tier.\",\n266\t      \"Turn off auto-updates for the study window where practical, or record every update as a new study block.\",\n267\t      \"Set a hard optional-spend cap. Start with subscriptions and Ollama; add paid API runs only after the pilot.\",\n268\t    ],\n269\t  },\n270\t  {\n271\t    id: \"stage-1\",\n272\t    week: \"Days 2–4\",\n273\t    title: \"Build the task pack\",\n274\t    goal: \"Make the result gradeable without model judgment.\",\n275\t    items: [\n276\t      \"Prepare T1–T4 first. Use small real repositories or frozen fixtures with clean reset commits.\",\n277\t      \"Write visible acceptance criteria and separate hidden tests before any assistant sees the task.\",\n278\t      \"Create one prompt per task. Do not mention the assistant or model name inside the prompt.\",\n279\t      \"Manually solve each task once so you know it is possible and know the expected effort.\",\n280\t    ],\n281\t  },\n282\t  {\n283\t    id: \"stage-2\",\n284\t    week: \"Days 5–7\",\n285\t    title: \"Build the runner\",\n286\t    goal: \"Capture the same evidence for every run.\",\n287\t    items: [\n288\t      \"Start each run from the same Git commit in its own worktree.\",\n289\t      \"Wrap codex exec, claude -p, opencode run, and Pi print/JSON mode behind one run command.\",\n290\t      \"Save prompt, settings, stdout, stderr, event log, patch, tests, elapsed time, interventions, and final answer.\",\n291\t      \"Use a run ID and never overwrite a prior run.\",\n292\t    ],\n293\t  },\n294\t  {\n295\t    id: \"stage-3\",\n296\t    week: \"Week 2\",\n297\t    title: \"Run the 28-run pilot\",\n298\t    goal: \"Find broken tasks and weak candidates cheaply.\",\n299\t    items: [\n300\t      \"Assistant pilot: 4 assistants × T1 and T2 × 1 run = 8.\",\n301\t      \"Model pilot: 7 models in Pi × T1 and T2 × 1 run = 14.\",\n302\t      \"Native pilot: 3 native pairings × T1 and T2 × 1 run = 6.\",\n303\t      \"Fix the harness, prompts, or hidden tests only if the issue affects everyone. Version every change.\",\n304\t    ],\n305\t  },\n306\t  {\n307\t    id: \"stage-4\",\n308\t    week: \"Weeks 3–4\",\n309\t    title: \"Complete the 94-run core study\",\n310\t    goal: \"Collect repeatable evidence, not impressions.\",\n311\t    items: [\n312\t      \"Complete the assistant lane: 32 total runs across T1–T4.\",\n313\t      \"Complete the model lane: 56 total runs across T1–T4.\",\n314\t      \"Complete the native lane: 6 runs on two challenge tasks.\",\n315\t      \"Randomize run order, clear sessions, restore the repository, and grade before revealing model identity where possible.\",\n316\t    ],\n317\t  },\n318\t  {\n319\t    id: \"stage-5\",\n320\t    week: \"Week 5\",\n321\t    title: \"Test the extension ecosystems\",\n322\t    goal: \"Measure what customization actually buys you.\",\n323\t    items: [\n324\t      \"Run one task with no extensions, then with a shared rule, one skill, one MCP server, and one safety guard.\",\n325\t      \"Record install time, failures, context overhead, permission prompts, and whether the extension improved the final score.\",\n326\t      \"Treat skills and MCP as portable building blocks. Treat plugin packaging and hooks as assistant-specific.\",\n327\t      \"Do not install a large plugin bundle until you have reviewed its code, permissions, and external connections.\",\n328\t    ],\n329\t  },\n330\t  {\n331\t    id: \"stage-6\",\n332\t    week: \"Week 6\",\n333\t    title: \"Run the distributed project\",\n334\t    goal: \"Prove that a frontier planner can direct smaller workers.\",\n335\t    items: [\n336\t      \"Use GPT-5.6 Sol as the first lead. Repeat once with Claude Opus 5 as lead.\",\n337\t      \"Give each worker a separate worktree, owned files, acceptance tests, and a machine-readable task file.\",\n338\t      \"Use DeepSeek for a bounded implementation, Kimi or Qwen Cloud for a larger worker task, and Terra or Sonnet for the difficult middle layer.\",\n339\t      \"Use the other vendor's frontier model as final reviewer, then run all tests and make the merge decision yourself.\",\n340\t    ],\n341\t  },\n342\t  {\n343\t    id: \"stage-7\",\n344\t    week: \"Final 2 days\",\n345\t    title: \"Analyze and publish\",\n346\t    goal: \"Make the conclusion honest and reusable.\",\n347\t    items: [\n348\t      \"Report medians and ranges; show every failure and intervention, not only the best run.\",\n349\t      \"Separate assistant effects, model effects, and native-pair results in the report.\",\n350\t      \"Write recommendations by task type: best planner, best daily driver, best local worker, best value, best extension system.\",\n351\t      \"Publish prompts, task versions, runner code, scoring rules, and raw results where licenses and privacy allow.\",\n352\t    ],\n353\t  },\n354\t];\n355\t\n356\tconst sources = [\n357\t  [\"OpenAI model guidance\", \"https://developers.openai.com/api/docs/guides/latest-model\"],\n358\t  [\"OpenAI model catalog\", \"https://developers.openai.com/api/docs/models\"],\n359\t  [\"Claude Code parallel agents\", \"https://code.claude.com/docs/en/agents\"],\n360\t  [\"Claude Code extension map\", \"https://code.claude.com/docs/en/features-overview\"],\n361\t  [\"Claude Code plugins\", \"https://code.claude.com/docs/en/plugins\"],\n362\t  [\"OpenCode providers\", \"https://opencode.ai/docs/providers\"],\n363\t  [\"OpenCode agents\", \"https://opencode.ai/docs/agents/\"],\n364\t  [\"OpenCode skills\", \"https://opencode.ai/docs/skills\"],\n365\t  [\"Pi agent harness\", \"https://github.com/earendil-works/pi\"],\n366\t  [\"Ollama launch integrations\", \"https://ollama.com/blog/launch\"],\n367\t  [\"Qwen3 Coder on Ollama\", \"https://ollama.com/library/qwen3-coder\"],\n368\t  [\"Kimi K2.7 Code on Ollama\", \"https://ollama.com/library/kimi-k2.7-code\"],\n369\t  [\"DeepSeek V4 Flash on Ollama\", \"https://ollama.com/library/deepseek-v4-flash\"],\n370\t  [\"Claude Opus 5\", \"https://www.anthropic.com/news/claude-opus-5\"],\n371\t  [\"Claude Sonnet 5\", \"https://www.anthropic.com/news/claude-sonnet-5\"],\n372\t];\n373\t\n374\tconst navItems = [\n375\t  [\"scope\", \"Scope\"],\n376\t  [\"models\", \"Models\"],\n377\t  [\"design\", \"Study design\"],\n378\t  [\"tasks\", \"Tasks\"],\n379\t  [\"score\", \"Scoring\"],\n380\t  [\"ecosystem\", \"Extensions\"],\n381\t  [\"workflow\", \"Distributed work\"],\n382\t  [\"steps\", \"Step-by-step\"],\n383\t  [\"start\", \"Start here\"],\n384\t];\n385\t\n386\tfunction CheckIcon({ checked }: { checked: boolean }) {\n387\t  return <span aria-hidden=\"true\">{checked ? \"✓\" : \"\"}</span>;\n388\t}\n389\t\n390\texport default function Home() {\n391\t  const [completed, setCompleted] = useState<string[]>([]);\n392\t\n393\t  useEffect(() => {\n394\t    let timer: number | undefined;\n395\t    try {\n396\t      const saved = window.localStorage.getItem(\"assistant-study-progress\");\n397\t      const parsed = saved ? JSON.parse(saved) : [];\n398\t      if (Array.isArray(parsed)) {\n399\t        timer = window.setTimeout(\n400\t          () => setCompleted(parsed.filter((item) => typeof item === \"string\")),\n401\t          0,\n402\t        );\n403\t      }\n404\t    } catch {\n405\t      // Progress is a convenience. The plan still works without browser storage.\n406\t    }\n407\t    return () => {\n408\t      if (timer !== undefined) window.clearTimeout(timer);\n409\t    };\n410\t  }, []);\n411\t\n412\t  const completeCount = completed.length;\n413\t  const percent = Math.round((completeCount / stages.length) * 100);\n414\t  const progressText = useMemo(\n415\t    () => `${completeCount} of ${stages.length} stages complete`,\n416\t    [completeCount],\n417\t  );\n418\t\n419\t  function toggleStage(id: string) {\n420\t    const next = completed.includes(id)\n421\t      ? completed.filter((item) => item !== id)\n422\t      : [...completed, id];\n423\t    setCompleted(next);\n424\t    try {\n425\t      window.localStorage.setItem(\n426\t        \"assistant-study-progress\",\n427\t        JSON.stringify(next),\n428\t      );\n429\t    } catch {\n430\t      // Ignore storage failures.\n431\t    }\n432\t  }\n433\t\n434\t  function resetProgress() {\n435\t    setCompleted([]);\n436\t    try {\n437\t      window.localStorage.removeItem(\"assistant-study-progress\");\n438\t    } catch {\n439\t      // Ignore storage failures.\n440\t    }\n441\t  }\n442\t\n443\t  return (\n444\t    <>\n445\t      <a className=\"skip-link\" href=\"#main-content\">\n446\t        Skip to the plan\n447\t      </a>\n448\t\n449\t      <header className=\"site-header\">\n450\t        <a className=\"brand\" href=\"#top\" aria-label=\"Coding assistant study home\">\n451\t          <span className=\"brand-mark\">LAB / 01</span>\n452\t          <span>Coding assistant study</span>\n453\t        </a>\n454\t        <div className=\"header-actions\">\n455\t          <div className=\"mini-progress\" aria-label={progressText}>\n456\t            <span>{progressText}</span>\n457\t            <span className=\"mini-track\" aria-hidden=\"true\">\n458\t              <span style={{ width: `${percent}%` }} />\n459\t            </span>\n460\t          </div>\n461\t          <button className=\"text-button print-button\" onClick={() => window.print()}>\n462\t            Print / save PDF\n463\t          </button>\n464\t        </div>\n465\t      </header>\n466\t\n467\t      <div className=\"page-shell\" id=\"top\">\n468\t        <aside className=\"side-nav\" aria-label=\"Plan sections\">\n469\t          <p className=\"eyebrow\">On this page</p>\n470\t          <nav>\n471\t            {navItems.map(([id, label], index) => (\n472\t              <a href={`#${id}`} key={id}>\n473\t                <span>{String(index + 1).padStart(2, \"0\")}</span>\n474\t                {label}\n475\t              </a>\n476\t            ))}\n477\t          </nav>\n478\t          <div className=\"side-note\">\n479\t            <p>Study size</p>\n480\t            <strong>94 core runs</strong>\n481\t            <span>plus one distributed project</span>\n482\t          </div>\n483\t        </aside>\n484\t\n485\t        <main id=\"main-content\">\n486\t          <section className=\"hero\" aria-labelledby=\"hero-title\">\n487\t            <div className=\"hero-copy\">\n488\t              <p className=\"kicker\">A practical six-week benchmark</p>\n489\t              <h1 id=\"hero-title\">\n490\t                Find the right <em>assistant</em>, the right <em>model</em>, and the\n491\t                right way to combine them.\n492\t              </h1>\n493\t              <p className=\"hero-lede\">\n494\t                A repeatable study of Codex, Claude Code, and OpenCode—with Pi as\n495\t                a neutral model lab, and Ollama for local and hosted open models.\n496\t              </p>\n497\t              <div className=\"hero-actions\">\n498\t                <a className=\"primary-button\" href=\"#start\">\n499\t                  Begin with Day 1\n500\t                </a>\n501\t                <a className=\"secondary-button\" href=\"#design\">\n502\t                  See the study design\n503\t                </a>\n504\t              </div>\n505\t            </div>\n506\t            <div className=\"hero-brief\" aria-label=\"Key recommendation\">\n507\t              <p className=\"eyebrow\">My recommendation</p>\n508\t              <p className=\"brief-big\">Do not run every model in every assistant.</p>\n509\t              <p>\n510\t                First hold the model fixed to measure the assistant. Then hold the\n511\t                assistant fixed to measure the model. Finally test each native\n512\t                pairing as a complete product.\n513\t              </p>\n514\t              <dl>\n515\t                <div>\n516\t                  <dt>Lead model</dt>\n517\t                  <dd>GPT-5.6 Sol, then Opus 5</dd>\n518\t                </div>\n519\t                <div>\n520\t                  <dt>Shared baseline</dt>\n521\t                  <dd>DeepSeek V4 Flash Cloud</dd>\n522\t                </div>\n523\t                <div>\n524\t                  <dt>Neutral harness</dt>\n525\t                  <dd>Pi</dd>\n526\t                </div>\n527\t              </dl>\n528\t            </div>\n529\t          </section>\n530\t\n531\t          <section className=\"section-block\" id=\"scope\">\n532\t            <div className=\"section-heading\">\n533\t              <p className=\"section-number\">01 / Scope</p>\n534\t              <h2>Four programs, with three in the final ranking.</h2>\n535\t              <p>\n536\t                Here, “assistant” or “harness” means the program around the model:\n537\t                its tools, planning, permissions, memory, plugins, and user\n538\t                experience. Pi is a control instrument, not a fourth primary winner.\n539\t              </p>\n540\t            </div>\n541\t            <div className=\"assistant-grid\">\n542\t              {assistantCards.map((assistant) => (\n543\t                <article className=\"assistant-card\" key={assistant.name}>\n544\t                  <div className=\"assistant-top\">\n545\t                    <span className=\"assistant-mark\">{assistant.mark}</span>\n546\t                    <span className=\"role-pill\">{assistant.role}</span>\n547\t                  </div>\n548\t                  <h3>{assistant.name}</h3>\n549\t                  <p>{assistant.summary}</p>\n550\t                  <div className=\"test-note\">\n551\t                    <span>Inspect</span>\n552\t                    <p>{assistant.test}</p>\n553\t                  </div>\n554\t                </article>\n555\t              ))}\n556\t            </div>\n557\t            <div className=\"callout plain\">\n558\t              <strong>Boundary:</strong> compare Codex, Claude Code, and OpenCode\n559\t              as the products you may keep using. Use Pi to make the model test\n560\t              fair and to explore custom orchestration.\n561\t            </div>\n562\t          </section>\n563\t\n564\t          <section className=\"section-block\" id=\"models\">\n565\t            <div className=\"section-heading split-heading\">\n566\t              <div>\n567\t                <p className=\"section-number\">02 / Models</p>\n568\t                <h2>A small, current model shortlist.</h2>\n569\t              </div>\n570\t              <p>\n571\t                Exact catalogs change quickly. Record the full model ID visible on\n572\t                the day of each run. “Open weight” is used for downloadable models\n573\t                because their licenses and definitions of open source differ.\n574\t              </p>\n575\t            </div>\n576\t            <div className=\"table-wrap model-table-wrap\" tabIndex={0}>\n577\t              <table>\n578\t                <thead>\n579\t                  <tr>\n580\t                    <th>Model</th>\n581\t                    <th>Class</th>\n582\t                    <th>Access</th>\n583\t                    <th>Use in this study</th>\n584\t                    <th>Priority</th>\n585\t                  </tr>\n586\t                </thead>\n587\t                <tbody>\n588\t                  {modelRows.map((row) => (\n589\t                    <tr key={row.model}>\n590\t                      <td>\n591\t                        <strong>{row.model}</strong>\n592\t                        <span>{row.maker}</span>\n593\t                      </td>\n594\t                      <td>{row.lane}</td>\n595\t                      <td>{row.access}</td>\n596\t                      <td>{row.use}</td>\n597\t                      <td>\n598\t                        <span\n599\t                          className={`priority priority-${row.priority.toLowerCase()}`}\n600\t                        >\n601\t                          {row.priority}\n602\t                        </span>\n603\t                      </td>\n604\t                    </tr>\n605\t                  ))}\n606\t                </tbody>\n607\t              </table>\n608\t            </div>\n609\t            <div className=\"model-rule-grid\">\n610\t              <div>\n611\t                <span>Hardware rule</span>\n612\t                <p>\n613\t                  With 16 GB of unified memory, keep large open-weight models in\n614\t                  Ollama Cloud. Use Qwen3 8B only as a labeled small local control,\n615\t                  not as a substitute inside the shared-model lane.\n616\t                </p>\n617\t              </div>\n618\t              <div>\n619\t                <span>Budget rule</span>\n620\t                <p>\n621\t                  Use subscription access first. Use Ollama Cloud for Kimi and\n622\t                  DeepSeek. Treat Fable, Luna, Haiku, and paid APIs as optional until\n623\t                  the pilot proves they add a useful comparison.\n624\t                </p>\n625\t              </div>\n626\t            </div>\n627\t          </section>\n628\t\n629\t          <section className=\"section-block\" id=\"design\">\n630\t            <div className=\"section-heading\">\n631\t              <p className=\"section-number\">03 / Study design</p>\n632\t              <h2>Three lanes prevent the wrong conclusion.</h2>\n633\t              <p>\n634\t                A great result may come from the model, the surrounding program, or\n635\t                both. These lanes separate those effects before you judge the full\n636\t                product.\n637\t              </p>\n638\t            </div>\n639\t            <div className=\"lane-list\">\n640\t              {benchmarkLanes.map((lane) => (\n641\t                <article className=\"lane-card\" key={lane.number}>\n642\t                  <span className=\"lane-number\">{lane.number}</span>\n643\t                  <div className=\"lane-content\">\n644\t                    <div className=\"lane-title-row\">\n645\t                      <h3>{lane.title}</h3>\n646\t                      <span>{lane.lock}</span>\n647\t                    </div>\n648\t                    <p>{lane.body}</p>\n649\t                    <div className=\"lane-meta\">\n650\t                      <p>\n651\t                        <strong>Target:</strong> {lane.runs}\n652\t                      </p>\n653\t                      <p>\n654\t                        <strong>Answers:</strong> {lane.answers}\n655\t                      </p>\n656\t                    </div>\n657\t                  </div>\n658\t                </article>\n659\t              ))}\n660\t            </div>\n661\t            <div className=\"method-strip\">\n662\t              <div>\n663\t                <span>Same start</span>\n664\t                <p>Clean commit and new session</p>\n665\t              </div>\n666\t              <div>\n667\t                <span>Same prompt</span>\n668\t                <p>Versioned and hashed</p>\n669\t              </div>\n670\t              <div>\n671\t                <span>Two runs</span>\n672\t                <p>Report median and range</p>\n673\t              </div>\n674\t              <div>\n675\t                <span>Blind grade</span>\n676\t                <p>Hide identity when possible</p>\n677\t              </div>\n678\t              <div>\n679\t                <span>Stop rule</span>\n680\t                <p>Maximum time and interventions</p>\n681\t              </div>\n682\t            </div>\n683\t          </section>\n684\t\n685\t          <section className=\"section-block\" id=\"tasks\">\n686\t            <div className=\"section-heading split-heading\">\n687\t              <div>\n688\t                <p className=\"section-number\">04 / Task pack</p>\n689\t                <h2>Eight tasks that resemble real work.</h2>\n690\t              </div>\n691\t              <p>\n692\t                Use T1–T4 for the controlled comparison. Use T5–T8 for native\n693\t                product tests, plugin tests, and the distributed project.\n694\t              </p>\n695\t            </div>\n696\t            <div className=\"task-grid\">\n697\t              {taskRows.map((task) => (\n698\t                <article className=\"task-card\" key={task.id}>\n699\t                  <div className=\"task-labels\">\n700\t                    <span>{task.id}</span>\n701\t                    <span>{task.kind}</span>\n702\t                  </div>\n703\t                  <h3>{task.title}</h3>\n704\t                  <p>{task.setup}</p>\n705\t                  <div className=\"pass-line\">\n706\t                    <span>Pass when</span>\n707\t                    <p>{task.pass}</p>\n708\t                  </div>\n709\t                </article>\n710\t              ))}\n711\t            </div>\n712\t            <div className=\"callout warning\">\n713\t              <strong>Do not use public benchmark tasks as your main evidence.</strong>\n714\t              Models may have seen them. Use private, frozen fixtures modeled on\n715\t              work you actually do. Public suites can be a small secondary check.\n716\t            </div>\n717\t          </section>\n718\t\n719\t          <section className=\"section-block\" id=\"score\">\n720\t            <div className=\"section-heading\">\n721\t              <p className=\"section-number\">05 / Scoring</p>\n722\t              <h2>One 100-point score, backed by raw evidence.</h2>\n723\t              <p>\n724\t                The score makes comparison easier. The patch, tests, event log, and\n725\t                human notes remain the source of truth.\n726\t              </p>\n727\t            </div>\n728\t            <div className=\"score-layout\">\n729\t              <div className=\"score-ring\" aria-label=\"100 point score\">\n730\t                <span>100</span>\n731\t                <p>total points</p>\n732\t              </div>\n733\t              <div className=\"score-list\">\n734\t                {scoreRows.map(([label, points, proof]) => (\n735\t                  <div className=\"score-row\" key={label}>\n736\t                    <span className=\"score-points\">{points}</span>\n737\t                    <strong>{label}</strong>\n738\t                    <p>{proof}</p>\n739\t                  </div>\n740\t                ))}\n741\t              </div>\n742\t            </div>\n743\t            <div className=\"evidence-grid\">\n744\t              <div>\n745\t                <h3>Always record</h3>\n746\t                <ul>\n747\t                  <li>Assistant version and exact model ID</li>\n748\t                  <li>Prompt version and repository commit</li>\n749\t                  <li>Context size, reasoning setting, permissions, and plugins</li>\n750\t                  <li>Elapsed time and time to an accepted result</li>\n751\t                  <li>Human interventions and permission prompts</li>\n752\t                </ul>\n753\t              </div>\n754\t              <div>\n755\t                <h3>Always save</h3>\n756\t                <ul>\n757\t                  <li>Event log or full transcript</li>\n758\t                  <li>Standard output and error output</li>\n759\t                  <li>Git patch and changed-file list</li>\n760\t                  <li>Visible and hidden test results</li>\n761\t                  <li>Final response and grader notes</li>\n762\t                </ul>\n763\t              </div>\n764\t              <div>\n765\t                <h3>Count an intervention when</h3>\n766\t                <ul>\n767\t                  <li>You correct a wrong plan or false claim</li>\n768\t                  <li>You provide a file location it should have found</li>\n769\t                  <li>You ask it to run a required check again</li>\n770\t                  <li>You approve a normal expected action only if comparing UX</li>\n771\t                  <li>You restart after a crash or unrecoverable loop</li>\n772\t                </ul>\n773\t              </div>\n774\t            </div>\n775\t          </section>\n776\t\n777\t          <section className=\"section-block\" id=\"ecosystem\">\n778\t            <div className=\"section-heading\">\n779\t              <p className=\"section-number\">06 / Skills, plugins, MCP, and hooks</p>\n780\t              <h2>Share the simple pieces. Keep product-specific wiring thin.</h2>\n781\t              <p>\n782\t                Skills and MCP are the most portable layer. Plugin packaging,\n783\t                lifecycle hooks, and permissions differ, so compare them as product\n784\t                features rather than forcing one configuration everywhere.\n785\t              </p>\n786\t            </div>\n787\t            <div className=\"portable-stack\" aria-label=\"Portable extension stack\">\n788\t              <div>\n789\t                <span>Shared rules</span>\n790\t                <strong>AGENTS.md</strong>\n791\t              </div>\n792\t              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n793\t              <div>\n794\t                <span>Shared workflow</span>\n795\t                <strong>SKILL.md</strong>\n796\t              </div>\n797\t              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n798\t              <div>\n799\t                <span>Shared tools</span>\n800\t                <strong>MCP servers</strong>\n801\t              </div>\n802\t              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n803\t              <div>\n804\t                <span>Local enforcement</span>\n805\t                <strong>Hooks + permissions</strong>\n806\t              </div>\n807\t            </div>\n808\t            <div className=\"table-wrap\" tabIndex={0}>\n809\t              <table className=\"extension-table\">\n810\t                <thead>\n811\t                  <tr>\n812\t                    <th>Layer</th>\n813\t                    <th>How to use it across assistants</th>\n814\t                    <th>What to measure</th>\n815\t                  </tr>\n816\t                </thead>\n817\t                <tbody>\n818\t                  {extensionRows.map((row) => (\n819\t                    <tr key={row.surface}>\n820\t                      <td><strong>{row.surface}</strong></td>\n821\t                      <td>{row.common}</td>\n822\t                      <td>{row.measure}</td>\n823\t                    </tr>\n824\t                  ))}\n825\t                </tbody>\n826\t              </table>\n827\t            </div>\n828\t            <div className=\"ecosystem-notes\">\n829\t              <article>\n830\t                <span>Codex</span>\n831\t                <p>\n832\t                  Test project instructions, skills, installable plugins, MCP,\n833\t                  hooks, custom agents, subagents, and structured exec output.\n834\t                </p>\n835\t              </article>\n836\t              <article>\n837\t                <span>Claude Code</span>\n838\t                <p>\n839\t                  Test CLAUDE.md importing AGENTS.md, skills, marketplace plugins,\n840\t                  MCP, deterministic hooks, subagents, agent teams, and worktrees.\n841\t                </p>\n842\t              </article>\n843\t              <article>\n844\t                <span>OpenCode</span>\n845\t                <p>\n846\t                  Test AGENTS.md, shared skills, provider plugins, custom tools, MCP,\n847\t                  fine-grained permissions, and its evolving V2 plugin API.\n848\t                </p>\n849\t              </article>\n850\t              <article>\n851\t                <span>Pi</span>\n852\t                <p>\n853\t                  Test AGENTS.md, Agent Skills, TypeScript extensions, packages,\n854\t                  JSON/RPC/SDK use, and external sandboxing because Pi has no built-in\n855\t                  permission boundary.\n856\t                </p>\n857\t              </article>\n858\t            </div>\n859\t            <div className=\"callout plain\">\n860\t              <strong>Cross-tool rule file:</strong> keep the real project guidance in\n861\t              <code> AGENTS.md</code>. Put <code>@AGENTS.md</code> at the top of\n862\t              Claude Code&apos;s <code>CLAUDE.md</code>. Do not maintain two copies.\n863\t            </div>\n864\t          </section>\n865\t\n866\t          <section className=\"section-block\" id=\"workflow\">\n867\t            <div className=\"section-heading\">\n868\t              <p className=\"section-number\">07 / Distributed project</p>\n869\t              <h2>Let one frontier model direct smaller workers.</h2>\n870\t              <p>\n871\t                The assistants should not edit one checkout together. Coordinate\n872\t                them through task files and Git worktrees, then merge only verified\n873\t                patches.\n874\t              </p>\n875\t            </div>\n876\t            <div className=\"workflow-diagram\" aria-label=\"Distributed coding workflow\">\n877\t              <div className=\"workflow-node lead-node\">\n878\t                <span>1 / Lead</span>\n879\t                <strong>GPT-5.6 Sol</strong>\n880\t                <p>Clarify scope, acceptance checks, boundaries, and task split.</p>\n881\t              </div>\n882\t              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n883\t              <div className=\"workflow-node contract-node\">\n884\t                <span>2 / Contract</span>\n885\t                <strong>Versioned task JSON</strong>\n886\t                <p>Goal, owned files, read-only context, checks, limits, output path.</p>\n887\t              </div>\n888\t              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n889\t              <div className=\"worker-grid\">\n890\t                <div className=\"workflow-node worker-node\">\n891\t                  <span>3A / Bounded worker</span>\n892\t                  <strong>OpenCode + DeepSeek</strong>\n893\t                  <p>Tests, fixtures, boilerplate, or a clearly isolated module.</p>\n894\t                </div>\n895\t                <div className=\"workflow-node worker-node\">\n896\t                  <span>3B / Larger worker</span>\n897\t                  <strong>Pi + Kimi/Qwen Cloud</strong>\n898\t                  <p>Longer isolated implementation with machine-readable output.</p>\n899\t                </div>\n900\t                <div className=\"workflow-node worker-node\">\n901\t                  <span>3C / Strong worker</span>\n902\t                  <strong>Codex Terra / Sonnet 5</strong>\n903\t                  <p>Difficult integration point, migration, or cross-file logic.</p>\n904\t                </div>\n905\t              </div>\n906\t              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n907\t              <div className=\"workflow-node review-node\">\n908\t                <span>4 / Independent review</span>\n909\t                <strong>Claude Opus 5</strong>\n910\t                <p>Review patches from the other vendor, run full checks, and list merge risks.</p>\n911\t              </div>\n912\t              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n913\t              <div className=\"workflow-node human-node\">\n914\t                <span>5 / Decision</span>\n915\t                <strong>Tests + human approval</strong>\n916\t                <p>Merge one patch at a time. Re-run the full suite after every merge.</p>\n917\t              </div>\n918\t            </div>\n919\t            <div className=\"contract-grid\">\n920\t              <article>\n921\t                <span>Task file must say</span>\n922\t                <ul>\n923\t                  <li>One clear outcome</li>\n924\t                  <li>Files the worker owns</li>\n925\t                  <li>Files it may read but not edit</li>\n926\t                  <li>Acceptance and verification commands</li>\n927\t                  <li>Time, tool, and permission limits</li>\n928\t                </ul>\n929\t              </article>\n930\t              <article>\n931\t                <span>Worker must return</span>\n932\t                <ul>\n933\t                  <li>Status: complete, failed, or blocked</li>\n934\t                  <li>Patch and changed-file list</li>\n935\t                  <li>Commands run and results</li>\n936\t                  <li>Assumptions and remaining risks</li>\n937\t                  <li>No merge, push, deploy, or hidden side effect</li>\n938\t                </ul>\n939\t              </article>\n940\t              <article>\n941\t                <span>Rotate bias</span>\n942\t                <ul>\n943\t                  <li>Run once with Sol leading and Opus reviewing</li>\n944\t                  <li>Run once with Opus leading and Sol reviewing</li>\n945\t                  <li>Keep worker tasks and acceptance checks unchanged</li>\n946\t                  <li>Compare coordination time and integration failures</li>\n947\t                </ul>\n948\t              </article>\n949\t            </div>\n950\t          </section>\n951\t\n952\t          <section className=\"section-block\" id=\"steps\">\n953\t            <div className=\"section-heading steps-heading\">\n954\t              <div>\n955\t                <p className=\"section-number\">08 / Step-by-step</p>\n956\t                <h2>Follow this sequence.</h2>\n957\t                <p>Check a stage when its evidence is saved, not when it has merely started.</p>\n958\t              </div>\n959\t              <div className=\"large-progress\" aria-label={progressText}>\n960\t                <div>\n961\t                  <strong>{percent}%</strong>\n962\t                  <button onClick={resetProgress}>Reset</button>\n963\t                </div>\n964\t                <span aria-hidden=\"true\"><span style={{ width: `${percent}%` }} /></span>\n965\t                <p>{progressText}</p>\n966\t              </div>\n967\t            </div>\n968\t            <div className=\"timeline\">\n969\t              {stages.map((stage, index) => {\n970\t                const isDone = completed.includes(stage.id);\n971\t                return (\n972\t                  <article className={`stage-card ${isDone ? \"is-done\" : \"\"}`} key={stage.id}>\n973\t                    <button\n974\t                      className=\"stage-check\"\n975\t                      aria-label={`${isDone ? \"Mark incomplete\" : \"Mark complete\"}: ${stage.title}`}\n976\t                      aria-pressed={isDone}\n977\t                      onClick={() => toggleStage(stage.id)}\n978\t                    >\n979\t                      <CheckIcon checked={isDone} />\n980\t                    </button>\n981\t                    <div className=\"stage-index\">{String(index + 1).padStart(2, \"0\")}</div>\n982\t                    <div className=\"stage-copy\">\n983\t                      <span>{stage.week}</span>\n984\t                      <h3>{stage.title}</h3>\n985\t                      <p>{stage.goal}</p>\n986\t                    </div>\n987\t                    <ul>\n988\t                      {stage.items.map((item) => <li key={item}>{item}</li>)}\n989\t                    </ul>\n990\t                  </article>\n991\t                );\n992\t              })}\n993\t            </div>\n994\t          </section>\n995\t\n996\t          <section className=\"section-block start-section\" id=\"start\">\n997\t            <div className=\"section-heading\">\n998\t              <p className=\"section-number\">09 / Start here</p>\n999\t              <h2>Your first working session.</h2>\n1000\t              <p>\n1001\t                Do only these actions first. Do not download every model or build a\n1002\t                large dashboard before the first end-to-end run works.\n1003\t              </p>\n1004\t            </div>\n1005\t            <div className=\"start-grid\">\n1006\t              <article className=\"command-card\">\n1007\t                <div className=\"command-title\">\n1008\t                  <span>1</span>\n1009\t                  <h3>Record the environment</h3>\n1010\t                </div>\n1011\t                <pre><code>{`codex --version\n1012\tclaude --version\n1013\topencode --version\n1014\tpi --version\n1015\tollama --version\n1016\tollama list\n1017\tgit rev-parse HEAD\n1018\tsystem_profiler SPHardwareDataType`}</code></pre>\n1019\t              </article>\n1020\t              <article className=\"command-card\">\n1021\t                <div className=\"command-title\">\n1022\t                  <span>2</span>\n1023\t                  <h3>Confirm the common model</h3>\n1024\t                </div>\n1025\t                <pre><code>{`ollama pull deepseek-v4-flash:cloud\n1026\tollama run deepseek-v4-flash:cloud\n1027\tollama pull kimi-k2.7-code:cloud\n1028\t\n1029\t# Optional laptop-sized local control:\n1030\tollama pull qwen3:8b`}</code></pre>\n1031\t              </article>\n1032\t              <article className=\"command-card wide-card\">\n1033\t                <div className=\"command-title\">\n1034\t                  <span>3</span>\n1035\t                  <h3>Create the evidence folders</h3>\n1036\t                </div>\n1037\t                <pre><code>{`benchmark/\n1038\t├── STUDY.md\n1039\t├── tasks/T1-repo-map/\n1040\t│   ├── prompt.md\n1041\t│   ├── rubric.json\n1042\t│   └── fixture.lock\n1043\t├── schemas/{run,task,result}.schema.json\n1044\t├── runner/\n1045\t└── runs/<run-id>/\n1046\t    ├── metadata.json\n1047\t    ├── prompt.md\n1048\t    ├── events.jsonl\n1049\t    ├── stdout.log\n1050\t    ├── stderr.log\n1051\t    ├── changes.patch\n1052\t    ├── tests.json\n1053\t    ├── result.json\n1054\t    └── grader.json`}</code></pre>\n1055\t              </article>\n1056\t            </div>\n1057\t            <div className=\"first-run\">\n1058\t              <div>\n1059\t                <p className=\"eyebrow\">The first proof</p>\n1060\t                <h3>Run T1 once in OpenCode with DeepSeek V4 Flash Cloud.</h3>\n1061\t                <p>\n1062\t                  Start from a clean repository. Ask for the repository map in\n1063\t                  read-only mode. Save every artifact, run the grader, then reset.\n1064\t                  Only after that succeeds should you add Codex, Claude Code, and Pi.\n1065\t                </p>\n1066\t              </div>\n1067\t              <ol>\n1068\t                <li>One task</li>\n1069\t                <li>One model</li>\n1070\t                <li>One assistant</li>\n1071\t                <li>One complete evidence folder</li>\n1072\t              </ol>\n1073\t            </div>\n1074\t          </section>\n1075\t\n1076\t          <section className=\"section-block guardrails-section\">\n1077\t            <div className=\"section-heading\">\n1078\t              <p className=\"section-number\">Guardrails</p>\n1079\t              <h2>Rules that keep the project credible.</h2>\n1080\t            </div>\n1081\t            <div className=\"guardrail-grid\">\n1082\t              <p><span>01</span> Freeze prompt and task versions before comparison.</p>\n1083\t              <p><span>02</span> Never let two workers write the same worktree.</p>\n1084\t              <p><span>03</span> Do not grade only the final answer; grade the patch and tests.</p>\n1085\t              <p><span>04</span> Record failures, refusals, crashes, and abandoned runs.</p>\n1086\t              <p><span>05</span> Keep credentials outside prompts, logs, patches, and repositories.</p>\n1087\t              <p><span>06</span> Require human approval for merges, pushes, deploys, and destructive actions.</p>\n1088\t              <p><span>07</span> Review third-party plugins and MCP servers before installation.</p>\n1089\t              <p><span>08</span> Re-run a study block when a model or assistant version changes materially.</p>\n1090\t            </div>\n1091\t          </section>\n1092\t\n1093\t          <section className=\"section-block sources-section\">\n1094\t            <div className=\"section-heading split-heading\">\n1095\t              <div>\n1096\t                <p className=\"section-number\">Current references</p>\n1097\t                <h2>Primary sources used for this plan.</h2>\n1098\t              </div>\n1099\t              <p>\n1100\t                Model and product details were checked on August 22, 2026. Recheck\n1101\t                the catalogs immediately before the first recorded run.\n1102\t              </p>\n1103\t            </div>\n1104\t            <div className=\"source-grid\">\n1105\t              {sources.map(([label, href], index) => (\n1106\t                <a href={href} target=\"_blank\" rel=\"noreferrer\" key={href}>\n1107\t                  <span>{String(index + 1).padStart(2, \"0\")}</span>\n1108\t                  {label}\n1109\t                  <span aria-hidden=\"true\">↗</span>\n1110\t                </a>\n1111\t              ))}\n1112\t            </div>\n1113\t          </section>\n1114\t\n1115\t          <footer>\n1116\t            <p>Coding assistant study plan</p>\n1117\t            <p>Prepared August 22, 2026 · Keep the evidence, not just the winner.</p>\n1118\t          </footer>\n1119\t        </main>\n1120\t      </div>\n1121\t    </>\n1122\t  );\n1123\t}\n1124\t"}]},"parent_tool_use_id":null,"session_id":"84820143-4cfe-427a-81c0-b26fa7bef41e","uuid":"cd911e59-4db5-41fb-bd70-553a46a9dfcc","timestamp":"2026-08-22T19:14:44.172Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ammarbinayaz/Documents/coding-assistant-benchmarking/app/page.tsx","content":"\"use client\";\n\nimport { useEffect, useMemo, useState } from \"react\";\n\nconst assistantCards = [\n  {\n    name: \"Codex\",\n    role: \"Primary assistant\",\n    mark: \"CX\",\n    summary:\n      \"Use it for the strongest OpenAI-native workflow: planning, implementation, parallel subagents, review, browser checks, and long-running work.\",\n    test: \"App and CLI flow, worktrees, custom agents, skills, plugins, MCP, hooks, approvals, structured non-interactive output.\",\n  },\n  {\n    name: \"Claude Code\",\n    role: \"Primary assistant\",\n    mark: \"CC\",\n    summary:\n      \"Use it for Anthropic-native coding, long tasks, careful planning, and its mature set of subagents, teams, hooks, MCP, and plugins.\",\n    test: \"Plan mode, subagents, agent view, agent teams, worktrees, plugin marketplace, hooks, MCP, permissions, print/JSON mode.\",\n  },\n  {\n    name: \"OpenCode\",\n    role: \"Primary assistant\",\n    mark: \"OC\",\n    summary:\n      \"Use it as the provider-flexible assistant. It is the cleanest place to compare local, cloud, and paid models without changing your daily interface.\",\n    test: \"Provider switching, Ollama discovery, agents, skills, MCP, plugins, permissions, session handling, run/server modes.\",\n  },\n  {\n    name: \"Pi\",\n    role: \"Neutral lab bench\",\n    mark: \"PI\",\n    summary:\n      \"Use Pi to compare models inside one minimal harness. It supports your OpenAI and Anthropic subscriptions plus custom local providers.\",\n    test: \"Model portability, extensions, skills, packages, JSON/RPC/SDK modes, session branching, and the cost of adding missing controls.\",\n  },\n];\n\nconst modelRows = [\n  {\n    model: \"GPT-5.6 Sol\",\n    maker: \"OpenAI\",\n    lane: \"Frontier\",\n    access: \"Codex subscription; API optional\",\n    use: \"Top-level planning, hardest fixes, final review\",\n    priority: \"Required\",\n  },\n  {\n    model: \"GPT-5.6 Terra\",\n    maker: \"OpenAI\",\n    lane: \"Efficient frontier\",\n    access: \"Codex subscription where listed; API optional\",\n    use: \"Exploration, review, medium-complexity worker\",\n    priority: \"Required\",\n  },\n  {\n    model: \"GPT-5.6 Luna\",\n    maker: \"OpenAI\",\n    lane: \"Low cost\",\n    access: \"API or catalog access\",\n    use: \"Simple scans, formatting, repetitive checks\",\n    priority: \"Optional\",\n  },\n  {\n    model: \"Claude Opus 5\",\n    maker: \"Anthropic\",\n    lane: \"Frontier\",\n    access: \"Claude subscription, plan dependent\",\n    use: \"Top-level planning, long work, difficult review\",\n    priority: \"Required\",\n  },\n  {\n    model: \"Claude Sonnet 5\",\n    maker: \"Anthropic\",\n    lane: \"Workhorse\",\n    access: \"Claude Code subscription\",\n    use: \"Daily coding baseline and moderate workers\",\n    priority: \"Required\",\n  },\n  {\n    model: \"Claude Fable 5\",\n    maker: \"Anthropic\",\n    lane: \"Frontier ceiling\",\n    access: \"Usage credits / account availability\",\n    use: \"One or two hardest runs only\",\n    priority: \"Stretch\",\n  },\n  {\n    model: \"Claude Haiku 4.5\",\n    maker: \"Anthropic\",\n    lane: \"Low cost\",\n    access: \"API or subscription catalog\",\n    use: \"Fast small worker and parallel scans\",\n    priority: \"Optional\",\n  },\n  {\n    model: \"Qwen3 Coder 480B Cloud\",\n    maker: \"Qwen\",\n    lane: \"Hosted open weight\",\n    access: \"Ollama Cloud\",\n    use: \"Optional third hosted coding model after the pilot\",\n    priority: \"Optional\",\n  },\n  {\n    model: \"Kimi K2.7 Code\",\n    maker: \"Moonshot AI\",\n    lane: \"Hosted open weight\",\n    access: \"Ollama Cloud\",\n    use: \"Long coding tasks and tool-heavy worker runs\",\n    priority: \"Required\",\n  },\n  {\n    model: \"DeepSeek V4 Flash\",\n    maker: \"DeepSeek\",\n    lane: \"Hosted open weight\",\n    access: \"Ollama Cloud\",\n    use: \"Long-context and cost-aware worker runs\",\n    priority: \"Required\",\n  },\n  {\n    model: \"Qwen3 8B\",\n    maker: \"Qwen\",\n    lane: \"Small local control\",\n    access: \"Ollama\",\n    use: \"Measure the quality and speed tradeoff of a laptop-sized worker\",\n    priority: \"Optional\",\n  },\n];\n\nconst benchmarkLanes = [\n  {\n    number: \"01\",\n    title: \"Compare the assistants\",\n    lock: \"Keep the model fixed\",\n    body: \"Run deepseek-v4-flash:cloud through Codex, Claude Code, OpenCode, and Pi. The same hosted model avoids turning laptop limits into an assistant advantage.\",\n    runs: \"4 assistants × 4 tasks × 2 runs = 32\",\n    answers: \"Which assistant plans better, uses tools better, stays in scope, recovers from errors, and needs fewer interventions?\",\n  },\n  {\n    number: \"02\",\n    title: \"Compare the models\",\n    lock: \"Keep the assistant fixed\",\n    body: \"Use Pi as the intended neutral harness after access is verified. Test the selected OpenAI and Anthropic models plus DeepSeek, Kimi, and an optional Qwen Cloud model with identical conditions.\",\n    runs: \"7 models × 4 tasks × 2 runs = 56\",\n    answers: \"Which model gives the best quality, time, and cost when the surrounding assistant is unchanged?\",\n  },\n  {\n    number: \"03\",\n    title: \"Compare real daily use\",\n    lock: \"Use each native best pairing\",\n    body: \"Run Codex + Sol, Claude Code + Opus or Sonnet, and OpenCode + the best open model from the pilot on two hard tasks.\",\n    runs: \"3 native pairs × 2 tasks × 1 run = 6\",\n    answers: \"Which full product would you choose when fairness matters less than getting the work done?\",\n  },\n];\n\nconst taskRows = [\n  {\n    id: \"T1\",\n    kind: \"Core\",\n    title: \"Understand an unfamiliar repository\",\n    setup: \"Ask for an architecture map, main request flow, risky areas, and a short change plan. Read-only.\",\n    pass: \"Matches a maintainer-written answer key; cites the right files; makes no edits.\",\n  },\n  {\n    id: \"T2\",\n    kind: \"Core\",\n    title: \"Fix a real bug\",\n    setup: \"Seed one edge-case bug with visible tests and hidden tests. Give only the issue report and reproduction.\",\n    pass: \"All tests pass, the root cause is fixed, and the diff does not include unrelated cleanup.\",\n  },\n  {\n    id: \"T3\",\n    kind: \"Core\",\n    title: \"Build a multi-file feature\",\n    setup: \"Add one API or data feature that needs schema, business logic, validation, tests, and docs.\",\n    pass: \"Acceptance tests pass; error paths work; existing behavior remains stable.\",\n  },\n  {\n    id: \"T4\",\n    kind: \"Core\",\n    title: \"Build and verify a user interface\",\n    setup: \"Provide a screenshot plus written behavior for desktop and mobile. Require keyboard use and browser verification.\",\n    pass: \"Functional checks, visual checks, accessibility checks, and console checks pass.\",\n  },\n  {\n    id: \"T5\",\n    kind: \"Challenge\",\n    title: \"Refactor without changing behavior\",\n    setup: \"Give a large, awkward module and freeze behavior with characterization tests before the refactor.\",\n    pass: \"Same public behavior, smaller clear units, no snapshot churn, and measured complexity improvement.\",\n  },\n  {\n    id: \"T6\",\n    kind: \"Challenge\",\n    title: \"Upgrade a dependency or API\",\n    setup: \"Pin an older library, provide current docs, and require a safe migration with a rollback note.\",\n    pass: \"Build and tests pass; deprecated usage is gone; no unnecessary dependency changes.\",\n  },\n  {\n    id: \"T7\",\n    kind: \"Challenge\",\n    title: \"Investigate an incident and a security flaw\",\n    setup: \"Use a controlled fixture with logs, one vulnerable path, noise, and a safe reproduction.\",\n    pass: \"Finds the real cause, ranks risk correctly, patches it, adds regression tests, and avoids unsafe actions.\",\n  },\n  {\n    id: \"T8\",\n    kind: \"Challenge\",\n    title: \"Repair CI and improve project guidance\",\n    setup: \"Give a broken pipeline, weak README, and missing assistant instructions.\",\n    pass: \"CI passes; setup is reproducible; AGENTS.md is short, specific, and useful across assistants.\",\n  },\n];\n\nconst scoreRows = [\n  [\"Correctness\", \"35\", \"Acceptance tests and hidden tests\"],\n  [\"No regressions\", \"15\", \"Existing tests and behavior stay intact\"],\n  [\"Scope discipline\", \"10\", \"Only necessary files and changes\"],\n  [\"Code quality\", \"10\", \"Clear, maintainable, and consistent with the repo\"],\n  [\"Autonomy\", \"8\", \"Few human corrections or repeated instructions\"],\n  [\"Tool and safety discipline\", \"7\", \"Good permission choices; no risky shortcuts\"],\n  [\"Time\", \"5\", \"Time to an accepted result, not time to first answer\"],\n  [\"Usage or cost\", \"5\", \"Tokens, subscription quota, cloud units, or local energy proxy\"],\n  [\"Explanation\", \"5\", \"Accurate summary, verification, and remaining risks\"],\n];\n\nconst extensionRows = [\n  {\n    surface: \"Project rules\",\n    common: \"Keep AGENTS.md as the single source. Claude's CLAUDE.md should import it with @AGENTS.md.\",\n    measure: \"Rule following and context size\",\n  },\n  {\n    surface: \"Skills\",\n    common: \"Reuse one small SKILL.md workflow through each assistant's discovery path.\",\n    measure: \"Portability, setup time, and quality gain\",\n  },\n  {\n    surface: \"MCP\",\n    common: \"Configure the same read-only docs or issue-tracker server in each assistant.\",\n    measure: \"Connection reliability, tool accuracy, permission clarity\",\n  },\n  {\n    surface: \"Hooks and guards\",\n    common: \"Apply the same policy: block secrets, format changed files, and run a focused check after edits.\",\n    measure: \"Coverage, false blocks, debuggability\",\n  },\n  {\n    surface: \"Plugins and extensions\",\n    common: \"Package the rule, skill, tool, and guard only after the loose version works.\",\n    measure: \"Install, update, permissions, versioning, and removal\",\n  },\n];\n\nconst stages = [\n  {\n    id: \"stage-0\",\n    week: \"Day 1\",\n    title: \"Freeze the study\",\n    goal: \"Write the question before seeing results.\",\n    items: [\n      \"Create STUDY.md with the three comparison lanes, the scorecard, and your stop rules.\",\n      \"Record machine, operating system, RAM/VRAM, assistant versions, model IDs, and subscription tier.\",\n      \"Turn off auto-updates for the study window where practical, or record every update as a new study block.\",\n      \"Set a hard optional-spend cap. Start with subscriptions and Ollama; add paid API runs only after the pilot.\",\n    ],\n  },\n  {\n    id: \"stage-1\",\n    week: \"Days 2–4\",\n    title: \"Build the task pack\",\n    goal: \"Make the result gradeable without model judgment.\",\n    items: [\n      \"Prepare T1–T4 first. Use small real repositories or frozen fixtures with clean reset commits.\",\n      \"Write visible acceptance criteria and separate hidden tests before any assistant sees the task.\",\n      \"Create one prompt per task. Do not mention the assistant or model name inside the prompt.\",\n      \"Manually solve each task once so you know it is possible and know the expected effort.\",\n    ],\n  },\n  {\n    id: \"stage-2\",\n    week: \"Days 5–7\",\n    title: \"Build the runner\",\n    goal: \"Capture the same evidence for every run.\",\n    items: [\n      \"Start each run from the same Git commit in its own worktree.\",\n      \"Wrap codex exec, claude -p, opencode run, and Pi print/JSON mode behind one run command.\",\n      \"Save prompt, settings, stdout, stderr, event log, patch, tests, elapsed time, interventions, and final answer.\",\n      \"Use a run ID and never overwrite a prior run.\",\n    ],\n  },\n  {\n    id: \"stage-3\",\n    week: \"Week 2\",\n    title: \"Run the 28-run pilot\",\n    goal: \"Find broken tasks and weak candidates cheaply.\",\n    items: [\n      \"Assistant pilot: 4 assistants × T1 and T2 × 1 run = 8.\",\n      \"Model pilot: 7 models in Pi × T1 and T2 × 1 run = 14.\",\n      \"Native pilot: 3 native pairings × T1 and T2 × 1 run = 6.\",\n      \"Fix the harness, prompts, or hidden tests only if the issue affects everyone. Version every change.\",\n    ],\n  },\n  {\n    id: \"stage-4\",\n    week: \"Weeks 3–4\",\n    title: \"Complete the 94-run core study\",\n    goal: \"Collect repeatable evidence, not impressions.\",\n    items: [\n      \"Complete the assistant lane: 32 total runs across T1–T4.\",\n      \"Complete the model lane: 56 total runs across T1–T4.\",\n      \"Complete the native lane: 6 runs on two challenge tasks.\",\n      \"Randomize run order, clear sessions, restore the repository, and grade before revealing model identity where possible.\",\n    ],\n  },\n  {\n    id: \"stage-5\",\n    week: \"Week 5\",\n    title: \"Test the extension ecosystems\",\n    goal: \"Measure what customization actually buys you.\",\n    items: [\n      \"Run one task with no extensions, then with a shared rule, one skill, one MCP server, and one safety guard.\",\n      \"Record install time, failures, context overhead, permission prompts, and whether the extension improved the final score.\",\n      \"Treat skills and MCP as portable building blocks. Treat plugin packaging and hooks as assistant-specific.\",\n      \"Do not install a large plugin bundle until you have reviewed its code, permissions, and external connections.\",\n    ],\n  },\n  {\n    id: \"stage-6\",\n    week: \"Week 6\",\n    title: \"Run the distributed project\",\n    goal: \"Prove that a frontier planner can direct smaller workers.\",\n    items: [\n      \"Use GPT-5.6 Sol as the first lead. Repeat once with Claude Opus 5 as lead.\",\n      \"Give each worker a separate worktree, owned files, acceptance tests, and a machine-readable task file.\",\n      \"Use DeepSeek for a bounded implementation, Kimi or Qwen Cloud for a larger worker task, and Terra or Sonnet for the difficult middle layer.\",\n      \"Use the other vendor's frontier model as final reviewer, then run all tests and make the merge decision yourself.\",\n    ],\n  },\n  {\n    id: \"stage-7\",\n    week: \"Final 2 days\",\n    title: \"Analyze and publish\",\n    goal: \"Make the conclusion honest and reusable.\",\n    items: [\n      \"Report medians and ranges; show every failure and intervention, not only the best run.\",\n      \"Separate assistant effects, model effects, and native-pair results in the report.\",\n      \"Write recommendations by task type: best planner, best daily driver, best local worker, best value, best extension system.\",\n      \"Publish prompts, task versions, runner code, scoring rules, and raw results where licenses and privacy allow.\",\n    ],\n  },\n];\n\nconst sources = [\n  [\"OpenAI model guidance\", \"https://developers.openai.com/api/docs/guides/latest-model\"],\n  [\"OpenAI model catalog\", \"https://developers.openai.com/api/docs/models\"],\n  [\"Claude Code parallel agents\", \"https://code.claude.com/docs/en/agents\"],\n  [\"Claude Code extension map\", \"https://code.claude.com/docs/en/features-overview\"],\n  [\"Claude Code plugins\", \"https://code.claude.com/docs/en/plugins\"],\n  [\"OpenCode providers\", \"https://opencode.ai/docs/providers\"],\n  [\"OpenCode agents\", \"https://opencode.ai/docs/agents/\"],\n  [\"OpenCode skills\", \"https://opencode.ai/docs/skills\"],\n  [\"Pi agent harness\", \"https://github.com/earendil-works/pi\"],\n  [\"Ollama launch integrations\", \"https://ollama.com/blog/launch\"],\n  [\"Qwen3 Coder on Ollama\", \"https://ollama.com/library/qwen3-coder\"],\n  [\"Kimi K2.7 Code on Ollama\", \"https://ollama.com/library/kimi-k2.7-code\"],\n  [\"DeepSeek V4 Flash on Ollama\", \"https://ollama.com/library/deepseek-v4-flash\"],\n  [\"Claude Opus 5\", \"https://www.anthropic.com/news/claude-opus-5\"],\n  [\"Claude Sonnet 5\", \"https://www.anthropic.com/news/claude-sonnet-5\"],\n];\n\nconst navItems = [\n  [\"scope\", \"Scope\"],\n  [\"models\", \"Models\"],\n  [\"design\", \"Study design\"],\n  [\"tasks\", \"Tasks\"],\n  [\"score\", \"Scoring\"],\n  [\"ecosystem\", \"Extensions\"],\n  [\"workflow\", \"Distributed work\"],\n  [\"steps\", \"Step-by-step\"],\n  [\"start\", \"Start here\"],\n];\n\nfunction CheckIcon({ checked }: { checked: boolean }) {\n  return <span aria-hidden=\"true\">{checked ? \"✓\" : \"\"}</span>;\n}\n\nexport default function Home() {\n  const [completed, setCompleted] = useState<string[]>([]);\n\n  useEffect(() => {\n    let timer: number | undefined;\n    try {\n      const saved = window.localStorage.getItem(\"assistant-study-progress\");\n      const parsed = saved ? JSON.parse(saved) : [];\n      if (Array.isArray(parsed)) {\n        timer = window.setTimeout(\n          () => setCompleted(parsed.filter((item) => typeof item === \"string\")),\n          0,\n        );\n      }\n    } catch {\n      // Progress is a convenience. The plan still works without browser storage.\n    }\n    return () => {\n      if (timer !== undefined) window.clearTimeout(timer);\n    };\n  }, []);\n\n  const completeCount = completed.length;\n  const percent = Math.round((completeCount / stages.length) * 100);\n  const progressText = useMemo(\n    () => `${completeCount} of ${stages.length} stages complete`,\n    [completeCount],\n  );\n\n  function toggleStage(id: string) {\n    const next = completed.includes(id)\n      ? completed.filter((item) => item !== id)\n      : [...completed, id];\n    setCompleted(next);\n    try {\n      window.localStorage.setItem(\n        \"assistant-study-progress\",\n        JSON.stringify(next),\n      );\n    } catch {\n      // Ignore storage failures.\n    }\n  }\n\n  function resetProgress() {\n    setCompleted([]);\n    try {\n      window.localStorage.removeItem(\"assistant-study-progress\");\n    } catch {\n      // Ignore storage failures.\n    }\n  }\n\n  return (\n    <>\n      <a className=\"skip-link\" href=\"#main-content\">\n        Skip to the plan\n      </a>\n\n      <header className=\"site-header\">\n        <a className=\"brand\" href=\"#top\" aria-label=\"Coding assistant study home\">\n          <span className=\"brand-mark\">LAB / 01</span>\n          <span>Coding assistant study</span>\n        </a>\n        <div className=\"header-actions\">\n          <div className=\"mini-progress\" aria-label={progressText}>\n            <span>{progressText}</span>\n            <span className=\"mini-track\" aria-hidden=\"true\">\n              <span style={{ width: `${percent}%` }} />\n            </span>\n          </div>\n          <button className=\"text-button print-button\" onClick={() => window.print()}>\n            Print / save PDF\n          </button>\n        </div>\n      </header>\n\n      <div className=\"page-shell\" id=\"top\">\n        <aside className=\"side-nav\" aria-label=\"Plan sections\">\n          <p className=\"eyebrow\">On this page</p>\n          <nav>\n            {navItems.map(([id, label], index) => (\n              <a href={`#${id}`} key={id}>\n                <span>{String(index + 1).padStart(2, \"0\")}</span>\n                {label}\n              </a>\n            ))}\n          </nav>\n          <div className=\"side-note\">\n            <p>Study size</p>\n            <strong>94 core runs</strong>\n            <span>plus one distributed project</span>\n          </div>\n        </aside>\n\n        <main id=\"main-content\">\n          <section className=\"hero\" aria-labelledby=\"hero-title\">\n            <div className=\"hero-copy\">\n              <p className=\"kicker\">A practical six-week benchmark</p>\n              <h1 id=\"hero-title\">\n                Find the right <em>assistant</em>, the right <em>model</em>, and the\n                right way to combine them.\n              </h1>\n              <p className=\"hero-lede\">\n                A repeatable study of Codex, Claude Code, and OpenCode—with Pi as\n                a neutral model lab, and Ollama for local and hosted open models.\n              </p>\n              <div className=\"hero-actions\">\n                <a className=\"primary-button\" href=\"#start\">\n                  Begin with Day 1\n                </a>\n                <a className=\"secondary-button\" href=\"#design\">\n                  See the study design\n                </a>\n              </div>\n            </div>\n            <div className=\"hero-brief\" aria-label=\"Key recommendation\">\n              <p className=\"eyebrow\">My recommendation</p>\n              <p className=\"brief-big\">Do not run every model in every assistant.</p>\n              <p>\n                First hold the model fixed to measure the assistant. Then hold the\n                assistant fixed to measure the model. Finally test each native\n                pairing as a complete product.\n              </p>\n              <dl>\n                <div>\n                  <dt>Lead model</dt>\n                  <dd>GPT-5.6 Sol, then Opus 5</dd>\n                </div>\n                <div>\n                  <dt>Shared baseline</dt>\n                  <dd>DeepSeek V4 Flash Cloud</dd>\n                </div>\n                <div>\n                  <dt>Neutral harness</dt>\n                  <dd>Pi</dd>\n                </div>\n              </dl>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"scope\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">01 / Scope</p>\n              <h2>Four programs, with three in the final ranking.</h2>\n              <p>\n                Here, “assistant” or “harness” means the program around the model:\n                its tools, planning, permissions, memory, plugins, and user\n                experience. Pi is a control instrument, not a fourth primary winner.\n              </p>\n            </div>\n            <div className=\"assistant-grid\">\n              {assistantCards.map((assistant) => (\n                <article className=\"assistant-card\" key={assistant.name}>\n                  <div className=\"assistant-top\">\n                    <span className=\"assistant-mark\">{assistant.mark}</span>\n                    <span className=\"role-pill\">{assistant.role}</span>\n                  </div>\n                  <h3>{assistant.name}</h3>\n                  <p>{assistant.summary}</p>\n                  <div className=\"test-note\">\n                    <span>Inspect</span>\n                    <p>{assistant.test}</p>\n                  </div>\n                </article>\n              ))}\n            </div>\n            <div className=\"callout plain\">\n              <strong>Boundary:</strong> compare Codex, Claude Code, and OpenCode\n              as the products you may keep using. Use Pi to make the model test\n              fair and to explore custom orchestration.\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"models\">\n            <div className=\"section-heading split-heading\">\n              <div>\n                <p className=\"section-number\">02 / Models</p>\n                <h2>A small, current model shortlist.</h2>\n              </div>\n              <p>\n                Exact catalogs change quickly. Record the full model ID visible on\n                the day of each run. “Open weight” is used for downloadable models\n                because their licenses and definitions of open source differ.\n              </p>\n            </div>\n            <div className=\"table-wrap model-table-wrap\" tabIndex={0}>\n              <table>\n                <thead>\n                  <tr>\n                    <th>Model</th>\n                    <th>Class</th>\n                    <th>Access</th>\n                    <th>Use in this study</th>\n                    <th>Priority</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  {modelRows.map((row) => (\n                    <tr key={row.model}>\n                      <td>\n                        <strong>{row.model}</strong>\n                        <span>{row.maker}</span>\n                      </td>\n                      <td>{row.lane}</td>\n                      <td>{row.access}</td>\n                      <td>{row.use}</td>\n                      <td>\n                        <span\n                          className={`priority priority-${row.priority.toLowerCase()}`}\n                        >\n                          {row.priority}\n                        </span>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n            <div className=\"model-rule-grid\">\n              <div>\n                <span>Hardware rule</span>\n                <p>\n                  With 16 GB of unified memory, keep large open-weight models in\n                  Ollama Cloud. Use Qwen3 8B only as a labeled small local control,\n                  not as a substitute inside the shared-model lane.\n                </p>\n              </div>\n              <div>\n                <span>Budget rule</span>\n                <p>\n                  Use subscription access first. Use Ollama Cloud for Kimi and\n                  DeepSeek. Treat Fable, Luna, Haiku, and paid APIs as optional until\n                  the pilot proves they add a useful comparison.\n                </p>\n              </div>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"design\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">03 / Study design</p>\n              <h2>Three lanes prevent the wrong conclusion.</h2>\n              <p>\n                A great result may come from the model, the surrounding program, or\n                both. These lanes separate those effects before you judge the full\n                product.\n              </p>\n            </div>\n            <div className=\"lane-list\">\n              {benchmarkLanes.map((lane) => (\n                <article className=\"lane-card\" key={lane.number}>\n                  <span className=\"lane-number\">{lane.number}</span>\n                  <div className=\"lane-content\">\n                    <div className=\"lane-title-row\">\n                      <h3>{lane.title}</h3>\n                      <span>{lane.lock}</span>\n                    </div>\n                    <p>{lane.body}</p>\n                    <div className=\"lane-meta\">\n                      <p>\n                        <strong>Target:</strong> {lane.runs}\n                      </p>\n                      <p>\n                        <strong>Answers:</strong> {lane.answers}\n                      </p>\n                    </div>\n                  </div>\n                </article>\n              ))}\n            </div>\n            <div className=\"method-strip\">\n              <div>\n                <span>Same start</span>\n                <p>Clean commit and new session</p>\n              </div>\n              <div>\n                <span>Same prompt</span>\n                <p>Versioned and hashed</p>\n              </div>\n              <div>\n                <span>Two runs</span>\n                <p>Report median and range</p>\n              </div>\n              <div>\n                <span>Blind grade</span>\n                <p>Hide identity when possible</p>\n              </div>\n              <div>\n                <span>Stop rule</span>\n                <p>Maximum time and interventions</p>\n              </div>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"tasks\">\n            <div className=\"section-heading split-heading\">\n              <div>\n                <p className=\"section-number\">04 / Task pack</p>\n                <h2>Eight tasks that resemble real work.</h2>\n              </div>\n              <p>\n                Use T1–T4 for the controlled comparison. Use T5–T8 for native\n                product tests, plugin tests, and the distributed project.\n              </p>\n            </div>\n            <div className=\"task-grid\">\n              {taskRows.map((task) => (\n                <article className=\"task-card\" key={task.id}>\n                  <div className=\"task-labels\">\n                    <span>{task.id}</span>\n                    <span>{task.kind}</span>\n                  </div>\n                  <h3>{task.title}</h3>\n                  <p>{task.setup}</p>\n                  <div className=\"pass-line\">\n                    <span>Pass when</span>\n                    <p>{task.pass}</p>\n                  </div>\n                </article>\n              ))}\n            </div>\n            <div className=\"callout warning\">\n              <strong>Do not use public benchmark tasks as your main evidence.</strong>\n              Models may have seen them. Use private, frozen fixtures modeled on\n              work you actually do. Public suites can be a small secondary check.\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"score\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">05 / Scoring</p>\n              <h2>One 100-point score, backed by raw evidence.</h2>\n              <p>\n                The score makes comparison easier. The patch, tests, event log, and\n                human notes remain the source of truth.\n              </p>\n            </div>\n            <div className=\"score-layout\">\n              <div className=\"score-ring\" aria-label=\"100 point score\">\n                <span>100</span>\n                <p>total points</p>\n              </div>\n              <div className=\"score-list\">\n                {scoreRows.map(([label, points, proof]) => (\n                  <div className=\"score-row\" key={label}>\n                    <span className=\"score-points\">{points}</span>\n                    <strong>{label}</strong>\n                    <p>{proof}</p>\n                  </div>\n                ))}\n              </div>\n            </div>\n            <div className=\"evidence-grid\">\n              <div>\n                <h3>Always record</h3>\n                <ul>\n                  <li>Assistant version and exact model ID</li>\n                  <li>Prompt version and repository commit</li>\n                  <li>Context size, reasoning setting, permissions, and plugins</li>\n                  <li>Elapsed time and time to an accepted result</li>\n                  <li>Human interventions and permission prompts</li>\n                </ul>\n              </div>\n              <div>\n                <h3>Always save</h3>\n                <ul>\n                  <li>Event log or full transcript</li>\n                  <li>Standard output and error output</li>\n                  <li>Git patch and changed-file list</li>\n                  <li>Visible and hidden test results</li>\n                  <li>Final response and grader notes</li>\n                </ul>\n              </div>\n              <div>\n                <h3>Count an intervention when</h3>\n                <ul>\n                  <li>You correct a wrong plan or false claim</li>\n                  <li>You provide a file location it should have found</li>\n                  <li>You ask it to run a required check again</li>\n                  <li>You approve a normal expected action only if comparing UX</li>\n                  <li>You restart after a crash or unrecoverable loop</li>\n                </ul>\n              </div>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"ecosystem\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">06 / Skills, plugins, MCP, and hooks</p>\n              <h2>Share the simple pieces. Keep product-specific wiring thin.</h2>\n              <p>\n                Skills and MCP are the most portable layer. Plugin packaging,\n                lifecycle hooks, and permissions differ, so compare them as product\n                features rather than forcing one configuration everywhere.\n              </p>\n            </div>\n            <div className=\"portable-stack\" aria-label=\"Portable extension stack\">\n              <div>\n                <span>Shared rules</span>\n                <strong>AGENTS.md</strong>\n              </div>\n              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n              <div>\n                <span>Shared workflow</span>\n                <strong>SKILL.md</strong>\n              </div>\n              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n              <div>\n                <span>Shared tools</span>\n                <strong>MCP servers</strong>\n              </div>\n              <span className=\"stack-arrow\" aria-hidden=\"true\">→</span>\n              <div>\n                <span>Local enforcement</span>\n                <strong>Hooks + permissions</strong>\n              </div>\n            </div>\n            <div className=\"table-wrap\" tabIndex={0}>\n              <table className=\"extension-table\">\n                <thead>\n                  <tr>\n                    <th>Layer</th>\n                    <th>How to use it across assistants</th>\n                    <th>What to measure</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  {extensionRows.map((row) => (\n                    <tr key={row.surface}>\n                      <td><strong>{row.surface}</strong></td>\n                      <td>{row.common}</td>\n                      <td>{row.measure}</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n            <div className=\"ecosystem-notes\">\n              <article>\n                <span>Codex</span>\n                <p>\n                  Test project instructions, skills, installable plugins, MCP,\n                  hooks, custom agents, subagents, and structured exec output.\n                </p>\n              </article>\n              <article>\n                <span>Claude Code</span>\n                <p>\n                  Test CLAUDE.md importing AGENTS.md, skills, marketplace plugins,\n                  MCP, deterministic hooks, subagents, agent teams, and worktrees.\n                </p>\n              </article>\n              <article>\n                <span>OpenCode</span>\n                <p>\n                  Test AGENTS.md, shared skills, provider plugins, custom tools, MCP,\n                  fine-grained permissions, and its evolving V2 plugin API.\n                </p>\n              </article>\n              <article>\n                <span>Pi</span>\n                <p>\n                  Test AGENTS.md, Agent Skills, TypeScript extensions, packages,\n                  JSON/RPC/SDK use, and external sandboxing because Pi has no built-in\n                  permission boundary.\n                </p>\n              </article>\n            </div>\n            <div className=\"callout plain\">\n              <strong>Cross-tool rule file:</strong> keep the real project guidance in\n              <code> AGENTS.md</code>. Put <code>@AGENTS.md</code> at the top of\n              Claude Code&apos;s <code>CLAUDE.md</code>. Do not maintain two copies.\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"workflow\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">07 / Distributed project</p>\n              <h2>Let one frontier model direct smaller workers.</h2>\n              <p>\n                The assistants should not edit one checkout together. Coordinate\n                them through task files and Git worktrees, then merge only verified\n                patches.\n              </p>\n            </div>\n            <div className=\"workflow-diagram\" aria-label=\"Distributed coding workflow\">\n              <div className=\"workflow-node lead-node\">\n                <span>1 / Lead</span>\n                <strong>GPT-5.6 Sol</strong>\n                <p>Clarify scope, acceptance checks, boundaries, and task split.</p>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"workflow-node contract-node\">\n                <span>2 / Contract</span>\n                <strong>Versioned task JSON</strong>\n                <p>Goal, owned files, read-only context, checks, limits, output path.</p>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"worker-grid\">\n                <div className=\"workflow-node worker-node\">\n                  <span>3A / Bounded worker</span>\n                  <strong>OpenCode + DeepSeek</strong>\n                  <p>Tests, fixtures, boilerplate, or a clearly isolated module.</p>\n                </div>\n                <div className=\"workflow-node worker-node\">\n                  <span>3B / Larger worker</span>\n                  <strong>Pi + Kimi/Qwen Cloud</strong>\n                  <p>Longer isolated implementation with machine-readable output.</p>\n                </div>\n                <div className=\"workflow-node worker-node\">\n                  <span>3C / Strong worker</span>\n                  <strong>Codex Terra / Sonnet 5</strong>\n                  <p>Difficult integration point, migration, or cross-file logic.</p>\n                </div>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"workflow-node review-node\">\n                <span>4 / Independent review</span>\n                <strong>Claude Opus 5</strong>\n                <p>Review patches from the other vendor, run full checks, and list merge risks.</p>\n              </div>\n              <div className=\"workflow-down\" aria-hidden=\"true\">↓</div>\n              <div className=\"workflow-node human-node\">\n                <span>5 / Decision</span>\n                <strong>Tests + human approval</strong>\n                <p>Merge one patch at a time. Re-run the full suite after every merge.</p>\n              </div>\n            </div>\n            <div className=\"contract-grid\">\n              <article>\n                <span>Task file must say</span>\n                <ul>\n                  <li>One clear outcome</li>\n                  <li>Files the worker owns</li>\n                  <li>Files it may read but not edit</li>\n                  <li>Acceptance and verification commands</li>\n                  <li>Time, tool, and permission limits</li>\n                </ul>\n              </article>\n              <article>\n                <span>Worker must return</span>\n                <ul>\n                  <li>Status: complete, failed, or blocked</li>\n                  <li>Patch and changed-file list</li>\n                  <li>Commands run and results</li>\n                  <li>Assumptions and remaining risks</li>\n                  <li>No merge, push, deploy, or hidden side effect</li>\n                </ul>\n              </article>\n              <article>\n                <span>Rotate bias</span>\n                <ul>\n                  <li>Run once with Sol leading and Opus reviewing</li>\n                  <li>Run once with Opus leading and Sol reviewing</li>\n                  <li>Keep worker tasks and acceptance checks unchanged</li>\n                  <li>Compare coordination time and integration failures</li>\n                </ul>\n              </article>\n            </div>\n          </section>\n\n          <section className=\"section-block\" id=\"steps\">\n            <div className=\"section-heading steps-heading\">\n              <div>\n                <p className=\"section-number\">08 / Step-by-step</p>\n                <h2>Follow this sequence.</h2>\n                <p>Check a stage when its evidence is saved, not when it has merely started.</p>\n              </div>\n              <div className=\"large-progress\" aria-label={progressText}>\n                <div>\n                  <strong>{percent}%</strong>\n                  <button onClick={resetProgress}>Reset</button>\n                </div>\n                <span aria-hidden=\"true\"><span style={{ width: `${percent}%` }} /></span>\n                <p>{progressText}</p>\n              </div>\n            </div>\n            <div className=\"timeline\">\n              {stages.map((stage, index) => {\n                const isDone = completed.includes(stage.id);\n                return (\n                  <article className={`stage-card ${isDone ? \"is-done\" : \"\"}`} key={stage.id}>\n                    <button\n                      className=\"stage-check\"\n                      aria-label={`${isDone ? \"Mark incomplete\" : \"Mark complete\"}: ${stage.title}`}\n                      aria-pressed={isDone}\n                      onClick={() => toggleStage(stage.id)}\n                    >\n                      <CheckIcon checked={isDone} />\n                    </button>\n                    <div className=\"stage-index\">{String(index + 1).padStart(2, \"0\")}</div>\n                    <div className=\"stage-copy\">\n                      <span>{stage.week}</span>\n                      <h3>{stage.title}</h3>\n                      <p>{stage.goal}</p>\n                    </div>\n                    <ul>\n                      {stage.items.map((item) => <li key={item}>{item}</li>)}\n                    </ul>\n                  </article>\n                );\n              })}\n            </div>\n          </section>\n\n          <section className=\"section-block start-section\" id=\"start\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">09 / Start here</p>\n              <h2>Your first working session.</h2>\n              <p>\n                Do only these actions first. Do not download every model or build a\n                large dashboard before the first end-to-end run works.\n              </p>\n            </div>\n            <div className=\"start-grid\">\n              <article className=\"command-card\">\n                <div className=\"command-title\">\n                  <span>1</span>\n                  <h3>Record the environment</h3>\n                </div>\n                <pre><code>{`codex --version\nclaude --version\nopencode --version\npi --version\nollama --version\nollama list\ngit rev-parse HEAD\nsystem_profiler SPHardwareDataType`}</code></pre>\n              </article>\n              <article className=\"command-card\">\n                <div className=\"command-title\">\n                  <span>2</span>\n                  <h3>Confirm the common model</h3>\n                </div>\n                <pre><code>{`ollama pull deepseek-v4-flash:cloud\nollama run deepseek-v4-flash:cloud\nollama pull kimi-k2.7-code:cloud\n\n# Optional laptop-sized local control:\nollama pull qwen3:8b`}</code></pre>\n              </article>\n              <article className=\"command-card wide-card\">\n                <div className=\"command-title\">\n                  <span>3</span>\n                  <h3>Create the evidence folders</h3>\n                </div>\n                <pre><code>{`benchmark/\n├── STUDY.md\n├── tasks/T1-repo-map/\n│   ├── prompt.md\n│   ├── rubric.json\n│   └── fixture.lock\n├── schemas/{run,task,result}.schema.json\n├── runner/\n└── runs/<run-id>/\n    ├── metadata.json\n    ├── prompt.md\n    ├── events.jsonl\n    ├── stdout.log\n    ├── stderr.log\n    ├── changes.patch\n    ├── tests.json\n    ├── result.json\n    └── grader.json`}</code></pre>\n              </article>\n            </div>\n            <div className=\"first-run\">\n              <div>\n                <p className=\"eyebrow\">The first proof</p>\n                <h3>Run T1 once in OpenCode with DeepSeek V4 Flash Cloud.</h3>\n                <p>\n                  Start from a clean repository. Ask for the repository map in\n                  read-only mode. Save every artifact, run the grader, then reset.\n                  Only after that succeeds should you add Codex, Claude Code, and Pi.\n                </p>\n              </div>\n              <ol>\n                <li>One task</li>\n                <li>One model</li>\n                <li>One assistant</li>\n                <li>One complete evidence folder</li>\n              </ol>\n            </div>\n          </section>\n\n          <section className=\"section-block guardrails-section\">\n            <div className=\"section-heading\">\n              <p className=\"section-number\">Guardrails</p>\n              <h2>Rules that keep the project credible.</h2>\n            </div>\n            <div className=\"guardrail-grid\">\n              <p><span>01</span> Freeze prompt and task versions before comparison.</p>\n              <p><span>02</span> Never let two workers write the same worktree.</p>\n              <p><span>03</span> Do not grade only the final answer; grade the patch and tests.</p>\n              <p><span>04</span> Record failures, refusals, crashes, and abandoned runs.</p>\n              <p><span>05</span> Keep credentials outside prompts, logs, patches, and repositories.</p>\n              <p><span>06</span> Require human approval for merges, pushes, deploys, and destructive actions.</p>\n              <p><span>07</span> Review third-party plugins and MCP servers before installation.</p>\n              <p><span>08</span> Re-run a study block when a model or assistant version changes materially.</p>\n            </div>\n          </section>\n\n          <section className=\"section-block sources-section\">\n            <div className=\"section-heading split-heading\">\n              <div>\n                <p className=\"section-number\">Current references</p>\n                <h2>Primary sources used for this plan.</h2>\n              </div>\n              <p>\n                Model and product details were checked on August 22, 2026. Recheck\n                the catalogs immediately before the first recorded run.\n              </p>\n            </div>\n            <div className=\"source-grid\">\n              {sources.map(([label, href], index) => (\n                <a href={href} target=\"_blank\" rel=\"noreferrer\" key={href}>\n                  <span>{String(index + 1).padStart(2, \"0\")}</span>\n                  {label}\n                  <span aria-hidden=\"true\">↗</span>\n                </a>\n              ))}\n            </div>\n          </section>\n\n          <footer>\n            <p>Coding assistant study plan</p>\n            <p>Prepared August 22, 2026 · Keep the evidence, not just the winner.</p>\n          </footer>\n        </main>\n      </div>\n    </>\n  );\n}\n","numLines":1124,"startLine":1,"totalLines":1124}}}
