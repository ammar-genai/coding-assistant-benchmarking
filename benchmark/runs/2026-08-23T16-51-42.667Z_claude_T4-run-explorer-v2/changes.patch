+  assert.equal(summary.passRatePct, 75);
+});
+
+test("summarizes an empty subset as zeros with the exact field set", () => {
+  const summary = summarizeRuns([]);
+
+  assert.deepEqual(summary, {
+    visibleCount: 0,
+    passRatePct: 0,
+    medianElapsedSeconds: 0,
+    totalCostUsd: 0,
+    costedRunCount: 0,
+  });
+  assert.deepEqual(Object.keys(summarizeRuns(sampleRuns)).sort(), [
+    "costedRunCount",
+    "medianElapsedSeconds",
+    "passRatePct",
+    "totalCostUsd",
+    "visibleCount",
+  ]);
+});
+
+test("keeps frozen source records and their order untouched", () => {
+  const before = sampleRuns.map((run) => ({ ...run }));
+
+  sortRuns(sampleRuns, "time-asc");
+  sortRuns(sampleRuns, "cost-asc");
+  filterRuns(sampleRuns, { assistant: "Codex", outcome: "pass" });
+  summarizeRuns(sampleRuns);
+
+  assert.deepEqual(sampleRuns.map((run) => ({ ...run })), before);
+});
+
+test("renders run data through DOM APIs instead of innerHTML", async () => {
+  const source = await readFile(new URL("./run-explorer.mjs", import.meta.url), "utf8");
+
+  assert.doesNotMatch(source, /innerHTML|outerHTML|insertAdjacentHTML|document\.write/);
+  assert.match(source, /createElement/);
+  assert.match(source, /textContent/);
+});
