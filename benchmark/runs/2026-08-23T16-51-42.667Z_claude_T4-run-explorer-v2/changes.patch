+} from "./run-explorer.mjs";
+
+/* Minimal stand-in for the browser nodes the explorer touches, so the wiring
+ * between controls, results, and summaries can be exercised under node:test. */
+class StubElement {
+  constructor(tagName) {
+    this.tagName = tagName.toUpperCase();
+    this.className = "";
+    this.hidden = false;
+    this.children = [];
+    this.handlers = new Map();
+    this.ownText = "";
+  }
+
+  set textContent(value) {
+    this.ownText = String(value);
+    this.children = [];
+  }
+
+  get textContent() {
+    return this.children.length
+      ? this.children.map((child) => child.textContent).join(" ")
+      : this.ownText;
+  }
+
+  append(...nodes) {
+    this.children.push(...nodes);
+  }
+
+  replaceChildren(...nodes) {
+    this.children = nodes;
+  }
+
+  addEventListener(type, handler) {
+    this.handlers.set(type, handler);
+  }
+
+  dispatch(type) {
+    const handler = this.handlers.get(type);
+    assert.ok(handler, `no ${type} handler registered on #${this.id}`);
+    handler();
+  }
+
+  classNames() {
+    return [this.className, ...this.children.flatMap((child) => child.classNames())];
+  }
+}
+
+const CONTROL_IDS = ["assistant-filter", "outcome-filter", "sort-order"];
+const OUTPUT_IDS = [
+  "reset-filters",
+  "results-list",
+  "empty-state",
+  "results-status",
+  "visible-count",
+  "pass-rate",
+  "median-time",
+  "known-cost",
