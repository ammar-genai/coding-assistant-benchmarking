isible-count\"), \"0\");\n156\t  assert.equal(ui.text(\"known-cost\"), \"$0.00\");\n157\t  assert.match(ui.text(\"results-status\"), /No runs match/i);\n158\t\n159\t  ui.get(\"reset-filters\").dispatch(\"click\");\n160\t  assert.equal(ui.get(\"assistant-filter\").value, \"all\");\n161\t  assert.equal(ui.get(\"outcome-filter\").value, \"all\");\n162\t  assert.equal(ui.get(\"sort-order\").value, \"score-desc\");\n163\t  assert.equal(ui.cards().length, sampleRuns.length);\n164\t  assert.equal(ui.get(\"empty-state\").hidden, true);\n165\t});\n166\t\n167\tconst tiedRuns = Object.freeze([\n168\t  Object.freeze({\n169\t    id: \"b-slow-strong\",\n170\t    assistant: \"Codex\",\n171\t    model: \"Sol\",\n172\t    outcome: \"pass\",\n173\t    score: 90,\n174\t    elapsedSeconds: 30,\n175\t    costUsd: 0.1,\n176\t  }),\n177\t  Object.freeze({\n178\t    id: \"a-fast-weak\",\n179\t    assistant: \"OpenCode\",\n180\t    model: \"Kimi\",\n181\t    outcome: \"fail\",\n182\t    score: 70,\n183\t    elapsedSeconds: 30,\n184\t    costUsd: 0.1,\n185\t  }),\n186\t  Object.freeze({\n187\t    id: \"c-fast-weak\",\n188\t    assistant: \"OpenCode\",\n189\t    model: \"Qwen\",\n190\t    outcome: \"fail\",\n191\t    score: 70,\n192\t    elapsedSeconds: 30,\n193\t    costUsd: null,\n194\t  }),\n195\t]);"}]},"parent_tool_use_id":null,"session_id":"0e2a1bca-5eea-4f83-b5eb-98120ec71593","uuid":"ec9a56a7-1294-4d55-becd-8d8503b2d8fe","timestamp":"2026-08-23T16:58:17.566Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-EabBsN/checkout/benchmark/fixtures/T4-run-explorer/student-tests.mjs","content":"    assert.ok(first.includes(fragment), `top card is missing \"${fragment}\": ${first}`);\n  }\n\n  // Outcome is conveyed by text, and the badge class is available for colour.\n  assert.ok(ui.cards()[0].classNames().includes(\"outcome outcome--pass\"));\n  const failing = ui.cards().find((card) => card.textContent.includes(\"oc-qwen-01\"));\n  assert.ok(failing.textContent.includes(\"Fail\"));\n  assert.ok(failing.textContent.includes(\"$0.05\"));\n\n  assert.equal(ui.text(\"visible-count\"), \"6\");\n  assert.equal(ui.text(\"pass-rate\"), \"66.7%\");\n  assert.equal(ui.text(\"known-cost\"), \"$0.19\");\n  assert.match(ui.text(\"results-status\"), /6 of 6/);\n});\n\ntest(\"filters, sorts, empties, and resets through the controls\", async () => {\n  const ui = await mountExplorer();\n\n  ui.select(\"assistant-filter\", \"OpenCode\");\n  assert.deepEqual(\n    ui.cards().map((card) => card.textContent.match(/oc-\\S+/)[0]),\n    [\"oc-kimi-01\", \"oc-qwen-01\"],\n  );\n  assert.equal(ui.text(\"visible-count\"), \"2\");\n  assert.equal(ui.text(\"pass-rate\"), \"50.0%\");\n  assert.equal(ui.text(\"median-time\"), \"43.5s\");\n  assert.equal(ui.text(\"known-cost\"), \"$0.19\");\n\n  ui.select(\"sort-order\", \"time-asc\");\n  assert.deepEqual(\n    ui.cards().map((card) => card.textContent.match(/oc-\\S+/)[0]),\n    [\"oc-qwen-01\", \"oc-kimi-01\"],\n  );\n\n  // No Codex run fails, so the empty state takes over and the list is cleared.\n  ui.select(\"assistant-filter\", \"Codex\");\n  ui.select(\"outcome-filter\", \"fail\");\n  assert.equal(ui.cards().length, 0);\n  assert.equal(ui.get(\"empty-state\").hidden, false);\n  assert.equal(ui.text(\"visible-count\"), \"0\");\n  assert.equal(ui.text(\"known-cost\"), \"$0.00\");\n  assert.match(ui.text(\"results-status\"), /No runs match/i);\n\n  ui.get(\"reset-filters\").dispatch(\"click\");\n  assert.equal(ui.get(\"assistant-filter\").value, \"all\");\n  assert.equal(ui.get(\"outcome-filter\").value, \"all\");\n  assert.equal(ui.get(\"sort-order\").value, \"score-desc\");\n  assert.equal(ui.cards().length, sampleRuns.length);\n  assert.equal(ui.get(\"empty-state\").hidden, true);\n});\n\nconst tiedRuns = Object.freeze([\n  Object.freeze({\n    id: \"b-slow-strong\",\n    assistant: \"Codex\",\n    model: \"Sol\",\n    outcome: \"pass\",\n    score: 90,\n    elapsedSeconds: 30,\n    costUsd: 0.1,\n  }),\n  Object.freeze({\n    id: \"a-fast-weak\",\n    assistant: \"OpenCode\",\n    model: \"Kimi\",\n    outcome: \"fail\",\n    score: 70,\n    elapsedSeconds: 30,\n    costUsd: 0.1,\n  }),\n  Object.freeze({\n    id: \"c-fast-weak\",\n    assistant: \"OpenCode\",\n    model: \"Qwen\",\n    outcome: \"fail\",\n    score: 70,\n    elapsedSeconds: 30,\n    costUsd: null,\n  }),\n]);","numLines":80,"startLine":116,"totalLines":298}}}
