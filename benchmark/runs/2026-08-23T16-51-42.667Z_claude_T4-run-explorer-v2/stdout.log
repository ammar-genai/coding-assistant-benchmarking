ELECT\") el.value = firstOptionValue(id);\n  byId.set(id, el);\n}\n\nglobalThis.document = {\n  readyState: \"complete\",\n  getElementById: (id) => byId.get(id) ?? null,\n  createElement: (tag) => new El(tag),\n  addEventListener() {},\n};\n\nawait import(new URL(\"./run-explorer.mjs\", FIXTURE));\n\nconst list = byId.get(\"results-list\");\nconst empty = byId.get(\"empty-state\");\nconst status = byId.get(\"results-status\");\nconst summary = () =>\n  [\"visible-count\", \"pass-rate\", \"median-time\", \"known-cost\"]\n    .map((id) => `${id}=${byId.get(id).textContent}`)\n    .join(\"  \");\nconst cards = () => list.children.map((card) => card.textContent);\n\nconsole.log(\"--- initial (defaults from HTML) ---\");\nconsole.log(\"selects:\", [\"assistant-filter\", \"outcome-filter\", \"sort-order\"].map((id) => byId.get(id).value).join(\", \"));\nconsole.log(summary());\nconsole.log(\"status:\", status.textContent);\nconsole.log(\"empty hidden:\", empty.hidden);\ncards().forEach((c) => console.log(\"  •\", c));\n\nconsole.log(\"\\n--- assistant=OpenCode, sort=cost-asc ---\");\nbyId.get(\"assistant-filter\").value = \"OpenCode\";\nbyId.get(\"assistant-filter\").fire(\"change\");\nbyId.get(\"sort-order\").value = \"cost-asc\";\nbyId.get(\"sort-order\").fire(\"change\");\nconsole.log(summary());\nconsole.log(\"status:\", status.textContent);\ncards().forEach((c) => console.log(\"  •\", c));\n\nconsole.log(\"\\n--- assistant=Codex + outcome=fail (no matches) ---\");\nbyId.get(\"assistant-filter\").value = \"Codex\";\nbyId.get(\"assistant-filter\").fire(\"change\");\nbyId.get(\"outcome-filter\").value = \"fail\";\nbyId.get(\"outcome-filter\").fire(\"change\");\nconsole.log(summary());\nconsole.log(\"status:\", status.textContent);\nconsole.log(\"empty hidden:\", empty.hidden, \"| cards:\", list.children.length);\n\nconsole.log(\"\\n--- reset ---\");\nbyId.get(\"reset-filters\").fire(\"click\");\nconsole.log(\"selects:\", [\"assistant-filter\", \"outcome-filter\", \"sort-order\"].map((id) => byId.get(id).value).join(\", \"));\nconsole.log(summary());\nconsole.log(\"status:\", status.textContent);\nconsole.log(\"empty hidden:\", empty.hidden, \"| cards:\", list.children.length);\nconsole.log(\"first card:\", cards()[0]);\n\nconsole.log(\"\\n--- time-asc ---\");\nbyId.get(\"sort-order\").value = \"time-asc\";\nbyId.get(\"sort-order\").fire(\"change\");\ncards().forEach((c) => console.log(\"  •\", c));\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1078,"cache_read_input_tokens":37148,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1078},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0e2a1bca-5eea-4f83-b5eb-98120ec71593","uuid":"a32f18af-2e0a-44b7-8a4f-4dbb4f9f9feb","timestamp":"2026-08-23T16:55:47.847Z","request_id":"req_011CeL2mCmjwTcWtoUD3t5Z5"}
