   <select class=\"field__control\" id=\"assistant-filter\">\n              <option value=\"all\">All assistants</option>\n              <option value=\"Codex\">Codex</option>\n              <option value=\"Claude Code\">Claude Code</option>\n              <option value=\"OpenCode\">OpenCode</option>\n            </select>\n          </p>\n\n          <p class=\"field\">\n            <label class=\"field__label\" for=\"outcome-filter\">Outcome</label>\n            <select class=\"field__control\" id=\"outcome-filter\">\n              <option value=\"all\">All outcomes</option>\n              <option value=\"pass\">Pass</option>\n              <option value=\"fail\">Fail</option>\n            </select>\n          </p>\n\n          <p class=\"field\">\n            <label class=\"field__label\" for=\"sort-order\">Sort by</label>\n            <select class=\"field__control\" id=\"sort-order\">\n              <option value=\"score-desc\">Score (high to low)</option>\n              <option value=\"time-asc\">Time (fastest)</option>\n              <option value=\"cost-asc\">Cost (known first)</option>\n            </select>\n          </p>\n        </div>\n      </section>\n\n      <section class=\"panel panel--summary\" aria-labelledby=\"summary-heading\">\n        <h2 class=\"panel__title\" id=\"summary-heading\">Current subset</h2>\n\n        <dl class=\"summary-grid\">\n          <div class=\"stat\">\n            <dt class=\"stat__label\">Visible runs</dt>\n            <dd class=\"stat__value\" id=\"visible-count\">0</dd>\n          </div>\n          <div class=\"stat\">\n            <dt class=\"stat__label\">Pass rate</dt>\n            <dd class=\"stat__value\" id=\"pass-rate\">0.0%</dd>\n          </div>\n          <div class=\"stat\">\n            <dt class=\"stat__label\">Median time</dt>\n            <dd class=\"stat__value\" id=\"median-time\">0.0s</dd>\n          </div>\n          <div class=\"stat\">\n            <dt class=\"stat__label\">Known cost</dt>\n            <dd class=\"stat__value\" id=\"known-cost\">$0.00</dd>\n          </div>\n        </dl>\n\n        <p class=\"panel__note\">\n          Known cost totals only runs with a measured USD amount. Subscription-billed runs report\n          no per-run price and are excluded from that total.\n        </p>\n      </section>\n\n      <section class=\"panel panel--results\" aria-labelledby=\"results-heading\">\n        <div class=\"panel__head\">\n          <h2 class=\"panel__title\" id=\"results-heading\">Matching runs</h2>\n          <p class=\"status\" id=\"results-status\" role=\"status\" aria-live=\"polite\"></p>\n        </div>\n\n        <ul class=\"results-list\" id=\"results-list\"></ul>\n\n        <p class=\"empty-state\" id=\"empty-state\" hidden>\n          No runs match the current filters. Try widening the assistant or outcome filter, or\n          reset the filters to see every sample run.\n        </p>\n      </section>\n    </main>\n  </body>\n</html>\n","structuredPatch":[{"oldStart":8,"oldLines":10,"newStart":8,"newLines":94,"lines":["     <script type=\"module\" src=\"./run-explorer.mjs\"></script>","   </head>","   <body>","-    <main>","-      <p>Benchmark evidence</p>","-      <h1>Run explorer</h1>","-      <p>Build the interactive comparison interface described in the task.</p>","+    <main class=\"page\">","+      <header class=\"intro\">","+        <p class=\"intro__eyebrow\">Benchmark evidence</p>","+        <h1 class=\"intro__title\">Run explorer</h1>","+        <p class=\"intro__lede\">","+          Filter, sort, and summarise a small set of sample benchmark runs. These records are","+          seeded fixtures for interface work only &mdash; they are not final study results.","+        </p>","+      </header>","+","+      <section class=\"panel panel--filters\" aria-labelledby=\"filters-heading\">","+        <div class=\"panel__head\">","+          <h2 class=\"panel__title\" id=\"filters-heading\">Filters</h2>","+          <button class=\"b