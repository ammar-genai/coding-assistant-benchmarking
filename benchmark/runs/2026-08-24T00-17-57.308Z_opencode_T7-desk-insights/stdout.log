 as TradeSort)}><option value=\"execution-desc\">Latest execution</option></select></label>\n32:       </div>\n33:       <div className=\"tc-table-region\" role=\"region\" aria-label=\"Trade blotter table\" tabIndex={0}>\n34:         <table className=\"tc-table\">\n35:           <caption>Today&apos;s synthetic securitized-product trades</caption>\n36:           <thead><tr><th scope=\"col\">Select</th><th scope=\"col\">Trade</th><th scope=\"col\">Product</th><th scope=\"col\">Status</th></tr></thead>\n37:           <tbody>\n38:             {trades.map((trade) => (\n39:               <tr key={trade.internalTradeId}>\n40:                 <td><button type=\"button\" aria-pressed={selectedTradeId === trade.internalTradeId} onClick={() => onSelect(trade.internalTradeId)}>View</button></td>\n41:                 <th scope=\"row\">{trade.internalTradeId}</th>\n42:                 <td>{trade.productType}</td>\n43:                 <td>{trade.status}</td>\n44:               </tr>\n45:             ))}\n46:           </tbody>\n47:         </table>\n48:       </div>\n49:     </section>\n50:   );\n51: }\n\n(End of file - total 51 lines)\n</content>","metadata":{"preview":"import type {\n  ProductType,\n  TradeBlotterProps,\n  TradeSort,\n  TradeStatus,\n} from \"../domain/types.ts\";\n\nexport function TradeBlotter({\n  trades,\n  selectedTradeId,\n  product,\n  status,\n  search,\n  sort,\n  onProductChange,\n  onStatusChange,\n  onSearchChange,\n  onSortChange,\n  onSelect,\n}: TradeBlotterProps) {","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-EwI6KY/checkout/app/trade-capture/components/trade-blotter.tsx","text":"import type {\n  ProductType,\n  TradeBlotterProps,\n  TradeSort,\n  TradeStatus,\n} from \"../domain/types.ts\";\n\nexport function TradeBlotter({\n  trades,\n  selectedTradeId,\n  product,\n  status,\n  search,\n  sort,\n  onProductChange,\n  onStatusChange,\n  onSearchChange,\n  onSortChange,\n  onSelect,\n}: TradeBlotterProps) {\n  return (\n    <section className=\"tc-panel tc-blotter\" aria-labelledby=\"tc-blotter-title\">\n      <div className=\"tc-panel-heading\">\n        <p className=\"tc-eyebrow\">Operations</p>\n        <h2 id=\"tc-blotter-title\">Trade blotter</h2>\n      </div>\n      <div className=\"tc-filter-bar\">\n        <label className=\"tc-field\">Search<input value={search} onChange={(event) => onSearchChange(event.target.value)} /></label>\n        <label className=\"tc-field\">Product<select value={product} onChange={(event) => onProductChange(event.target.value as ProductType | \"all\")}><option value=\"all\">All products</option></select></label>\n        <label className=\"tc-field\">Status<select value={status} onChange={(event) => onStatusChange(event.target.value as TradeStatus | \"all\")}><option value=\"all\">All statuses</option></select></label>\n        <label className=\"tc-field\">Sort<select value={sort} onChange={(event) => onSortChange(event.target.value as TradeSort)}><option value=\"execution-desc\">Latest execution</option></select></label>\n      </div>\n      <div className=\"tc-table-region\" role=\"region\" aria-label=\"Trade blotter table\" tabIndex={0}>\n        <table className=\"tc-table\">\n          <caption>Today&apos;s synthetic securitized-product trades</caption>\n          <thead><tr><th scope=\"col\">Select</th><th scope=\"col\">Trade</th><th scope=\"col\">Product</th><th scope=\"col\">Status</th></tr></thead>\n          <tbody>\n            {trades.map((trade) => (\n              <tr key={trade.internalTradeId}>\n                <td><button type=\"button\" aria-pressed={selectedTradeId === trade.internalTradeId} onClick={() => onSelect(trade.internalTradeId)}>View</button></td>\n                <th scope=\"row\">{trade.internalTradeId}</th>\n                <td>{trade.productType}</td>\n                <td>{trade.status}</td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n    </section>\n  );\n}","lineStart":1,"lineEnd":51,"totalLines":51,"truncated":false}},"title":"app/trade-capture/components/trade-blotter.tsx","time":{"start":1787530692555,"end":1787530692559}},"id":"prt_03121c499001VRH7gTLDmkVTi7","sessionID":"ses_fcede7034ffedO3qY1epZkSTJa","messageID":"msg_03121b486001DxO0hSaR0pF6I0"}}
