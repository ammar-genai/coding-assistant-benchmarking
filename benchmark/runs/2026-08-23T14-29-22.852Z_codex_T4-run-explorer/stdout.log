{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmark/fixtures/T4-run-explorer/index.html << 'EOF'\n<\"'!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Benchmark run explorer</title>\n    <link rel=\"stylesheet\" href=\"./styles.css\" />\n    <script type=\"module\" src=\"./run-explorer.mjs\"></script>\n  </head>\n  <body>\n    <main>\n      <p class=\"eyebrow\">Benchmark evidence</p>\n      <h1>Run explorer</h1>\n      <p class=\"explainer\">\n        These are sample benchmark runs used to develop the comparison\n        interface. They are not final study results.\n      </p>\n\n      <section class=\"controls\" aria-label=\"Filter and sort runs\">\n        <div class=\"filters\">\n          <div class=\"field\">\n            <label for=\"assistant-filter\">Assistant</label>\n            <select id=\"assistant-filter\">\n              <option value=\"all\">All assistants</option>\n              <option value=\"Codex\">Codex</option>\n              <option value=\"Claude Code\">Claude Code</option>\n              <option value=\"OpenCode\">OpenCode</option>\n            </select>\n          </div>\n\n          <div class=\"field\">\n            <label for=\"outcome-filter\">Outcome</label>\n            <select id=\"outcome-filter\">\n              <option value=\"all\">All outcomes</option>\n              <option value=\"pass\">Pass</option>\n              <option value=\"fail\">Fail</option>\n            </select>\n          </div>\n\n          <div class=\"field\">\n            <label for=\"sort-order\">Sort by</label>\n            <select id=\"sort-order\">\n              <option value=\"score-desc\">Score (high to low)</option>\n              <option value=\"time-asc\">Time (fastest)</option>\n              <option value=\"cost-asc\">Cost (known first)</option>\n            </select>\n          </div>\n        </div>\n\n        <button id=\"reset-filters\" type=\"button\">Reset filters</button>\n      </section>\n\n      <section class=\"summary\" aria-label=\"Summary statistics\">\n        <div class=\"summary-item\">\n          <span id=\"visible-count\">0</span>\n          <span class=\"summary-label\">visible runs</span>\n        </div>\n        <div class=\"summary-item\">\n          <span id=\"pass-rate\">0%</span>\n          <span class=\"summary-label\">pass rate</span>\n        </div>\n        <div class=\"summary-item\">\n          <span id=\"median-time\">0.0s</span>\n          <span class=\"summary-label\">median time</span>\n        </div>\n        <div class=\"summary-item\">\n          <span id=\"known-cost\">$0.00</span>\n          <span class=\"summary-label\">known cost</span>\n          <small class=\"summary-note\">Subscription costs excluded</small>\n        </div>\n      </section>\n\n      <p id=\"status\" class=\"status\" aria-live=\"polite\">Loading runs…</p>\n\n      <section aria-label=\"Results\">\n        <ol id=\"results-list\"></ol>\n        <p id=\"empty-state\" hidden>No runs match the current filters.</p>\n      </section>\n    </main>\n  </body>\n</html>\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
