{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmark/fixtures/T4-run-explorer/student-tests.mjs << 'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\n\nimport { filterRuns, sortRuns, summarizeRuns } from \\\"./run-explorer.mjs\\\";\n\nconst mixedRuns = Object.freeze([\n  Object.freeze({\n    id: \\\"a\\\",\n    assistant: \\\"Codex\\\",\n    model: \\\"Sol\\\",\n    outcome: \\\"pass\\\",\n    score: 90,\n    elapsedSeconds: 30,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \\\"b\\\",\n    assistant: \\\"OpenCode\\\",\n    model: \\\"Kimi\\\",\n    outcome: \\\"fail\\\",\n    score: 80,\n    elapsedSeconds: 20,\n    costUsd: 0.01,\n  }),\n  Object.freeze({\n    id: \\\"c\\\",\n    assistant: \\\"Claude Code\\\",\n    model: \\\"Fable\\\",\n    outcome: \\\"pass\\\",\n    score: 85,\n    elapsedSeconds: 25,\n    costUsd: 0.02,\n  }),\n  Object.freeze({\n    id: \\\"d\\\",\n    assistant: \\\"Codex\\\",\n    model: \\\"Sol\\\",\n    outcome: \\\"fail\\\",\n    score: 70,\n    elapsedSeconds: 15,\n    costUsd: null,\n  }),\n]);\n\ntest(\\\"sortRuns cost-asc orders known costs before nulls, then score, then id\\\", () => {\n  const result = sortRuns(mixedRuns, \\\"cost-asc\\\");\n  assert.deepEqual(result.map((run) => run.id), [\\\"b\\\", \\\"c\\\", \\\"a\\\", \\\"d\\\"]);\n  assert.notEqual(result, mixedRuns);\n});\n\ntest(\\\"summarizeRuns avoids floating-point residue in total cost\\\", () => {\n  const result = summarizeRuns([\n    {\n      id: \\\"x\\\",\n      assistant: \\\"Codex\\\",\n      model: \\\"Sol\\\",\n      outcome: \\\"pass\\\",\n      score: 1,\n      elapsedSeconds: 1,\n      costUsd: 0.04,\n    },\n    {\n      id: \\\"y\\\",\n      assistant: \\\"Codex\\\",\n      model: \\\"Sol\\\",\n      outcome: \\\"pass\\\",\n      score: 2,\n      elapsedSeconds: 2,\n      costUsd: 0.02,\n    },\n    {\n      id: \\\"z\\\",\n      assistant: \\\"Codex\\\",\n      model: \\\"Sol\\\",\n      outcome: \\\"pass\\\",\n      score: 3,\n      elapsedSeconds: 3,\n      costUsd: null,\n    },\n  ]);\n  assert.equal(result.totalCostUsd, 0.06);\n  assert.equal(result.costedRunCount, 2);\n});\n\ntest(\\\"summarizeRuns returns zeros for an empty array\\\", () => {\n  assert.deepEqual(summarizeRuns([]), {\n    visibleCount: 0,\n    passRatePct: 0,\n    medianElapsedSeconds: 0,\n    totalCostUsd: 0,\n    costedRunCount: 0,\n  });\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
