-// Add at least two meaningful node:test cases for the run explorer.
-// Do not copy or modify the committed run-explorer.test.mjs suite.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { filterRuns, sortRuns, summarizeRuns } from "./run-explorer.mjs";
+
+const mixedRuns = Object.freeze([
+  Object.freeze({
+    id: "a",
+    assistant: "Codex",
+    model: "Sol",
+    outcome: "pass",
+    score: 90,
+    elapsedSeconds: 30,
+    costUsd: null,
+  }),
+  Object.freeze({
+    id: "b",
+    assistant: "OpenCode",
+    model: "Kimi",
+    outcome: "fail",
+    score: 80,
+    elapsedSeconds: 20,
+    costUsd: 0.01,
+  }),
+  Object.freeze({
+    id: "c",
+    assistant: "Claude Code",
+    model: "Fable",
+    outcome: "pass",
+    score: 85,
+    elapsedSeconds: 25,
+    costUsd: 0.02,
+  }),
+  Object.freeze({
+    id: "d",
+    assistant: "Codex",
+    model: "Sol",
+    outcome: "fail",
+    score: 70,
+    elapsedSeconds: 15,
+    costUsd: null,
+  }),
+]);
+
+test("sortRuns cost-asc orders known costs before nulls, then score, then id", () => {
+  const result = sortRuns(mixedRuns, "cost-asc");
+  assert.deepEqual(result.map((run) => run.id), ["b", "c", "a", "d"]);
+  assert.notEqual(result, mixedRuns);
+});
+
+test("summarizeRuns avoids floating-point residue in total cost", () => {
+  const result = summarizeRuns([
+    {
+      id: "x",
+      assistant: "Codex",
+      model: "Sol",
+      outcome: "pass",
+      score: 1,
+      elapsedSeconds: 1,
+      costUsd: 0.04,
+    },
+    {
+      id: "y",
+      assistant: "Codex",
+      model: "Sol",
+      outcome: "pass",
+      score: 2,
+      elapsedSeconds: 2,
+      costUsd: 0.02,
+    },
+    {
+      id: "z",
+      assistant: "Codex",
+      model: "Sol",
+      outcome: "pass",
+      score: 3,
+      elapsedSeconds: 3,
+      costUsd: null,
+    },
+  ]);
+  assert.equal(result.totalCostUsd, 0.06);
+  assert.equal(result.costedRunCount, 2);
+});
+
+test("summarizeRuns returns zeros for an empty array", () => {
+  assert.deepEqual(summarizeRuns([]), {
+    visibleCount: 0,
+    passRatePct: 0,
+    medianElapsedSeconds: 0,
+    totalCostUsd: 0,
+    costedRunCount: 0,
+  });
+});
