     if (!pending) {
-      pending = Promise.resolve()
+      const load = Promise.resolve()
         .then(() => loadFromOrigin(key))
         .then(normalizeConfig);
+
+      // A failed load must not stay cached, or every later read replays the
+      // same rejection. Only drop the entry if this load still owns the key,
+      // so a late failure cannot evict a replacement installed after a clear.
+      load.catch(() => {
+        if (entries.get(key) === load) {
+          entries.delete(key);
+        }
+      });
+
+      pending = load;
       entries.set(key, pending);
     }
 
