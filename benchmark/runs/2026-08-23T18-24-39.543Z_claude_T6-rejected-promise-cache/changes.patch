+import { createConfigApi } from "./config-api.mjs";
+import { ConfigOriginError, createConfigCache } from "./config-cache.mjs";
+
+const CONFIG = Object.freeze({ version: "v1", features: Object.freeze(["search"]) });
+
+/** Flush pending microtasks so an in-flight origin load has actually started. */
+function tick() {
+  return new Promise((resolve) => setImmediate(resolve));
+}
+
+function deferred() {
+  let settle;
+  const promise = new Promise((resolve, reject) => {
+    settle = { resolve, reject };
+  });
+  promise.catch(() => {});
+  return { promise, ...settle };
+}
+
+test("every read after a failure calls the origin again instead of replaying it", async () => {
+  const seen = [];
+  const cache = createConfigCache(async (tenantId) => {
+    seen.push(tenantId);
+    if (seen.length <= 3) {
+      throw new ConfigOriginError("origin timeout");
+    }
+    return CONFIG;
+  });
+
+  for (let attempt = 0; attempt < 3; attempt += 1) {
+    await assert.rejects(cache.getConfig("acme"), ConfigOriginError);
+    assert.equal(cache.size(), 0, "a failed load must not stay in the cache");
+  }
+
+  assert.deepEqual(await cache.getConfig("acme"), CONFIG);
+  assert.deepEqual(seen, ["acme", "acme", "acme", "acme"]);
+});
+
+test("callers waiting on one failing load share it, and the next read retries", async () => {
+  const origin = deferred();
+  let calls = 0;
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    return calls === 1 ? origin.promise : CONFIG;
+  });
+
+  const first = cache.getConfig("acme");
+  const second = cache.getConfig("acme");
+  await tick();
+
+  const failure = new ConfigOriginError("origin timeout");
+  origin.reject(failure);
+
+  const settled = await Promise.allSettled([first, second]);
+  assert.deepEqual(
+    settled.map((result) => result.status),
+    ["rejected", "rejected"],
+  );
+  assert.equal(settled[0].reason, failure);
+  assert.equal(settled[1].reason, failure, "waiters share the same in-flight failure");
+  assert.equal(calls, 1, "the shared failure must not fan out into extra origin calls");
+
+  assert.deepEqual(await cache.getConfig("acme"), CONFIG);
+  assert.equal(calls, 2);
+});
+
+test("a late failure does not evict the replacement installed after a clear", async () => {
+  const slowFailure = deferred();
+  const loaded = [];
+  const cache = createConfigCache(async (tenantId) => {
+    loaded.push(tenantId);
+    return loaded.length === 1
+      ? slowFailure.promise
+      : { version: "v2", features: ["search"] };
+  });
+
+  const stale = cache.getConfig("acme");
+  await tick();
+
+  cache.clear("acme");
+  const replacement = await cache.getConfig("acme");
+  assert.deepEqual(replacement, { version: "v2", features: ["search"] });
+
+  slowFailure.reject(new ConfigOriginError("late timeout"));
+  await assert.rejects(stale, ConfigOriginError);
+  await tick();
+
+  assert.equal(cache.size(), 1, "the replacement entry must survive the late failure");
+  assert.deepEqual(await cache.getConfig("acme"), { version: "v2", features: ["search"] });
+  assert.equal(loaded.length, 2, "the surviving entry must still be served from cache");
+});
+
+test("one failing tenant does not disturb a cached healthy tenant", async () => {
+  const calls = { acme: 0, beta: 0 };
+  const cache = createConfigCache(async (tenantId) => {
+    calls[tenantId] += 1;
+    if (tenantId === "acme") {
+      throw new ConfigOriginError("origin timeout");
+    }
+    return CONFIG;
+  });
+
+  await cache.getConfig("beta");
+  await assert.rejects(cache.getConfig("acme"), ConfigOriginError);
+  await assert.rejects(cache.getConfig("acme"), ConfigOriginError);
+
+  const beta = await cache.getConfig("beta");
+  beta.features.push("mutated");
+
+  assert.deepEqual(calls, { acme: 2, beta: 1 }, "successful entries must stay cached");
+  assert.deepEqual(await cache.getConfig("beta"), CONFIG);
+  assert.equal(cache.size(), 1);
+});
+
+test("an invalid origin payload is not cached and later reads recover", async () => {
+  let calls = 0;
+  const cache = createConfigCache(async () => {
+    calls += 1;
+    return calls === 1 ? { version: 7, features: [] } : CONFIG;
+  });
+  const handle = createConfigApi(cache);
+
+  const failed = await handle({ method: "GET", url: "/api/config/acme" });
+  const recovered = await handle({ method: "GET", url: "/api/config/acme" });
+
+  assert.equal(failed.status, 500);
+  assert.deepEqual(failed.body, { error: "config_unavailable" });
+  assert.equal(failed.headers["cache-control"], "no-store");
+  assert.equal(recovered.status, 200);
+  assert.deepEqual(recovered.body, { config: CONFIG });
