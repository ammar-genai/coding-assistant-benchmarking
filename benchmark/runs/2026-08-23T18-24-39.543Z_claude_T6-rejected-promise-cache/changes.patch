+
+test("the API routing and error contract is unchanged", async () => {
+  const cache = createConfigCache(async () => CONFIG);
+  const handle = createConfigApi(cache);
+
+  const ok = await handle({ method: "GET", url: "/api/config/acme" });
+  const wrongMethod = await handle({ method: "POST", url: "/api/config/acme" });
+  const unknown = await handle({ method: "GET", url: "/api/settings/acme" });
