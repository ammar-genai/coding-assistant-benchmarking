{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CeL9f1tHxb4v1guzqs22V","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MuQyvR8JetW44eKCxAYKmY","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-hm2Jmi/checkout/benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createConfigApi } from \"./config-api.mjs\";\nimport { ConfigOriginError, createConfigCache } from \"./config-cache.mjs\";\n\nconst CONFIG = Object.freeze({ version: \"v1\", features: Object.freeze([\"search\"]) });\n\n/** Flush pending microtasks so an in-flight origin load has actually started. */\nfunction tick() {\n  return new Promise((resolve) => setImmediate(resolve));\n}\n\nfunction deferred() {\n  let settle;\n  const promise = new Promise((resolve, reject) => {\n    settle = { resolve, reject };\n  });\n  promise.catch(() => {});\n  return { promise, ...settle };\n}\n\ntest(\"every read after a failure calls the origin again instead of replaying it\", async () => {\n  const seen = [];\n  const cache = createConfigCache(async (tenantId) => {\n    seen.push(tenantId);\n    if (seen.length <= 3) {\n      throw new ConfigOriginError(\"origin timeout\");\n    }\n    return CONFIG;\n  });\n\n  for (let attempt = 0; attempt < 3; attempt += 1) {\n    await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n    assert.equal(cache.size(), 0, \"a failed load must not stay in the cache\");\n  }\n\n  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n  assert.deepEqual(seen, [\"acme\", \"acme\", \"acme\", \"acme\"]);\n});\n\ntest(\"callers waiting on one failing load share it, and the next read retries\", async () => {\n  const origin = deferred();\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return calls === 1 ? origin.promise : CONFIG;\n  });\n\n  const first = cache.getConfig(\"acme\");\n  const second = cache.getConfig(\"acme\");\n  await tick();\n\n  const failure = new ConfigOriginError(\"origin timeout\");\n  origin.reject(failure);\n\n  const settled = await Promise.allSettled([first, second]);\n  assert.deepEqual(\n    settled.map((result) => result.status),\n    [\"rejected\", \"rejected\"],\n  );\n  assert.equal(settled[0].reason, failure);\n  assert.equal(settled[1].reason, failure, \"waiters share the same in-flight failure\");\n  assert.equal(calls, 1, \"the shared failure must not fan out into extra origin calls\");\n\n  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n  assert.equal(calls, 2);\n});\n\ntest(\"a late failure does not evict the replacement installed after a clear\", async () => {\n  const slowFailure = deferred();\n  const loaded = [];\n  const cache = createConfigCache(async (tenantId) => {\n    loaded.push(tenantId);\n    return loaded.length === 1\n      ? slowFailure.promise\n      : { version: \"v2\", features: [\"search\"] };\n  });\n\n  const stale = cache.getConfig(\"acme\");\n  await tick();\n\n  cache.clear(\"acme\");\n  const replacement = await cache.getConfig(\"acme\");\n  assert.deepEqual(replacement, { version: \"v2\", features: [\"search\"] });\n\n  slowFailure.reject(new ConfigOriginError(\"late timeout\"));\n  await assert.rejects(stale, ConfigOriginError);\n  await tick();\n\n  assert.equal(cache.size(), 1, \"the replacement entry must survive the late failure\");\n  assert.deepEqual(await cache.getConfig(\"acme\"), { version: \"v2\", features: [\"search\"] });\n  assert.equal(loaded.length, 2, \"the surviving entry must still be served from cache\");\n});\n\ntest(\"one failing tenant does not disturb a cached healthy tenant\", async () => {\n  const calls = { acme: 0, beta: 0 };\n  const cache = createConfigCache(async (tenantId) => {\n    calls[tenantId] += 1;\n    if (tenantId === \"acme\") {\n      throw new ConfigOriginError(\"origin timeout\");\n    }\n    return CONFIG;\n  });\n\n  await cache.getConfig(\"beta\");\n  await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n  await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n\n  const beta = await cache.getConfig(\"beta\");\n  beta.features.push(\"mutated\");\n\n  assert.deepEqual(calls, { acme: 2, beta: 1 }, \"successful entries must stay cached\");\n  assert.deepEqual(await cache.getConfig(\"beta\"), CONFIG);\n  assert.equal(cache.size(), 1);\n});\n\ntest(\"an invalid origin payload is not cached and later reads recover\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return calls === 1 ? { version: 7, features: [] } : CONFIG;\n  });\n  const handle = createConfigApi(cache);\n\n  const failed = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n  const recovered = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n\n  assert.equal(failed.status, 500);\n  assert.deepEqual(failed.body, { error: \"config_unavailable\" });\n  assert.equal(failed.headers[\"cache-control\"], \"no-store\");\n  assert.equal(recovered.status, 200);\n  assert.deepEqual(recovered.body, { config: CONFIG });\n  assert.equal(calls, 2);\n});\n\ntest(\"the API routing and error contract is unchanged\", async () => {\n  const cache = createConfigCache(async () => CONFIG);\n  const handle = createConfigApi(cache);\n\n  const ok = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n  const wrongMethod = await handle({ method: \"POST\", url: \"/api/config/acme\" });\n  const unknown = await handle({ method: \"GET\", url: \"/api/settings/acme\" });\n  const blankTenant = await handle({ method: \"GET\", url: \"/api/config/%20\" });\n\n  assert.equal(ok.status, 200);\n  assert.equal(ok.headers[\"content-type\"], \"application/json; charset=utf-8\");\n  assert.equal(wrongMethod.status, 405);\n  assert.equal(wrongMethod.headers.allow, \"GET\");\n  assert.equal(unknown.status, 404);\n  assert.equal(blankTenant.status, 400);\n  assert.deepEqual(blankTenant.body, { error: \"invalid_tenant\" });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1010,"cache_read_input_tokens":17876,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1010},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e7197c1d-8495-42ce-9b3d-b74a0e04e6d6","uuid":"99b5429f-673d-4284-a71f-2976273b128e","timestamp":"2026-08-23T18:26:36.128Z","request_id":"req_011CeL9ezxyyLXvTdtmV3qDa"}
