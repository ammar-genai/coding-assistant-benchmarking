entries.get(key) === load) {\n          entries.delete(key);\n        }\n      });\n\n      pending = load;\n      entries.set(key, pending);\n    }\n\n    return copyConfig(await pending);\n  }\n\n  function clear(tenantId) {","numLines":28,"startLine":45,"totalLines":87}}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CeL9oN3iWAQdZxJdaZDZW","type":"message","role":"assistant","content":[{"type":"text","text":"Now the incident write-up:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":544,"cache_read_input_tokens":32174,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":544},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e7197c1d-8495-42ce-9b3d-b74a0e04e6d6","uuid":"fba73e93-0e63-4bb9-a8ef-4c9dc550b233","timestamp":"2026-08-23T18:27:40.277Z","request_id":"req_011CeL9oLm5SUAecU1WrHUbj"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CeL9oN3iWAQdZxJdaZDZW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013Tg269vSnNFLpMXUUpZwMj","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-hm2Jmi/checkout/benchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md","content":"# Config-read incident\n\n## Summary\n\nThe configuration cache stored the *promise* of an origin load, and it kept\nstoring it even when that load failed. One transient origin timeout was\ntherefore remembered permanently: every later read for the same tenant awaited\nthe same already-rejected promise and received the same original error, without\never contacting the origin again. The cache now removes a failed load once it\nsettles, so the next read is a fresh miss that retries the origin.\n\n## User impact\n\nFor tenant `acme`, config reads kept returning `503\nconfig_origin_unavailable` with `retry-after: 1` after the origin had already\nrecovered. The failure was sticky rather than transient: it would have lasted\nuntil someone called `clear()` or restarted the process, and clients honoring\n`retry-after` would have retried into the same cached error indefinitely.\nTenants whose first load succeeded were unaffected, which made the outage look\npartial and tenant-specific.\n\n## Root cause and evidence\n\n`createConfigCache` stored the in-flight promise as the cache entry:\n\n```js\npending = Promise.resolve().then(() => loadFromOrigin(key)).then(normalizeConfig);\nentries.set(key, pending);\n```\n\nNothing ever removed that entry on failure. A rejected promise is a perfectly\ngood cache hit as far as the `Map` is concerned: `entries.get(key)` returns it,\n`await pending` re-throws the *stored* rejection reason, and the origin is never\ncalled again. This is a negative-caching bug, not an origin bug.\n\n`incident.log` shows exactly that shape:\n\n- `request=cfg-781 attempt=1 cache=miss status=503 error=origin_timeout` — the\n  one real origin call, which timed out.\n- `request=cfg-782 attempt=2 cache=hit` and `request=cfg-783 attempt=3\n  cache=hit` — both `503` with the *same* `error=origin_timeout`, replayed from\n  the stored rejection.\n- `request_count=3 origin_load_count=1` — three requests, one origin load. The\n  process never retried, so the origin's recovery could not be observed.\n\nThe committed test `retries the origin after a transient load failure` fails\nagainst the original code with the first attempt's `ConfigOriginError`, and the\nAPI-level test returns `503` where `200` is expected.\n\n## Why the logs were misleading\n\nThe log invites two wrong conclusions:\n\n- **The healthy probe looks like a contradiction.** At `18.407Z` the\n  `origin-probe` reports `status=200 latency_ms=31`, and the incident line ends\n  with `upstream_probe=healthy`. That tempts you to blame the probe (wrong\n  endpoint, wrong host, stale check) or to suspect flapping at the origin. The\n  probe was right: the origin genuinely was healthy. The application simply\n  never asked it again, so the probe and the request path were reporting on two\n  different things.\n- **`cache=hit` reads like the cache is working.** A hit is normally the\n  healthy, fast path, so the eye slides past it and settles on\n  `error=origin_timeout`, pointing the investigation at the network or the\n  origin. The critical detail is that a *hit* produced a `503`: the entry being\n  hit was a stored failure. `origin_load_count=1` against `request_count=3` is\n  the confirming signal — if the origin were the problem, the load count would\n  have tracked the request count.\n\n## Fix and regression coverage\n\n`config-cache.mjs` now attaches a cleanup handler when it creates a load:\n\n```js\nload.catch(() => {\n  if (entries.get(key) === load) {\n    entries.delete(key);\n  }\n});\n```\n\nThree properties matter here:\n\n- Only *failed* loads are removed, so successful entries stay cached and are not\n  evicted just to make retries pass.\n- The identity check `entries.get(key) === load` removes only the entry that\n  this load owns. If the key was explicitly cleared and refilled while the first\n  load was still running, the first load's late failure finds a different\n  promise under the key and leaves the replacement alone.\n- Coalescing is unchanged. Callers already waiting on the failing load still\n  share it and all see the same error; only the *next* read is a fresh miss.\n\n`config-api.mjs` was not changed; its status mapping was already correct once\nthe cache stopped replaying failures.\n\n`student-tests.mjs` covers:\n\n1. Repeated reads after a failure each call the origin again, and no failed\n   entry is left behind (`size() === 0`) — the incident itself.\n2. Concurrent waiters on one failing load share a single origin call and the\n   same error object, and the next read retries — coalescing is preserved.\n3. A late failure does not evict a replacement installed after `clear()` — the\n   guard against an over-broad \"delete on any failure\" fix. This test passes\n   against the original code too; it exists so a future fix cannot regress it.\n4. A failing tenant does not disturb a cached healthy tenant, and cached\n   successes are still returned as isolated copies — the guard against fixing\n   retries by weakening caching.\n5. An invalid origin payload (a validation failure rather than a transport\n   failure) is also not cached, and the API returns `500` then `200`.\n6. The API routing and error contract (`200`/`400`/`404`/`405`, `no-store`,\n   `allow: GET`) is unchanged.\n\nWith the cleanup handler removed, tests 1, 2, 4 and 5 fail, along with both\ncommitted recovery tests; with it in place all 11 tests pass.\n\n## Remaining risk\n\nThere is no backoff or circuit breaking. Now that failures are no longer\ncached, a sustained origin outage means every incoming request becomes an origin\ncall, so a slow or failing origin is exposed to the full request rate instead of\none load per tenant. Concurrent requests are still coalesced, which bounds this\nto roughly one in-flight load per tenant at a time, but a broad outage across\nmany tenants could add load to an origin that is already struggling. If that\nbecomes a problem, the right follow-up is a short, explicit negative-cache TTL\nor a circuit breaker with a deliberate cooldown — not a return to caching\nfailures forever. Separately, successful entries still have no TTL, so a tenant's\nconfig stays cached until `clear()` is called.\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":544,"cache_read_input_tokens":32174,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":544},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e7197c1d-8495-42ce-9b3d-b74a0e04e6d6","uuid":"a93ea1bf-66d3-4ae7-8ade-a71f2ab2a6ba","timestamp":"2026-08-23T18:28:10.018Z","request_id":"req_011CeL9oLm5SUAecU1WrHUbj"}
