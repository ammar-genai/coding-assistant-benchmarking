{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XgbwH8LFWkNcUXgsU91vv3","type":"tool_result","content":"1\timport assert from \"node:assert/strict\";\n2\timport test from \"node:test\";\n3\t\n4\timport { createConfigApi } from \"./config-api.mjs\";\n5\timport { ConfigOriginError, createConfigCache } from \"./config-cache.mjs\";\n6\t\n7\tconst CONFIG = Object.freeze({ version: \"v1\", features: Object.freeze([\"search\"]) });\n8\t\n9\ttest(\"caches successful loads and returns isolated copies\", async () => {\n10\t  let calls = 0;\n11\t  const cache = createConfigCache(async () => {\n12\t    calls += 1;\n13\t    return CONFIG;\n14\t  });\n15\t\n16\t  const first = await cache.getConfig(\"acme\");\n17\t  first.features.push(\"mutated\");\n18\t  const second = await cache.getConfig(\" acme \");\n19\t\n20\t  assert.equal(calls, 1);\n21\t  assert.deepEqual(second, { version: \"v1\", features: [\"search\"] });\n22\t  assert.notEqual(first, second);\n23\t});\n24\t\n25\ttest(\"coalesces concurrent cache misses for one tenant\", async () => {\n26\t  let release;\n27\t  let calls = 0;\n28\t  const origin = new Promise((resolve) => {\n29\t    release = resolve;\n30\t  });\n31\t  const cache = createConfigCache(async () => {\n32\t    calls += 1;\n33\t    return origin;\n34\t  });\n35\t\n36\t  const first = cache.getConfig(\"acme\");\n37\t  const second = cache.getConfig(\"acme\");\n38\t  release(CONFIG);\n39\t\n40\t  assert.deepEqual(await Promise.all([first, second]), [CONFIG, CONFIG]);\n41\t  assert.equal(calls, 1);\n42\t});\n43\t\n44\ttest(\"retries the origin after a transient load failure\", async () => {\n45\t  let calls = 0;\n46\t  const cache = createConfigCache(async () => {\n47\t    calls += 1;\n48\t    if (calls === 1) {\n49\t      throw new ConfigOriginError(\"temporary timeout\");\n50\t    }\n51\t    return CONFIG;\n52\t  });\n53\t\n54\t  await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n55\t  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n56\t  assert.equal(calls, 2);\n57\t});\n58\t\n59\ttest(\"the API recovers on the request after a transient origin failure\", async () => {\n60\t  let calls = 0;\n61\t  const cache = createConfigCache(async () => {\n62\t    calls += 1;\n63\t    if (calls === 1) {\n64\t      throw new ConfigOriginError(\"temporary timeout\");\n65\t    }\n66\t    return CONFIG;\n67\t  });\n68\t  const handle = createConfigApi(cache);\n69\t\n70\t  const failed = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n71\t  const recovered = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n72\t\n73\t  assert.equal(failed.status, 503);\n74\t  assert.equal(failed.headers[\"retry-after\"], \"1\");\n75\t  assert.equal(recovered.status, 200);\n76\t  assert.deepEqual(recovered.body, { config: CONFIG });\n77\t});\n78\t\n79\ttest(\"keeps tenants separate and supports targeted invalidation\", async () => {\n80\t  const calls = [];\n81\t  const cache = createConfigCache(async (tenantId) => {\n82\t    calls.push(tenantId);\n83\t    return { version: `${tenantId}-${calls.length}`, features: [] };\n84\t  });\n85\t\n86\t  await cache.getConfig(\"acme\");\n87\t  await cache.getConfig(\"beta\");\n88\t  cache.clear(\"acme\");\n89\t  await cache.getConfig(\"acme\");\n90\t\n91\t  assert.deepEqual(calls, [\"acme\", \"beta\", \"acme\"]);\n92\t  assert.equal(cache.size(), 2);\n93\t});\n94\t"}]},"parent_tool_use_id":null,"session_id":"e7197c1d-8495-42ce-9b3d-b74a0e04e6d6","uuid":"8459b6b0-add9-4cbc-933d-363df512bca7","timestamp":"2026-08-23T18:24:50.419Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-hm2Jmi/checkout/benchmark/fixtures/T6-rejected-promise-cache/config-cache.test.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { createConfigApi } from \"./config-api.mjs\";\nimport { ConfigOriginError, createConfigCache } from \"./config-cache.mjs\";\n\nconst CONFIG = Object.freeze({ version: \"v1\", features: Object.freeze([\"search\"]) });\n\ntest(\"caches successful loads and returns isolated copies\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return CONFIG;\n  });\n\n  const first = await cache.getConfig(\"acme\");\n  first.features.push(\"mutated\");\n  const second = await cache.getConfig(\" acme \");\n\n  assert.equal(calls, 1);\n  assert.deepEqual(second, { version: \"v1\", features: [\"search\"] });\n  assert.notEqual(first, second);\n});\n\ntest(\"coalesces concurrent cache misses for one tenant\", async () => {\n  let release;\n  let calls = 0;\n  const origin = new Promise((resolve) => {\n    release = resolve;\n  });\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    return origin;\n  });\n\n  const first = cache.getConfig(\"acme\");\n  const second = cache.getConfig(\"acme\");\n  release(CONFIG);\n\n  assert.deepEqual(await Promise.all([first, second]), [CONFIG, CONFIG]);\n  assert.equal(calls, 1);\n});\n\ntest(\"retries the origin after a transient load failure\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      throw new ConfigOriginError(\"temporary timeout\");\n    }\n    return CONFIG;\n  });\n\n  await assert.rejects(cache.getConfig(\"acme\"), ConfigOriginError);\n  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n  assert.equal(calls, 2);\n});\n\ntest(\"the API recovers on the request after a transient origin failure\", async () => {\n  let calls = 0;\n  const cache = createConfigCache(async () => {\n    calls += 1;\n    if (calls === 1) {\n      throw new ConfigOriginError(\"temporary timeout\");\n    }\n    return CONFIG;\n  });\n  const handle = createConfigApi(cache);\n\n  const failed = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n  const recovered = await handle({ method: \"GET\", url: \"/api/config/acme\" });\n\n  assert.equal(failed.status, 503);\n  assert.equal(failed.headers[\"retry-after\"], \"1\");\n  assert.equal(recovered.status, 200);\n  assert.deepEqual(recovered.body, { config: CONFIG });\n});\n\ntest(\"keeps tenants separate and supports targeted invalidation\", async () => {\n  const calls = [];\n  const cache = createConfigCache(async (tenantId) => {\n    calls.push(tenantId);\n    return { version: `${tenantId}-${calls.length}`, features: [] };\n  });\n\n  await cache.getConfig(\"acme\");\n  await cache.getConfig(\"beta\");\n  cache.clear(\"acme\");\n  await cache.getConfig(\"acme\");\n\n  assert.deepEqual(calls, [\"acme\", \"beta\", \"acme\"]);\n  assert.equal(cache.size(), 2);\n});\n","numLines":94,"startLine":1,"totalLines":94}}}
