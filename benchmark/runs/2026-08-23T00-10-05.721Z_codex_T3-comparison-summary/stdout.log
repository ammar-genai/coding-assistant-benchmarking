(\n+      typeof summary?.assistant !== \"string\" ||\n+      summary.assistant.length === 0 ||\n+      typeof summary.best_run_id !== \"string\" ||\n+      summary.best_run_id.length === 0 ||\n+      !Number.isInteger(summary.run_count) ||\n+      summary.run_count <= 0 ||\n+      typeof summary.best_score !== \"number\" ||\n+      !Number.isFinite(summary.best_score) ||\n+      summary.best_score < 0 ||\n+      summary.best_score > 100 ||\n+      typeof summary.median_elapsed_ms !== \"number\" ||\n+      !Number.isFinite(summary.median_elapsed_ms) ||\n+      summary.median_elapsed_ms < 0\n+    ) {\n+      throw new TypeError(\"summary contains invalid fields\");\n+    }\n+\n+    const assistant = summary.assistant.replaceAll(\"|\", \"\\\\|\");\n+    const bestRunId = summary.best_run_id.replaceAll(\"|\", \"\\\\|\");\n+    const medianSeconds = (summary.median_elapsed_ms / 1_000).toFixed(3);\n+\n+    lines.push(\n+      `| ${assistant} | ${summary.run_count} | ${summary.best_score} | ${bestRunId} | ${medianSeconds} s |`,\n+    );\n+  }\n+\n+  if (summaries.length === 0) {\n+    lines.push(\"\", \"_No eligible runs._\");\n+  }\n+\n+  return lines.join(\"\\n\");\n }\ndiff --git a/benchmark/fixtures/T3-comparison-summary/student-tests.mjs b/benchmark/fixtures/T3-comparison-summary/student-tests.mjs\nindex 27384fc..5015df7 100644\n--- a/benchmark/fixtures/T3-comparison-summary/student-tests.mjs\n+++ b/benchmark/fixtures/T3-comparison-summary/student-tests.mjs\n@@ -1,2 +1,78 @@\n // Add at least two meaningful node:test cases for the feature contract.\n // Do not copy or modify the committed comparison-summary.test.mjs suite.\n+import assert from \"node:assert/strict\";\n+import test from \"node:test\";\n+\n+import { renderComparisonTable } from \"./render-comparison-table.mjs\";\n+import { summarizeAssistants } from \"./summarize-assistants.mjs\";\n+\n+const eligibleRun = (overrides = {}) => ({\n+  run_id: \"run-b\",\n+  assistant: \"Assistant\",\n+  status: \"complete\",\n+  acceptance_status: \"pass\",\n+  score: 90,\n+  elapsed_ms: 100,\n+  ...overrides,\n+});\n+\n+test(\"uses numeric medians and run ID as the final best-run tie-break\", () => {\n+  const summaries = summarizeAssistants([\n+    eligibleRun({ run_id: \"run-b\", elapsed_ms: 10 }),\n+    eligibleRun({ run_id: \"run-a\", elapsed_ms: 10 }),\n+    eligibleRun({ run_id: \"run-c\", score: 80, elapsed_ms: 2 }),\n+    eligibleRun({ run_id: \"run-d\", score: 70, elapsed_ms: 100 }),\n+  ]);\n+\n+  assert.deepEqual(summaries, [\n+    {\n+      assistant: \"Assistant\",\n+      run_count: 4,\n+      best_score: 90,\n+      best_run_id: \"run-a\",\n+      median_elapsed_ms: 10,\n+    },\n+  ]);\n+});\n+\n+test(\"ignores invalid fields on ineligible runs but rejects them on eligible runs\", () => {\n+  assert.deepEqual(\n+    summarizeAssistants([\n+      null,\n+      { status: \"incomplete\", score: Number.NaN },\n+      eligibleRun({ comparison_eligible: false, run_id: \"\" }),\n+    ]),\n+    [],\n+  );\n+\n+  assert.throws(\n+    () => summarizeAssistants([eligibleRun({ elapsed_ms: Number.NaN })]),\n+    TypeError,\n+  );\n+});\n+\n+test(\"preserves summary order and validates every rendered field\", () => {\n+  const first = {\n+    assistant: \"Zulu\",\n+    run_count: 1,\n+    best_score: 100,\n+    best_run_id: \"z-run\",\n+    median_elapsed_ms: 1,\n+  };\n+  const second = {\n+    assistant: \"Alpha\",\n+    run_count: 2,\n+    best_score: 50,\n+    best_run_id: \"a-run\",\n+    median_elapsed_ms: 2_345.5,\n+  };\n+\n+  assert.equal(\n+    renderComparisonTable([first, second]).split(\"\\n\")[2],\n+    \"| Zulu | 1 | 100 | z-run | 0.001 s |\",\n+  );\n+  assert.throws(\n+    () => renderComparisonTable([first, { ...second, run_count: 1.5 }]),\n+    TypeError,\n+  );\n+});\ndiff --git a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs\nindex 3fe2216..61eab82 100644\n--- a/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs\n+++ b/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs\n@@ -6,5 +6,72 @@ export function summarizeAssistants(runs) {\n     throw new TypeError(\"runs must be an array\");\n   }\n \n-  return [];\n+  const runsByAssistant = new Map();\n+\n+  for (const run of runs) {\n+    const isEligible =\n+      run?.status === \"complete\" &&\n+      run?.acceptance_status === \"pass\" &&\n+      run?.comparison_eligible !== false;\n+\n+    if (!isEligible) {\n+      continue;\n+    }\n+\n+    if (\n+      typeof run.run_id !== \"string\" ||\n+      run.run_id.length === 0 ||\n+      typeof run.assistant !== \"string\" ||\n+      run.assistant.length === 0 ||\n+      typeof run.score !== \"number\" ||\n+      !Number.isFinite(run.score) ||\n+      run.score < 0 ||\n+      run.score > 100 ||\n+      typeof run.elapsed_ms !== \"number\" ||\n+      !Number.isFinite(run.elapsed_ms) ||\n+      run.elapsed_ms < 0\n+    ) {\n+      throw new TypeError(\"eligible run contains invalid fields\");\n+    }\n+\n+    const assistantRuns = runsByAssistant.get(run.assistant);\n+    if (assistantRuns) {\n+      assistantRuns.push(run);\n+    } else {\n+      runsByAssistant.set(run.assistant, [run]);\n+    }\n+  }\n+\n+  return [...runsByAssistant.entries()]\n+    .sort(([assistantA], [assistantB]) =>\n+      assistantA < assistantB ? -1 : assistantA > assistantB ? 1 : 0,\n+    )\n+    .map(([assistant, assistantRuns]) => {\n+      const bestRun = assistantRuns.reduce((best, run) => {\n+        if (run.score !== best.score) {\n+          return run.score > best.score ? run : best;\n+        }\n+        if (run.elapsed_ms !== best.elapsed_ms) {\n+          return run.elapsed_ms < best.elapsed_ms ? run : best;\n+        }\n+        return run.run_id < best.run_id ? run : best;\n+      });\n+      const elapsedTimes = assistantRuns\n+        .map((run) => run.elapsed_ms)\n+        .sort((a, b) => a - b);\n+      const middle = Math.floor(elapsedTimes.length / 2);\n+      const medianElapsedMs =\n+        elapsedTimes.length % 2 === 0\n+          ? elapsedTimes[middle - 1] +\n+            (elapsedTimes[middle] - elapsedTimes[middle - 1]) / 2\n+          : elapsedTimes[middle];\n+\n+      return {\n+        assistant,\n+        run_count: assistantRuns.length,\n+        best_score: bestRun.score,\n+        best_run_id: bestRun.run_id,\n+        median_elapsed_ms: medianElapsedMs,\n+      };\n+    });\n }\n","exit_code":0,"status":"completed"}}
