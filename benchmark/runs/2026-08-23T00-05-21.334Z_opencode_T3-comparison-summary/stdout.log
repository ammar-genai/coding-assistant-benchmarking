{"type":"tool_use","timestamp":1787443537071,"sessionID":"ses_fd41055b7ffePZG3ZUGYnYPSRR","part":{"type":"tool","tool":"write","callID":"call_igm41e6v","state":{"status":"completed","input":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"throws TypeError when runs is not an array\", () => {\n  assert.throws(() => summarizeAssistants(null), TypeError);\n  assert.throws(() => summarizeAssistants(\"runs\"), TypeError);\n});\n\ntest(\"validates eligible runs and ignores invalid fields on ineligible runs\", () => {\n  const ineligible = {\n    run_id: \"bad\",\n    assistant: \"\",\n    status: \"running\",\n    acceptance_status: \"pass\",\n    score: \"not-a-number\",\n    elapsed_ms: -5,\n  };\n  assert.deepEqual(summarizeAssistants([ineligible]), []);\n\n  const invalidEligible = {\n    run_id: \"ok\",\n    assistant: \"Assistant\",\n    status: \"complete\",\n    acceptance_status: \"pass\",\n    score: 101,\n    elapsed_ms: 10,\n  };\n  assert.throws(() => summarizeAssistants([invalidEligible]), TypeError);\n});\n\ntest(\"breaks a best-score tie by lower elapsed time then smaller run_id\", () => {\n  const runs = [\n    {\n      run_id: \"b\",\n      assistant: \"Assistant\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 90,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \"a\",\n      assistant: \"Assistant\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 90,\n      elapsed_ms: 100,\n    },\n    {\n      run_id: \"c\",\n      assistant: \"Assistant\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 90,\n      elapsed_ms: 50,\n    },\n  ];\n  assert.equal(summarizeAssistants(runs)[0].best_run_id, \"c\");\n});\n\ntest(\"computes median over all eligible runs with an even count\", () => {\n  const runs = [\n    { run_id: \"1\", assistant: \"Assistant\", status: \"complete\", acceptance_status: \"pass\", score: 80, elapsed_ms: 1_000 },\n    { run_id: \"2\", assistant: \"Assistant\", status: \"complete\", acceptance_status: \"pass\", score: 60, elapsed_ms: 3_000 },\n    { run_id: \"3\", assistant: \"Assistant\", status: \"complete\", acceptance_status: \"pass\", score: 70, elapsed_ms: 2_000 },\n    { run_id: \"4\", assistant: \"Assistant\", status: \"complete\", acceptance_status: \"pass\", score: 90, elapsed_ms: 4_000 },\n  ];\n  const summary = summarizeAssistants(runs)[0];\n  assert.equal(summary.median_elapsed_ms, 2_500);\n  assert.equal(summary.run_count, 4);\n});\n\ntest(\"renderComparisonTable throws on invalid summaries\", () => {\n  assert.throws(\n    () => renderComparisonTable([{ assistant: \"\", run_count: 1, best_score: 50, best_run_id: \"r\", median_elapsed_ms: 10 }]),\n    TypeError,\n  );\n  assert.throws(() => renderComparisonTable(null), TypeError);\n});\n","filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-JC0Zat/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-JC0Zat/checkout/benchmark/fixtures/T3-comparison-summary/student-tests.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/student-tests.mjs","time":{"start":1787443537062,"end":1787443537069}},"id":"prt_02befe4a0001qFtyWXRPJtwJUe","sessionID":"ses_fd41055b7ffePZG3ZUGYnYPSRR","messageID":"msg_02befd5ed001cxBYapvAzxwnIw"}}
