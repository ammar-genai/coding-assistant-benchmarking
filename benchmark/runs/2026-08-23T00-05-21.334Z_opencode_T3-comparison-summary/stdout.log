{"type":"tool_use","timestamp":1787443530964,"sessionID":"ses_fd41055b7ffePZG3ZUGYnYPSRR","part":{"type":"tool","tool":"write","callID":"call_aw8kk7yg","state":{"status":"completed","input":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-JC0Zat/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","content":"/**\n * Build one comparison summary per assistant from raw benchmark run records.\n */\nexport function summarizeAssistants(runs) {\n  if (!Array.isArray(runs)) {\n    throw new TypeError(\"runs must be an array\");\n  }\n\n  const eligible = runs.filter(\n    (run) =>\n      run &&\n      run.status === \"complete\" &&\n      run.acceptance_status === \"pass\" &&\n      run.comparison_eligible !== false,\n  );\n\n  for (const run of eligible) {\n    validateEligibleRun(run);\n  }\n\n  const byAssistant = new Map();\n  for (const run of eligible) {\n    if (!byAssistant.has(run.assistant)) {\n      byAssistant.set(run.assistant, []);\n    }\n    byAssistant.get(run.assistant).push(run);\n  }\n\n  const summaries = [];\n  for (const [assistant, group] of byAssistant.entries()) {\n    const times = group.map((run) => run.elapsed_ms).sort((a, b) => a - b);\n    const mid = Math.floor(times.length / 2);\n    const median =\n      times.length % 2 === 1\n        ? times[mid]\n        : (times[mid - 1] + times[mid]) / 2;\n\n    const best = [...group].sort(compareBest)[0];\n\n    summaries.push({\n      assistant,\n      run_count: group.length,\n      best_score: best.score,\n      best_run_id: best.run_id,\n      median_elapsed_ms: median,\n    });\n  }\n\n  summaries.sort((a, b) => (a.assistant < b.assistant ? -1 : a.assistant > b.assistant ? 1 : 0));\n\n  return summaries;\n}\n\nfunction compareBest(a, b) {\n  if (a.score !== b.score) return b.score - a.score;\n  if (a.elapsed_ms !== b.elapsed_ms) return a.elapsed_ms - b.elapsed_ms;\n  return a.run_id < b.run_id ? -1 : a.run_id > b.run_id ? 1 : 0;\n}\n\nfunction validateEligibleRun(run) {\n  if (\n    typeof run.run_id !== \"string\" ||\n    run.run_id.length === 0 ||\n    typeof run.assistant !== \"string\" ||\n    run.assistant.length === 0\n  ) {\n    throw new TypeError(\"invalid eligible run\");\n  }\n  if (\n    typeof run.score !== \"number\" ||\n    !Number.isFinite(run.score) ||\n    run.score < 0 ||\n    run.score > 100\n  ) {\n    throw new TypeError(\"invalid eligible run score\");\n  }\n  if (\n    typeof run.elapsed_ms !== \"number\" ||\n    !Number.isFinite(run.elapsed_ms) ||\n    run.elapsed_ms < 0\n  ) {\n    throw new TypeError(\"invalid eligible run elapsed_ms\");\n  }\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-JC0Zat/checkout/benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/summarize-assistants.mjs","time":{"start":1787443530953,"end":1787443530963}},"id":"prt_02befccbf001J2yUXomlZSiSha","sessionID":"ses_fd41055b7ffePZG3ZUGYnYPSRR","messageID":"msg_02befc37c0010Z1EUFoMGmCC24"}}
