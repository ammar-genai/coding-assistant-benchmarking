{"type":"tool_use","timestamp":1787443533149,"sessionID":"ses_fd41055b7ffePZG3ZUGYnYPSRR","part":{"type":"tool","tool":"write","callID":"call_0bvhbd3a","state":{"status":"completed","input":{"content":"/**\n * Render assistant summaries as a stable Markdown table.\n */\nexport function renderComparisonTable(summaries) {\n  if (!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n\n  for (const summary of summaries) {\n    validateSummary(summary);\n  }\n\n  const header = \"| Assistant | Runs | Best score | Best run | Median time |\";\n  const separator = \"|---|---:|---:|---|---:|\";\n\n  if (summaries.length === 0) {\n    return [header, separator, \"\", \"_No eligible runs._\"].join(\"\\n\");\n  }\n\n  const rows = summaries.map((summary) => {\n    const assistant = escapePipe(summary.assistant);\n    const bestRunId = escapePipe(summary.best_run_id);\n    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);\n    return `| ${assistant} | ${summary.run_count} | ${summary.best_score} | ${bestRunId} | ${seconds} s |`;\n  });\n\n  return [header, separator, ...rows].join(\"\\n\");\n}\n\nfunction escapePipe(value) {\n  return value.replace(/\\|/g, \"\\\\|\");\n}\n\nfunction validateSummary(summary) {\n  if (\n    typeof summary.assistant !== \"string\" ||\n    summary.assistant.length === 0 ||\n    typeof summary.best_run_id !== \"string\" ||\n    summary.best_run_id.length === 0\n  ) {\n    throw new TypeError(\"invalid summary\");\n  }\n  if (\n    !Number.isInteger(summary.run_count) ||\n    summary.run_count <= 0\n  ) {\n    throw new TypeError(\"invalid summary run_count\");\n  }\n  if (\n    typeof summary.best_score !== \"number\" ||\n    !Number.isFinite(summary.best_score) ||\n    summary.best_score < 0 ||\n    summary.best_score > 100\n  ) {\n    throw new TypeError(\"invalid summary best_score\");\n  }\n  if (\n    typeof summary.median_elapsed_ms !== \"number\" ||\n    !Number.isFinite(summary.median_elapsed_ms) ||\n    summary.median_elapsed_ms < 0\n  ) {\n    throw new TypeError(\"invalid summary median_elapsed_ms\");\n  }\n}\n","filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-JC0Zat/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-JC0Zat/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","time":{"start":1787443533144,"end":1787443533148}},"id":"prt_02befd555001kbDzNvFN167xvR","sessionID":"ses_fd41055b7ffePZG3ZUGYnYPSRR","messageID":"msg_02befcd430015MhC8AUBPeIGjn"}}
