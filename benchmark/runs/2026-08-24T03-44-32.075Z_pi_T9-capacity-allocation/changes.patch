-// Replace this placeholder with at least three meaningful node:test cases.
 import assert from "node:assert/strict";
 import test from "node:test";
 
-test("replace this placeholder with allocation contract tests", () => {
-  assert.fail("Add at least three meaningful tests");
+import { allocateCapacity } from "./allocation-engine.mjs";
+
+test("returns rows in original input order, not allocation order", () => {
+  const requests = [
+    { id: "low", desk: "ABS", requested: 50, priority: 1, submittedAt: "2026-08-23T09:00:00Z" },
+    { id: "high", desk: "ABS", requested: 50, priority: 5, submittedAt: "2026-08-23T10:00:00Z" },
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { ABS: 60 }), [
+    { id: "low", allocated: 10, unfilled: 40 },
+    { id: "high", allocated: 50, unfilled: 0 },
+  ]);
+});
+
+test("does not mutate the input array, records, or capacity object", () => {
+  const requestA = { id: "a", desk: "ABS", requested: 30, priority: 2, submittedAt: "2026-08-23T10:00:00Z" };
+  const requestB = { id: "b", desk: "ABS", requested: 30, priority: 1, submittedAt: "2026-08-23T09:00:00Z" };
+  const requests = [requestA, requestB];
+  const capacityByDesk = { ABS: 40 };
+  const snapshot = JSON.parse(JSON.stringify({ requests, capacityByDesk }));
+
+  allocateCapacity(requests, capacityByDesk);
+
+  assert.deepEqual({ requests, capacityByDesk }, snapshot);
+});
+
+test("zero capacity desk allocates nothing and leaves everything unfilled", () => {
+  const requests = [
+    { id: "a", desk: "RMBS", requested: 15, priority: 3, submittedAt: "2026-08-23T10:00:00Z" },
+  ];
+
+  assert.deepEqual(allocateCapacity(requests, { RMBS: 0 }), [
+    { id: "a", allocated: 0, unfilled: 15 },
+  ]);
+});
+
+test("rejects duplicate ids and invalid requests with TypeError", () => {
+  const base = { desk: "ABS", requested: 10, priority: 1, submittedAt: "2026-08-23T10:00:00Z" };
+
+  assert.throws(
+    () => allocateCapacity([{ ...base, id: "a" }, { ...base, id: "a" }], { ABS: 10 }),
+    TypeError,
+  );
+  assert.throws(
+    () => allocateCapacity([{ ...base, id: "" }], { ABS: 10 }),
+    TypeError,
+  );
+  assert.throws(
+    () => allocateCapacity([{ ...base, id: "a", requested: 0 }], { ABS: 10 }),
+    TypeError,
+  );
+  assert.throws(
+    () => allocateCapacity([{ ...base, id: "a", requested: Number.POSITIVE_INFINITY }], { ABS: 10 }),
+    TypeError,
+  );
+  assert.throws(
+    () => allocateCapacity([{ ...base, id: "a", priority: 1.5 }], { ABS: 10 }),
+    TypeError,
+  );
+  assert.throws(
+    () => allocateCapacity([{ ...base, id: "a" }], {}),
+    TypeError,
+  );
+});
+
+test("invalid input does not mutate the provided inputs", () => {
+  const requests = [
+    { id: "a", desk: "ABS", requested: 10, priority: 1, submittedAt: "not-a-date" },
+  ];
+  const capacityByDesk = { ABS: 10 };
+  const snapshot = JSON.parse(JSON.stringify({ requests, capacityByDesk }));
+
+  assert.throws(() => allocateCapacity(requests, capacityByDesk), TypeError);
+  assert.deepEqual({ requests, capacityByDesk }, snapshot);
 });
