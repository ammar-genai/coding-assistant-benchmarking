{"type":"tool_use","timestamp":1787503870837,"sessionID":"ses_fd07aa253ffeA65EQl88ShiV73","part":{"type":"tool","tool":"write","callID":"write:18","state":{"status":"completed","input":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport {\n  filterRuns,\n  sampleRuns,\n  sortRuns,\n  summarizeRuns,\n} from \"./run-explorer.mjs\";\n\nfunction makeRun(overrides) {\n  return Object.freeze({\n    id: \"run-0\",\n    assistant: \"Codex\",\n    model: \"Model\",\n    outcome: \"pass\",\n    score: 50,\n    elapsedSeconds: 10,\n    costUsd: null,\n    ...overrides,\n  });\n}\n\ntest(\"filterRuns rejects non-array input and matches case-sensitively\", () => {\n  const runs = [makeRun({ id: \"a\", assistant: \"Codex\", outcome: \"pass\" })];\n\n  assert.throws(\n    () => filterRuns(null, { assistant: \"all\", outcome: \"all\" }),\n    TypeError,\n  );\n  assert.throws(\n    () => filterRuns(\"Codex\", { assistant: \"all\", outcome: \"all\" }),\n    TypeError,\n  );\n  assert.throws(\n    () => filterRuns({ length: 1 }, { assistant: \"all\", outcome: \"all\" }),\n    TypeError,\n  );\n\n  // Exact, case-sensitive matching: lowercase \"codex\" matches nothing.\n  assert.equal(filterRuns(runs, { assistant: \"codex\", outcome: \"all\" }).length, 0);\n\n  // \"all\" disables both filters and still returns a new array.\n  const all = filterRuns(runs, { assistant: \"all\", outcome: \"all\" });\n  assert.deepEqual(all.map((run) => run.id), [\"a\"]);\n  assert.notEqual(all, runs);\n});\n\ntest(\"sortRuns rejects unsupported orders and non-array input\", () => {\n  const runs = [makeRun({ id: \"a\" })];\n\n  assert.throws(() => sortRuns(null, \"score-desc\"), TypeError);\n  assert.throws(() => sortRuns(runs, \"score-asc\"), TypeError);\n  assert.throws(() => sortRuns(runs, \"\"), TypeError);\n  assert.throws(() => sortRuns(runs, undefined), TypeError);\n});\n\ntest(\"sortRuns time-asc breaks equal elapsed times by score then id\", () => {\n  const runs = [\n    makeRun({ id: \"b-tie-low\", score: 80, elapsedSeconds: 12 }),\n    makeRun({ id: \"a-tie-high\", score: 90, elapsedSeconds: 12 }),\n    makeRun({ id: \"c-quickest\", score: 40, elapsedSeconds: 4 }),\n  ];\n\n  const result = sortRuns(runs, \"time-asc\");\n  assert.deepEqual(\n    result.map((run) => run.id),\n    [\"c-quickest\", \"a-tie-high\", \"b-tie-low\"],\n  );\n  // Input order is untouched.\n  assert.deepEqual(\n    runs.map((run) => run.id),\n    [\"b-tie-low\", \"a-tie-high\", \"c-quickest\"],\n  );\n});\n\ntest(\"sortRuns cost-asc puts known costs first, then nulls by score\", () => {\n  const runs = [\n    makeRun({ id: \"sub-high\", score: 99, costUsd: null }),\n    makeRun({ id: \"pricey\", score: 70, costUsd: 0.2 }),\n    makeRun({ id: \"cheap\", score: 60, costUsd: 0.02 }),\n    makeRun({ id: \"sub-low\", score: 50, costUsd: null }),\n  ];\n\n  const result = sortRuns(runs, \"cost-asc\");\n  assert.deepEqual(\n    result.map((run) => run.id),\n    [\"cheap\", \"pricey\", \"sub-high\", \"sub-low\"],\n  );\n});\n\ntest(\"summarizeRuns returns zeros for an empty array and throws for non-arrays\", () => {\n  assert.deepEqual(summarizeRuns([]), {\n    visibleCount: 0,\n    passRatePct: 0,\n    medianElapsedSeconds: 0,\n    totalCostUsd: 0,\n    costedRunCount: 0,\n  });\n  assert.throws(() => summarizeRuns(undefined), TypeError);\n  assert.throws(() => summarizeRuns(42), TypeError);\n});\n\ntest(\"summarizeRuns averages the middle pair for an even count\", () => {\n  const runs = [\n    makeRun({ id: \"a\", outcome: \"pass\", elapsedSeconds: 10 }),\n    makeRun({ id: \"b\", outcome: \"fail\", elapsedSeconds: 21 }),\n    makeRun({ id: \"c\", outcome: \"fail\", elapsedSeconds: 30 }),\n    makeRun({ id: \"d\", outcome: \"pass\", elapsedSeconds: 45 }),\n  ];\n\n  const summary = summarizeRuns(runs);\n  assert.equal(summary.visibleCount, 4);\n  assert.equal(summary.passRatePct, 50);\n  assert.equal(summary.medianElapsedSeconds, 25.5); // (21 + 30) / 2\n});\n\ntest(\"summarizeRuns avoids floating-point residue and rounds pass rate\", () => {\n  const runs = [\n    makeRun({ id: \"a\", outcome: \"pass\", costUsd: 0.1 }),\n    makeRun({ id: \"b\", outcome: \"fail\", costUsd: 0.2 }),\n    makeRun({ id: \"c\", outcome: \"fail\", costUsd: null }),\n  ];\n\n  const summary = summarizeRuns(runs);\n  assert.equal(summary.totalCostUsd, 0.3); // not 0.30000000000000004\n  assert.equal(summary.costedRunCount, 2);\n  assert.equal(summary.passRatePct, 33.3); // 1/3 rounded to one decimal\n});\n\ntest(\"filter, sort, and summarize compose over the seeded sample runs\", () => {\n  const openCode = filterRuns(sampleRuns, {\n    assistant: \"OpenCode\",\n    outcome: \"all\",\n  });\n  const sorted = sortRuns(openCode, \"time-asc\");\n  assert.deepEqual(\n    sorted.map((run) => run.id),\n    [\"oc-qwen-01\", \"oc-kimi-01\"],\n  );\n  assert.deepEqual(summarizeRuns(openCode), {\n    visibleCount: 2,\n    passRatePct: 50,\n    medianElapsedSeconds: 43.5,\n    totalCostUsd: 0.19,\n    costedRunCount: 2,\n  });\n});\n","filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-C6sy9k/checkout/benchmark/fixtures/T4-run-explorer/student-tests.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-C6sy9k/checkout/benchmark/fixtures/T4-run-explorer/student-tests.mjs","exists":true,"truncated":false},"title":"benchmark/fixtures/T4-run-explorer/student-tests.mjs","time":{"start":1787503870826,"end":1787503870834}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now the student tests. Original edge-case tests, not copying the committed suite.","format":"unknown","index":0}]}},"id":"prt_02f888362001qoHDHXeadrPo56","sessionID":"ses_fd07aa253ffeA65EQl88ShiV73","messageID":"msg_02f886468001ChIWKlW23EPZbN"}}
