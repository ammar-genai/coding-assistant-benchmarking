,"text":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Benchmark run explorer</title>\n    <link rel=\"stylesheet\" href=\"./styles.css\" />\n    <script type=\"module\" src=\"./run-explorer.mjs\"></script>\n  </head>\n  <body>\n    <main>\n      <p>Benchmark evidence</p>\n      <h1>Run explorer</h1>\n      <p>Build the interactive comparison interface described in the task.</p>\n    </main>\n  </body>\n</html>","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"benchmark/fixtures/T4-run-explorer/index.html","time":{"start":1787503681211,"end":1787503681218}},"id":"prt_02f859eb4001V64Q9HiW3wrzJM","sessionID":"ses_fd07aa253ffeA65EQl88ShiV73","messageID":"msg_02f859393001DpFv55o611jkvn"}}
