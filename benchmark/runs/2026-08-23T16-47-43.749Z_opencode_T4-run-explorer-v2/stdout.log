 sortRuns(runs, \"score-desc\");\n47: \n48:   assert.deepEqual(result.map((run) => run.id), [\"opencode-a\", \"codex-a\", \"opencode-b\"]);\n49:   assert.deepEqual(runs.map((run) => run.id), [\"codex-a\", \"opencode-b\", \"opencode-a\"]);\n50: });\n51: \n52: test(\"summarizes the visible runs\", () => {\n53:   assert.deepEqual(summarizeRuns(runs), {\n54:     visibleCount: 3,\n55:     passRatePct: 66.7,\n56:     medianElapsedSeconds: 20,\n57:     totalCostUsd: 0.06,\n58:     costedRunCount: 2,\n59:   });\n60: });\n61: \n62: test(\"ships the required accessible, responsive interface hooks\", async () => {\n63:   const [html, css] = await Promise.all([\n64:     readFile(new URL(\"./index.html\", import.meta.url), \"utf8\"),\n65:     readFile(new URL(\"./styles.css\", import.meta.url), \"utf8\"),\n66:   ]);\n67: \n68:   for (const id of [\"assistant-filter\", \"outcome-filter\", \"sort-order\"]) {\n69:     assert.match(html, new RegExp(`<label[^>]+for=[\"']${id}[\"']`, \"i\"));\n70:     assert.match(html, new RegExp(`<select[^>]+id=[\"']${id}[\"']`, \"i\"));\n71:   }\n72:   assert.match(html, /<main\\b/i);\n73:   assert.match(html, /aria-live=[\"']polite[\"']/i);\n74:   assert.match(html, /id=[\"']reset-filters[\"']/i);\n75:   assert.match(html, /id=[\"']results-list[\"']/i);\n76:   assert.match(html, /id=[\"']empty-state[\"'][^>]+hidden/i);\n77:   assert.match(css, /@media\\s*\\([^)]*max-width\\s*:/i);\n78:   assert.match(css, /:focus-visible/i);\n79:   assert.doesNotMatch(html, /style\\s*=/i);\n80: });\n\n(End of file - total 80 lines)\n</content>","metadata":{"preview":"import assert from \"node:assert/strict\";\nimport { readFile } from \"node:fs/promises\";\nimport test from \"node:test\";\n\nimport { filterRuns, sortRuns, summarizeRuns } from \"./run-explorer.mjs\";\n\nconst runs = Object.freeze([\n  Object.freeze({\n    id: \"codex-a\",\n    assistant: \"Codex\",\n    model: \"Sol\",\n    outcome: \"pass\",\n    score: 94,\n    elapsedSeconds: 24,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"opencode-b\",\n    assistant: \"OpenCode\",\n    model: \"Kimi\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-C6sy9k/checkout/benchmark/fixtures/T4-run-explorer/run-explorer.test.mjs","text":"import assert from \"node:assert/strict\";\nimport { readFile } from \"node:fs/promises\";\nimport test from \"node:test\";\n\nimport { filterRuns, sortRuns, summarizeRuns } from \"./run-explorer.mjs\";\n\nconst runs = Object.freeze([\n  Object.freeze({\n    id: \"codex-a\",\n    assistant: \"Codex\",\n    model: \"Sol\",\n    outcome: \"pass\",\n    score: 94,\n    elapsedSeconds: 24,\n    costUsd: null,\n  }),\n  Object.freeze({\n    id: \"opencode-b\",\n    assistant: \"OpenCode\",\n    model: \"Kimi\",\n    outcome: \"fail\",\n    score: 81,\n    elapsedSeconds: 18,\n    costUsd: 0.04,\n  }),\n  Object.freeze({\n    id: \"opencode-a\",\n    assistant: \"OpenCode\",\n    model: \"Qwen\",\n    outcome: \"pass\",\n    score: 94,\n    elapsedSeconds: 20,\n    costUsd: 0.02,\n  }),\n]);\n\ntest(\"filters by assistant and outcome without mutating the input\", () => {\n  const result = filterRuns(runs, { assistant: \"OpenCode\", outcome: \"pass\" });\n\n  assert.deepEqual(result.map((run) => run.id), [\"opencode-a\"]);\n  assert.notEqual(result, runs);\n  assert.deepEqual(runs.map((run) => run.id), [\"codex-a\", \"opencode-b\", \"opencode-a\"]);\n});\n\ntest(\"sorts score ties by faster elapsed time and then run ID\", () => {\n  const result = sortRuns(runs, \"score-desc\");\n\n  assert.deepEqual(result.map((run) => run.id), [\"opencode-a\", \"codex-a\", \"opencode-b\"]);\n  assert.deepEqual(runs.map((run) => run.id), [\"codex-a\", \"opencode-b\", \"opencode-a\"]);\n});\n\ntest(\"summarizes the visible runs\", () => {\n  assert.deepEqual(summarizeRuns(runs), {\n    visibleCount: 3,\n    passRatePct: 66.7,\n    medianElapsedSeconds: 20,\n    totalCostUsd: 0.06,\n    costedRunCount: 2,\n  });\n});\n\ntest(\"ships the required accessible, responsive interface hooks\", async () => {\n  const [html, css] = await Promise.all([\n    readFile(new URL(\"./index.html\", import.meta.url), \"utf8\"),\n    readFile(new URL(\"./styles.css\", import.meta.url), \"utf8\"),\n  ]);\n\n  for (const id of [\"assistant-filter\", \"outcome-filter\", \"sort-order\"]) {\n    assert.match(html, new RegExp(`<label[^>]+for=[\"']${id}[\"']`, \"i\"));\n    assert.match(html, new RegExp(`<select[^>]+id=[\"']${id}[\"']`, \"i\"));\n  }\n  assert.match(html, /<main\\b/i);\n  assert.match(html, /aria-live=[\"']polite[\"']/i);\n  assert.match(html, /id=[\"']reset-filters[\"']/i);\n  assert.match(html, /id=[\"']results-list[\"']/i);\n  assert.match(html, /id=[\"']empty-state[\"'][^>]+hidden/i);\n  assert.match(css, /@media\\s*\\([^)]*max-width\\s*:/i);\n  assert.match(css, /:focus-visible/i);\n  assert.doesNotMatch(html, /style\\s*=/i);\n});","lineStart":1,"lineEnd":80,"totalLines":80,"truncated":false}},"title":"benchmark/fixtures/T4-run-explorer/run-explorer.test.mjs","time":{"start":1787503672479,"end":1787503672490}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_02f857c96001jG90EqrPrZAaU1","sessionID":"ses_fd07aa253ffeA65EQl88ShiV73","messageID":"msg_02f8575e8001h7XyjPG8A87hhG"}}
