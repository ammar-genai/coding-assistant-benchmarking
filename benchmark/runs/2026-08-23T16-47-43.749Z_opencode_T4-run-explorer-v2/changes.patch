+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow);
+  transition:
+    border-color 150ms ease,
+    transform 150ms ease,
+    box-shadow 150ms ease;
+}
+
+.run-card:hover {
+  border-color: var(--accent);
+  transform: translateY(-2px);
+}
+
+.run-card__head {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  gap: 0.75rem;
+}
+
+.run-card__assistant {
+  margin: 0;
+  font-size: 1.1rem;
+}
+
+.run-card__model {
+  margin: 0.15rem 0 0;
+  color: var(--muted);
+  font-size: 0.9rem;
+  overflow-wrap: break-word;
+}
+
+.outcome {
+  flex-shrink: 0;
+  padding: 0.2rem 0.65rem;
+  border-radius: 999px;
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+}
+
+.outcome--pass {
+  background: var(--pass-bg);
+  color: var(--pass-ink);
+}
+
+.outcome--fail {
+  background: var(--fail-bg);
+  color: var(--fail-ink);
+}
+
+.run-card__stats {
+  margin: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1.25rem;
+}
+
+.run-card__stat {
+  display: grid;
+  gap: 0.1rem;
+}
+
+.run-card__stat dt {
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.run-card__stat dd {
+  margin: 0;
+  font-weight: 600;
+}
+
+/* Empty state */
+
+.empty-state {
   padding: 2rem;
+  background: var(--surface);
+  border: 1px dashed var(--border);
+  border-radius: var(--radius);
+  text-align: center;
+  color: var(--muted);
+}
+
+.empty-state[hidden] {
+  display: none;
+}
+
+.empty-state p {
+  margin: 0;
+}
+
+.empty-state p + p {
+  margin-top: 0.35rem;
+}
+
+.empty-state__title {
+  font-weight: 700;
+  color: var(--ink);
+}
+
+/* Narrow screens: stack controls and results, avoid horizontal scrolling. */
+
+@media (max-width: 720px) {
+  .page {
+    padding: 1.5rem 1rem 2.5rem;
+    gap: 1.25rem;
+  }
+
+  .panel {
+    grid-template-columns: 1fr;
+    align-items: stretch;
+  }
+
+  .summaries {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .results__list {
+    grid-template-columns: 1fr;
+  }
 }
 
-/* Implement the responsive run-explorer design. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+  }
+}
