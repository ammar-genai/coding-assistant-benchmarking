+export function filterRuns(runs, filters) {
+  if (!Array.isArray(runs)) {
+    throw new TypeError("filterRuns expects runs to be an array");
+  }
+  const { assistant = ALL, outcome = ALL } = filters ?? {};
+  return runs.filter(
+    (run) =>
+      (assistant === ALL || run.assistant === assistant) &&
+      (outcome === ALL || run.outcome === outcome),
+  );
+}
+
+function compareIds(a, b) {
+  if (a.id === b.id) {
+    return 0;
+  }
+  return a.id < b.id ? -1 : 1;
+}
+
+function knownCostUsd(run) {
+  return typeof run.costUsd === "number" && Number.isFinite(run.costUsd)
+    ? run.costUsd
+    : null;
+}
+
+const COMPARATORS = {
+  "score-desc": (a, b) =>
+    b.score - a.score || a.elapsedSeconds - b.elapsedSeconds || compareIds(a, b),
+  "time-asc": (a, b) =>
+    a.elapsedSeconds - b.elapsedSeconds || b.score - a.score || compareIds(a, b),
+  "cost-asc": (a, b) => {
+    const aCost = knownCostUsd(a);
+    const bCost = knownCostUsd(b);
+    if (aCost === null && bCost === null) {
+      return b.score - a.score || compareIds(a, b);
+    }
+    if (aCost === null) {
+      return 1;
+    }
+    if (bCost === null) {
+      return -1;
+    }
+    return aCost - bCost || b.score - a.score || compareIds(a, b);
+  },
+};
+
+export function sortRuns(runs, order) {
+  if (!Array.isArray(runs)) {
+    throw new TypeError("sortRuns expects runs to be an array");
+  }
+  const comparator = COMPARATORS[order];
+  if (comparator === undefined) {
+    throw new TypeError(`Unsupported sort order: ${String(order)}`);
+  }
+  return [...runs].sort(comparator);
+}
+
+export function summarizeRuns(runs) {
+  if (!Array.isArray(runs)) {
+    throw new TypeError("summarizeRuns expects runs to be an array");
+  }
+  const visibleCount = runs.length;
+  if (visibleCount === 0) {
+    return {
+      visibleCount: 0,
+      passRatePct: 0,
+      medianElapsedSeconds: 0,
+      totalCostUsd: 0,
+      costedRunCount: 0,
+    };
+  }
+
+  const passCount = runs.reduce(
+    (count, run) => count + (run.outcome === "pass" ? 1 : 0),
+    0,
+  );
+  const passRatePct = Math.round((passCount / visibleCount) * 1000) / 10;
+
+  const elapsedTimes = runs
+    .map((run) => run.elapsedSeconds)
+    .sort((a, b) => a - b);
+  const middle = Math.floor(elapsedTimes.length / 2);
+  const medianElapsedSeconds =
+    elapsedTimes.length % 2 === 1
+      ? elapsedTimes[middle]
+      : (elapsedTimes[middle - 1] + elapsedTimes[middle]) / 2;
+
+  let costCents = 0;
+  let costedRunCount = 0;
+  for (const run of runs) {
+    const cost = knownCostUsd(run);
+    if (cost !== null) {
+      costCents += Math.round(cost * 100);
+      costedRunCount += 1;
+    }
+  }
+
+  return {
+    visibleCount,
+    passRatePct,
+    medianElapsedSeconds,
+    totalCostUsd: costCents / 100,
