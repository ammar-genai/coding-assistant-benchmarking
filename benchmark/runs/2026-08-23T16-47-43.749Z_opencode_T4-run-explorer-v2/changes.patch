-// Add at least two meaningful node:test cases for the run explorer.
-// Do not copy or modify the committed run-explorer.test.mjs suite.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  filterRuns,
+  sampleRuns,
+  sortRuns,
+  summarizeRuns,
+} from "./run-explorer.mjs";
+
+function makeRun(overrides) {
+  return Object.freeze({
+    id: "run-0",
+    assistant: "Codex",
+    model: "Model",
+    outcome: "pass",
+    score: 50,
+    elapsedSeconds: 10,
+    costUsd: null,
+    ...overrides,
+  });
+}
+
+test("filterRuns rejects non-array input and matches case-sensitively", () => {
+  const runs = [makeRun({ id: "a", assistant: "Codex", outcome: "pass" })];
+
+  assert.throws(
+    () => filterRuns(null, { assistant: "all", outcome: "all" }),
+    TypeError,
+  );
+  assert.throws(
+    () => filterRuns("Codex", { assistant: "all", outcome: "all" }),
+    TypeError,
+  );
+  assert.throws(
+    () => filterRuns({ length: 1 }, { assistant: "all", outcome: "all" }),
+    TypeError,
+  );
+
+  // Exact, case-sensitive matching: lowercase "codex" matches nothing.
+  assert.equal(filterRuns(runs, { assistant: "codex", outcome: "all" }).length, 0);
+
+  // "all" disables both filters and still returns a new array.
+  const all = filterRuns(runs, { assistant: "all", outcome: "all" });
+  assert.deepEqual(all.map((run) => run.id), ["a"]);
+  assert.notEqual(all, runs);
+});
+
+test("sortRuns rejects unsupported orders and non-array input", () => {
+  const runs = [makeRun({ id: "a" })];
+
+  assert.throws(() => sortRuns(null, "score-desc"), TypeError);
+  assert.throws(() => sortRuns(runs, "score-asc"), TypeError);
+  assert.throws(() => sortRuns(runs, ""), TypeError);
+  assert.throws(() => sortRuns(runs, undefined), TypeError);
+});
+
+test("sortRuns time-asc breaks equal elapsed times by score then id", () => {
+  const runs = [
+    makeRun({ id: "b-tie-low", score: 80, elapsedSeconds: 12 }),
+    makeRun({ id: "a-tie-high", score: 90, elapsedSeconds: 12 }),
+    makeRun({ id: "c-quickest", score: 40, elapsedSeconds: 4 }),
+  ];
+
+  const result = sortRuns(runs, "time-asc");
+  assert.deepEqual(
+    result.map((run) => run.id),
+    ["c-quickest", "a-tie-high", "b-tie-low"],
+  );
+  // Input order is untouched.
+  assert.deepEqual(
+    runs.map((run) => run.id),
+    ["b-tie-low", "a-tie-high", "c-quickest"],
+  );
+});
+
+test("sortRuns cost-asc puts known costs first, then nulls by score", () => {
+  const runs = [
+    makeRun({ id: "sub-high", score: 99, costUsd: null }),
+    makeRun({ id: "pricey", score: 70, costUsd: 0.2 }),
+    makeRun({ id: "cheap", score: 60, costUsd: 0.02 }),
+    makeRun({ id: "sub-low", score: 50, costUsd: null }),
+  ];
+
+  const result = sortRuns(runs, "cost-asc");
+  assert.deepEqual(
+    result.map((run) => run.id),
+    ["cheap", "pricey", "sub-high", "sub-low"],
+  );
+});
+
+test("summarizeRuns returns zeros for an empty array and throws for non-arrays", () => {
+  assert.deepEqual(summarizeRuns([]), {
+    visibleCount: 0,
+    passRatePct: 0,
+    medianElapsedSeconds: 0,
+    totalCostUsd: 0,
+    costedRunCount: 0,
+  });
+  assert.throws(() => summarizeRuns(undefined), TypeError);
+  assert.throws(() => summarizeRuns(42), TypeError);
+});
+
+test("summarizeRuns averages the middle pair for an even count", () => {
+  const runs = [
+    makeRun({ id: "a", outcome: "pass", elapsedSeconds: 10 }),
+    makeRun({ id: "b", outcome: "fail", elapsedSeconds: 21 }),
+    makeRun({ id: "c", outcome: "fail", elapsedSeconds: 30 }),
+    makeRun({ id: "d", outcome: "pass", elapsedSeconds: 45 }),
+  ];
+
+  const summary = summarizeRuns(runs);
+  assert.equal(summary.visibleCount, 4);
+  assert.equal(summary.passRatePct, 50);
+  assert.equal(summary.medianElapsedSeconds, 25.5); // (21 + 30) / 2
+});
+
+test("summarizeRuns avoids floating-point residue and rounds pass rate", () => {
+  const runs = [
+    makeRun({ id: "a", outcome: "pass", costUsd: 0.1 }),
+    makeRun({ id: "b", outcome: "fail", costUsd: 0.2 }),
+    makeRun({ id: "c", outcome: "fail", costUsd: null }),
+  ];
+
+  const summary = summarizeRuns(runs);
+  assert.equal(summary.totalCostUsd, 0.3); // not 0.30000000000000004
+  assert.equal(summary.costedRunCount, 2);
+  assert.equal(summary.passRatePct, 33.3); // 1/3 rounded to one decimal
+});
+
+test("filter, sort, and summarize compose over the seeded sample runs", () => {
+  const openCode = filterRuns(sampleRuns, {
+    assistant: "OpenCode",
+    outcome: "all",
+  });
+  const sorted = sortRuns(openCode, "time-asc");
+  assert.deepEqual(
+    sorted.map((run) => run.id),
+    ["oc-qwen-01", "oc-kimi-01"],
+  );
+  assert.deepEqual(summarizeRuns(openCode), {
+    visibleCount: 2,
+    passRatePct: 50,
+    medianElapsedSeconds: 43.5,
+    totalCostUsd: 0.19,
+    costedRunCount: 2,
+  });
+});
