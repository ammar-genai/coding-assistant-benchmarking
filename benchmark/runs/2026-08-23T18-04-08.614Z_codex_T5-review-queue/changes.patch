-export function createReviewApi() {
-  throw new Error("TODO: implement the review API");
+const CONTENT_TYPE = "application/json; charset=utf-8";
+const REVIEW_FIELDS = ["runId", "decision", "reviewer", "note"];
+const DECISIONS = new Set(["approve", "reject", "needs-work"]);
+const RUN_ID_PATTERN = /^run-[a-z0-9][a-z0-9-]{2,63}$/;
+
+function response(status, body, headers = {}) {
+  return {
+    status,
+    headers: { "content-type": CONTENT_TYPE, ...headers },
+    body,
+  };
+}
+
+function validationFailed(fields) {
+  return response(400, { error: "validation_failed", fields });
+}
+
+function validateReview(body) {
+  if (body === null || typeof body !== "object" || Array.isArray(body)) {
+    return { values: null, fields: { body: "Must be an object." } };
+  }
+
+  const fields = {};
+  const unknown = Object.keys(body)
+    .filter((field) => !REVIEW_FIELDS.includes(field))
+    .sort();
+  if (unknown.length > 0) {
+    fields.body = `Unknown fields: ${unknown.join(", ")}.`;
+  }
+
+  const values = {};
+  for (const field of REVIEW_FIELDS) {
+    if (typeof body[field] !== "string") {
+      fields[field] = "Must be a string.";
+    } else {
+      values[field] = body[field].trim();
+    }
+  }
+
+  if (typeof values.runId === "string" && !RUN_ID_PATTERN.test(values.runId)) {
+    fields.runId = "Must be a valid run ID.";
+  }
+  if (typeof values.decision === "string" && !DECISIONS.has(values.decision)) {
+    fields.decision = "Must be approve, reject, or needs-work.";
+  }
+  if (
+    typeof values.reviewer === "string" &&
+    (values.reviewer.length < 2 || values.reviewer.length > 40)
+  ) {
+    fields.reviewer = "Must contain 2 through 40 characters.";
+  }
+  if (typeof values.note === "string") {
+    if (values.note.length > 240) {
+      fields.note = "Must contain at most 240 characters.";
+    } else if (
+      (values.decision === "reject" || values.decision === "needs-work") &&
+      values.note.length === 0
+    ) {
+      fields.note = "Required for reject and needs-work decisions.";
+    }
+  }
+
+  return { values, fields };
+}
+
+function summaryFor(reviews) {
+  const summary = { total: reviews.length, approve: 0, reject: 0, "needs-work": 0 };
+  for (const review of reviews) {
+    if (DECISIONS.has(review.decision)) {
+      summary[review.decision] += 1;
+    }
+  }
+  return summary;
+}
+
+export function createReviewApi(store) {
+  if (
+    store === null ||
+    typeof store !== "object" ||
+    typeof store.save !== "function" ||
+    typeof store.get !== "function" ||
+    typeof store.list !== "function"
+  ) {
+    throw new TypeError("store must provide save, get, and list functions");
+  }
+
+  return function handleReviewRequest(request) {
+    if (
+      request === null ||
+      typeof request !== "object" ||
+      Array.isArray(request) ||
+      typeof request.method !== "string" ||
+      request.method.length === 0 ||
+      typeof request.url !== "string" ||
+      request.url.length === 0
+    ) {
+      return response(400, { error: "invalid_request" });
+    }
+
+    let url;
+    try {
+      url = new URL(request.url, "http://review-queue.local");
+    } catch {
+      return response(400, { error: "invalid_request" });
+    }
+
+    const method = request.method.toUpperCase();
+    if (url.pathname === "/api/reviews") {
+      if (method === "POST") {
+        const { values, fields } = validateReview(request.body);
+        if (Object.keys(fields).length > 0) {
+          return validationFailed(fields);
+        }
+        const saved = store.save(values);
+        return response(saved.created ? 201 : 200, { review: saved.review });
+      }
+
+      if (method === "GET") {
+        const decision = url.searchParams.get("decision");
+        if (decision !== null && !DECISIONS.has(decision)) {
+          return validationFailed({ decision: "Must be approve, reject, or needs-work." });
+        }
+        const allReviews = store.list();
+        return response(200, {
+          reviews: decision === null ? allReviews : store.list({ decision }),
+          summary: summaryFor(allReviews),
+        });
+      }
+
+      return response(405, { error: "method_not_allowed" }, { allow: "GET, POST" });
+    }
+
+    const detailMatch = url.pathname.match(/^\/api\/reviews\/([^/]+)$/);
+    if (detailMatch) {
+      if (method !== "GET") {
+        return response(405, { error: "method_not_allowed" }, { allow: "GET" });
+      }
+
+      let runId;
+      try {
+        runId = decodeURIComponent(detailMatch[1]);
+      } catch {
+        return response(400, { error: "invalid_request" });
+      }
+      const review = store.get(runId);
+      return review === null
+        ? response(404, { error: "review_not_found" })
+        : response(200, { review });
+    }
+
+    return response(404, { error: "not_found" });
+  };
 }
