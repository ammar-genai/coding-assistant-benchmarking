-export function renderReviewPage() {
-  return "<h1>TODO: build the run review queue</h1>";
+function escapeHtml(value) {
+  return String(value)
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;")
+    .replaceAll("'", "&#39;");
+}
+
+function reviewRows(reviews) {
+  if (reviews.length === 0) {
+    return '<tr><td colspan="5">No reviews yet.</td></tr>';
+  }
+
+  return reviews
+    .map(
+      (review) => `        <tr>
+          <td>${escapeHtml(review.runId)}</td>
+          <td>${escapeHtml(review.decision)}</td>
+          <td>${escapeHtml(review.reviewer)}</td>
+          <td>${escapeHtml(review.note)}</td>
+          <td>${escapeHtml(review.updatedAt)}</td>
+        </tr>`,
+    )
+    .join("\n");
+}
+
+export function renderReviewPage({ reviews, summary, message = "" }) {
+  return `<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Run review queue</title>
+</head>
+<body>
+  <main>
+    <h1>Run review queue</h1>
+    <p>Record a decision for each benchmark run and review the current queue.</p>
+
+    <section aria-label="Review summary">
+      <dl>
+        <div><dt>Total</dt><dd>${escapeHtml(summary.total)}</dd></div>
+        <div><dt>Approved</dt><dd>${escapeHtml(summary.approve)}</dd></div>
+        <div><dt>Rejected</dt><dd>${escapeHtml(summary.reject)}</dd></div>
+        <div><dt>Needs work</dt><dd>${escapeHtml(summary["needs-work"])}</dd></div>
+      </dl>
+    </section>
+
+    <section aria-labelledby="review-form-heading">
+      <h2 id="review-form-heading">Add or update a review</h2>
+      <form method="post" action="/api/reviews">
+        <div>
+          <label for="run-id">Run ID</label>
+          <input id="run-id" name="runId" required>
+        </div>
+        <div>
+          <label for="decision">Decision</label>
+          <select id="decision" name="decision" required>
+            <option value="approve">Approve</option>
+            <option value="reject">Reject</option>
+            <option value="needs-work">Needs work</option>
+          </select>
+        </div>
+        <div>
+          <label for="reviewer">Reviewer</label>
+          <input id="reviewer" name="reviewer" minlength="2" maxlength="40" required>
+        </div>
+        <div>
+          <label for="note">Note</label>
+          <textarea id="note" name="note" maxlength="240" aria-describedby="note-help"></textarea>
+          <p id="note-help">A note is required for reject and needs-work decisions.</p>
+        </div>
+        <button type="submit">Save review</button>
+      </form>
+      <p role="status" aria-live="polite">${escapeHtml(message)}</p>
+    </section>
+
+    <section aria-labelledby="saved-reviews-heading">
+      <h2 id="saved-reviews-heading">Reviews</h2>
+      <table>
+        <caption>Saved run reviews</caption>
+        <thead>
+          <tr>
+            <th scope="col">Run ID</th>
+            <th scope="col">Decision</th>
+            <th scope="col">Reviewer</th>
+            <th scope="col">Note</th>
+            <th scope="col">Updated</th>
+          </tr>
+        </thead>
+        <tbody>
+${reviewRows(reviews)}
+        </tbody>
+      </table>
+    </section>
+  </main>
+</body>
+</html>`;
 }
diff --git a/benchmark/fixtures/T5-review-queue/review-store.mjs b/benchmark/fixtures/T5-review-queue/review-store.mjs
index 1138160..b694cbf 100644
--- a/benchmark/fixtures/T5-review-queue/review-store.mjs
+++ b/benchmark/fixtures/T5-review-queue/review-store.mjs
@@ -1,3 +1,60 @@
-export function createReviewStore() {
-  throw new Error("TODO: implement the review store");
+const REVIEW_FIELDS = ["runId", "decision", "reviewer", "note"];
+
+function copyReview(review) {
+  return { ...review };
+}
+
+export function createReviewStore({ now = () => new Date().toISOString() } = {}) {
+  if (typeof now !== "function") {
+    throw new TypeError("now must be a function");
+  }
+
+  const reviews = new Map();
+
+  function save(review) {
+    if (review === null || typeof review !== "object" || Array.isArray(review)) {
+      throw new TypeError("review must be an object");
+    }
+
+    for (const field of REVIEW_FIELDS) {
+      if (typeof review[field] !== "string") {
+        throw new TypeError(`${field} must be a string`);
+      }
+    }
+
+    const timestamp = now();
+    if (typeof timestamp !== "string" || timestamp.length === 0) {
+      throw new TypeError("now must return a non-empty string");
+    }
+
+    const current = reviews.get(review.runId);
+    const stored = {
+      runId: review.runId,
+      decision: review.decision,
+      reviewer: review.reviewer,
+      note: review.note,
+      createdAt: current?.createdAt ?? timestamp,
+      updatedAt: timestamp,
+    };
+
+    reviews.set(stored.runId, stored);
+    return { created: current === undefined, review: copyReview(stored) };
+  }
+
+  function get(runId) {
+    const review = reviews.get(runId);
+    return review === undefined ? null : copyReview(review);
+  }
+
+  function list({ decision } = {}) {
+    return [...reviews.values()]
+      .filter((review) => decision === undefined || review.decision === decision)
+      .sort((left, right) => {
+        const byUpdatedAt = right.updatedAt.localeCompare(left.updatedAt);
+        return byUpdatedAt || left.runId.localeCompare(right.runId);
+      })
+      .map(copyReview);
+  }
+
+  return { save, get, list };
 }
diff --git a/benchmark/fixtures/T5-review-queue/student-tests.mjs b/benchmark/fixtures/T5-review-queue/student-tests.mjs
index 6330f62..4a992a3 100644
--- a/benchmark/fixtures/T5-review-queue/student-tests.mjs
+++ b/benchmark/fixtures/T5-review-queue/student-tests.mjs
@@ -1,2 +1,73 @@
-// Add at least three meaningful node:test cases for the feature contract.
-// Do not copy or modify the committed review-queue.test.mjs suite.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { createReviewApi } from "./review-api.mjs";
+import { renderReviewPage } from "./review-page.mjs";
+import { createReviewStore } from "./review-store.mjs";
+
+test("store results are sorted and cannot mutate stored reviews", () => {
+  const timestamps = ["2026-08-23T10:00:00.000Z", "2026-08-23T11:00:00.000Z"];
+  const store = createReviewStore({ now: () => timestamps.shift() });
+  store.save({ runId: "run-zed", decision: "approve", reviewer: "Ada", note: "" });
+  const saved = store.save({ runId: "run-alpha", decision: "reject", reviewer: "Lin", note: "Broken" });
+
+  saved.review.decision = "approve";
+  const listed = store.list();
+  listed[0].note = "changed";
+  listed.push({});
+
+  assert.deepEqual(store.list().map(({ runId }) => runId), ["run-alpha", "run-zed"]);
+  assert.equal(store.get("run-alpha").decision, "reject");
+  assert.equal(store.get("run-alpha").note, "Broken");
+});
+
+test("API reports sorted unknown fields and does not persist invalid input", () => {
+  const store = createReviewStore();
+  const handle = createReviewApi(store);
+  const result = handle({
+    method: "POST",
+    url: "/api/reviews",
+    body: {
+      runId: "run-alpha",
+      decision: "approve",
+      reviewer: "Ada",
+      note: "",
+      zeta: true,
+      alpha: true,
+    },
+  });
+
+  assert.equal(result.status, 400);
+  assert.equal(result.body.error, "validation_failed");
+  assert.match(result.body.fields.body, /alpha, zeta/);
+  assert.deepEqual(store.list(), []);
+});
+
+test("API summaries ignore a list filter and recognized routes advertise methods", () => {
+  const store = createReviewStore({ now: () => "2026-08-23T12:00:00.000Z" });
+  store.save({ runId: "run-one", decision: "approve", reviewer: "Ada", note: "" });
+  store.save({ runId: "run-two", decision: "reject", reviewer: "Lin", note: "Why" });
+  const handle = createReviewApi(store);
+
+  const filtered = handle({ method: "GET", url: "/api/reviews?decision=approve" });
+  const disallowed = handle({ method: "DELETE", url: "/api/reviews/run-one" });
+
+  assert.equal(filtered.body.reviews.length, 1);
+  assert.deepEqual(filtered.body.summary, { total: 2, approve: 1, reject: 1, "needs-work": 0 });
+  assert.equal(disallowed.status, 405);
+  assert.equal(disallowed.headers.allow, "GET");
+});
+
+test("page escapes every dynamic output location", () => {
+  const attack = '<img src=x onerror="alert(1)">';
+  const html = renderReviewPage({
+    reviews: [
+      { runId: attack, decision: attack, reviewer: attack, note: attack, updatedAt: attack },
+    ],
+    summary: { total: attack, approve: attack, reject: attack, "needs-work": attack },
+    message: attack,
+  });
+
+  assert.doesNotMatch(html, /<img/);
+  assert.equal(html.match(/&lt;img/g)?.length, 10);
+});
