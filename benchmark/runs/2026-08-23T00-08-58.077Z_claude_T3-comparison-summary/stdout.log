         acceptance_status: \"pass\",","+          score: 101,","+          elapsed_ms: 10,","+        },","+      ]),","+    TypeError,","+  );","+  assert.throws(","+    () =>","+      summarizeAssistants([","+        {","+          run_id: \"r\",","+          assistant: \"A\",","+          status: \"complete\",","+          acceptance_status: \"pass\",","+          score: 50,","+          elapsed_ms: -1,","+        },","+      ]),","+    TypeError,","+  );","+});","+","+test(\"renders summaries in the supplied order and escapes pipes\", () => {","+  const summaries = [","+    {","+      assistant: \"A|B\",","+      run_count: 1,","+      best_score: 88,","+      best_run_id: \"r1\",","+      median_elapsed_ms: 500,","+    },","+    {","+      assistant: \"C\",","+      run_count: 2,","+      best_score: 92.5,","+      best_run_id: \"r|2\",","+      median_elapsed_ms: 1_750,","+    },","+  ];","+","+  assert.equal(","+    renderComparisonTable(summaries),","+    [","+      \"| Assistant | Runs | Best score | Best run | Median time |\",","+      \"|---|---:|---:|---|---:|\",","+      \"| A\\\\|B | 1 | 88 | r1 | 0.500 s |\",","+      \"| C | 2 | 92.5 | r\\\\|2 | 1.750 s |\",","+    ].join(\"\\n\"),","+  );","+});","+","+test(\"throws TypeError for invalid summary fields\", () => {","+  assert.throws(","+    () =>","+      renderComparisonTable([","+        {","+          assistant: \"\",","+          run_count: 1,","+          best_score: 50,","+          best_run_id: \"r\",","+          median_elapsed_ms: 10,","+        },","+      ]),","+    TypeError,","+  );","+  assert.throws(","+    () =>","+      renderComparisonTable([","+        {","+          assistant: \"A\",","+          run_count: 0,","+          best_score: 50,","+          best_run_id: \"r\",","+          median_elapsed_ms: 10,","+        },","+      ]),","+    TypeError,","+  );","+  assert.throws(","+    () =>","+      renderComparisonTable([","+        {","+          assistant: \"A\",","+          run_count: 1,","+          best_score: 101,","+          best_run_id: \"r\",","+          median_elapsed_ms: 10,","+        },","+      ]),","+    TypeError,","+  );","+  assert.throws(","+    () =>","+      renderComparisonTable([","+        {","+          assistant: \"A\",","+          run_count: 1,","+          best_score: 50,","+          best_run_id: \"\",","+          median_elapsed_ms: 10,","+        },","+      ]),","+    TypeError,","+  );","+  assert.throws(","+    () =>","+      renderComparisonTable([","+        {","+          assistant: \"A\",","+          run_count: 1,","+          best_score: 50,","+          best_run_id: \"r\",","+          median_elapsed_ms: -1,","+        },","+      ]),","+    TypeError,","+  );","+});"]}],"originalFile":"// Add at least two meaningful node:test cases for the feature contract.\n// Do not copy or modify the committed comparison-summary.test.mjs suite.\n","userModified":false}}
