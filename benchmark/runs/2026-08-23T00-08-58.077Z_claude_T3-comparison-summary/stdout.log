{"type":"assistant","message":{"id":"msg_88557c405093c44c2edcf4c5","type":"message","role":"assistant","model":"kimi-k2.7-code","content":[{"type":"tool_use","id":"functions.Write:8","name":"Write","input":{"file_path":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-oDPFwQ/checkout/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs","content":"/**\n * Render assistant summaries as a stable Markdown table.\n */\nexport function renderComparisonTable(summaries) {\n  if (!Array.isArray(summaries)) {\n    throw new TypeError(\"summaries must be an array\");\n  }\n\n  const lines = [\n    \"| Assistant | Runs | Best score | Best run | Median time |\",\n    \"|---|---:|---:|---|---:|\",\n  ];\n\n  if (summaries.length === 0) {\n    lines.push(\"\", \"_No eligible runs._\");\n    return lines.join(\"\\n\");\n  }\n\n  for (const summary of summaries) {\n    validateSummary(summary);\n    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);\n    lines.push(\n      `| ${escapePipe(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapePipe(summary.best_run_id)} | ${seconds} s |`,\n    );\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction validateSummary(summary) {\n  if (!summary || typeof summary !== \"object\") {\n    throw new TypeError(\"summary must be an object\");\n  }\n  if (!isNonEmptyString(summary.assistant)) {\n    throw new TypeError(\"summary assistant must be a non-empty string\");\n  }\n  if (!isNonEmptyString(summary.best_run_id)) {\n    throw new TypeError(\"summary best_run_id must be a non-empty string\");\n  }\n  if (!Number.isInteger(summary.run_count) || summary.run_count <= 0) {\n    throw new TypeError(\"summary run_count must be a positive integer\");\n  }\n  if (!isFiniteNumber(summary.best_score) || summary.best_score < 0 || summary.best_score > 100) {\n    throw new TypeError(\"summary best_score must be a finite number from 0 to 100\");\n  }\n  if (!isFiniteN