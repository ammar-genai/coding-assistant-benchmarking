{"type":"user","message":{"role":"user","content":[{"tool_use_id":"functions.Read:3","type":"tool_result","content":"1\timport assert from \"node:assert/strict\";\n2\timport test from \"node:test\";\n3\t\n4\timport { renderComparisonTable } from \"./render-comparison-table.mjs\";\n5\timport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n6\t\n7\ttest(\"summarizes eligible runs by assistant in stable order\", () => {\n8\t  const runs = Object.freeze([\n9\t    Object.freeze({\n10\t      run_id: \"codex-slow\",\n11\t      assistant: \"Codex\",\n12\t      status: \"complete\",\n13\t      acceptance_status: \"pass\",\n14\t      score: 91,\n15\t      elapsed_ms: 2_000,\n16\t    }),\n17\t    Object.freeze({\n18\t      run_id: \"claude-best\",\n19\t      assistant: \"Claude Code\",\n20\t      status: \"complete\",\n21\t      acceptance_status: \"pass\",\n22\t      score: 96,\n23\t      elapsed_ms: 1_250,\n24\t      comparison_eligible: true,\n25\t    }),\n26\t    Object.freeze({\n27\t      run_id: \"codex-best\",\n28\t      assistant: \"Codex\",\n29\t      status: \"complete\",\n30\t      acceptance_status: \"pass\",\n31\t      score: 95,\n32\t      elapsed_ms: 1_000,\n33\t    }),\n34\t    Object.freeze({\n35\t      run_id: \"failed-run\",\n36\t      assistant: \"Claude Code\",\n37\t      status: \"complete\",\n38\t      acceptance_status: \"fail\",\n39\t      score: 100,\n40\t      elapsed_ms: 10,\n41\t    }),\n42\t    Object.freeze({\n43\t      run_id: \"excluded-run\",\n44\t      assistant: \"Codex\",\n45\t      status: \"complete\",\n46\t      acceptance_status: \"pass\",\n47\t      comparison_eligible: false,\n48\t      score: 100,\n49\t      elapsed_ms: 10,\n50\t    }),\n51\t  ]);\n52\t\n53\t  assert.deepEqual(summarizeAssistants(runs), [\n54\t    {\n55\t      assistant: \"Claude Code\",\n56\t      run_count: 1,\n57\t      best_score: 96,\n58\t      best_run_id: \"claude-best\",\n59\t      median_elapsed_ms: 1_250,\n60\t    },\n61\t    {\n62\t      assistant: \"Codex\",\n63\t      run_count: 2,\n64\t      best_score: 95,\n65\t      best_run_id: \"codex-best\",\n66\t      median_elapsed_ms: 1_500,\n67\t    },\n68\t  ]);\n69\t});\n70\t\n71\ttest(\"breaks a best-score tie with elapsed time\", () => {\n72\t  const runs = [\n73\t    {\n74\t      run_id: \"slower\",\n75\t      assistant: \"OpenCode\",\n76\t      status: \"complete\",\n77\t      acceptance_status: \"pass\",\n78\t      score: 94,\n79\t      elapsed_ms: 1_100,\n80\t    },\n81\t    {\n82\t      run_id: \"faster\",\n83\t      assistant: \"OpenCode\",\n84\t      status: \"complete\",\n85\t      acceptance_status: \"pass\",\n86\t      score: 94,\n87\t      elapsed_ms: 900,\n88\t    },\n89\t  ];\n90\t\n91\t  assert.equal(summarizeAssistants(runs)[0].best_run_id, \"faster\");\n92\t});\n93\t\n94\ttest(\"renders the exact Markdown table format\", () => {\n95\t  const summaries = [\n96\t    {\n97\t      assistant: \"Open|Code\",\n98\t      run_count: 2,\n99\t      best_score: 95.5,\n100\t      best_run_id: \"run|2\",\n101\t      median_elapsed_ms: 1_250,\n102\t    },\n103\t  ];\n104\t\n105\t  assert.equal(\n106\t    renderComparisonTable(summaries),\n107\t    [\n108\t      \"| Assistant | Runs | Best score | Best run | Median time |\",\n109\t      \"|---|---:|---:|---|---:|\",\n110\t      \"| Open\\\\|Code | 2 | 95.5 | run\\\\|2 | 1.250 s |\",\n111\t    ].join(\"\\n\"),\n112\t  );\n113\t});\n114\t\n115\ttest(\"renders an explicit empty state below the table header\", () => {\n116\t  assert.equal(\n117\t    renderComparisonTable([]),\n118\t    [\n119\t      \"| Assistant | Runs | Best score | Best run | Median time |\",\n120\t      \"|---|---:|---:|---|---:|\",\n121\t      \"\",\n122\t      \"_No eligible runs._\",\n123\t    ].join(\"\\n\"),\n124\t  );\n125\t});\n126\t"}]},"parent_tool_use_id":null,"session_id":"0f942b9e-6087-4a0e-a1ac-354bc45f970d","uuid":"619ae6f0-a700-4984-a531-c124dd39dfef","timestamp":"2026-08-23T00:09:00.780Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/cs/y_h_9x9j2hj316xhs3mvszd80000gn/T/coding-assistant-benchmark-oDPFwQ/checkout/benchmark/fixtures/T3-comparison-summary/comparison-summary.test.mjs","content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\n\nimport { renderComparisonTable } from \"./render-comparison-table.mjs\";\nimport { summarizeAssistants } from \"./summarize-assistants.mjs\";\n\ntest(\"summarizes eligible runs by assistant in stable order\", () => {\n  const runs = Object.freeze([\n    Object.freeze({\n      run_id: \"codex-slow\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 91,\n      elapsed_ms: 2_000,\n    }),\n    Object.freeze({\n      run_id: \"claude-best\",\n      assistant: \"Claude Code\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 96,\n      elapsed_ms: 1_250,\n      comparison_eligible: true,\n    }),\n    Object.freeze({\n      run_id: \"codex-best\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 95,\n      elapsed_ms: 1_000,\n    }),\n    Object.freeze({\n      run_id: \"failed-run\",\n      assistant: \"Claude Code\",\n      status: \"complete\",\n      acceptance_status: \"fail\",\n      score: 100,\n      elapsed_ms: 10,\n    }),\n    Object.freeze({\n      run_id: \"excluded-run\",\n      assistant: \"Codex\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      comparison_eligible: false,\n      score: 100,\n      elapsed_ms: 10,\n    }),\n  ]);\n\n  assert.deepEqual(summarizeAssistants(runs), [\n    {\n      assistant: \"Claude Code\",\n      run_count: 1,\n      best_score: 96,\n      best_run_id: \"claude-best\",\n      median_elapsed_ms: 1_250,\n    },\n    {\n      assistant: \"Codex\",\n      run_count: 2,\n      best_score: 95,\n      best_run_id: \"codex-best\",\n      median_elapsed_ms: 1_500,\n    },\n  ]);\n});\n\ntest(\"breaks a best-score tie with elapsed time\", () => {\n  const runs = [\n    {\n      run_id: \"slower\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 94,\n      elapsed_ms: 1_100,\n    },\n    {\n      run_id: \"faster\",\n      assistant: \"OpenCode\",\n      status: \"complete\",\n      acceptance_status: \"pass\",\n      score: 94,\n      elapsed_ms: 900,\n    },\n  ];\n\n  assert.equal(summarizeAssistants(runs)[0].best_run_id, \"faster\");\n});\n\ntest(\"renders the exact Markdown table format\", () => {\n  const summaries = [\n    {\n      assistant: \"Open|Code\",\n      run_count: 2,\n      best_score: 95.5,\n      best_run_id: \"run|2\",\n      median_elapsed_ms: 1_250,\n    },\n  ];\n\n  assert.equal(\n    renderComparisonTable(summaries),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"| Open\\\\|Code | 2 | 95.5 | run\\\\|2 | 1.250 s |\",\n    ].join(\"\\n\"),\n  );\n});\n\ntest(\"renders an explicit empty state below the table header\", () => {\n  assert.equal(\n    renderComparisonTable([]),\n    [\n      \"| Assistant | Runs | Best score | Best run | Median time |\",\n      \"|---|---:|---:|---|---:|\",\n      \"\",\n      \"_No eligible runs._\",\n    ].join(\"\\n\"),\n  );\n});\n","numLines":126,"startLine":1,"totalLines":126}}}
