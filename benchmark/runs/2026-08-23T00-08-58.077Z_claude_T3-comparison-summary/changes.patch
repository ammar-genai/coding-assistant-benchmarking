diff --git a/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs b/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
index 40fbc04..661236e 100644
--- a/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
+++ b/benchmark/fixtures/T3-comparison-summary/render-comparison-table.mjs
@@ -6,5 +6,56 @@ export function renderComparisonTable(summaries) {
     throw new TypeError("summaries must be an array");
   }
 
-  return "";
+  const lines = [
+    "| Assistant | Runs | Best score | Best run | Median time |",
+    "|---|---:|---:|---|---:|",
+  ];
+
+  if (summaries.length === 0) {
+    lines.push("", "_No eligible runs._");
+    return lines.join("\n");
+  }
+
+  for (const summary of summaries) {
+    validateSummary(summary);
+    const seconds = (summary.median_elapsed_ms / 1000).toFixed(3);
+    lines.push(
+      `| ${escapePipe(summary.assistant)} | ${summary.run_count} | ${summary.best_score} | ${escapePipe(summary.best_run_id)} | ${seconds} s |`,
+    );
+  }
+
+  return lines.join("\n");
+}
+
+function validateSummary(summary) {
+  if (!summary || typeof summary !== "object") {
+    throw new TypeError("summary must be an object");
+  }
+  if (!isNonEmptyString(summary.assistant)) {
+    throw new TypeError("summary assistant must be a non-empty string");
+  }
+  if (!isNonEmptyString(summary.best_run_id)) {
+    throw new TypeError("summary best_run_id must be a non-empty string");
+  }
+  if (!Number.isInteger(summary.run_count) || summary.run_count <= 0) {
+    throw new TypeError("summary run_count must be a positive integer");
+  }
+  if (!isFiniteNumber(summary.best_score) || summary.best_score < 0 || summary.best_score > 100) {
+    throw new TypeError("summary best_score must be a finite number from 0 to 100");
+  }
+  if (!isFiniteNumber(summary.median_elapsed_ms) || summary.median_elapsed_ms < 0) {
+    throw new TypeError("summary median_elapsed_ms must be a finite number >= 0");
+  }
+}
+
+function isNonEmptyString(value) {
+  return typeof value === "string" && value.length > 0;
+}
+
+function isFiniteNumber(value) {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+function escapePipe(value) {
+  return value.replaceAll("|", "\\|");
 }
diff --git a/benchmark/fixtures/T3-comparison-summary/student-tests.mjs b/benchmark/fixtures/T3-comparison-summary/student-tests.mjs
