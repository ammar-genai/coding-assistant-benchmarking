+
+  await projector.project(created()); // version 1
+
+  await assert.rejects(
+    projector.project({
+      tradeId: "trade-1",
+      version: 5,
+      type: "AMENDED",
+      payload: { notional: 200 },
+    }),
+    /version gap/,
+  );
+
+  assert.equal(projector.getSnapshot("trade-1").version, 1);
+  assert.equal(projector.getSnapshot("trade-1").notional, 100);
