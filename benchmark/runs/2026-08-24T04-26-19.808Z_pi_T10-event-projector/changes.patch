+import { createEventProjector } from "./event-projector.mjs";
+
+const created = (tradeId = "trade-1") => ({
+  tradeId,
+  version: 1,
+  type: "CREATED",
+  payload: { notional: 100, owner: "desk-a" },
+});
+
+test("unrelated trades progress concurrently instead of sharing one queue", async () => {
+  const waiting = [];
+  const projector = createEventProjector(async () => {
+    await new Promise((resolve) => waiting.push(resolve));
+  });
+
+  const a = projector.project(created("trade-a"));
+  const b = projector.project(created("trade-b"));
+
+  // Flush microtasks so both events reach applyToStore.
+  for (let i = 0; i < 20; i++) await Promise.resolve();
+
+  assert.equal(
+    waiting.length,
+    2,
+    "both trades should be persisted at the same time",
+  );
+
+  waiting.forEach((release) => release());
+  await Promise.all([a, b]);
+
+  assert.deepEqual(projector.getSnapshot("trade-a").version, 1);
+  assert.deepEqual(projector.getSnapshot("trade-b").version, 1);
+});
+
+test("duplicate or stale version returns current snapshot without persisting", async () => {
+  const persisted = [];
+  const projector = createEventProjector(async (_tradeId, state) => {
+    persisted.push(state.version);
+  });
+
+  await projector.project(created()); // version 1
+  const dup = await projector.project(created()); // version 1 again
+  const stale = await projector.project({
+    tradeId: "trade-1",
+    version: 1,
+    type: "AMENDED",
+    payload: { notional: 200 },
+  });
+
+  assert.equal(dup.version, 1);
+  assert.equal(stale.version, 1);
+  assert.deepEqual(persisted, [1], "duplicate/stale events must not persist");
+});
+
