version 1 again\n  const stale = await projector.project({\n    tradeId: \"trade-1\",\n    version: 1,\n    type: \"AMENDED\",\n    payload: { notional: 200 },\n  });\n\n  assert.equal(dup.version, 1);\n  assert.equal(stale.version, 1);\n  assert.deepEqual(persisted, [1], \"duplicate/stale events must not persist\");\n});\n\ntest(\"a version gap rejects without changing state\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await projector.project(created()); // version 1\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 5,\n      type: \"AMENDED\",\n      payload: { notional: 200 },\n    }),\n    /version gap/,\n  );\n\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 1);\n  assert.equal(projector.getSnapshot(\"trade-1\").notional, 100);\n});\n\ntest(\"a cancelled trade is terminal and rejects later new versions\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await projector.project(created()); // version 1\n  await projector.project({\n    tradeId: \"trade-1\",\n    version: 2,\n    type: \"CANCELLED\",\n    payload: {},\n  });\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 3,\n      type: \"AMENDED\",\n      payload: { notional: 500 },\n    }),\n    /cancelled|terminal/,\n  );\n\n  const snap = projector.getSnapshot(\"trade-1\");\n  assert.equal(snap.status, \"cancelled\");\n  assert.equal(snap.version, 2);\n});\n\ntest(\"CREATED with invalid notional rejects without persisting\", async () => {\n  let persisted = 0;\n  const projector = createEventProjector(async () => {\n    persisted++;\n  });\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-x\",\n      version: 1,\n      type: \"CREATED\",\n      payload: { notional: -5, owner: \"desk\" },\n    }),\n    /notional/,\n  );\n\n  assert.equal(persisted, 0, \"nothing should be persisted on validation failure\");\n  assert.equal(projector.getSnapshot(\"trade-x\"), null);\n});\n\ntest(\"AMENDED with an invalid field rejects and leaves prior state intact\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await projector.project(created()); // version 1\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 2,\n      type: \"AMENDED\",\n      payload: { notional: 0 },\n    }),\n    /notional/,\n  );\n\n  const snap = projector.getSnapshot(\"trade-1\");\n  assert.equal(snap.version, 1, \"rejected amendment must not advance version\");\n  assert.equal(snap.notional, 100, \"rejected amendment must not change state\");\n});\n\ntest(\"an unsupported event type rejects with TypeError\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({\n      tradeId: \"trade-1\",\n      version: 1,\n      type: \"BOGUS\",\n      payload: {},\n    }),\n    TypeError,\n  );\n});\n\ntest(\"snapshots and store arguments are isolated from internal state\", async () => {\n  const projector = createEventProjector(async (_tradeId, state, event) => {\n    // Mutate everything we receive; internal state must not be affected.\n    state.notional = 9999;\n    state.status = \"tampered\";\n    event.payload.notional = 9999;\n    event.version = 9999;\n  });\n\n  await projector.project(created());\n\n  const snap = projector.getSnapshot(\"trade-1\");\n  snap.notional = 9999;\n\n  const again = projector.getSnapshot(\"trade-1\");\n  assert.equal(again.notional, 100, \"store mutations must not leak\");\n  assert.equal(again.status, \"active\", \"store mutations must not leak\");\n  assert.equal(again.version, 1, \"snapshot mutations must not leak\");\n});\n"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.2","usage":{"input":2376,"output":1248,"cacheRead":9505,"cacheWrite":0,"reasoning":0,"totalTokens":13129,"cost":{"input":0.0022952159999999997,"outp