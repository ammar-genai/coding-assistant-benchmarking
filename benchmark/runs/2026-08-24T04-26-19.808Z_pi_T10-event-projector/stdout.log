on-empty string\");\n  }\n}\n```\n\nNow the main reduce with validation:\n\n```js\nfunction applyEvent(current, event) {\n  // returns { state, persisted: true } or { noop: true } \n  const type = event && event.type;\n  if (type !== \"CREATED\" && type !== \"AMENDED\" && type !== \"CANCELLED\") {\n    throw new TypeError(`unsupported event type: ${type}`);\n  }\n  const tradeId = event.tradeId;\n  if (current === null || current === undefined) {\n    // first event must be CREATED at version 1\n    if (type !== \"CREATED\") {\n      throw new Error(`first event for trade ${tradeId} must be CREATED`);\n    }\n    if (event.version !== 1) {\n      throw new Error(`first event for trade ${tradeId} must be at version 1`);\n    }\n    const state = {\n      tradeId,\n      version: 1,\n      status: \"active\",\n      notional: event.payload.notional,\n      owner: event.payload.owner,\n    };\n    validateStateFields(state);\n    return { state };\n  }\n  // existing trade\n  if (event.version <= current.version) {\n    // duplicate or stale: return current snapshot, no persist\n    return { noop: true };\n  }\n  if (event.version !== current.version + 1) {\n    throw new Error(`version gap for trade ${tradeId}`);\n  }\n  if (current.status === \"cancelled\") {\n    throw new Error(`trade ${tradeId} is cancelled (terminal)`);\n  }\n  if (type === \"CREATED\") {\n    // already exists, can't recreate -> but version is current+1, this is a gap-ish. Actually CREATED at version current+1 is invalid.\n    throw new Error(`trade ${tradeId} already exists`);\n  }\n  if (type === \"AMENDED\") {\n    const state = {\n      ...current,\n      ...event.payload,\n      version: event.version,\n    };\n    validateStateFields(state);\n    return { state };\n  }\n  // CANCELLED\n  const state = {\n    ...current,\n    version: event.version,\n    status: \"cancelled\",\n  };\n  return { state };\n}\n```\n\nWait — for AMENDED, `...event.payload` could include `version` or `status` or