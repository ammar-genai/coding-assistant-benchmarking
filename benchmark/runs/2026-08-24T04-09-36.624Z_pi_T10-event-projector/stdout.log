ot(\"trade-1\").notional, 200);\n});\n\ntest(\"version gaps and invalid first events reject without changing state\", async () => {\n  const projector = createEventProjector(async () => {});\n\n  await assert.rejects(\n    projector.project({ tradeId: \"t\", version: 3, type: \"CREATED\", payload: { notional: 1, owner: \"a\" } }),\n    /version 1/,\n  );\n  await assert.rejects(\n    projector.project({ tradeId: \"t\", version: 1, type: \"AMENDED\", payload: {} }),\n    /no accepted events/,\n  );\n  assert.equal(projector.getSnapshot(\"t\"), null);\n\n  await projector.project(created(\"t\"));\n  await assert.rejects(\n    projector.project({ tradeId: \"t\", version: 5, type: \"AMENDED\", payload: {} }),\n    /version gap/,\n  );\n  assert.equal(projector.getSnapshot(\"t\").version, 1);\n});\n\ntest(\"a CANCELLED trade is terminal and rejects later new versions\", async () => {\n  const projector = createEventProjector(async () => {});\n  await projector.project(created());\n  await projector.project({ tradeId: \"trade-1\", version: 2, type: \"CANCELLED\", payload: {} });\n  assert.equal(projector.getSnapshot(\"trade-1\").status, \"cancelled\");\n\n  await assert.rejects(\n    projector.project({ tradeId: \"trade-1\", version: 3, type: \"AMENDED\", payload: { notional: 5 } }),\n    /terminal/,\n  );\n  assert.equal(projector.getSnapshot(\"trade-1\").version, 2);\n});\n\ntest(\"malformed events reject with TypeError; invalid field values rejected\", async () => {\n  const projector = createEventProjector(async () => {});\n  await assert.rejects(projector.project(null), TypeError);\n  await assert.rejects(\n    projector.project({ tradeId: \"x\", version: 1, type: \"NOPE\", payload: {} }),\n    TypeError,\n  );\n  await assert.rejects(projector.project(created(\"x\", { notional: -5 })), TypeError);\n  await assert.rejects(projector.project(created(\"x\", { owner: \"\" })), TypeError);\n\n  await projector.project(created(\"x\"));\n  await assert.rejects(\n    projector.project({ tradeId: \"x\", version: 2, type: \"AMENDED\", payload: { notional: Number.NaN } }),\n    TypeError,\n  );\n  assert.equal(projector.getSnapshot(\"x\").notional, 100);\n});\n\ntest(\"returned states and snapshots do not expose mutable internal state\", async () => {\n  const projector = createEventProjector(async () => {});\n  const event = created();\n  const persisted = await projector.project(event);\n  persisted.notional = 1;\n  event.payload.notional = 1;\n  const snapshot = projector.getSnapshot(\"trade-1\");\n  assert.equal(snapshot.notional, 100);\n  snapshot.owner = \"mutated\";\n  assert.equal(projector.getSnapshot(\"trade-1\").owner, \"desk-a\");\n});\n"}}
