-// Replace this placeholder with at least four meaningful node:test cases.
 import assert from "node:assert/strict";
 import test from "node:test";
 
-test("replace this placeholder with projector regression tests", () => {
-  assert.fail("Add at least four meaningful tests");
+import { createEventProjector } from "./event-projector.mjs";
+
+const created = (tradeId = "trade-1", overrides = {}) => ({
+  tradeId,
+  version: 1,
+  type: "CREATED",
+  payload: { notional: 100, owner: "desk-a", ...overrides },
+});
+
+test("different trades progress concurrently and are not blocked by one queue", async () => {
+  let resolveSlow;
+  const slow = new Promise((resolve) => {
+    resolveSlow = resolve;
+  });
+  const projector = createEventProjector(async (tradeId) => {
+    if (tradeId === "slow") {
+      await slow;
+    }
+  });
+
+  const slowProject = projector.project(created("slow"));
+  // Must resolve even though "slow" trade persistence is still pending.
+  const fast = await projector.project(created("fast"));
+  assert.equal(fast.version, 1);
+  assert.equal(projector.getSnapshot("fast").status, "active");
+
+  resolveSlow();
+  assert.equal((await slowProject).version, 1);
+});
+
+test("duplicate or stale versions return the snapshot without persisting", async () => {
+  const persisted = [];
+  const projector = createEventProjector(async (_tradeId, state) => {
+    persisted.push(structuredClone(state));
+  });
+
+  await projector.project(created());
+  await projector.project({
+    tradeId: "trade-1",
+    version: 2,
+    type: "AMENDED",
+    payload: { notional: 200 },
+  });
+
+  const dup = await projector.project(created()); // stale version 1
+  assert.equal(dup.version, 2);
+  const stale = await projector.project({
+    tradeId: "trade-1",
+    version: 2,
+    type: "AMENDED",
+    payload: { notional: 999 },
+  });
+  assert.equal(stale.version, 2);
+  assert.equal(persisted.length, 2); // no extra persistence calls
+  assert.equal(projector.getSnapshot("trade-1").notional, 200);
+});
+
+test("version gaps and invalid first events reject without changing state", async () => {
+  const projector = createEventProjector(async () => {});
+
+  await assert.rejects(
+    projector.project({ tradeId: "t", version: 3, type: "CREATED", payload: { notional: 1, owner: "a" } }),
+    /version 1/,
+  );
+  await assert.rejects(
+    projector.project({ tradeId: "t", version: 1, type: "AMENDED", payload: {} }),
+    /no accepted events/,
+  );
+  assert.equal(projector.getSnapshot("t"), null);
+
+  await projector.project(created("t"));
+  await assert.rejects(
+    projector.project({ tradeId: "t", version: 5, type: "AMENDED", payload: {} }),
+    /version gap/,
+  );
+  assert.equal(projector.getSnapshot("t").version, 1);
+});
+
+test("a CANCELLED trade is terminal and rejects later new versions", async () => {
+  const projector = createEventProjector(async () => {});
+  await projector.project(created());
+  await projector.project({ tradeId: "trade-1", version: 2, type: "CANCELLED", payload: {} });
+  assert.equal(projector.getSnapshot("trade-1").status, "cancelled");
+
+  await assert.rejects(
+    projector.project({ tradeId: "trade-1", version: 3, type: "AMENDED", payload: { notional: 5 } }),
+    /terminal/,
+  );
+  assert.equal(projector.getSnapshot("trade-1").version, 2);
+});
+
+test("malformed events reject with TypeError; invalid field values rejected", async () => {
+  const projector = createEventProjector(async () => {});
+  await assert.rejects(projector.project(null), TypeError);
+  await assert.rejects(
+    projector.project({ tradeId: "x", version: 1, type: "NOPE", payload: {} }),
+    TypeError,
+  );
+  await assert.rejects(projector.project(created("x", { notional: -5 })), TypeError);
+  await assert.rejects(projector.project(created("x", { owner: "" })), TypeError);
+
+  await projector.project(created("x"));
+  await assert.rejects(
+    projector.project({ tradeId: "x", version: 2, type: "AMENDED", payload: { notional: Number.NaN } }),
+    TypeError,
+  );
+  assert.equal(projector.getSnapshot("x").notional, 100);
+});
+
+test("returned states and snapshots do not expose mutable internal state", async () => {
+  const projector = createEventProjector(async () => {});
+  const event = created();
+  const persisted = await projector.project(event);
+  persisted.notional = 1;
+  event.payload.notional = 1;
+  const snapshot = projector.getSnapshot("trade-1");
+  assert.equal(snapshot.notional, 100);
+  snapshot.owner = "mutated";
+  assert.equal(projector.getSnapshot("trade-1").owner, "desk-a");
 });
