{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'git diff --check && git status --short && git diff -- benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs benchmark/fixtures/T6-rejected-promise-cache/config-api.mjs benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs benchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md && git diff --name-only'","aggregated_output":" M benchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md\n M benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\n M benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs\ndiff --git a/benchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md b/benchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md\nindex 5c0c8ea..5a7b10f 100644\n--- a/benchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md\n+++ b/benchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md\n@@ -2,24 +2,59 @@\n \n ## Summary\n \n-Complete after diagnosing the failure.\n+A transient timeout left a rejected origin-load promise in the in-process\n+configuration cache. Later reads reused that rejection instead of trying the\n+origin again. The cache now removes a failed load while retaining successful\n+entries and protecting any newer replacement for the same tenant.\n \n ## User impact\n \n-Complete after diagnosing the failure.\n+Configuration reads for the affected tenant returned 503 after the origin had\n+recovered. In the recorded incident, all three requests for `acme` failed, and\n+the second and third requests had no opportunity to recover because the\n+application made only one origin load.\n \n ## Root cause and evidence\n \n-Complete after diagnosing the failure.\n+`getConfig` stored the in-flight promise in `entries` so concurrent misses could\n+share one load. It never removed that promise if the load or validation\n+rejected. Because a rejected promise remains settled and truthy, every later\n+lookup found the same entry and immediately replayed the original error.\n+\n+The log records a miss and timeout for `cfg-781`, followed by two\n+`cache=hit` responses with the same `origin_timeout`. Its final line confirms\n+three requests but only one origin load. The implementation matched that\n+timeline: the only deletion paths were explicit `clear` calls, while the load\n+chain had no failure cleanup. The committed retry tests also failed because a\n+second read reused the first rejected promise.\n \n ## Why the logs were misleading\n \n-Complete after diagnosing the failure.\n+The healthy probe tested the origin independently; it did not prove that the\n+application issued a new load. Meanwhile, `cache=hit` can sound like a valid\n+configuration was cached. Here it meant only that a promise entry existed, and\n+that promise contained the earlier rejection. Those signals can wrongly point\n+an investigation toward an intermittent upstream or an HTTP cache even though\n+the poison was in the process-local promise map.\n \n ## Fix and regression coverage\n \n-Complete after diagnosing the failure.\n+The load chain now catches both origin failures and invalid origin results. It\n+deletes the entry only when the map still contains that exact promise, then\n+rethrows the original error to all current waiters. This permits the next read\n+to load again without adding automatic retries or evicting successful values.\n+The identity check prevents an old load that fails late from deleting a newer\n+entry installed after an explicit clear.\n+\n+The added regression tests cover shared failure for concurrent waiters followed\n+by recovery, the clear-and-replace late-failure race, and retry after invalid\n+origin data while a successful tenant remains cached. The committed suite also\n+covers copy isolation, normalized tenant keys, coalescing, tenant separation,\n+targeted invalidation, and API recovery with the required 503 retry response.\n \n ## Remaining risk\n \n-Complete after diagnosing the failure.\n+Successful entries have no expiry or size bound. They remain until explicitly\n+cleared or the process restarts, so freshness and memory growth still depend on\n+the caller's invalidation policy; this repair intentionally does not change\n+that existing cache contract.\ndiff --git a/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs b/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\nindex c2c316c..2345c01 100644\n--- a/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\n+++ b/benchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\n@@ -51,7 +51,13 @@ export function createConfigCache(loadFromOrigin) {\n     if (!pending) {\n       pending = Promise.resolve()\n         .then(() => loadFromOrigin(key))\n-        .then(normalizeConfig);\n+        .then(normalizeConfig)\n+        .catch((error) => {\n+          if (entries.get(key) === pending) {\n+            entries.delete(key);\n+          }\n+          throw error;\n+        });\n       entries.set(key, pending);\n     }\n \ndiff --git a/benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs b/benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs\nindex 3fb23bb..775058a 100644\n--- a/benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs\n+++ b/benchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs\n@@ -1,6 +1,76 @@\n import assert from \"node:assert/strict\";\n import test from \"node:test\";\n \n-test(\"replace this placeholder with incident regression tests\", () => {\n-  assert.fail(\"Add at least three meaningful tests\");\n+import { ConfigOriginError, createConfigCache } from \"./config-cache.mjs\";\n+\n+const CONFIG = Object.freeze({ version: \"v1\", features: Object.freeze([\"search\"]) });\n+\n+test(\"all waiters share a failed load and the next read retries\", async () => {\n+  let calls = 0;\n+  let rejectLoad;\n+  const firstLoad = new Promise((resolve, reject) => {\n+    rejectLoad = reject;\n+  });\n+  const cache = createConfigCache(async () => {\n+    calls += 1;\n+    return calls === 1 ? firstLoad : CONFIG;\n+  });\n+\n+  const first = cache.getConfig(\"acme\");\n+  const second = cache.getConfig(\" acme \");\n+  const timeout = new ConfigOriginError(\"temporary timeout\");\n+  rejectLoad(timeout);\n+\n+  const failures = await Promise.allSettled([first, second]);\n+  assert.deepEqual(failures.map(({ status }) => status), [\"rejected\", \"rejected\"]);\n+  assert.equal(failures[0].reason, timeout);\n+  assert.equal(failures[1].reason, timeout);\n+  assert.equal(calls, 1);\n+\n+  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n+  assert.equal(calls, 2);\n+});\n+\n+test(\"a late failure does not delete a replacement created after clear\", async () => {\n+  let calls = 0;\n+  let rejectFirstLoad;\n+  const firstLoad = new Promise((resolve, reject) => {\n+    rejectFirstLoad = reject;\n+  });\n+  const replacement = { version: \"v2\", features: [\"billing\"] };\n+  const cache = createConfigCache(async () => {\n+    calls += 1;\n+    return calls === 1 ? firstLoad : replacement;\n+  });\n+\n+  const staleRead = cache.getConfig(\"acme\");\n+  await Promise.resolve();\n+  cache.clear(\"acme\");\n+  assert.deepEqual(await cache.getConfig(\"acme\"), replacement);\n+\n+  rejectFirstLoad(new ConfigOriginError(\"late timeout\"));\n+  await assert.rejects(staleRead, ConfigOriginError);\n+\n+  assert.deepEqual(await cache.getConfig(\"acme\"), replacement);\n+  assert.equal(calls, 2);\n+});\n+\n+test(\"invalid origin data is evicted without disturbing successful tenants\", async () => {\n+  const calls = new Map();\n+  const cache = createConfigCache(async (tenantId) => {\n+    const count = (calls.get(tenantId) ?? 0) + 1;\n+    calls.set(tenantId, count);\n+    if (tenantId === \"beta\" && count === 1) {\n+      return { version: \"bad\", features: [42] };\n+    }\n+    return tenantId === \"acme\" ? CONFIG : { version: \"v2\", features: [] };\n+  });\n+\n+  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n+  await assert.rejects(cache.getConfig(\"beta\"), /features must be an array of strings/);\n+  assert.equal(cache.size(), 1);\n+\n+  assert.deepEqual(await cache.getConfig(\"acme\"), CONFIG);\n+  assert.deepEqual(await cache.getConfig(\"beta\"), { version: \"v2\", features: [] });\n+  assert.deepEqual(Object.fromEntries(calls), { acme: 1, beta: 2 });\n });\nbenchmark/fixtures/T6-rejected-promise-cache/INCIDENT.md\nbenchmark/fixtures/T6-rejected-promise-cache/config-cache.mjs\nbenchmark/fixtures/T6-rejected-promise-cache/student-tests.mjs\n","exit_code":0,"status":"completed"}}
