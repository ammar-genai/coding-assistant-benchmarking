{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/coding-assistant-benchmark/task.schema.json",
  "title": "Benchmark task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "type",
    "mode",
    "prompt_path",
    "allowed_paths",
    "forbidden_actions",
    "acceptance_checks",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^T[0-9]+-[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["analysis", "bug-fix", "feature", "ui", "refactor", "migration", "incident", "ci"] },
    "mode": { "enum": ["read-only", "workspace-write"] },
    "prompt_path": { "type": "string", "minLength": 1 },
    "allowed_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "command": { "type": "string" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_time_seconds", "max_human_interventions"],
      "properties": {
        "max_wall_time_seconds": { "type": "integer", "minimum": 1 },
        "max_human_interventions": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
